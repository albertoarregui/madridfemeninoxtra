---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import NextMatchCountdown from "../components/NextMatchCountdown.astro";
import { getAssetUrl } from "../utils/assets";
import "../styles/global.css";
// @ts-ignore
import "@fontsource/cormorant-garamond/400.css";
// @ts-ignore
import "@fontsource/cormorant-garamond/400-italic.css";
// @ts-ignore
import "@fontsource/cormorant-garamond/700.css";
// @ts-ignore
import "@fontsource/cinzel/400.css";
// @ts-ignore
import "@fontsource/cinzel/700.css";
// @ts-ignore
import "@fontsource/dm-sans/400.css";
// @ts-ignore
import "@fontsource/dm-sans/500.css";
// @ts-ignore
import "@fontsource/dm-sans/700.css";

const ogImage = "https://www.madridfemeninoxtra.com/og.png";
const orgLogo = "https://www.madridfemeninoxtra.com/icon-512.png";
const favicon = "/icon.webp";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	showAds?: boolean;
	author?: string;
	noBg?: boolean;
	canonical?: string;
}
const {
	title = "Noticias, actualidad y estadísticas del Real Madrid femenino | Madrid Femenino Xtra",
	description = "Tu fuente 100% dedicada al Real Madrid Femenino. Consulta todas las noticias, resultados, clasificación, calendario y estadísticas en un solo lugar. ¡Entra y no te pierdas nada de la actualidad del equipo!",
	image = ogImage,
	noindex = false,
	showAds = true,
	author = "Madrid Femenino Xtra",
	noBg = false,
	canonical,
} = Astro.props;

const canonicalUrl = canonical
	? new URL(canonical, Astro.site).href
	: new URL(Astro.url.pathname, Astro.site).href;

const bgUrl = noBg ? null : getAssetUrl("background", "background.webp");

const siteSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": "https://www.madridfemeninoxtra.com/#organization",
			name: "Madrid Femenino Xtra",
			url: "https://www.madridfemeninoxtra.com/home",
			logo: orgLogo,
			sameAs: ["https://twitter.com/madridfemxtra"],
		},
		{
			"@type": "WebSite",
			"@id": "https://www.madridfemeninoxtra.com/#website",
			url: "https://www.madridfemeninoxtra.com/home",
			name: "Madrid Femenino Xtra",
			inLanguage: "es",
			publisher: { "@id": "https://www.madridfemeninoxtra.com/#organization" },
			potentialAction: {
				"@type": "SearchAction",
				target: { "@type": "EntryPoint", urlTemplate: "https://www.madridfemeninoxtra.com/search?q={search_term_string}" },
				"query-input": "required name=search_term_string",
			},
		},
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="icon" type="image/webp" href={favicon} />
		<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalUrl} />
		<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
		<link rel="alternate" type="application/rss+xml" title="Madrid Femenino Xtra Noticias" href="/rss.xml" />
		<link rel="preconnect" href="https://i.ytimg.com" />
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#090909" />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Madrid Femenino Xtra" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="es_ES" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@madridfemxtra" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="robots" content={noindex ? "noindex" : "index, follow"} />
		<slot name="head" />
		<ClientRouter />
	</head>
	<body>
		{bgUrl && <div class="global-bg" style={`background-image:url(${bgUrl})`}></div>}
		<Header />
		<div class="page-wrapper">
			<slot />
		</div>
		<Footer />
		<NextMatchCountdown />
		<CookieConsent showAds={showAds} />
		<ScrollToTop />
		<script is:inline>
			function setupGlobalSelects() {
				const containers = document.querySelectorAll(
					".custom-select-container[data-custom-select='true']",
				);

				containers.forEach((container) => {
					if (container.getAttribute("data-global-init")) return;
					container.setAttribute("data-global-init", "true");

					const trigger = container.querySelector(
						".custom-select-trigger",
					);
					const nativeSelect =
						container.querySelector(".native-select") ||
						container.querySelector("select");
					const options = container.querySelectorAll(
						".custom-select-option",
					);
					const selectedText = trigger
						? trigger.querySelector(".selected-text")
						: null;

					if (!trigger) return;

					const handleToggle = (e) => {
						e.stopPropagation();
						document
							.querySelectorAll(".custom-select-container")
							.forEach((c) => {
								if (c !== container) c.classList.remove("open");
							});
						container.classList.toggle("open");
					};

					trigger.addEventListener("click", handleToggle);

					options.forEach((option) => {
						option.addEventListener("click", (e) => {
							e.stopPropagation();
							const value = option.getAttribute("data-value");
							const text = option.textContent.trim();

							if (selectedText) selectedText.textContent = text;
							options.forEach((opt) =>
								opt.classList.remove("selected"),
							);
							option.classList.add("selected");

							if (nativeSelect) {
								nativeSelect.value = value;
								nativeSelect.dispatchEvent(
									new Event("change", { bubbles: true }),
								);
							}
							container.classList.remove("open");
						});
					});
				});

				if (!window.globalSelectOutsideListenerSet) {
					document.addEventListener("click", (e) => {
						const isClickInside = e.target.closest(
							".custom-select-container",
						);
						if (!isClickInside) {
							document
								.querySelectorAll(
									".custom-select-container.open",
								)
								.forEach((c) => c.classList.remove("open"));
						}
					});
					window.globalSelectOutsideListenerSet = true;
				}
			}

			if (document.readyState === "loading") {
				document.addEventListener(
					"DOMContentLoaded",
					setupGlobalSelects,
				);
			} else {
				setupGlobalSelects();
			}
			document.addEventListener("astro:page-load", setupGlobalSelects);

			setInterval(setupGlobalSelects, 1000);

			function setupSectionTitles() {
				document.querySelectorAll('.section-title, .landing-title').forEach(function(el) {
					if (!el.getAttribute('data-title')) {
						var text = el.textContent ? el.textContent.trim().toUpperCase() : '';
						if (text) el.setAttribute('data-title', text);
					}
				});
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", setupSectionTitles);
			} else {
				setupSectionTitles();
			}
			document.addEventListener("astro:page-load", setupSectionTitles);
		</script>
	</body>
</html>



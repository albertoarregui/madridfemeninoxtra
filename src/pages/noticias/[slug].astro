<script is:inline>
    function loadEmbeds() {

        if (window.twttr && window.twttr.widgets) {
            window.twttr.widgets.load();
        } else if (document.querySelector('.twitter-tweet') && !document.getElementById("twttr-wjs")) {
            const s = document.createElement("script");
            s.id = "twttr-wjs";
            s.src = "https://platform.twitter.com/widgets.js";
            s.async = true;
            document.head.appendChild(s);
        }


        if (window.instgrm && window.instgrm.Embeds) {
            window.instgrm.Embeds.process();
        } else if (document.querySelector('.instagram-media') && !document.getElementById("instgrm-wjs")) {
            const s = document.createElement("script");
            s.id = "instgrm-wjs";
            s.src = "//www.instagram.com/embed.js";
            s.async = true;
            document.head.appendChild(s);
        }


        if (document.querySelector('.tiktok-embed') && !document.getElementById("tiktok-wjs")) {
            const s = document.createElement("script");
            s.id = "tiktok-wjs";
            s.src = "https://www.tiktok.com/embed.js";
            s.async = true;
            document.head.appendChild(s);
        }
    }


    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", loadEmbeds);
    } else {
        loadEmbeds();
    }
    document.addEventListener("astro:page-load", loadEmbeds);
    setTimeout(loadEmbeds, 1000);
</script>


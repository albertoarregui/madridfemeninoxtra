---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import {
    fetchPlayersDirectly,
    fetchPlayerStats,
    slugify as playerSlugify,
} from "../../utils/players";
import {
    fetchCoachesDirectly,
    fetchCoachStats,
} from "../../utils/entrenadores";
import { fetchRefereesDirectly } from "../../utils/arbitras";
import { fetchRivalsDirectly, getRivalShieldUrl } from "../../utils/rivales";
import { fetchGameById, fetchGameBySlug } from "../../utils/partidos";
import { getFlagSrc } from "../../utils/flags";
import { generateSlug } from "../../utils/url-helper";
import { cached } from "../../utils/cache";

export const prerender = false;

const { slug } = Astro.params;

let noticia: any = null;
let noticiaId: string | null = null;
let noticiaCreatedAt: string | null = null;
let noticiaUpdatedAt: string | null = null;
let relatedNoticias: any[] = [];

try {
    const { contentfulClient } = await import("../../lib/contentful");
    const entrySelect = [
        "sys.id", "sys.createdAt", "sys.updatedAt",
        "fields.title", "fields.subtitle", "fields.slug", "fields.body",
        // Solo campos que existen en el tipo `noticia`: Contentful rechaza
        // la consulta entera (422) si se selecciona uno desconocido.
        "fields.featuredImage", "fields.author",
        "fields.player", "fields.category", "fields.focusType",
        "fields.referenceId",
    ] as any;
    const entries = await cached(`contentful:news:item:${slug}:es`, 24 * 60 * 60 * 1000, async () => contentfulClient.getEntries({
        content_type: "noticia",
        "fields.slug": slug,
        include: 1,
        limit: 1,
        select: entrySelect,
    }), { tags: ["news", `news-${slug}`] });

    let entry = entries?.items?.[0];
    if (!entry) {
        const recentEntries = await cached(`contentful:news:recent-fallback:es`, 24 * 60 * 60 * 1000, async () => contentfulClient.getEntries({
            content_type: "noticia",
            order: ["-sys.createdAt"],
            include: 1,
            limit: 25,
            select: entrySelect,
        }), { tags: ["news"] });
        entry = recentEntries.items.find((item: any) => item.fields?.slug === slug);
    }

    if (entry) {
        noticia = entry.fields;
        noticiaId = entry.sys.id;
        noticiaCreatedAt = entry.sys.createdAt;
        noticiaUpdatedAt = entry.sys.updatedAt;

        if (noticia?.category && noticiaId) {
            try {
                const relatedEntries = await cached(`contentful:news:related:${noticiaId}:${noticia.category}:es`, 24 * 60 * 60 * 1000, async () => contentfulClient.getEntries({
                    content_type: "noticia",
                    "fields.category": noticia.category,
                    "sys.id[ne]": noticiaId,
                    order: ["-sys.createdAt"],
                    limit: 3,
                    include: 1,
                    select: [
                        "sys.id", "sys.createdAt",
                        "fields.title", "fields.slug", "fields.featuredImage",
                    ] as any,
                }), { tags: ["news"] });
                relatedNoticias = relatedEntries.items.map((item: any) => ({
                    ...item.fields,
                    id: item.sys.id,
                    createdAt: item.sys.createdAt,
                }));
            } catch (e) {
                console.warn("Error fetching related news:", e);
            }
        }
    }
} catch (e: any) {
    console.warn("Error consultando Contentful:", e);
}

if (!noticia) {
    return Astro.redirect("/404");
}

const n = noticia as any;
const { title, subtitle, player, category, focusType, referenceId, id, author } = n;

const contentReferenceId = referenceId || id;

const TIPOS_WIDGET = ["player", "coach", "referee", "club", "match"] as const;

const esTipoValido = (t: string): boolean =>
    (TIPOS_WIDGET as readonly string[]).includes(String(t).toLowerCase().trim());

const tiposDeclarados = String(focusType ?? "")
    .split(/[,;\n]+/)
    .map((t: string) => t.trim().toLowerCase())
    .filter(Boolean);

const tipoPrincipal = tiposDeclarados.find(esTipoValido) || "";

const refsCrudas = String(referenceId ?? id ?? "")
    .split(/[,;\n]+/)
    .map((r: string) => r.trim())
    .filter(Boolean);

const referenciasWidget = refsCrudas
    .map((r: string, i: number) => {
        const m = r.match(/^([a-zA-Z]+)\s*:\s*(.+)$/);
        if (m && esTipoValido(m[1])) {
            return { tipo: m[1].toLowerCase(), ref: m[2].trim() };
        }
        const enParalelo =
            tiposDeclarados.length === refsCrudas.length &&
            esTipoValido(tiposDeclarados[i])
                ? tiposDeclarados[i]
                : tipoPrincipal;
        return { tipo: enParalelo, ref: r };
    })
    .filter((r: any) => r.ref && r.tipo);

const refsDe = (tipo: string): string[] => {
    const propias = referenciasWidget
        .filter((r: any) => r.tipo === tipo)
        .map((r: any) => r.ref);
    return propias.length ? propias : tipoPrincipal === tipo ? [""] : [];
};

const featuredImageUrl = n.featuredImage?.fields?.file?.url
    ? (String(n.featuredImage.fields.file.url).startsWith("//") ? `https:${n.featuredImage.fields.file.url}` : `${n.featuredImage.fields.file.url}`)
    : "https://www.madridfemeninoxtra.com/og.png";
const featuredImageWidth: number = n.featuredImage?.fields?.file?.details?.image?.width ?? 1200;
const featuredImageHeight: number = n.featuredImage?.fields?.file?.details?.image?.height ?? 630;
const hasCfImage = Boolean(n.featuredImage?.fields?.file?.url);

function contentfulSrcSet(url: string, widths: number[] = [480, 768, 1200]): string | undefined {
    if (!url.includes("images.ctfassets.net")) return undefined;
    const separator = url.includes("?") ? "&" : "?";
    return widths.map((width) => `${url}${separator}fm=webp&w=${width}&q=82 ${width}w`).join(", ");
}

let bodyHtml = ``;

if (n.body) {
    try {
        if (typeof n.body === "string") {
            bodyHtml = `<p>${n.body}</p>`;
        } else if (n.body.nodeType === "document") {
            const options = {
                renderNode: {
                    "embedded-asset-block": (node: any) => {
                        const file = node.data?.target?.fields?.file;
                        const title = node.data?.target?.fields?.title || '';
                        if (file && file.url) {
                            const url = file.url.startsWith('//') ? (String(file.url).startsWith("//") ? `https:${file.url}` : `${file.url}`) : file.url;
                            const width = Number(file.details?.image?.width) || 1200;
                            const height = Number(file.details?.image?.height) || 675;
                            const srcset = contentfulSrcSet(url);
                            return `<figure class="media-centered"><img src="${url}"${srcset ? ` srcset="${srcset}" sizes="(max-width: 768px) 100vw, 900px"` : ''} alt="${title}" width="${width}" height="${height}" loading="lazy" decoding="async" />${title ? `<figcaption class="photo-caption">${title}</figcaption>` : ''}</figure>`;
                        }
                        return '';
                    }
                }
            };
            bodyHtml = documentToHtmlString(n.body, options);


            bodyHtml = bodyHtml.replace(/&lt;(\/?(?:iframe|blockquote|script|a|p|div|section|span|br)[\s\S]*?)&gt;/gi, (m: string, content: string) => {
                const unescaped = content.replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, "&").replace(/&mdash;/g, "—");
                return `<${unescaped}>`;
            });
            

            bodyHtml = bodyHtml.replace(/<blockquote(.*?)class="twitter-tweet"(.*?)>/gi, '<blockquote$1class="twitter-tweet" data-align="center" data-theme="light"$2>');
            

            bodyHtml = bodyHtml.replace(/<p>\s*<iframe/gi, '<iframe');
            bodyHtml = bodyHtml.replace(/<\/iframe>\s*<\/p>/gi, '</iframe>');
            bodyHtml = bodyHtml.replace(/<p>\s*<blockquote/gi, '<blockquote');
            bodyHtml = bodyHtml.replace(/<\/blockquote>\s*<\/p>/gi, '</blockquote>');
        } else {
            bodyHtml = `<p>Error de formato.</p>`;
        }
    } catch (e) {
        bodyHtml = `<p>Ocurrió un error leyendo el contenido.</p>`;
    }
}

const plainText = bodyHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const wordCount = plainText.split(' ').filter((w: string) => w.length > 0).length;
const readTime = Math.max(1, Math.round(wordCount / 200));

let playerData: any = null;
let playerStats: any = null;
let coachData: any = null;
let coachStats: any = null;
let clubData: any = null;
let refereeData: any = null;
let matchData: any = null;
let matchLineup: any[] = [];

const playerWidgets: any[] = [];
for (const ref of refsDe("player")) {
    const allPlayers = await fetchPlayersDirectly();
    const buscado = ref || String(contentReferenceId ?? "");
    const datos =
        allPlayers.find((p) => String(p.id_jugadora) === buscado) ||
        allPlayers.find(
            (p) =>
                String(p.nombre).toLowerCase() ===
                String(buscado || player).toLowerCase(),
        ) ||
        allPlayers.find((p) =>
            String(p.nombre)
                .toLowerCase()
                .includes(String(buscado || player || "").toLowerCase()),
        );
    if (!datos) continue;

    const statsResponse = await fetchPlayerStats(
        datos.id_jugadora,
        datos.posicion === "Portera",
    );
    const stats = statsResponse
        ? {
              ...statsResponse,
              current_official: statsResponse.total_carrera_oficial || {
                  partidos: 0,
                  minutos: 0,
                  goles: 0,
                  asistencias: 0,
                  porterias_cero: 0,
              },
              season_name: "TOTAL (OFICIAL)",
          }
        : null;
    playerWidgets.push({ playerData: datos, playerStats: stats });
}
playerData = playerWidgets[0]?.playerData ?? null;
playerStats = playerWidgets[0]?.playerStats ?? null;

const coachWidgets: any[] = [];
for (const ref of refsDe("coach")) {
    const coaches = await fetchCoachesDirectly();
    const buscado = ref || String(contentReferenceId ?? "");
    coachData = buscado
        ? coaches.find((c) => String(c.id_entrenador) === buscado) ||
          coaches.find((c) => String(c.slug) === buscado) ||
          coaches.find((c) =>
              String(c.nombre).toLowerCase().includes(buscado.toLowerCase()),
          )
        : coaches.find((c) => String(c.nombre).toLowerCase().includes("toril"));
    coachStats = null;

    if (coachData) {
        const statsResp = await fetchCoachStats(coachData.id_entrenador);
        if (statsResp?.estadisticas?.length > 0) {
            const officialComps = [
                "Liga F",
                "Primera Iberdrola",
                "UWCL",
                "Copa de la Reina",
                "Supercopa de España",
            ];

            const officialTotal = (statsResp.estadisticas as any[]).reduce(
                (accTotal: any, season: any) => {
                    const comps = (season.competiciones || []) as any[];
                    const seasonOfficial = comps
                        .filter((c: any) =>
                            officialComps.includes(c.competicion),
                        )
                        .reduce(
                            (acc: any, c: any) => ({
                                partidos: acc.partidos + c.partidos,
                                victorias: acc.victorias + c.victorias,
                                empates: acc.empates + c.empates,
                                derrotas: acc.derrotas + c.derrotas,
                                goles_favor: acc.goles_favor + c.goles_favor,
                                goles_contra: acc.goles_contra + c.goles_contra,
                            }),
                            {
                                partidos: 0,
                                victorias: 0,
                                empates: 0,
                                derrotas: 0,
                                goles_favor: 0,
                                goles_contra: 0,
                            },
                        );

                    return {
                        partidos: accTotal.partidos + seasonOfficial.partidos,
                        victorias:
                            accTotal.victorias + seasonOfficial.victorias,
                        empates: accTotal.empates + seasonOfficial.empates,
                        derrotas: accTotal.derrotas + seasonOfficial.derrotas,
                        goles_favor:
                            accTotal.goles_favor + seasonOfficial.goles_favor,
                        goles_contra:
                            accTotal.goles_contra + seasonOfficial.goles_contra,
                    };
                },
                {
                    partidos: 0,
                    victorias: 0,
                    empates: 0,
                    derrotas: 0,
                    goles_favor: 0,
                    goles_contra: 0,
                },
            );

            coachStats = {
                current_official: officialTotal,
                season_name: "TOTAL (OFICIAL)",
            };
        }
    }
    if (coachData) coachWidgets.push({ coachData, coachStats });
}
coachData = coachWidgets[0]?.coachData ?? null;
coachStats = coachWidgets[0]?.coachStats ?? null;

const refereeWidgets: any[] = [];
for (const ref of refsDe("referee")) {
    const referees = await fetchRefereesDirectly();
    const buscado = ref || String(contentReferenceId ?? "");
    const datos = buscado
        ? referees.find((r) => String(r.id_arbitra) === buscado) ||
          referees.find((r) =>
              String(r.nombre).toLowerCase().includes(buscado.toLowerCase()),
          )
        : referees[0];
    if (datos) refereeWidgets.push({ refereeData: datos });
}
refereeData = refereeWidgets[0]?.refereeData ?? null;

const clubWidgets: any[] = [];
for (const ref of refsDe("club")) {
    const contentReferenceId = ref || String((referenceId ?? id) ?? "");
    const rivals = await fetchRivalsDirectly();
    clubData = contentReferenceId
        ? rivals.find((r) => String(r.id_club) === String(contentReferenceId)) ||
          rivals.find((r) => String(r.slug) === String(contentReferenceId))
        : rivals[0];

    // La referencia explícita del widget manda: otros campos editoriales de la
    // noticia pueden mencionar al Real Madrid aunque el club destacado sea rival.
    const isRMRequested = String(contentReferenceId) === "1";

    if (!clubData || (isRMRequested && String(clubData.id_club) !== "1")) {
        const { getPlayersDbClient } = await import("../../db/client");
        const client = await getPlayersDbClient();
        if (client) {
            const clubRes = await client.execute({
                sql: `SELECT c.*, e.nombre as estadio, e.capacidad, e.lat as estadio_lat, e.lng as estadio_lng 
                      FROM clubes c 
                      LEFT JOIN estadios e ON c.estadio = e.id_estadio 
                      WHERE ${isRMRequested ? "c.id_club = 1" : "c.id_club = ?"}`,
                args: isRMRequested ? [] : [contentReferenceId as any],
            });
            if (clubRes.rows.length > 0) {
                const row = clubRes.rows[0];
                const cleanNombre = String(row.nombre || "Club");
                const matchesRes = await client.execute({
                    sql: `SELECT p.goles_rm, p.goles_rival, p.penaltis
                          FROM partidos p
                          LEFT JOIN competiciones co ON p.id_competicion = co.id_competicion
                          WHERE (p.id_club_local = ? OR p.id_club_visitante = ?)
                            AND p.goles_rm IS NOT NULL AND p.goles_rm != ''
                            AND p.goles_rival IS NOT NULL AND p.goles_rival != ''
                            AND LOWER(COALESCE(co.competicion, '')) NOT LIKE '%amistoso%'`,
                    args: [row.id_club as any, row.id_club as any],
                });
                const playedMatches = matchesRes.rows;

                let wins = 0,
                    draws = 0,
                    losses = 0,
                    gf = 0,
                    ga = 0,
                    cleanSheets = 0;
                playedMatches.forEach((m: any) => {
                    const gRM = Number(m.goles_rm) || 0;
                    const gRiv = Number(m.goles_rival) || 0;
                    gf += gRM;
                    ga += gRiv;
                    if (gRiv === 0) cleanSheets++;
                    const penaltis = String(m.penaltis ?? "").trim();
                    if (gRM > gRiv || (gRM === gRiv && penaltis === "1")) wins++;
                    else if (gRM < gRiv || (gRM === gRiv && penaltis === "0")) losses++;
                    else draws++;
                });

                clubData = {
                    id_club: row.id_club,
                    nombre: cleanNombre,
                    ciudad: row.ciudad || "",
                    pais: row.pais || "",
                    iso: row.iso || "",
                    slug: row.slug || generateSlug(cleanNombre),
                    estadio: row.estadio || "",
                    capacidad: row.capacidad || null,
                    shieldUrl: getRivalShieldUrl({
                        nombre: cleanNombre,
                        foto_url: row.foto_url,
                    }),
                    stats: {
                        played: playedMatches.length,
                        wins,
                        draws,
                        losses,
                        gf,
                        ga,
                        gd: gf - ga,
                        cleanSheets,
                    },
                };
            }
        }
    }
    if (clubData) clubWidgets.push({ clubData });
}
clubData = clubWidgets[0]?.clubData ?? null;

const posOrder = ["Portera", "Defensa", "Centrocampista", "Delantera"];

const lineaDe = (pos: string): string => {
    const p = (pos || "").toLowerCase();
    if (/porter|guardameta|\bgk\b/.test(p)) return "Portera";
    if (/lateral|central|defens|carriler/.test(p)) return "Defensa";
    if (/extremo|delanter|atacante|punta|forward|ariete/.test(p))
        return "Delantera";
    return "Centrocampista";
};

const ladoDe = (pos: string): number => {
    const p = (pos || "").toLowerCase();
    if (/izquierd|\bizq|left/.test(p)) return 0;
    if (/derech|\bder\b|right/.test(p)) return 2;
    return 1;
};

const esDeBanda = (pos: string): boolean =>
    /lateral|carriler|extremo|banda|winger/i.test(pos || "");

const colocarLinea = (jugadoras: any[]): any[] => {
    const conLado = jugadoras.some((p) => ladoDe(p.posicion) !== 1);
    if (conLado) {
        return jugadoras
            .map((p, i) => ({ p, i }))
            .sort(
                (a, b) => ladoDe(a.p.posicion) - ladoDe(b.p.posicion) || a.i - b.i,
            )
            .map(({ p }) => p);
    }
    const bandas = jugadoras.filter((p) => esDeBanda(p.posicion));
    const centro = jugadoras.filter((p) => !esDeBanda(p.posicion));
    if (bandas.length === 2 && centro.length > 0) {
        return [bandas[0], ...centro, bandas[1]];
    }
    return jugadoras;
};

const filasDeAlineacion = (alineacion: any[]) => {
    const filas: Record<string, any[]> = {};
    alineacion.forEach((p: any) => {
        const key = lineaDe(p.posicion);
        if (!filas[key]) filas[key] = [];
        filas[key].push(p);
    });
    return posOrder
        .map((k) => ({ key: k, players: colocarLinea(filas[k] || []) }))
        .filter((r) => r.players.length > 0);
};

const matchWidgets: any[] = [];
for (const ref of refsDe("match")) {
    const buscado = ref || String(contentReferenceId ?? "").trim();
    if (!buscado) continue;
    try {
        const datos = /^\d+$/.test(buscado)
            ? await fetchGameById(buscado)
            : await fetchGameBySlug(buscado);
        if (!datos) continue;

        const { fetchMatchLineups } = await import("../../utils/partidos");
        const alineacion = ((await fetchMatchLineups(datos.id_partido)) || []).map(
            (p: any) => ({
                ...p,
                nombre: p.name ?? p.nombre ?? "",
                posicion: p.pos ?? p.posicion ?? "",
                foto_url: p.imageUrl ?? p.foto_url ?? "",
                goles: p.goals ?? p.goles ?? 0,
                asistencias: p.assists ?? p.asistencias ?? 0,
            }),
        );

        const esLocalRM =
            datos.club_local?.toLowerCase().includes("real madrid") ?? false;
        matchWidgets.push({
            matchData: datos,
            matchLineup: alineacion,
            matchRowsOrdered: filasDeAlineacion(alineacion),
            matchRivalName:
                (esLocalRM ? datos.club_visitante : datos.club_local) || "",
            matchRivalShield: esLocalRM
                ? datos.visitante_shield_url || datos.visitante_foto_url
                : datos.local_shield_url || datos.local_foto_url,
        });
    } catch (e) {
        console.warn("Error fetching match data:", e);
    }
}
matchData = matchWidgets[0]?.matchData ?? null;
matchLineup = matchWidgets[0]?.matchLineup ?? [];

const publishDateISO = new Date(noticia?.publishDate || noticiaCreatedAt || '').toISOString();
const modifiedDateISO = noticiaUpdatedAt
    ? new Date(noticiaUpdatedAt).toISOString()
    : publishDateISO;
const articleUrl = `https://www.madridfemeninoxtra.com/noticias/${slug}`;
const categorySlug = (category || 'actualidad').toLowerCase().replace(/\s+/g, '-');

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.madridfemeninoxtra.com" },
        { "@type": "ListItem", "position": 2, "name": "Noticias", "item": "https://www.madridfemeninoxtra.com/noticias" },
        ...(category ? [{ "@type": "ListItem", "position": 3, "name": category, "item": `https://www.madridfemeninoxtra.com/noticias/categoria/${categorySlug}` }] : []),
        { "@type": "ListItem", "position": category ? 4 : 3, "name": title, "item": articleUrl },
    ],
};

const newsSchema = {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: title,
    description: subtitle || title,
    image: featuredImageUrl ? [featuredImageUrl] : [],
    datePublished: publishDateISO,
    dateModified: modifiedDateISO,
    author: author
        ? { "@type": "Person", name: author, ...(String(author).toLowerCase().includes("alberto") ? { "@id": "https://www.madridfemeninoxtra.com/autor/alberto-arregui#person", url: "https://www.madridfemeninoxtra.com/autor/alberto-arregui" } : {}) }
        : { "@type": "Organization", name: "Madrid Femenino Xtra", url: "https://www.madridfemeninoxtra.com" },
    publisher: {
        "@type": "Organization",
        name: "Madrid Femenino Xtra",
        url: "https://www.madridfemeninoxtra.com",
        logo: {
            "@type": "ImageObject",
            url: "https://www.madridfemeninoxtra.com/icon-512.png",
        },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
    url: articleUrl,
    inLanguage: "es",
    wordCount,
    keywords: [
        "Real Madrid Femenino",
        category || "fútbol femenino",
        player || "",
    ]
        .filter(Boolean)
        .join(", "),
};



---

<Layout
    title={`${title} | Madrid Femenino Xtra`}
    description={subtitle || `${title} - Madrid Femenino Xtra`}
    ogTitle={`${title} | Madrid Femenino Xtra`}
    ogDescription={subtitle || `${title} - Madrid Femenino Xtra`}
    image={featuredImageUrl || undefined}
    noBg={true}
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(newsSchema)}
        slot="head"
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
        slot="head"
    />
    <script is:inline data-astro-rerun>
      (() => {
        const pagePath = location.pathname;
        const match = new RegExp('^/noticias/([a-z0-9-]+)/?$').exec(location.pathname);
        if (!match) return;
        const slug = match[1];
        const storageKey = 'mfx:lectura:' + slug;
        try {
          const last = Number(localStorage.getItem(storageKey) || 0);
          if (last && Date.now() - last < 24 * 60 * 60 * 1000) return;
        } catch { return; }
        if (document.visibilityState !== 'visible') return;
        // Sólo contar una lectura con tiempo real de permanencia.
        setTimeout(async () => {
          if (document.visibilityState !== 'visible' || location.pathname !== pagePath) return;
          try {
            const res = await fetch('/api/noticias/lectura', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ slug }),
              keepalive: true,
            });
            if (res.ok) localStorage.setItem(storageKey, String(Date.now()));
          } catch {}
        }, 8000);
      })();
    </script>
    <meta

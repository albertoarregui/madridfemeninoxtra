                                                <div class="pitch-center-line" />
                                                <div class="pitch-penalty-top" />
                                                <div class="pitch-penalty-bottom" />
                                            </div>

                                            {matchLineup.length === 0 && (
                                                <div class="pitch-no-data">
                                                    XI inicial no disponible
                                                </div>
                                            )}

                                            {matchRowsOrdered.map((rowData: any) => (
                                                <div class="pitch-row">
                                                    {rowData.players.map(
                                                        (p: any) => (
                                                            <div
                                                                class={`pitch-player ${Number(p.goles) > 0 ? "scored" : ""} ${Number(p.asistencias) > 0 ? "assisted" : ""}`}
                                                            >
                                                                <div class="pp-avatar">
                                                                    {p.foto_url ? (
                                                                        <img
                                                                            src={
                                                                                p.foto_url
                                                                            }
                                                                            alt={
                                                                                p.nombre
                                                                            }
                                                                        />
                                                                    ) : (
                                                                        <span class="pp-initials">
                                                                            {(
                                                                                p.nombre ||
                                                                                "?"
                                                                            )
                                                                                .split(
                                                                                    " ",
                                                                                )
                                                                                .map(
                                                                                    (
                                                                                        n: string,
                                                                                    ) =>
                                                                                        n[0],
                                                                                )
                                                                                .slice(
                                                                                    0,
                                                                                    2,
                                                                                )
                                                                                .join(
                                                                                    "",
                                                                                )}
                                                                        </span>
                                                                    )}
                                                                    {Number(
                                                                        p.goles,
                                                                    ) > 0 && (
                                                                        <span class="pp-goal-badge">
                                                                            ⚽{" "}
                                                                            {
                                                                                p.goles
                                                                            }
                                                                        </span>
                                                                    )}
                                                                    {Number(
                                                                        p.asistencias,
                                                                    ) > 0 &&
                                                                        !Number(
                                                                            p.goles,
                                                                        ) && (
                                                                            <span class="pp-assist-badge">
                                                                                🅰
                                                                            </span>
                                                                        )}
                                                                </div>
                                                                <span class="pp-name">
                                                                    {p.nombre || ""}
                                                                </span>
                                                            </div>
                                                        ),
                                                    )}
                                                </div>
                                            ))}
                                        </div>
                                    </div>

                                    <a
                                        href={`/partidos/${matchData.slug || matchData.id_partido}`}
                                        class="widget-cta-btn-premium"
                                        style="margin-top: 1.5rem; display:block;"
                                    >
                                        VER DETALLES DEL PARTIDO →
                                    </a>
                                </div>
                            ))
                        }
                    </div>

                    {relatedNoticias.length > 0 && (
                        <div class="related-news-section">
                            <h3 class="related-news-heading">MÁS NOTICIAS DE {category?.toUpperCase()}</h3>
                            <div class="related-news-grid">
                                {relatedNoticias.map((r: any) => (
                                    <a href={`/noticias/${r.slug}`} class="related-card mfx-link-card"><span class="mfx-spin" aria-hidden="true"></span>
                                        <div class="related-card-image">
                                            <img
                                                src={r.featuredImage?.fields?.file?.url ? (String(r.featuredImage.fields.file.url).startsWith("//") ? `https:${r.featuredImage.fields.file.url}?fm=webp&w=600&h=320&q=80&fit=fill` : `${r.featuredImage.fields.file.url}?fm=webp&w=600&h=320&q=80&fit=fill`) : "https://www.madridfemeninoxtra.com/og.png"}
                                                alt={r.title}
                                                loading="lazy"
                                                decoding="async"
                                                width="600"
                                                height="320"
                                            />
                                        </div>
                                        <div class="related-card-info">
                                            <time class="related-card-date">
                                                {new Date(r.createdAt || '').toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                                            </time>
                                            <h4 class="related-card-title">{r.title}</h4>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </div>
    </article>
</Layout>

<script is:inline>
    function loadEmbeds() {

        if (window.twttr && window.twttr.widgets) {
            window.twttr.widgets.load();
        } else if (document.querySelector('.twitter-tweet') && !document.getElementById("twttr-wjs")) {
            const s = document.createElement("script");
            s.id = "twttr-wjs";
            s.src = "https://platform.twitter.com/widgets.js";
            s.async = true;
            document.head.appendChild(s);
        }


        if (window.instgrm && window.instgrm.Embeds) {
            window.instgrm.Embeds.process();
        } else if (document.querySelector('.instagram-media') && !document.getElementById("instgrm-wjs")) {
            const s = document.createElement("script");
            s.id = "instgrm-wjs";
            s.src = "//www.instagram.com/embed.js";
            s.async = true;
            document.head.appendChild(s);
        }


        if (document.querySelector('.tiktok-embed') && !document.getElementById("tiktok-wjs")) {
            const s = document.createElement("script");
            s.id = "tiktok-wjs";
            s.src = "https://www.tiktok.com/embed.js";
            s.async = true;
            document.head.appendChild(s);
        }
    }


    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", loadEmbeds);
    } else {
        loadEmbeds();
    }
    document.addEventListener("astro:page-load", loadEmbeds);
    setTimeout(loadEmbeds, 1000);
</script>


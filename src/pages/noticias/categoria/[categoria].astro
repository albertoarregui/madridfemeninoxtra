---
import Layout from "../../../layouts/Layout.astro";
import { contentfulClient } from "../../../lib/contentful";
import NewsArchive from "../../../components/NewsArchive";

export const prerender = false;

const { categoria } = Astro.params;

const categoryDisplay = (categoria || '').replace(/-/g, ' ').toUpperCase();

let noticias: any[] = [];
let error = null;

try {
    const entries = await contentfulClient.getEntries({
        content_type: "noticia",
        order: ["-sys.createdAt"],
    });

    const allNoticias = entries.items.map((item: any) => ({
        ...item.fields,
        id: item.sys.id,
        createdAt: item.sys.createdAt,
        updatedAt: item.sys.updatedAt,
    }));

    noticias = allNoticias.filter((n: any) => {
        const cat = (n.category || 'actualidad').toLowerCase().replace(/\s+/g, '-');
        return cat === categoria;
    });
} catch (e: any) {
    console.error("Error fetching news:", e);
    error = e.message;
}

const title = `${categoryDisplay} | Noticias | Madrid Femenino Xtra`;
const description = `Todas las noticias de ${categoryDisplay} del Real Madrid Femenino.`;
---

<Layout title={title} description={description}>
    <main class="news-archive-page">
        <header class="page-header-container">
            <nav class="category-breadcrumb" aria-label="Breadcrumb">
                <a href="/noticias">NOTICIAS</a>
                <span aria-hidden="true">›</span>
                <span>{categoryDisplay}</span>
            </nav>
            <h1 class="landing-title">{categoryDisplay}</h1>
            <p class="landing-subtitle">
                Noticias de {categoryDisplay} del Real Madrid Femenino
            </p>
        </header>

        <section class="news-grid-section">
            <div class="container">
                {error && (
                    <p class="error-message">Error cargando las noticias: {error}</p>
                )}
                {noticias.length === 0 && !error && (
                    <p class="no-news-msg">No hay noticias en esta categoría.</p>
                )}
                {noticias.length > 0 && (
                    <NewsArchive noticias={noticias} client:load />
                )}
            </div>
        </section>
    </main>
</Layout>

<style>
    .news-archive-page {
        background-color: #fdfdfd;
        min-height: 100vh;
    }

    .category-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: "Bebas Neue", sans-serif;
        font-size: 1rem;
        color: #aaa;
        letter-spacing: 1px;
        margin-bottom: 1rem;
        justify-content: center;
    }

    .category-breadcrumb a {
        color: #aaa;
        text-decoration: none;
        transition: color 0.2s;
    }

    .category-breadcrumb a:hover {
        color: #ffde59;
    }

    .category-breadcrumb span:last-child {
        color: #151e42;
        font-weight: bold;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .no-news-msg {
        text-align: center;
        color: #aaa;
        font-family: "Bebas Neue", sans-serif;
        font-size: 1.5rem;
        letter-spacing: 1px;
        padding: 4rem 0;
    }

    @media (max-width: 768px) {
        .news-archive-page {
            padding-top: 1rem;
        }
    }
</style>

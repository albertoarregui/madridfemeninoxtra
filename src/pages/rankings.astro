---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { fetchRankingsDirectly, fetchPlayerStreaks } from "../utils/rankings";
import { fetchPlayerAwards } from "../utils/awards";
import { fetchPlayersDirectly, getPlayerImageUrl } from "../utils/players";
import { breadcrumbSchema } from "../utils/seo";
import StatsRankings from "../components/StatsRankings.tsx";

const rankingsData = await fetchRankingsDirectly();
const streaksData = await fetchPlayerStreaks();
const awardsData = await fetchPlayerAwards();
const playersData = await fetchPlayersDirectly();

const uniqueSeasons = [
    ...new Set(rankingsData.map((g) => g.temporada).filter((s): s is string => !!s)),
].sort().reverse();

const competitionOrder = [
    "Primera Iberdrola",
    "Liga F",
    "UWCL",
    "Copa de la Reina",
    "Supercopa de España",
    "Amistosos",
];

const uniqueCompetitions = [
    ...new Set(rankingsData.map((g) => g.competicion).filter((c): c is string => !!c)),
].sort((a, b) => {
    const indexA = competitionOrder.indexOf(a);
    const indexB = competitionOrder.indexOf(b);
    if (indexA !== -1 && indexB !== -1) return indexA - indexB;
    if (indexA !== -1) return -1;
    if (indexB !== -1) return 1;
    return a.localeCompare(b);
});

const getRankingImage = (player: any): string => {
    const seasons = Object.keys(player.season_photos || {}).sort().reverse();
    for (const season of seasons) {
        const photo = player.season_photos?.[season];
        if (photo) {
            return getPlayerImageUrl({ ...player, foto_url: photo, foto_perfil_url: undefined });
        }
    }
    return getPlayerImageUrl({
        ...player,
        foto_url: player.foto_url || player.nombre,
        foto_perfil_url: undefined,
    });
};

const playerImageMap = Object.fromEntries(
    playersData.map((p: any) => [p.slug, getRankingImage(p)]),
);

const featuredRankings = [
    ["/rankings/maximas-goleadoras", "Máximas goleadoras"],
    ["/rankings/maximas-asistentes", "Máximas asistentes"],
    ["/rankings/mas-partidos", "Más partidos"],
    ["/rankings/mas-minutos", "Más minutos"],
    ["/rankings/mas-capitanias", "Más capitanías"],
    ["/rankings/porterias-a-cero", "Porterías a cero"],
];
---

<Layout
    title="Estadísticas del Real Madrid Femenino: goleadoras, asistentes y récords | MFX"
    description="Rankings históricos del Real Madrid Femenino: máximas goleadoras y asistentes, jugadoras con más partidos, minutos, capitanías y porterías a cero."
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "Rankings", path: "/rankings" },
            ]),
        )}
    />

    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10 rankings-main-page">
        <header class="page-header-container">
            <h1 class="landing-title">Estadísticas y rankings del Real Madrid Femenino</h1>
            <p class="landing-subtitle">Goleadoras, asistentes, partidos, minutos, capitanías y más datos históricos</p>
        </header>

        <nav class="seo-ranking-links" aria-label="Rankings históricos destacados">
            {featuredRankings.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>

        {rankingsData.length > 0 ? (
            <StatsRankings
                client:load
                rankingsData={rankingsData}
                streaksData={streaksData}
                awardsData={awardsData}
                seasons={uniqueSeasons}
                competitions={uniqueCompetitions}
                playerImageMap={playerImageMap}
            />
        ) : (
            <p style="text-align: center; color: red; font-size: 1.2em; padding: 2rem;">
                Error al cargar datos o no se encontraron registros. Comprueba la conexión a Turso o tu API endpoint.
            </p>
        )}
    </main>
</Layout>

<style>
    main { color: #f0f0f0; }
    .seo-ranking-links {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.8rem;
        margin: 0 0 2rem;
    }
    .seo-ranking-links a {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(212, 168, 67, 0.18);
        border-radius: 4px;
        background: rgba(8, 16, 34, 0.85);
        color: #d4a843;
        padding: 0.9rem 1rem;
        text-align: center;
        text-decoration: none;
        font-family: "Cinzel", serif;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        transition: 0.2s ease;
    }
    .seo-ranking-links a::before,
    .seo-ranking-links a::after {
        content: "";
        position: absolute;
        width: 10px;
        height: 10px;
        pointer-events: none;
    }
    .seo-ranking-links a::before {
        top: 0; left: 0;
        border-top: 1px solid rgba(212, 168, 67, 0.5);
        border-left: 1px solid rgba(212, 168, 67, 0.5);
    }
    .seo-ranking-links a::after {
        right: 0; bottom: 0;
        border-right: 1px solid rgba(212, 168, 67, 0.5);
        border-bottom: 1px solid rgba(212, 168, 67, 0.5);
    }
    .seo-ranking-links a:hover {
        border-color: rgba(212, 168, 67, 0.5);
        background: rgba(10, 20, 42, 0.92);
        transform: translateY(-2px);
    }
</style>

<style is:global>
    .rankings-main-page .stats-rankings-react #ranking-table-top {
        position: relative !important;
        overflow: hidden !important;
        border-radius: 4px !important;
        border: 1px solid rgba(212, 168, 67, 0.18) !important;
        background: rgba(8, 16, 34, 0.85) !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
    }
    .rankings-main-page .stats-rankings-react #ranking-table-top::before,
    .rankings-main-page .stats-rankings-react #ranking-table-top::after {
        content: "";
        position: absolute;
        width: 12px;
        height: 12px;
        z-index: 4;
        pointer-events: none;
    }
    .rankings-main-page .stats-rankings-react #ranking-table-top::before {
        top: 0; left: 0;
        border-top: 1px solid rgba(212, 168, 67, 0.5);
        border-left: 1px solid rgba(212, 168, 67, 0.5);
    }
    .rankings-main-page .stats-rankings-react #ranking-table-top::after {
        right: 0; bottom: 0;
        border-right: 1px solid rgba(212, 168, 67, 0.5);
        border-bottom: 1px solid rgba(212, 168, 67, 0.5);
    }
    .rankings-main-page .stats-rankings-react .ranking-title-header {
        padding: 0.95rem 1.25rem !important;
        border-bottom: 1px solid rgba(212, 168, 67, 0.12) !important;
        background: rgba(212, 168, 67, 0.03) !important;
        text-align: left !important;
    }
    .rankings-main-page .stats-rankings-react .ranking-title-header h2 {
        margin: 0 !important;
        padding: 0 !important;
        border-left: 0 !important;
        font-family: "Cinzel", serif !important;
        font-size: 0.78rem !important;
        font-weight: 600 !important;
        line-height: 1.3 !important;
        letter-spacing: 0.18em !important;
        color: rgba(212, 168, 67, 0.82) !important;
        text-transform: uppercase !important;
    }
    .rankings-main-page .stats-rankings-react #ranking-table-top thead tr {
        background: rgba(6, 13, 28, 0.7) !important;
        border-bottom: 1px solid rgba(212, 168, 67, 0.12) !important;
    }
    .rankings-main-page .stats-rankings-react .ranking-table-row {
        background: rgba(6, 13, 28, 0.18) !important;
        border-bottom: 1px solid rgba(212, 168, 67, 0.07) !important;
    }
    .rankings-main-page .stats-rankings-react .ranking-table-row:hover {
        background: rgba(212, 168, 67, 0.06) !important;
    }
    .rankings-main-page .stats-rankings-react .ranking-table-row td:nth-child(2) > div { gap: 0.85rem !important; }
    .rankings-main-page .stats-rankings-react .ranking-table-row td:nth-child(2) > div > div {
        width: 48px !important;
        height: 48px !important;
        min-width: 48px !important;
        flex: 0 0 48px !important;
        border-radius: 50% !important;
        overflow: hidden !important;
        border: 1px solid rgba(212, 168, 67, 0.42) !important;
        background: rgba(212, 168, 67, 0.06) !important;
        box-shadow: inset 0 0 0 2px rgba(6, 13, 28, 0.75) !important;
    }
    .rankings-main-page .stats-rankings-react .ranking-table-row td:nth-child(2) img {
        width: 100% !important;
        height: 100% !important;
        border-radius: 50% !important;
        object-fit: cover !important;
        object-position: center 18% !important;
    }
    @media (max-width: 640px) {
        .rankings-main-page .stats-rankings-react .ranking-title-header { padding: 0.8rem 0.9rem !important; }
        .rankings-main-page .stats-rankings-react .ranking-table-row td:nth-child(2) > div > div {
            width: 42px !important;
            height: 42px !important;
            min-width: 42px !important;
            flex-basis: 42px !important;
        }
    }
</style>

---
import Layout from "../layouts/Layout.astro";
import Squad from "../sections/Squad.astro";
import { getCurrentSeason } from "../utils/season";
import { breadcrumbSchema } from "../utils/seo";
import { fetchPlayersDirectly, firstTeamSeasons } from "../utils/players";
import "../styles/global.css";

const currentSeason = getCurrentSeason();
const seasons = firstTeamSeasons(await fetchPlayersDirectly());
const requestedSeason = Astro.url.searchParams.get("temporada");
const season = requestedSeason && seasons.includes(requestedSeason) ? requestedSeason : currentSeason;

const description = `Plantilla del Real Madrid Femenino ${season}: jugadoras, dorsales y posiciones de la temporada ${season === currentSeason ? "actual" : season}. Consulta las fichas individuales.`;
---

<Layout
    title={`Plantilla Real Madrid Femenino ${season}: jugadoras y dorsales | Madrid Femenino Xtra`}
    description={description}
    ogTitle={`Plantilla, jugadoras y dorsales del Real Madrid Femenino ${season} | Madrid Femenino Xtra`}
    ogDescription="Conoce la plantilla del Real Madrid Femenino: jugadoras, dorsales, posiciones, nacionalidades, estadísticas y fichas individuales de todas las futbolistas del primer equipo."
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema([
        { name: "Inicio", path: "/" }, { name: "Plantilla", path: "/plantilla" },
    ]))} />
    <main class="max-w-[1700px] mx-auto px-6 md:px-0">
        <header class="page-header-container">
            <h1 class="landing-title">PLANTILLA {season}</h1>
            <p class="landing-subtitle">
                Jugadoras, dorsales y posiciones del Real Madrid Femenino de la temporada {season}
            </p>
        </header>
        <Squad season={season} currentSeason={currentSeason} seasons={seasons} />
    </main>
</Layout>

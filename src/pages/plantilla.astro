---
import Layout from "../layouts/Layout.astro";
import Squad from "../sections/Squad.astro";
import { getCurrentSeason } from "../utils/season";
import "../styles/global.css";

const currentSeason = getCurrentSeason();

const description = `Plantilla del Real Madrid Femenino ${currentSeason}: jugadoras, dorsales y posiciones de la temporada actual. Consulta las fichas individuales.`;
---

<Layout
    title={`Plantilla Real Madrid Femenino ${currentSeason}: jugadoras y dorsales | MFX`}
    description={description}
>
    <main class="max-w-[1700px] mx-auto px-6 md:px-0">
        <header class="page-header-container">
            <h1 class="landing-title">Plantilla del Real Madrid Femenino {currentSeason}</h1>
            <p class="landing-subtitle">
                Jugadoras, dorsales y posiciones de la temporada {currentSeason}
            </p>
        </header>
        <Squad season={currentSeason} />
    </main>
</Layout>

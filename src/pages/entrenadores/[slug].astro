---
import Layout from "../../layouts/Layout.astro";
import {
    fetchCoachesDirectly,
    fetchCoachStats,
    fetchCoachTrajectory,
} from "../../utils/entrenadores";
import { fetchCoachRecords } from "../../utils/coach-records";
import { fetchCoachStreaks } from "../../utils/coach-streaks";
import { getAssetUrl } from "../../utils/assets";

const { slug } = Astro.params;

const allCoaches = await fetchCoachesDirectly();
const coach = allCoaches.find(
    (c) => c.slug?.toLowerCase() === slug?.toLowerCase() || c.id?.toLowerCase() === slug?.toLowerCase(),
);

if (!coach) {
    return Astro.redirect("/404");
}

const coachStats = await fetchCoachStats(coach.id_entrenador);
const coachRecords = await fetchCoachRecords(coach.id_entrenador);
const coachStreaks = await fetchCoachStreaks(coach.id_entrenador);
const trajectory = await fetchCoachTrajectory(coach.id_entrenador);

const flagUrl = coach.flagUrl || "";
const nombre = coach.nombre || coach.name || "";

const formatDate = (dateString: string | null | undefined): string => {
    if (!dateString) return "-";
    try {
        const date = new Date(dateString.split("T")[0]);
        if (isNaN(date.getTime())) return "-";
        return date.toLocaleDateString("es-ES", { day: "2-digit", month: "2-digit", year: "numeric" });
    } catch { return "-"; }
};

const fechaNacimiento = formatDate(coach.fecha_nacimiento);

const quickStats = coachStats ? [
    { value: coachStats.total_carrera.partidos, label: 'PARTIDOS' },
    { value: coachStats.total_carrera.victorias, label: 'VICTORIAS' },
    { value: `${coachStats.total_carrera.porcentaje_victorias}%`, label: '% VIC.' },
    { value: coachStats.total_carrera.empates, label: 'EMPATES' },
    { value: coachStats.total_carrera.derrotas, label: 'DERROTAS' },
] : [];
---

<Layout
    title={`${nombre} | Madrid Femenino Xtra`}
    description={`Perfil completo de ${nombre}, entrenador del Real Madrid Femenino. Estadísticas, récords y trayectoria.`}
>
    <section class="coach-hero">
        <div class="hero-bg-glow" aria-hidden="true"></div>

        <a href={`/entrenadores#card-${slug}`} class="hero-back-link">← VOLVER A ENTRENADORES</a>

        <div class="hero-inner">
            <div class="hero-photo-col" transition:name={`coach-${slug}`}>
                <img
                    src={coach.imageUrl}
                    alt={`Foto de ${nombre}`}
                    class="hero-coach-photo"
                    loading="eager"
                    decoding="async"
                    width={460}
                    height={560}
                    onerror="this.src='/assets/entrenadores/placeholder.png'"
                />
            </div>

            <div class="hero-info-col">
                <div class="hero-chips">
                    <span class="hero-chip hero-chip-gold">♦ ENTRENADOR ♦</span>
                    {(coach.pais || coach.country) && (
                        <span class="hero-chip">
                            {flagUrl && <img src={flagUrl} alt="" class="chip-flag" width="16" height="16" loading="lazy" />}
                            {coach.pais || coach.country}
                        </span>
                    )}
                </div>

                <h1 class="hero-coach-name">{nombre}</h1>

                {quickStats.length > 0 && (
                    <div class="hero-quick-stats">
                        {quickStats.map(qs => (
                            <div class="qs-card">
                                <span class="qs-number">{qs.value}</span>
                                <span class="qs-label">{qs.label}</span>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </section>

    <main class="coach-content">
        <div class="content-grid">

            <section class="profile-card full-col">
                <h2 class="card-title">FICHA PERSONAL</h2>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Nombre completo</span>
                        <span class="info-value">{nombre}</span>
                    </div>
                    {coach.fecha_nacimiento && (
                        <div class="info-row">
                            <span class="info-label">Fecha de nac.</span>
                            <span class="info-value">{fechaNacimiento}</span>
                        </div>
                    )}
                    {coach.ciudad && (
                        <div class="info-row">
                            <span class="info-label">Lugar de nac.</span>
                            <span class="info-value">{coach.ciudad}</span>
                        </div>
                    )}
                    {(coach.pais || coach.country) && (
                        <div class="info-row">
                            <span class="info-label">Nacionalidad</span>
                            <span class="info-value" style="display:flex;align-items:center;gap:0.5rem;">
                                {coach.pais || coach.country}
                                {flagUrl && <img src={flagUrl} alt="" width="20" height="20" loading="lazy" style="border-radius:2px;" />}
                            </span>
                        </div>
                    )}
                </div>
            </section>

            <section class="profile-card">
                <h2 class="card-title">TRAYECTORIA</h2>
                <div class="card-body" style="padding:1.25rem 1.5rem;">
                    {trajectory && trajectory.length > 0 ? (
                        <div class="trajectory-timeline">
                            {trajectory.map((item: any) => (
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-body">
                                        <span class="timeline-years">{item.anio_inicio} – {item.anio_fin || 'Act.'}</span>
                                        <span class="timeline-club">{item.club}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p class="no-data">Sin datos disponibles</p>
                    )}
                </div>
            </section>

            <section class="profile-card">
                <h2 class="card-title">RÉCORDS</h2>
                <div class="card-body" style="padding:1.25rem 1.5rem;">
                    {coachRecords ? (
                        <div class="records-list">
                            {coachRecords.mas_partido && (
                                <div class="record-row">
                                    <span class="record-label">Más partidos</span>
                                    <span class="record-value">{coachRecords.mas_partido.rival} · {coachRecords.mas_partido.partidos}</span>
                                </div>
                            )}
                            {coachRecords.mas_victorias && (
                                <div class="record-row">
                                    <span class="record-label">Más victorias</span>
                                    <span class="record-value">{coachRecords.mas_victorias.rival} · {coachRecords.mas_victorias.victorias}</span>
                                </div>
                            )}
                            {coachRecords.mas_empates && (
                                <div class="record-row">
                                    <span class="record-label">Más empates</span>
                                    <span class="record-value">{coachRecords.mas_empates.rival} · {coachRecords.mas_empates.empates}</span>
                                </div>
                            )}
                            {coachRecords.mayor_victoria && (
                                <div class="record-row">
                                    <span class="record-label">Mayor victoria</span>
                                    <span class="record-value">{coachRecords.mayor_victoria.goles_rm}-{coachRecords.mayor_victoria.goles_rival} vs {coachRecords.mayor_victoria.rival}</span>
                                </div>
                            )}
                            {coachRecords.mayor_derrota && (
                                <div class="record-row">
                                    <span class="record-label">Mayor derrota</span>
                                    <span class="record-value">{coachRecords.mayor_derrota.goles_rm}-{coachRecords.mayor_derrota.goles_rival} vs {coachRecords.mayor_derrota.rival}</span>
                                </div>
                            )}
                            {coachRecords.mas_repetido && (
                                <div class="record-row">
                                    <span class="record-label">Resultado más repetido</span>
                                    <span class="record-value">{coachRecords.mas_repetido.resultado} · {coachRecords.mas_repetido.veces} veces</span>
                                </div>
                            )}
                        </div>
                    ) : (
                        <p class="no-data">Sin datos disponibles</p>
                    )}
                </div>
            </section>

            <section class="profile-card">
                <h2 class="card-title">RACHAS</h2>
                <div class="card-body" style="padding:1.25rem 1.5rem;">
                    {coachStreaks ? (
                        <div class="records-list">
                            {[
                                ['Ganando', coachStreaks.best.ganando],
                                ['Sin perder', coachStreaks.best.sin_perder],
                                ['Empatando', coachStreaks.best.empatando],
                                ['Sin ganar', coachStreaks.best.sin_ganar],
                                ['Perdiendo', coachStreaks.best.perdiendo],
                                ['Marcando', coachStreaks.best.marcando],
                                ['Sin marcar', coachStreaks.best.sin_marcar],
                                ['Sin encajar', coachStreaks.best.sin_encajar],
                                ['Encajando', coachStreaks.best.encajando],
                            ].map(([label, value]) => (
                                <div class="record-row">
                                    <span class="record-label">{label}</span>
                                    <span class="record-value">{value}</span>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p class="no-data">Sin datos disponibles</p>
                    )}
                </div>
            </section>

            {coachStats && coachStats.estadisticas && coachStats.estadisticas.length > 0 && (
                <section class="profile-card full-col">
                    <h2 class="card-title">ESTADÍSTICAS</h2>
                    <div class="card-body" style="padding:0;">
                        <div class="stats-table-wrapper">
                            <table class="stats-table">
                                <thead>
                                    <tr>
                                        <th>Temporada</th>
                                        <th title="Partidos">PJ</th>
                                        <th title="Victorias">V</th>
                                        <th title="% Victorias">%V</th>
                                        <th title="Empates">E</th>
                                        <th title="% Empates">%E</th>
                                        <th title="Derrotas">D</th>
                                        <th title="% Derrotas">%D</th>
                                        <th title="Goles a Favor">GF</th>
                                        <th title="Goles en Contra">GC</th>
                                        <th title="Diferencia">Dif</th>
                                        <th title="Porterías a Cero">PC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {coachStats.estadisticas.map((season: any) => (
                                        <>
                                            <tr class="season-total-row" onclick={`toggleSeason('${season.temporada.replace(/\//g, "-")}')`} style="cursor:pointer;">
                                                <td><div class="flex items-center justify-start gap-2 w-full"><strong>{season.temporada}</strong><span class="toggle-icon">▼</span></div></td>
                                                <td><strong>{season.total.partidos}</strong></td>
                                                <td><strong>{season.total.victorias}</strong></td>
                                                <td><strong>{season.total.porcentaje_victorias}%</strong></td>
                                                <td><strong>{season.total.empates}</strong></td>
                                                <td><strong>{season.total.porcentaje_empates}%</strong></td>
                                                <td><strong>{season.total.derrotas}</strong></td>
                                                <td><strong>{season.total.porcentaje_derrotas}%</strong></td>
                                                <td><strong>{season.total.goles_favor}</strong></td>
                                                <td><strong>{season.total.goles_contra}</strong></td>
                                                <td><strong>{season.total.goles_favor - season.total.goles_contra}</strong></td>
                                                <td><strong>{season.total.porterias_cero}</strong></td>
                                            </tr>
                                            {season.competiciones.map((comp: any) => (
                                                <tr class={`competition-row season-${season.temporada.replace(/\//g, "-")}`} style="display:none;">
                                                    <td class="competition-name">
                                                        <div class="competition-name-wrapper">
                                                            {getAssetUrl("competiciones", comp.competicion.toLowerCase().includes("amistoso") ? "amistoso" : comp.competicion) && (
                                                                <img src={getAssetUrl("competiciones", comp.competicion.toLowerCase().includes("amistoso") ? "amistoso" : comp.competicion)} alt={comp.competicion} class="competition-logo" />
                                                            )}
                                                            {comp.competicion}
                                                        </div>
                                                    </td>
                                                    <td>{comp.partidos}</td>
                                                    <td>{comp.victorias}</td>
                                                    <td>{comp.porcentaje_victorias}%</td>
                                                    <td>{comp.empates}</td>
                                                    <td>{comp.porcentaje_empates}%</td>
                                                    <td>{comp.derrotas}</td>
                                                    <td>{comp.porcentaje_derrotas}%</td>
                                                    <td>{comp.goles_favor}</td>
                                                    <td>{comp.goles_contra}</td>
                                                    <td>{comp.goles_favor - comp.goles_contra}</td>
                                                    <td>{comp.porterias_cero}</td>
                                                </tr>
                                            ))}
                                        </>
                                    ))}
                                    <tr class="career-total-row">
                                        <td style="text-align:left!important;"><strong>TOTAL</strong></td>
                                        <td><strong>{coachStats.total_carrera.partidos}</strong></td>
                                        <td><strong>{coachStats.total_carrera.victorias}</strong></td>
                                        <td><strong>{coachStats.total_carrera.porcentaje_victorias}%</strong></td>
                                        <td><strong>{coachStats.total_carrera.empates}</strong></td>
                                        <td><strong>{coachStats.total_carrera.porcentaje_empates}%</strong></td>
                                        <td><strong>{coachStats.total_carrera.derrotas}</strong></td>
                                        <td><strong>{coachStats.total_carrera.porcentaje_derrotas}%</strong></td>
                                        <td><strong>{coachStats.total_carrera.goles_favor}</strong></td>
                                        <td><strong>{coachStats.total_carrera.goles_contra}</strong></td>
                                        <td><strong>{coachStats.total_carrera.goles_favor - coachStats.total_carrera.goles_contra}</strong></td>
                                        <td><strong>{coachStats.total_carrera.porterias_cero}</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            )}

        </div>
    </main>

    <script is:inline>
        function toggleSeason(season) {
            const rows = document.querySelectorAll(`.competition-row.season-${season}`);
            const icon = document.querySelector(`.season-total-row[onclick*="${season}"] .toggle-icon`);
            rows.forEach(row => {
                if (row.style.display === "none") { row.style.display = "table-row"; if (icon) icon.textContent = "▲"; }
                else { row.style.display = "none"; if (icon) icon.textContent = "▼"; }
            });
        }
    </script>
</Layout>

<style>
.coach-hero {
    width: 100%;
    min-height: 80vh;
    background: #060d1c;
    position: relative;
    overflow: hidden;
}
.coach-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, #060d1c);
    pointer-events: none;
    z-index: 2;
}

.hero-bg-glow {
    position: absolute;
    right: 15%;
    top: 50%;
    transform: translateY(-50%);
    width: 900px;
    height: 900px;
    background: radial-gradient(circle, rgba(212,168,67,0.035) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
}

.hero-back-link {
    position: absolute;
    top: 1.75rem;
    left: 2rem;
    z-index: 20;
    font-family: 'Cinzel', serif;
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(212,168,67,0.55);
    text-decoration: none;
    transition: color 0.2s;
}
.hero-back-link:hover { color: #d4a843; }

.hero-inner {
    display: grid;
    grid-template-columns: min(40vw, 460px) 1fr;
    min-height: 80vh;
    align-items: end;
    position: relative;
    z-index: 1;
}

.hero-photo-col {
    position: relative;
    align-self: end;
}
.hero-photo-col::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 35%;
    background: linear-gradient(to top, #060d1c 0%, rgba(6,8,15,0.5) 55%, transparent 100%);
    z-index: 3;
    pointer-events: none;
}

.hero-coach-photo {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    object-position: bottom center;
    display: block;
    filter: drop-shadow(0 0 70px rgba(0,0,0,0.5));
}

.hero-info-col {
    padding: 5rem 5rem 4rem 3.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 80vh;
    position: relative;
}

.hero-chips {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
}

.hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 1rem;
    border-radius: 100px;
    border: 1px solid rgba(212,168,67,0.22);
    background: rgba(6,13,28,0.55);
    backdrop-filter: blur(6px);
    font-family: 'Cinzel', serif;
    font-size: 0.57rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(200,210,220,0.65);
}

.hero-chip-gold {
    border-color: rgba(212,168,67,0.5);
    background: linear-gradient(135deg, rgba(212,168,67,0.14), rgba(212,168,67,0.04));
    color: #d4a843;
}

.chip-flag {
    width: 16px;
    height: 16px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
}

.hero-coach-name {
    font-family: 'Cinzel', serif;
    font-size: clamp(2.8rem, 5.5vw, 7.5rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.88;
    letter-spacing: 0.01em;
    background: linear-gradient(180deg, #f5f0e8 20%, #d4a843 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0.75rem 0 2.5rem;
}

.hero-quick-stats {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
}

.qs-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.85rem 1.1rem;
    background: rgba(212,168,67,0.04);
    border: 1px solid rgba(212,168,67,0.18);
    border-radius: 3px;
    min-width: 75px;
    transition: background 0.2s, border-color 0.2s;
}
.qs-card:hover { background: rgba(212,168,67,0.08); border-color: rgba(212,168,67,0.35); }

.qs-number {
    font-family: 'Cinzel', serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #d4a843;
    line-height: 1;
    margin-bottom: 0.3rem;
}

.qs-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    color: rgba(200,210,220,0.45);
    text-transform: uppercase;
    text-align: center;
}

.coach-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 2.5rem 5rem;
    width: 100%;
}

.content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.25rem;
}

.full-col { grid-column: 1 / -1; }

.profile-card {
    background: rgba(8,16,34,0.85);
    border: 1px solid rgba(212,168,67,0.18);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
}
.profile-card::before {
    content: '';
    position: absolute; top: 0; left: 0;
    width: 12px; height: 12px;
    border-top: 1px solid rgba(212,168,67,0.5);
    border-left: 1px solid rgba(212,168,67,0.5);
    pointer-events: none;
}
.profile-card::after {
    content: '';
    position: absolute; bottom: 0; right: 0;
    width: 12px; height: 12px;
    border-bottom: 1px solid rgba(212,168,67,0.5);
    border-right: 1px solid rgba(212,168,67,0.5);
    pointer-events: none;
}

.card-title {
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(212,168,67,0.75);
    text-transform: uppercase;
    padding: 0.85rem 1.25rem;
    margin: 0;
    border-bottom: 1px solid rgba(212,168,67,0.12);
    background: rgba(212,168,67,0.03);
}

.card-body { padding: 0; }

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid rgba(212,168,67,0.07);
    gap: 1rem;
}
.info-row:last-child { border-bottom: none; }
.info-label {
    font-family: 'Cinzel', serif;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: rgba(200,210,220,0.45);
    text-transform: uppercase;
    flex-shrink: 0;
}
.info-value {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: #f0f0f0;
    text-align: right;
}

.trajectory-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid rgba(212,168,67,0.2);
    margin-left: 0.5rem;
}
.timeline-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0;
    position: relative;
}
.timeline-dot {
    width: 8px; height: 8px;
    background: #d4a843;
    border-radius: 50%;
    border: 2px solid rgba(6,13,28,0.9);
    box-shadow: 0 0 0 1px rgba(212,168,67,0.35);
    flex-shrink: 0;
    margin-left: -4.5px;
    margin-top: 0.35rem;
}
.timeline-body { display: flex; flex-direction: column; gap: 0.1rem; }
.timeline-years {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: rgba(200,210,220,0.45);
    text-transform: uppercase;
}
.timeline-club {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.92rem;
    color: #f0f0f0;
    font-weight: 600;
}

.records-list { display: flex; flex-direction: column; }
.record-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(212,168,67,0.07);
    gap: 1rem;
}
.record-row:last-child { border-bottom: none; }
.record-label {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: rgba(200,210,220,0.45);
    text-transform: uppercase;
    flex-shrink: 0;
}
.record-value {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    color: #d4a843;
    font-weight: 600;
    text-align: right;
}

.stats-table-wrapper {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(212,168,67,0.25) transparent;
}
.competition-name-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 140px;
    text-align: left;
}
.competition-logo { width: 22px; height: 22px; object-fit: contain; }

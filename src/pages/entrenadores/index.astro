---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { fetchCoachesDirectly } from "../../utils/entrenadores";
import Coaches from "../../sections/Coaches.astro";
const coaches = await fetchCoachesDirectly();
---

<Layout
    title="Entrenadores del Real Madrid Femenino: historial y estadísticas | MFX"
    description="Todos los entrenadores del Real Madrid Femenino: etapas, partidos, resultados, porcentaje de victorias y estadísticas históricas."
>
    <main class="py-10">
        <div class="max-w-7xl mx-auto px-6 md:px-4">
            <header class="page-header-container">
                <h1 class="landing-title">Entrenadores del Real Madrid Femenino</h1>
                <p class="landing-subtitle">Todos los entrenadores del Real Madrid Femenino a lo largo de su historia</p>
            </header>
        </div>

        <Coaches coaches={coaches} />
    </main>
</Layout>

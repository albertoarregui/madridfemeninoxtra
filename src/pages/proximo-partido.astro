---
import NextMatchCountdown from "../components/NextMatchCountdown.astro";
import { cacheTags } from "../lib/cache-tags";

export const partial = true;

Astro.response.headers.set("Cache-Control", "public, max-age=60");
Astro.response.headers.set("Vercel-CDN-Cache-Control", "max-age=300, stale-while-revalidate=600");
Astro.response.headers.set("Vercel-Cache-Tag", [cacheTags.database, cacheTags.matches, cacheTags.calendar].join(","));
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<NextMatchCountdown />

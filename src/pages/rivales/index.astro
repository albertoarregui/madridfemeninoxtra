---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { fetchRivalsDirectly } from "../../utils/rivales";
import RivalsTable from "../../components/RivalsTable";

const rivals = await fetchRivalsDirectly();
---

<Layout
    title="Rivales del Real Madrid Femenino: historial y estadísticas | MFX"
    description="Historial de rivales del Real Madrid Femenino: enfrentamientos, resultados, porcentaje de victorias, goles y protagonistas."
>
    <main class="max-w-[1700px] mx-auto px-6 md:px-0">
        <header class="page-header-container">
            <h1 class="landing-title" data-title="RIVALES">Rivales del Real Madrid Femenino</h1>
            <p class="landing-subtitle">Todos los rivales del Real Madrid Femenino a lo largo de su historia</p>
        </header>

        <RivalsTable client:load rivals={rivals} />
    </main>
</Layout>

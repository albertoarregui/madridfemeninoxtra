}
.hero-back-link:hover { color: #d4a843; }

.hero-inner {
    display: grid;
    grid-template-columns: min(32vw, 340px) 1fr;
    min-height: 52vh;
    align-items: center;
    position: relative;
    z-index: 1;
    padding: 5rem 4rem 3rem 4rem;
    gap: 3rem;
}

.hero-shield-col {
    display: flex;
    align-items: center;
    justify-content: center;

---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";
import { fetchRivalsDirectly, slugify } from "../../utils/rivales";
import {
    fetchRivalRecords,
    fetchRivalTopPlayers,
    fetchRivalMatches,
    calculateRivalStats,
    calculateStreaks,
} from "../../utils/rival-records";
import type { ImageMetadata } from "astro";
import { getAssetUrl, getAssetMetadata } from "../../utils/assets";
import { competitionDisplayName } from "../../utils/competiciones";

const { slug } = Astro.params;

const allRivals = await fetchRivalsDirectly();
let rival = allRivals.find((r) => r.slug === slug);

if (!rival) {
    if (slug === "cacereno") {
        rival = allRivals.find(
            (r) =>
                r.slug.includes("cacereno") ||
                r.nombre.toLowerCase().includes("cacereño"),
        );
    } else if (slug === "ffc-turbine-potsdam") {
        rival = allRivals.find(
            (r) =>
                r.nombre.toLowerCase().includes("turbine") &&
                r.nombre.toLowerCase().includes("potsdam"),
        );
    } else {
        rival = allRivals.find(
            (r) => r.slug.includes(slug!) || (slug && slug.includes(r.slug)),
        );
    }
}

if (!rival) {
    return Astro.redirect("/404");
}

const shieldImageSrc = rival.shieldUrl;

const flagImage = getAssetMetadata("banderas", rival.pais) || undefined;

const stadiumUrl = rival.estadio_foto_url;
const hasExternalStadium =
    stadiumUrl &&
    (stadiumUrl.startsWith("http://") || stadiumUrl.startsWith("https://"));
let stadiumImageSrc = hasExternalStadium
    ? stadiumUrl
    : getAssetMetadata("estadios", rival.estadio)?.src || null;

const clubUrl = rival.foto_url;
const hasExternalClub =
    clubUrl &&
    (clubUrl.startsWith("http://") || clubUrl.startsWith("https://"));
let clubImageSrc = hasExternalClub ? clubUrl : null;

const rivalRecords = await fetchRivalRecords(rival.id_club);

const topPlayersData = await fetchRivalTopPlayers(rival.id_club);

const rivalMatches = await fetchRivalMatches(rival.id_club);

const rivalStats = calculateRivalStats(rivalMatches);

const competitionOrder = [
    "Primera Iberdrola",
    "Liga F",
    "UWCL",
    "Copa de la Reina",
    "Supercopa de España",
    "Amistosos",
];
const uniqueCompetitions = [
    ...new Set(rivalMatches.map((m) => m.competicion)),
].filter((c) => c && c !== "-");
const competitions = uniqueCompetitions.sort((a, b) => {
    const indexA = competitionOrder.indexOf(a);
    const indexB = competitionOrder.indexOf(b);
    if (indexA === -1 && indexB === -1) return a.localeCompare(b);
    if (indexA === -1) return 1;
    if (indexB === -1) return -1;
    return indexA - indexB;
});

const getSeason = (dateStr: string) => {
    const d = new Date(dateStr);
    const year = d.getFullYear();
    const month = d.getMonth() + 1;
    const startYear = month >= 8 ? year : year - 1;
    const endYear = startYear + 1;
    return `${startYear}/${endYear.toString().slice(-2)}`;
};

const officialMatches = rivalMatches.filter(
    (m) => m.competicion !== "Amistoso",
);
const homeMatches = officialMatches.filter((m) => !m.esLocal);
const awayMatches = officialMatches.filter((m) => m.esLocal);

const streaksTotal = calculateStreaks(officialMatches);
const streaksHome = calculateStreaks(homeMatches);
const streaksAway = calculateStreaks(awayMatches);

const uniqueSeasons = [
    ...new Set(rivalMatches.map((m) => getSeason(m.fecha))),
].sort((a, b) => b.localeCompare(a));

const circumference = 220;
const totalMatches = rivalStats.total.pj;

const winsArc =
    totalMatches > 0
        ? Math.round((rivalStats.total.pg / totalMatches) * circumference)
        : 0;
const drawsArc =
    totalMatches > 0
        ? Math.round((rivalStats.total.pe / totalMatches) * circumference)
        : 0;
const lossesArc =
    totalMatches > 0
        ? Math.round((rivalStats.total.pp / totalMatches) * circumference)
        : 0;

const totalGoals = rivalStats.total.gf + rivalStats.total.gc;
const goalsForArc =
    totalGoals > 0
        ? Math.round((rivalStats.total.gf / totalGoals) * circumference)
        : 0;
const goalsAgainstArc =
    totalGoals > 0
        ? Math.round((rivalStats.total.gc / totalGoals) * circumference)
        : 0;

const cleanSheetsArc =
    totalMatches > 0
        ? Math.round(
              (rivalStats.total.cleanSheets / totalMatches) * circumference,
          )
        : 0;
const concededArc =
    totalMatches > 0
        ? Math.round((rivalStats.total.conceded / totalMatches) * circumference)
        : 0;

const totalCards =
    (rivalStats.total.yellowCards || 0) + (rivalStats.total.redCards || 0);
const yellowCardsArc =
    totalCards > 0
        ? Math.round(
              (rivalStats.total.yellowCards / totalCards) * circumference,
          )
        : 0;
const redCardsArc =
    totalCards > 0
        ? Math.round((rivalStats.total.redCards / totalCards) * circumference)
        : 0;

const mockPlayers: string[] = [];

const isRealMadrid =
    rival.nombre.toLowerCase().trim().includes("real madrid") ||
    slug === "real-madrid";

const rt = rivalStats?.total;
const joinNatural = (arr: string[]) =>
    arr.length <= 1 ? (arr[0] || "") : `${arr.slice(0, -1).join(", ")} y ${arr[arr.length - 1]}`;

const bioParts: string[] = [];

const lugar = [rival.ciudad, rival.pais].filter(Boolean).join(", ");
if (lugar && rival.estadio) bioParts.push(`${rival.nombre} es un club de ${lugar}, que disputa sus partidos como local en el ${rival.estadio}.`);
else if (lugar) bioParts.push(`${rival.nombre} es un club de ${lugar}.`);
else if (rival.estadio) bioParts.push(`${rival.nombre} disputa sus partidos como local en el ${rival.estadio}.`);
else bioParts.push(`${rival.nombre} es uno de los rivales del Real Madrid Femenino.`);

if (rt && rt.pj) {
    const balanceAdj = rt.pg > rt.pp ? "favorable" : rt.pg < rt.pp ? "adverso" : "muy igualado";
    bioParts.push(`El Real Madrid Femenino y ${rival.nombre} se han medido en ${rt.pj} ${rt.pj === 1 ? "ocasión" : "ocasiones"} a lo largo de su historia, con un balance ${balanceAdj} para las madridistas: ${rt.pg} victorias, ${rt.pe} empates y ${rt.pp} derrotas. En el cómputo global, el conjunto blanco ha anotado ${rt.gf} goles y ha encajado ${rt.gc}.`);

    const recBits: string[] = [];
    if (rivalRecords?.mayor_victoria?.resultado) recBits.push(`la mayor victoria blanca es un ${rivalRecords.mayor_victoria.resultado}`);
    if (rivalRecords?.mayor_derrota?.resultado) recBits.push(`la mayor derrota, un ${rivalRecords.mayor_derrota.resultado}`);
    if (rivalRecords?.mas_repetido?.resultado) recBits.push(`el resultado más repetido es el ${rivalRecords.mas_repetido.resultado} (${rivalRecords.mas_repetido.veces} veces)`);
    if (recBits.length) bioParts.push(`En cuanto a registros, ${joinNatural(recBits)}.`);

    const scorers = (topPlayersData?.topScorers || []).slice(0, 3).map((p: any) => `${p.nombre} (${p.goles})`);
    const assisters = (topPlayersData?.topAssisters || []).slice(0, 3).map((p: any) => `${p.nombre} (${p.asistencias})`);
    const contributors = (topPlayersData?.topContributors || []).slice(0, 3).map((p: any) => `${p.nombre} (${p.total})`);
    if (scorers.length) bioParts.push(`Las máximas goleadoras madridistas ante ${rival.nombre} son ${joinNatural(scorers)}.`);
    if (assisters.length) bioParts.push(`En asistencias destacan ${joinNatural(assisters)}.`);
    if (contributors.length) bioParts.push(`Y en goles generados (G+A), las más determinantes son ${joinNatural(contributors)}.`);
} else {
    bioParts.push(`Aquí encontrarás el historial y las estadísticas de los enfrentamientos entre el Real Madrid Femenino y ${rival.nombre}.`);
}
const bio = bioParts.join(" ");

const rivalSchema = {
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    name: rival.nombre,
    sport: "Football",
    ...(rival.shieldUrl ? { logo: rival.shieldUrl } : {}),
    ...(rival.estadio ? { location: { "@type": "Place", name: rival.estadio } } : {}),
    description: bio,
};

const seoTitle = `Real Madrid Femenino vs ${rival.nombre}: historial y estadísticas | Madrid Femenino Xtra`;
const seoDescription = (rt && rt.pj)
    ? `Historial del Real Madrid Femenino contra ${rival.nombre}: ${rt.pj} partidos, ${rt.pg} victorias, ${rt.pe} empates y ${rt.pp} derrotas. Goleadoras, asistentes y todos los partidos.`
    : `Historial completo del Real Madrid Femenino contra ${rival.nombre}. Estadísticas, goleadoras, asistentes y todos los partidos disputados.`;
---

<Layout title={seoTitle} description={seoDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(rivalSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ name: "Inicio", path: "/home" }, { name: "Rivales", path: "/rivales" }, { name: rival.nombre, path: `/rivales/${slug}` }]))} />
    <section class="rival-hero">
        <div class="hero-bg-glow" aria-hidden="true"></div>

        <a href={isRealMadrid ? "/" : "/rivales"} class="hero-back-link">
            ← {isRealMadrid ? "VOLVER AL INICIO" : "VOLVER A RIVALES"}
        </a>

        <div class="hero-inner">
            <div class="hero-shield-col">
                {shieldImageSrc ? (
                    <img
                        src={shieldImageSrc}
                        alt={`Escudo de ${rival.nombre}`}
                        class="hero-shield-img"
                        onerror={`this.onerror=null; this.src='/assets/escudos/placeholder.png';`}
                    />
                ) : (
                    <div class="hero-shield-placeholder">
                        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(212,168,67,0.3)" stroke-width="1">
                            <path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.25C17.25 22.15 21 17.25 21 12V7L12 2z"/>
                        </svg>
                    </div>
                )}
            </div>

            <div class="hero-info-col">
                <div class="hero-chips">
                    {flagImage && (
                        <span class="hero-chip hero-chip-gold">
                            <img
                                src={flagImage.src}
                                alt={`Bandera de ${rival.pais}`}
                                class="chip-flag"
                                width="16"
                                height="16"
                                loading="lazy"
                            />
                            {rival.pais}
                        </span>
                    )}
                    {!flagImage && rival.pais && (
                        <span class="hero-chip hero-chip-gold">{rival.pais}</span>
                    )}
                    {rival.ciudad && (
                        <span class="hero-chip">{rival.ciudad}</span>
                    )}
                </div>

                <h1 class="hero-rival-name">{rival.nombre}</h1>

                <div class="hero-quick-stats">
                    <div class="qs-card">
                        <span class="qs-number">{rivalStats.total.pj}</span>
                        <span class="qs-label">PARTIDOS</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{rivalStats.total.percPG}%</span>
                        <span class="qs-label">VICTORIAS</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{rivalStats.total.gf}</span>
                        <span class="qs-label">GOLES A FAVOR</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{rivalStats.total.gc}</span>
                        <span class="qs-label">GOLES EN CONTRA</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{streaksTotal.wins}</span>
                        <span class="qs-label">MAX. VICTORIAS SEGUIDAS</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <main class="rival-content">
        <section class="profile-card" style="margin:0 0 1.25rem;">
            <h2 class="card-title">{isRealMadrid ? "EL REAL MADRID FEMENINO" : `HISTORIAL CONTRA ${rival.nombre.toUpperCase()}`}</h2>
            <div class="card-body">
                <p style="margin:0;padding:clamp(0.75rem,3vw,1rem) clamp(0.9rem,4vw,1.25rem);line-height:1.75;font-size:clamp(0.92rem,2.6vw,1.05rem);overflow-wrap:break-word;text-wrap:pretty;text-align:justify;box-sizing:border-box;">{bio}</p>
            </div>
        </section>
        <div class="rival-grid">

            <div class="left-column">

                <section class="profile-card">
                    <h2 class="card-title">
                        {isRealMadrid ? "FICHA DEL REAL MADRID" : `FICHA DE RIVAL`}
                    </h2>
                    <div class="card-body">
                        <div class="info-row">
                            <span class="info-label">Nombre</span>
                            <span class="info-value">{rival.nombre}</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Ciudad</span>
                            <span class="info-value">{rival.ciudad}</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">País</span>
                            <span class="info-value" style="display:flex;align-items:center;gap:0.5rem;justify-content:flex-end;">
                                {rival.pais}
                                {flagImage && (
                                    <img
                                        src={flagImage.src}
                                        alt={`Bandera de ${rival.pais}`}
                                        class="flag-icon"
                                        width="24"
                                        height="16"
                                        loading="lazy"
                                    />
                                )}
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Estadio</span>
                            <span class="info-value">{rival.estadio}</span>
                        </div>
                    </div>
                </section>

                <section class="profile-card">
                    <h2 class="card-title">
                        {isRealMadrid
                            ? "ESTADÍSTICAS DEL REAL MADRID"
                            : `ESTADÍSTICAS CONTRA ${rival.nombre}`}
                    </h2>
                    <div class="card-body" style="padding:0;">
                        <div class="table-wrapper">
                            <table class="rival-stats-table">
                                <thead>
                                    <tr>
                                        <th>JUGADOS COMO</th>
                                        <th>PJ</th>
                                        <th>PG</th>
                                        <th>%PG</th>
                                        <th>PE</th>
                                        <th>%PE</th>
                                        <th>PP</th>
                                        <th>%PP</th>
                                        <th class="highlight-yellow">GF</th>
                                        <th class="highlight-red">GC</th>
                                        <th class="highlight-blue">DIF</th>
                                        <th>Avg.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>LOCAL</td>
                                        <td>{rivalStats.away.pj}</td>
                                        <td>{rivalStats.away.pg}</td>
                                        <td>{rivalStats.away.percPG}%</td>
                                        <td>{rivalStats.away.pe}</td>
                                        <td>{rivalStats.away.percPE}%</td>
                                        <td>{rivalStats.away.pp}</td>
                                        <td>{rivalStats.away.percPP}%</td>
                                        <td class="highlight-yellow">{rivalStats.away.gf}</td>
                                        <td class="highlight-red">{rivalStats.away.gc}</td>
                                        <td class="highlight-blue">{rivalStats.away.dif > 0 ? "+" : ""}{rivalStats.away.dif}</td>
                                        <td>{rivalStats.away.avg}</td>
                                    </tr>
                                    <tr>
                                        <td>VISITANTE</td>
                                        <td>{rivalStats.home.pj}</td>
                                        <td>{rivalStats.home.pg}</td>
                                        <td>{rivalStats.home.percPG}%</td>
                                        <td>{rivalStats.home.pe}</td>
                                        <td>{rivalStats.home.percPE}%</td>
                                        <td>{rivalStats.home.pp}</td>
                                        <td>{rivalStats.home.percPP}%</td>
                                        <td class="highlight-yellow">{rivalStats.home.gf}</td>
                                        <td class="highlight-red">{rivalStats.home.gc}</td>
                                        <td class="highlight-blue">{rivalStats.home.dif > 0 ? "+" : ""}{rivalStats.home.dif}</td>
                                        <td>{rivalStats.home.avg}</td>
                                    </tr>
                                    <tr class="total-row">
                                        <td><strong>TOTAL</strong></td>
                                        <td>{rivalStats.total.pj}</td>
                                        <td>{rivalStats.total.pg}</td>
                                        <td>{rivalStats.total.percPG}%</td>
                                        <td>{rivalStats.total.pe}</td>
                                        <td>{rivalStats.total.percPE}%</td>
                                        <td>{rivalStats.total.pp}</td>
                                        <td>{rivalStats.total.percPP}%</td>
                                        <td class="highlight-yellow">{rivalStats.total.gf}</td>
                                        <td class="highlight-red">{rivalStats.total.gc}</td>
                                        <td class="highlight-blue">{rivalStats.total.dif > 0 ? "+" : ""}{rivalStats.total.dif}</td>
                                        <td>{rivalStats.total.avg}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section class="profile-card">
                    <h2 class="card-title">GRÁFICAS</h2>
                    <div class="card-body" style="padding:1.25rem;">
                        <div class="filters-container">
                            <div class="custom-select-container" id="container-location">
                                <div class="custom-select-trigger" id="trigger-location">
                                    <span class="selected-text">Local/Visitante</span>
                                    <div class="custom-select-arrow">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                                    </div>
                                </div>
                                <div class="custom-select-options">
                                    <div class="custom-select-option selected" data-value="all">Local/Visitante</div>
                                    <div class="custom-select-option" data-value="local">Como Local</div>
                                    <div class="custom-select-option" data-value="visitor">Como Visitante</div>
                                </div>
                                <select id="location-filter" style="display: none;">
                                    <option value="all">Local/Visitante</option>
                                    <option value="local">Como Local</option>
                                    <option value="visitor">Como Visitante</option>
                                </select>
                            </div>
                            <div class="custom-select-container" id="container-competicion">
                                <div class="custom-select-trigger" id="trigger-competicion">
                                    <span class="selected-text">Todas las Competiciones</span>
                                    <div class="custom-select-arrow">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                                    </div>
                                </div>
                                <div class="custom-select-options">
                                    <div class="custom-select-option selected" data-value="all">Todas las Competiciones</div>
                                    <div class="custom-select-option" data-value="oficiales">Partidos oficiales</div>
                                    {competitions.map((comp) => (
                                        <div class="custom-select-option" data-value={comp}>{comp}</div>
                                    ))}
                                </div>
                                <select id="competition-filter" style="display: none;">
                                    <option value="all">Todas las Competiciones</option>
                                    <option value="oficiales">Partidos oficiales</option>
                                    {competitions.map((comp) => (
                                        <option value={comp}>{comp}</option>
                                    ))}
                                </select>
                            </div>
                            <div class="custom-select-container" id="container-temporada">
                                <div class="custom-select-trigger" id="trigger-temporada">
                                    <span class="selected-text">Todas las Temporadas</span>
                                    <div class="custom-select-arrow">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                                    </div>
                                </div>
                                <div class="custom-select-options">
                                    <div class="custom-select-option selected" data-value="all">Todas las Temporadas</div>
                                    {uniqueSeasons.map((season) => (
                                        <div class="custom-select-option" data-value={season}>{season}</div>
                                    ))}
                                </div>
                                <select id="season-filter" style="display: none;">
                                    <option value="all">Todas las Temporadas</option>
                                    {uniqueSeasons.map((season) => (
                                        <option value={season}>{season}</option>
                                    ))}
                                </select>
                            </div>
                        </div>
                        <div class="charts-row">
                            <div class="chart-item">
                                <svg viewBox="0 0 100 100" class="pie-chart" id="results-chart">
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#22c55e" stroke-width="20" stroke-dasharray={`${winsArc} ${circumference - winsArc}`} transform="rotate(-90 50 50)"></circle>
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(212,168,67,0.7)" stroke-width="20" stroke-dasharray={`${drawsArc} ${circumference - drawsArc}`} stroke-dashoffset={-winsArc} transform="rotate(-90 50 50)"></circle>
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#f87171" stroke-width="20" stroke-dasharray={`${lossesArc} ${circumference - lossesArc}`} stroke-dashoffset={-(winsArc + drawsArc)} transform="rotate(-90 50 50)"></circle>
                                </svg>
                                <div class="chart-legend" id="results-legend">
                                    <div><span class="dot green"></span> Ganados ({rivalStats.total.pg})</div>
                                    <div><span class="dot orange"></span> Empatados ({rivalStats.total.pe})</div>
                                    <div><span class="dot red"></span> Perdidos ({rivalStats.total.pp})</div>
                                </div>
                            </div>
                            <div class="chart-item">
                                <svg viewBox="0 0 100 100" class="pie-chart" id="goals-chart">
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#22c55e" stroke-width="20" stroke-dasharray={`${goalsForArc} ${circumference - goalsForArc}`} transform="rotate(-90 50 50)"></circle>
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#f87171" stroke-width="20" stroke-dasharray={`${goalsAgainstArc} ${circumference - goalsAgainstArc}`} stroke-dashoffset={-goalsForArc} transform="rotate(-90 50 50)"></circle>
                                </svg>
                                <div class="chart-legend" id="goals-legend">
                                    <div><span class="dot green"></span> A favor ({rivalStats.total.gf})</div>
                                    <div><span class="dot red"></span> En contra ({rivalStats.total.gc})</div>
                                </div>
                            </div>
                            <div class="chart-item">
                                <svg viewBox="0 0 100 100" class="pie-chart" id="clean-sheets-chart">
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#22c55e" stroke-width="20" stroke-dasharray={`${cleanSheetsArc} ${circumference - cleanSheetsArc}`} transform="rotate(-90 50 50)"></circle>
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#f87171" stroke-width="20" stroke-dasharray={`${concededArc} ${circumference - concededArc}`} stroke-dashoffset={-cleanSheetsArc} transform="rotate(-90 50 50)"></circle>
                                </svg>
                                <div class="chart-legend" id="clean-sheets-legend">
                                    <div><span class="dot green"></span> P. a cero ({rivalStats.total.cleanSheets})</div>
                                    <div><span class="dot red"></span> Con gol ({rivalStats.total.conceded})</div>
                                </div>
                            </div>
                            <div class="chart-item">
                                <svg viewBox="0 0 100 100" class="pie-chart" id="cards-chart">
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#facc15" stroke-width="20" stroke-dasharray={`${yellowCardsArc} ${circumference - yellowCardsArc}`} transform="rotate(-90 50 50)"></circle>
                                    <circle cx="50" cy="50" r="35" fill="none" stroke="#f87171" stroke-width="20" stroke-dasharray={`${redCardsArc} ${circumference - redCardsArc}`} stroke-dashoffset={-yellowCardsArc} transform="rotate(-90 50 50)"></circle>
                                </svg>
                                <div class="chart-legend" id="cards-legend">
                                    <div><span class="dot yellow"></span> Amarillas ({rivalStats.total.yellowCards})</div>
                                    <div><span class="dot red"></span> Rojas ({rivalStats.total.redCards})</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="profile-card">
                    <h2 class="card-title">
                        {isRealMadrid
                            ? "TODOS LOS PARTIDOS DISPUTADOS POR EL REAL MADRID"
                            : `TODOS LOS PARTIDOS CONTRA ${rival.nombre}`}
                    </h2>
                    <div class="card-body" style="padding:0;">
                        <div class="table-wrapper">
                            <table class="matches-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Competición</th>
                                        <th>En</th>
                                        <th>Res.</th>
                                        <th>Árbitra</th>
                                        <th>Estadio</th>
                                        <th>Asist.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {rivalMatches.length > 0 ? (
                                        rivalMatches.map((match: any, index: number) => {
                                            const golesRM = parseInt(match.golesRM) || 0;
                                            const golesRival = parseInt(match.golesRival) || 0;
                                            let resultClass = "";
                                            if (golesRM > golesRival) {
                                                resultClass = "resultado-victoria";
                                            } else if (golesRM === golesRival) {
                                                resultClass = "resultado-empate";
                                            } else {
                                                resultClass = "resultado-derrota";
                                            }
                                            return (
                                                <tr class={`match-row ${index >= 5 ? "hidden-match" : ""}`}>
                                                    <td>{new Date(match.fecha).toLocaleDateString("es-ES")}</td>
                                                    <td>{competitionDisplayName(match.competicion, { idTemporada: match.id_temporada })}</td>
                                                    <td>{match.ubicacion}</td>
                                                    <td class={resultClass}>{match.resultado}</td>
                                                    <td>{match.arbitra}</td>
                                                    <td>{match.estadio}</td>
                                                    <td>{match.asistencia || "-"}</td>
                                                </tr>
                                            );
                                        })
                                    ) : (
                                        <tr>
                                            <td colspan="7" style="text-align:center;padding:2rem;color:rgba(150,160,175,0.5);font-style:italic;">
                                                No hay partidos registrados
                                            </td>
                                        </tr>
                                    )}
                                </tbody>
                            </table>
                        </div>
                        {rivalMatches.length > 5 && (
                            <div class="matches-footer">
                                <button id="show-more-matches" class="btn-more">
                                    Ver todos los partidos ({rivalMatches.length})
                                </button>
                            </div>
                        )}
                    </div>
                </section>

            </div>

            <div class="right-column">

                <section class="profile-card">
                    <h2 class="card-title">ESTADIO</h2>
                    <div class="card-body" style="padding:0;">
                        <div class="stadium-photo">
                            {stadiumImageSrc ? (
                                <img
                                    src={stadiumImageSrc}
                                    alt={`Estadio ${rival.estadio}`}
                                    class="stadium-img"
                                />
                            ) : (
                                <div class="photo-placeholder">
                                    <span>Foto no disponible</span>
                                </div>
                            )}
                        </div>
                        {rival.estadio && (
                            <div class="info-row" style="padding:0.6rem 1.25rem;">
                                <span class="info-label">Estadio</span>
                                <span class="info-value">{rival.estadio}</span>
                            </div>
                        )}
                    </div>
                </section>

                <section class="profile-card">
                    <h2 class="card-title">RÉCORDS</h2>
                    <div class="card-body" style="padding:0;">
                        <div class="records-grid-header">
                            <span class="header-label"></span>
                            <span class="header-val">TOTAL</span>
                            <span class="header-val">CASA</span>
                            <span class="header-val">FUERA</span>
                        </div>
                        <div class="records-list">
                            <div class="record-row record-row-grid">
                                <span class="info-label">Victorias seguidas</span>
                                <span class="record-value">{streaksTotal.wins}</span>
                                <span class="record-value">{streaksHome.wins}</span>
                                <span class="record-value">{streaksAway.wins}</span>
                            </div>
                            <div class="record-row record-row-grid">
                                <span class="info-label">Empates seguidos</span>
                                <span class="record-value">{streaksTotal.draws}</span>
                                <span class="record-value">{streaksHome.draws}</span>
                                <span class="record-value">{streaksAway.draws}</span>
                            </div>
                            <div class="record-row record-row-grid">
                                <span class="info-label">Derrotas seguidas</span>
                                <span class="record-value">{streaksTotal.losses}</span>
                                <span class="record-value">{streaksHome.losses}</span>
                                <span class="record-value">{streaksAway.losses}</span>
                            </div>
                            <div class="record-row record-row-grid">
                                <span class="info-label">Sin ganar</span>
                                <span class="record-value">{streaksTotal.noWins}</span>
                                <span class="record-value">{streaksHome.noWins}</span>
                                <span class="record-value">{streaksAway.noWins}</span>
                            </div>
                            <div class="record-row record-row-grid">
                                <span class="info-label">Sin perder</span>
                                <span class="record-value">{streaksTotal.undefeated}</span>
                                <span class="record-value">{streaksHome.undefeated}</span>
                                <span class="record-value">{streaksAway.undefeated}</span>
                            </div>
                            <div class="record-row record-row-grid">
                                <span class="info-label">Porterías a cero</span>
                                <span class="record-value">{streaksTotal.cleanSheets}</span>
                                <span class="record-value">{streaksHome.cleanSheets}</span>
                                <span class="record-value">{streaksAway.cleanSheets}</span>
                            </div>
                            {rivalRecords?.mayor_victoria && (
                                <div class="info-row">
                                    <span class="info-label">Mayor victoria</span>
                                    <span class="info-value" style="color:#d4a843;font-weight:700;">{rivalRecords.mayor_victoria.resultado}</span>
                                </div>
                            )}
                            {rivalRecords?.mayor_derrota && (
                                <div class="info-row">
                                    <span class="info-label">Mayor derrota</span>
                                    <span class="info-value" style="color:#f87171;font-weight:700;">{rivalRecords.mayor_derrota.resultado}</span>
                                </div>
                            )}
                            {rivalRecords?.mas_repetido && (
                                <div class="info-row">
                                    <span class="info-label">Más repetido</span>
                                    <span class="info-value">{rivalRecords.mas_repetido.resultado} — {rivalRecords.mas_repetido.veces} veces</span>
                                </div>
                            )}
                            {rivalRecords?.maximo_goleador && (
                                <div class="info-row">
                                    <span class="info-label">Máxima goleadora</span>
                                    <span class="info-value">{rivalRecords.maximo_goleador.nombre} — {rivalRecords.maximo_goleador.goles}</span>
                                </div>
                            )}
                            {rivalRecords?.goleador_rival && (
                                <div class="info-row">
                                    <span class="info-label">Goleador rival</span>
                                    <span class="info-value">{rivalRecords.goleador_rival.nombre} — {rivalRecords.goleador_rival.goles}</span>
                                </div>
                            )}
                            {rivalRecords?.mas_partidos && (
                                <div class="info-row">
                                    <span class="info-label">Más partidos</span>
                                    <span class="info-value">{rivalRecords.mas_partidos.nombre} — {rivalRecords.mas_partidos.partidos}</span>
                                </div>
                            )}
                        </div>
                    </div>
                </section>

                <section class="profile-card">
                    <h2 class="card-title">MÁXIMAS GOLEADORAS</h2>
                    <div class="card-body" style="padding:0;">
                        {topPlayersData.topScorers.length > 0 ? (
                            topPlayersData.topScorers.map((player: any, index: number) => (
                                <div class="top-item">
                                    <span class="top-position">{index + 1}</span>
                                    <span class="top-name">{player.nombre}</span>
                                    <span class="top-stat">{player.goles} {player.goles === 1 ? "gol" : "goles"}</span>
                                </div>
                            ))
                        ) : (
                            <p class="no-data">Sin datos disponibles</p>
                        )}
                    </div>
                </section>

                <section class="profile-card">
                    <h2 class="card-title">MÁS ASISTENTES</h2>
                    <div class="card-body" style="padding:0;">
                        {topPlayersData.topAssisters.length > 0 ? (
                            topPlayersData.topAssisters.map((player: any, index: number) => (
                                <div class="top-item">
                                    <span class="top-position">{index + 1}</span>
                                    <span class="top-name">{player.nombre}</span>
                                    <span class="top-stat">{player.asistencias} {player.asistencias === 1 ? "asistencia" : "asistencias"}</span>
                                </div>
                            ))
                        ) : (
                            <p class="no-data">Sin datos disponibles</p>
                        )}
                    </div>
                </section>

                <section class="profile-card">
                    <h2 class="card-title">MÁS GOLES GENERADOS (G+A)</h2>
                    <div class="card-body" style="padding:0;">
                        {topPlayersData.topContributors.length > 0 ? (
                            topPlayersData.topContributors.map((player: any, index: number) => (
                                <div class="top-item">
                                    <span class="top-position">{index + 1}</span>
                                    <span class="top-name">{player.nombre}</span>
                                    <span class="top-stat">{player.total} ({player.goles}G + {player.asistencias}A)</span>
                                </div>
                            ))
                        ) : (
                            <p class="no-data">Sin datos disponibles</p>
                        )}
                    </div>
                </section>

            </div>
        </div>
    </main>
</Layout>

<script define:vars={{ initialMatches: rivalMatches }}>

    function getSeason(dateStr) {
        const d = new Date(dateStr);
        const year = d.getFullYear();
        const month = d.getMonth() + 1;
        const startYear = month >= 8 ? year : year - 1;
        const endYear = startYear + 1;
        return `${startYear}/${endYear.toString().slice(-2)}`;
    }

    const allMatches = initialMatches.map((m) => ({
        ...m,
        season: getSeason(m.fecha),
    }));

    const compFilter = document.getElementById("competition-filter");
    const seasonFilter = document.getElementById("season-filter");
    const locationFilter = document.getElementById("location-filter");

    function calculateStats(matches) {
        const stats = {
            home: {
                pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0,
                cleanSheets: 0, conceded: 0, yellowCards: 0, redCards: 0,
            },
            away: {
                pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0,
                cleanSheets: 0, conceded: 0, yellowCards: 0, redCards: 0,
            },
            total: {
                pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0,
                cleanSheets: 0, conceded: 0, yellowCards: 0, redCards: 0,
            },
        };

        matches.forEach((match) => {
            const golesRM = parseInt(match.golesRM) || 0;
            const golesRival = parseInt(match.golesRival) || 0;
            const isHome = match.esLocal;
            const location = isHome ? stats.home : stats.away;

            location.pj++;
            location.gf += golesRM;
            location.gc += golesRival;

            if (golesRival === 0) {
                location.cleanSheets++;
            } else {
                location.conceded++;
            }

            location.yellowCards += match.amarillas || 0;
            location.redCards += match.rojas || 0;

            if (golesRM > golesRival) location.pg++;
            else if (golesRM === golesRival) location.pe++;
            else location.pp++;
        });

        stats.total.pj = stats.home.pj + stats.away.pj;
        stats.total.pg = stats.home.pg + stats.away.pg;
        stats.total.pe = stats.home.pe + stats.away.pe;
        stats.total.pp = stats.home.pp + stats.away.pp;
        stats.total.gf = stats.home.gf + stats.away.gf;
        stats.total.gc = stats.home.gc + stats.away.gc;
        stats.total.gc = stats.home.gc + stats.away.gc;
        stats.total.cleanSheets = stats.home.cleanSheets + stats.away.cleanSheets;
        stats.total.conceded = stats.home.conceded + stats.away.conceded;
        stats.total.yellowCards = stats.home.yellowCards + stats.away.yellowCards;
        stats.total.redCards = stats.home.redCards + stats.away.redCards;

        const addFields = (obj) => ({
            ...obj,
            percPG: obj.pj > 0 ? ((obj.pg / obj.pj) * 100).toFixed(1) : "0.0",
            percPE: obj.pj > 0 ? ((obj.pe / obj.pj) * 100).toFixed(1) : "0.0",
            percPP: obj.pj > 0 ? ((obj.pp / obj.pj) * 100).toFixed(1) : "0.0",
            avg: obj.pj > 0 ? (obj.gf / obj.pj).toFixed(2) : "0.00",
            dif: obj.gf - obj.gc,
        });

        return {
            home: addFields(stats.home),
            away: addFields(stats.away),
            total: addFields(stats.total),
        };
    }

    function updateCharts(stats) {
        const circumference = 220;
        const totalMatches = stats.total.pj;
        const totalGoals = stats.total.gf + stats.total.gc;

        const winsArc = totalMatches > 0 ? Math.round((stats.total.pg / totalMatches) * circumference) : 0;
        const drawsArc = totalMatches > 0 ? Math.round((stats.total.pe / totalMatches) * circumference) : 0;
        const lossesArc = totalMatches > 0 ? Math.round((stats.total.pp / totalMatches) * circumference) : 0;

        const goalsForArc = totalGoals > 0 ? Math.round((stats.total.gf / totalGoals) * circumference) : 0;
        const goalsAgainstArc = totalGoals > 0 ? Math.round((stats.total.gc / totalGoals) * circumference) : 0;

        const cleanSheetsArc = totalMatches > 0 ? Math.round((stats.total.cleanSheets / totalMatches) * circumference) : 0;
        const concededArc = totalMatches > 0 ? Math.round((stats.total.conceded / totalMatches) * circumference) : 0;

        const resultsChart = document.getElementById("results-chart");
        if (resultsChart) {
            const circles = resultsChart.querySelectorAll("circle");
            if (circles[0]) circles[0].setAttribute("stroke-dasharray", `${winsArc} ${circumference - winsArc}`);
            if (circles[1]) {
                circles[1].setAttribute("stroke-dasharray", `${drawsArc} ${circumference - drawsArc}`);
                circles[1].setAttribute("stroke-dashoffset", -winsArc);
            }
            if (circles[2]) {
                circles[2].setAttribute("stroke-dasharray", `${lossesArc} ${circumference - lossesArc}`);
                circles[2].setAttribute("stroke-dashoffset", -(winsArc + drawsArc));
            }
        }

        const goalsChart = document.getElementById("goals-chart");
        if (goalsChart) {
            const circles = goalsChart.querySelectorAll("circle");
            if (circles[0]) circles[0].setAttribute("stroke-dasharray", `${goalsForArc} ${circumference - goalsForArc}`);
            if (circles[1]) {
                circles[1].setAttribute("stroke-dasharray", `${goalsAgainstArc} ${circumference - goalsAgainstArc}`);
                circles[1].setAttribute("stroke-dashoffset", -goalsForArc);
            }
        }

        const cleanSheetsChart = document.getElementById("clean-sheets-chart");
        if (cleanSheetsChart) {
            const circles = cleanSheetsChart.querySelectorAll("circle");
            if (circles[0]) circles[0].setAttribute("stroke-dasharray", `${cleanSheetsArc} ${circumference - cleanSheetsArc}`);
            if (circles[1]) {
                circles[1].setAttribute("stroke-dasharray", `${concededArc} ${circumference - concededArc}`);
                circles[1].setAttribute("stroke-dashoffset", -cleanSheetsArc);
            }
        }

        const resultsLegend = document.getElementById("results-legend");
        if (resultsLegend) {
            const divs = resultsLegend.querySelectorAll("div");
            if (divs[0]) divs[0].innerHTML = `<span class="dot green"></span> Ganados (${stats.total.pg})`;
            if (divs[1]) divs[1].innerHTML = `<span class="dot orange"></span> Empatados (${stats.total.pe})`;
            if (divs[2]) divs[2].innerHTML = `<span class="dot red"></span> Perdidos (${stats.total.pp})`;
        }

        const goalsLegend = document.getElementById("goals-legend");
        if (goalsLegend) {
            const divs = goalsLegend.querySelectorAll("div");
            if (divs[0]) divs[0].innerHTML = `<span class="dot green"></span> A favor (${stats.total.gf})`;
            if (divs[1]) divs[1].innerHTML = `<span class="dot red"></span> En contra (${stats.total.gc})`;
        }

        const cleanSheetsLegend = document.getElementById("clean-sheets-legend");
        if (cleanSheetsLegend) {
            const divs = cleanSheetsLegend.querySelectorAll("div");
            if (divs[0]) divs[0].innerHTML = `<span class="dot green"></span> P. a cero (${stats.total.cleanSheets})`;
            if (divs[1]) divs[1].innerHTML = `<span class="dot red"></span> Con gol (${stats.total.conceded})`;
        }

        const totalCards = (stats.total.yellowCards || 0) + (stats.total.redCards || 0);
        const yellowCardsArc = totalCards > 0 ? Math.round((stats.total.yellowCards / totalCards) * circumference) : 0;
        const redCardsArc = totalCards > 0 ? Math.round((stats.total.redCards / totalCards) * circumference) : 0;

        const cardsChart = document.getElementById("cards-chart");
        if (cardsChart) {
            const circles = cardsChart.querySelectorAll("circle");
            if (circles[0]) circles[0].setAttribute("stroke-dasharray", `${yellowCardsArc} ${circumference - yellowCardsArc}`);
            if (circles[1]) {
                circles[1].setAttribute("stroke-dasharray", `${redCardsArc} ${circumference - redCardsArc}`);
                circles[1].setAttribute("stroke-dashoffset", -yellowCardsArc);
            }
        }

        const cardsLegend = document.getElementById("cards-legend");
        if (cardsLegend) {
            const divs = cardsLegend.querySelectorAll("div");
            if (divs[0]) divs[0].innerHTML = `<span class="dot yellow"></span> Amarillas (${stats.total.yellowCards})`;
            if (divs[1]) divs[1].innerHTML = `<span class="dot red"></span> Rojas (${stats.total.redCards})`;
        }
    }

    function updateTable(stats) {
        const table = document.querySelector(".rival-stats-table tbody");
        if (!table) return;

        const getRowHtml = (label, data) => `
            <td>${label}</td>
            <td>${data.pj}</td>
            <td>${data.pg}</td>
            <td>${data.percPG}%</td>
            <td>${data.pe}</td>
            <td>${data.percPE}%</td>
            <td>${data.pp}</td>
            <td>${data.percPP}%</td>
            <td class="highlight-yellow">${data.gf}</td>
            <td class="highlight-red">${data.gc}</td>
            <td class="highlight-blue">${data.dif > 0 ? "+" : ""}${data.dif}</td>
            <td>${data.avg}</td>
        `;

        table.innerHTML = `
            <tr>${getRowHtml("LOCAL", stats.away)}</tr>
            <tr>${getRowHtml("VISITANTE", stats.home)}</tr>
            <tr class="total-row">${getRowHtml("<strong>TOTAL</strong>", stats.total)}</tr>
        `;
    }

    function updateUI() {
        const selectedComp = compFilter?.value || "all";
        const selectedSeason = seasonFilter?.value || "all";
        const selectedLocation = locationFilter?.value || "all";

        const filteredMatches = allMatches.filter((m) => {
            let compMatch = false;
            if (selectedComp === "all") {
                compMatch = true;
            } else if (selectedComp === "oficiales") {
                const officialComps = ["Liga F", "Primera Iberdrola", "UWCL", "Copa de la Reina", "Supercopa", "Supercopa de España"];
                compMatch = officialComps.some((c) => m.competicion.includes(c));
            } else {
                compMatch = m.competicion === selectedComp;
            }

            const seasonMatch = selectedSeason === "all" || m.season === selectedSeason;

            let locationMatch = true;
            if (selectedLocation === "local") {
                locationMatch = m.esLocal === false;
            } else if (selectedLocation === "visitor") {
                locationMatch = m.esLocal === true;
            }

            return compMatch && seasonMatch && locationMatch;
        });

        const newStats = calculateStats(filteredMatches);
        updateCharts(newStats);
        updateTable(newStats);
    }

    function initCustomSelects() {
        const containers = document.querySelectorAll(".custom-select-container");

        containers.forEach((container) => {
            const trigger = container.querySelector(".custom-select-trigger");
            const select = container.querySelector("select");
            const options = container.querySelectorAll(".custom-select-option");
            const selectedText = trigger?.querySelector(".selected-text");

            trigger?.addEventListener("click", (e) => {
                e.stopPropagation();
                containers.forEach((c) => {
                    if (c !== container) c.classList.remove("open");
                });
                container.classList.toggle("open");
            });

            options.forEach((option) => {
                option.addEventListener("click", () => {
                    const value = option.dataset.value;
                    const text = option.textContent;

                    if (selectedText) selectedText.textContent = text;
                    options.forEach((opt) => opt.classList.remove("selected"));
                    option.classList.add("selected");

                    if (select && value !== undefined) {
                        select.value = value;
                        select.dispatchEvent(new Event("change"));
                    }

                    container.classList.remove("open");
                });
            });
        });

        document.addEventListener("click", () => {
            containers.forEach((c) => c.classList.remove("open"));
        });
    }

    initCustomSelects();

    if (compFilter) compFilter.addEventListener("change", updateUI);
    if (seasonFilter) seasonFilter.addEventListener("change", updateUI);
    if (locationFilter) locationFilter.addEventListener("change", updateUI);

    const showMoreBtn = document.getElementById("show-more-matches");
    if (showMoreBtn) {
        showMoreBtn.addEventListener("click", () => {
            const hiddenMatches = document.querySelectorAll(".hidden-match");
            hiddenMatches.forEach((row) => {
                row.classList.remove("hidden-match");
                row.style.display = "table-row";
            });
            if (showMoreBtn.parentElement) {
                showMoreBtn.parentElement.style.display = "none";
            }
        });
    }
</script>

<style>

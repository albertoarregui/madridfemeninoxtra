---
import Layout from "../../layouts/Layout.astro";
import LaFabricaNav from "../../components/LaFabricaNav.astro";
import { fetchFabricaSpain } from "../../utils/fabrica";
import { breadcrumbSchema } from "../../utils/seo";
import { getAssetUrl } from "../../utils/assets";
import "../../styles/la-fabrica.css";

const { summary, tournaments } = await fetchFabricaSpain();
const share = summary.plazas_totales > 0
    ? (summary.plazas_rm / summary.plazas_totales * 100).toLocaleString("es-ES", { maximumFractionDigits: 1 })
    : "0";

const linkLabel = (url: string) => {
    try {
        const host = new URL(url).hostname.replace(/^www\./, "");
        if (host.includes("rfef")) return "RFEF";
        if (host.includes("uefa")) return "UEFA";
        if (host.includes("fifa")) return "FIFA";
        if (host.includes("realmadrid")) return "Real Madrid";
        return host;
    } catch {
        return "Fuente";
    }
};

const rankText = (ranking: number, shared: boolean) =>
    `${ranking}.º${shared ? " (empatado)" : ""}`;

const roleText = (item: any) => {
    const roles = [];
    if (item.capitana_final) roles.push("capitana");
    if (item.titular_final === true) roles.push("titular en la final");
    else if (item.jugo_final === true) roles.push("jugó la final");
    if (item.goles_torneo != null) roles.push(`${item.goles_torneo} goles`);
    if (item.vinculo_rm === "antes_de_llegar") roles.push("llegó después al Madrid");
    if (item.vinculo_rm === "despues_de_salir") roles.push("formada previamente en el Madrid");
    return roles.join(" · ");
};

const competitionLogo = (competition: string, category: string, year: number) => {
    const key = `${competition.toLowerCase()}-${category.toLowerCase()}`;

    if (key.includes("europeo-sub-17")) {
        return getAssetUrl("competiciones", "euro_femenino_sub17_oficial.webp");
    }
    if (key.includes("europeo-sub-19")) {
        return getAssetUrl("competiciones", "euro_femenino_sub19_oficial.webp");
    }
    if (key.includes("mundial-sub-17")) {
        if (year === 2022) return getAssetUrl("competiciones", "mundial_femenino_sub17_2022.webp");
        if (year === 2024) return getAssetUrl("competiciones", "mundial_femenino_sub17_2024.webp");
        return getAssetUrl("competiciones", "mundial_femenino_sub17.svg");
    }
    if (key.includes("mundial-sub-20")) {
        if (year === 2026) return getAssetUrl("competiciones", "mundial_femenino_sub20_2026.webp");
        return getAssetUrl("competiciones", "mundial_femenino_sub20.svg");
    }

    return "";
};

const playerPlaceholder = getAssetUrl("jugadoras", "placeholder.png");
const playerPhoto = (item: { nombre: string; foto_url: string | null }) => {
    const name = item.nombre.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
    if (name.includes("raquel") && name.includes("inigo")) {
        return getAssetUrl("jugadoras", "raquel_inigo_transparente.webp");
    }
    if (name.includes("correro")) return getAssetUrl("jugadoras", "noe_correro_transparente.webp");
    return item.foto_url || playerPlaceholder;
};

const datasetSchema = {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Aportación del Real Madrid a las selecciones inferiores femeninas de España",
    description: "Histórico de las jugadoras del Real Madrid y canteranas madridistas en las fases finales europeas y mundiales en las que España fue campeona o subcampeona desde 2022.",
    url: "https://www.madridfemeninoxtra.com/la-fabrica/espana",
    temporalCoverage: "2022/2026",
    creator: {
        "@type": "Organization",
        name: "Madrid Femenino Xtra",
        url: "https://www.madridfemeninoxtra.com/",
    },
};
---

<Layout
    title="Canteranas del Real Madrid con España: Europeos y Mundiales | La Fábrica"
    description="Datos torneo a torneo del peso del Real Madrid en las selecciones inferiores de España: jugadoras aportadas, ranking por clubes, finales y premios UEFA y FIFA."
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "La Fábrica", path: "/la-fabrica" },
                { name: "España", path: "/la-fabrica/espana" },
            ]),
        )}
    />
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(datasetSchema)} />

    <main class="fabrica-page">
        <div class="fabrica-shell">
            <header class="page-header-container fabrica-page-header">
                <h1 class="landing-title">LA FÁBRICA CON ESPAÑA</h1>
                <p class="landing-subtitle">Europeos y Mundiales · aportación por clubes y protagonismo madridista</p>
            </header>

            <LaFabricaNav />

            <section class="fabrica-kpis" aria-label="España en cifras">
                <article class="fabrica-kpi">
                    <strong>{summary.total_torneos}</strong>
                    <span>finales con España campeona o subcampeona</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>{summary.plazas_rm}</strong>
                    <span>plazas acumuladas de jugadoras del Real Madrid</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>{share}%</strong>
                    <span>de las {summary.plazas_totales} plazas acumuladas de España</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>{summary.torneos_lider}/{summary.total_torneos}</strong>
                    <span>torneos como club líder o colíder en aportación</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>{summary.torneos_top2}/{summary.total_torneos}</strong>
                    <span>torneos dentro del top-2 de clubes representados</span>
                </article>
            </section>

            <div class="fabrica-note fabrica-card">
                <div class="fabrica-card-head">Criterio de lectura</div>
                <div class="fabrica-card-body">
                    <p>
                        “Madridistas oficiales” cuenta a las jugadoras que pertenecían al
                        Real Madrid durante el torneo. También se identifican por separado
                        las futbolistas que pasaron por La Fábrica antes o después, para no
                        mezclar formación histórica con la aportación oficial del club en
                        cada convocatoria.
                    </p>
                </div>
            </div>

            <section class="fabrica-section">
                <div class="section-label">2022—2026</div>
                <h2 class="section-title">TORNEO POR TORNEO</h2>
                <p class="fabrica-section-copy">
                    Pulsa en cada competición para ver el ranking por clubes, las
                    canteranas participantes, su protagonismo y los galardones individuales.
                </p>

                <div class="tournaments">
                    {tournaments.map((tournament) => {
                        const maxClub = Math.max(...tournament.clubs.map((club) => club.jugadoras), 1);
                        const logo = competitionLogo(tournament.competicion, tournament.categoria, tournament.anio);

                        return (
                            <details class="tournament-card" id={tournament.slug}>
                                <summary class="tournament-summary">
                                    <div class="tournament-summary-main">
                                        {logo && (
                                            <span class:list={["competition-logo-wrap", {
                                                "competition-logo-wrap--light": tournament.competicion.toLowerCase().includes("mundial") && tournament.categoria.toLowerCase() === "sub-17" && [2022, 2024].includes(tournament.anio),
                                            }]}>
                                                <img
                                                    src={logo}
                                                    alt={`${tournament.competicion} ${tournament.categoria}`}
                                                    width="96"
                                                    height="48"
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </span>
                                        )}
                                        <div class="tournament-summary-copy">
                                            <div class="tournament-meta">
                                                <span class="meta-pill">{tournament.anio}</span>
                                                <span class="result-pill">{tournament.resultado_espana}</span>
                                                <span class="rank-pill">RM {rankText(tournament.ranking_rm, tournament.ranking_compartido)}</span>
                                            </div>
                                            <h3>{tournament.competicion} {tournament.categoria} {tournament.anio}</h3>
                                        </div>
                                    </div>

                                    <div class="tournament-summary-side">
                                        <div class="tournament-rm-count">
                                            <strong>{tournament.madridistas_oficiales}</strong>
                                            <span>madridistas de {tournament.total_convocadas}</span>
                                        </div>
                                        <span class="tournament-toggle" aria-hidden="true">▼</span>
                                    </div>
                                </summary>

                                <div class="tournament-content">
                                    <p class="tournament-resume">{tournament.resumen}</p>

                                    <div class="tournament-columns">
                                        <div class="tournament-block">
                                            <div class="fabrica-card-head">Aportación por clubes</div>
                                            <div class="tournament-block-body">
                                                <div class="club-ranking">
                                                    {tournament.clubs.map((club) => (
                                                        <div class:list={["club-row", { rm: club.club === "Real Madrid CF" }]}>
                                                            <span>{club.club === "Real Madrid CF" ? "Real Madrid" : club.club}</span>
                                                            <span class="club-bar" aria-hidden="true">
                                                                <span style={`width: ${(club.jugadoras / maxClub) * 100}%`}></span>
                                                            </span>
                                                            <strong>{club.jugadoras}</strong>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="tournament-block">
                                            <div class="fabrica-card-head">Canteranas y madridistas</div>
                                            <div class="tournament-block-body">
                                                <div class="people-list">
                                                    {tournament.participations.map((item) => (
                                                        <div class="person-row">
                                                            <div class="person-avatar">
                                                                <img
                                                                    src={playerPhoto(item)}
                                                                    alt={item.nombre}
                                                                    width="55"
                                                                    height="55"
                                                                    loading="lazy"
                                                                    decoding="async"
                                                                />
                                                            </div>
                                                            <div class="person-content">
                                                                <div class="person-head">
                                                                    <span class="person-name">{item.nombre}</span>
                                                                    {roleText(item) && <span class="person-role">{roleText(item)}</span>}
                                                                </div>
                                                                {item.resumen && <p>{item.resumen}</p>}
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    {tournament.awards.length > 0 && (
                                        <div class="tournament-block tournament-awards">
                                            <div class="fabrica-card-head">Galardones individuales</div>
                                            <div class="tournament-block-body">
                                                <div class="awards-list">
                                                    {tournament.awards.map((award) => (
                                                        <div class="award-row">
                                                            <div class="award-avatar">
                                                                <img
                                                                    src={playerPhoto(award)}
                                                                    alt={award.nombre}
                                                                    width="55"
                                                                    height="55"
                                                                    loading="lazy"
                                                                    decoding="async"
                                                                />
                                                            </div>
                                                            <div class="award-content">
                                                                <div class="award-head">
                                                                    <span class="award-name">
                                                                        {award.nombre} · <span>{award.galardon}</span>
                                                                    </span>
                                                                    <span class="meta-pill">{award.organismo}</span>
                                                                </div>
                                                                {award.detalle && <p>{award.detalle}</p>}
                                                                <a
                                                                    class="award-source"
                                                                    href={award.fuente_url}
                                                                    target="_blank"
                                                                    rel="noopener noreferrer"
                                                                >
                                                                    Fuente {award.organismo} ↗
                                                                </a>
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        </div>
                                    )}

                                    <div class="tournament-links">
                                        <a
                                            class="link-pill"
                                            href={tournament.fuente_convocatoria_url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {linkLabel(tournament.fuente_convocatoria_url)} · convocatoria ↗
                                        </a>
                                        {tournament.fuente_resultado_url && (
                                            <a
                                                class="link-pill"
                                                href={tournament.fuente_resultado_url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {linkLabel(tournament.fuente_resultado_url)} · torneo ↗
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </details>
                        );
                    })}
                </div>
            </section>

            <section class="fabrica-section">
                <div class="section-label">Lectura global</div>
                <h2 class="section-title">{summary.titulos} TÍTULOS Y {summary.subcampeonatos} SUBCAMPEONATOS</h2>
                <div class="fabrica-panel fabrica-card">
                    <div class="fabrica-card-body">
                        <p>
                            El dato de club se mantiene separado del dato de formación:
                            en cada edición se identifica quién pertenecía al Real Madrid en
                            ese momento y quién había pasado o pasaría después por La Fábrica.
                            Así, la comparación entre clubes y el impacto formativo pueden
                            leerse sin mezclar criterios.
                        </p>
                    </div>
                </div>
            </section>
        </div>
    </main>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import LaFabricaNav from "../../components/LaFabricaNav.astro";
import { breadcrumbSchema } from "../../utils/seo";
import "../../styles/global.css";
import "../../styles/la-fabrica.css";

const seasons = ["2026/27","2025/26","2024/25","2023/24","2022/23","2021/22","2020/21"];
---

<Layout
    title="Plantillas históricas de La Fábrica | Real Madrid Femenino | MFX"
    description="Consulta las plantillas históricas del Real Madrid B, Juvenil y Cadete femenino desde 2020/21, con fichas de jugadoras y enlaces al primer equipo."
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "La Fábrica", path: "/la-fabrica" },
                { name: "Plantillas", path: "/la-fabrica/plantillas" },
            ]),
        )}
    />

    <main class="fabrica-page">
        <div class="fabrica-shell">
            <header class="page-header-container fabrica-page-header">
                <h1 class="landing-title">PLANTILLAS DE LA FÁBRICA</h1>
                <p class="landing-subtitle">Real Madrid B · Juvenil · Cadete</p>
            </header>

            <LaFabricaNav />

            <section class="academy-browser" aria-labelledby="academy-browser-title">
                <div class="section-label">Archivo de plantillas</div>
                <h2 class="section-title" id="academy-browser-title">EQUIPO Y TEMPORADA</h2>

                <div class="academy-filters-panel">
                    <div class="academy-filter-field">
                        <span class="academy-filter-label">Equipo</span>
                        <div class="custom-select-container" data-custom-select="true">
                            <div class="custom-select-trigger">
                                <span class="selected-text">Real Madrid B</span>
                                <span class="custom-select-arrow" aria-hidden="true">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                                </span>
                            </div>
                            <select id="academy-team" class="native-select" hidden>
                                <option value="Real Madrid B" selected>Real Madrid B</option>
                                <option value="Juvenil">Juvenil</option>
                                <option value="Cadete">Cadete</option>
                            </select>
                            <div class="custom-select-options">
                                <div class="custom-select-option selected" data-value="Real Madrid B">Real Madrid B</div>
                                <div class="custom-select-option" data-value="Juvenil">Juvenil</div>
                                <div class="custom-select-option" data-value="Cadete">Cadete</div>
                            </div>
                        </div>
                    </div>

                    <div class="academy-filter-field">
                        <span class="academy-filter-label">Temporada</span>
                        <div class="custom-select-container" data-custom-select="true">
                            <div class="custom-select-trigger">
                                <span class="selected-text">2026/27</span>
                                <span class="custom-select-arrow" aria-hidden="true">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                                </span>
                            </div>
                            <select id="academy-season" class="native-select" hidden>
                                {seasons.map((season, index) => <option value={season} selected={index === 0}>{season}</option>)}
                            </select>
                            <div class="custom-select-options">
                                {seasons.map((season, index) => (
                                    <div class:list={["custom-select-option", { selected: index === 0 }]} data-value={season}>{season}</div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="academy-roster-meta" aria-live="polite">
                    <span id="academy-selection">Real Madrid B · 2026/27</span>
                    <span id="academy-count"></span>
                </div>

                <div id="academy-status" class="fabrica-empty">Cargando plantilla…</div>
                <div id="academy-roster" class="academy-roster" hidden></div>
            </section>
        </div>
    </main>
</Layout>

<script is:inline data-astro-rerun>
(() => {
    const DATA_URL = "https://media.madridfemeninoxtra.com/data/la-fabrica/academy.json";
    const PLACEHOLDER = "https://media.madridfemeninoxtra.com/jugadoras/placeholder.png";
    const POSITION_ORDER = ["Portera", "Defensa", "Centrocampista", "Delantera", "Otros"];

    const state = {
        data: null,
        team: "Real Madrid B",
        season: "2026/27",
    };

    const rosterEl = document.getElementById("academy-roster");
    const statusEl = document.getElementById("academy-status");
    const countEl = document.getElementById("academy-count");
    const selectionEl = document.getElementById("academy-selection");
    const teamEl = document.getElementById("academy-team");
    const seasonEl = document.getElementById("academy-season");

    const esc = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
    }[char]));

    const positionGroup = (position) => {
        const p = String(position || "").toLowerCase();
        if (p.includes("porter")) return "Portera";
        if (p.includes("defensa") || p.includes("lateral") || p.includes("central")) return "Defensa";
        if (p.includes("centro") || p.includes("medio") || p.includes("pivote") || p.includes("interior")) return "Centrocampista";
        if (p.includes("delantera") || p.includes("extremo") || p.includes("ariete")) return "Delantera";
        return "Otros";
    };

    const MIDDLE_GIVEN_NAMES = new Set(["aniela", "grace", "luisa", "nayaded"]);

    const shortName = (fullName) => {
        const parts = String(fullName || "").trim().split(/\s+/).filter(Boolean);
        if (parts.length <= 2) return parts.join(" ");
        const first = parts[0];
        const second = parts[1]?.toLowerCase();

        if (MIDDLE_GIVEN_NAMES.has(second) && parts[2]) {
            return `${first} ${parts[2]}`;
        }

        if (second === "de" && parts[2]) {
            const third = parts[2].toLowerCase();
            if (["la", "las", "los"].includes(third) && parts[3]) {
                return `${first} de ${parts[2]} ${parts[3]}`;
            }
            return `${first} de ${parts[2]}`;
        }

        return `${first} ${parts[1]}`;
    };

    function syncSelectAvailability() {
        if (!state.data) return;
        const available = new Set(
            state.data.rosters
                .filter((row) => row.team === state.team)
                .map((row) => row.season)
        );

        for (const option of seasonEl.options) {
            option.disabled = !available.has(option.value);
        }

        if (!available.has(state.season)) {
            const firstAvailable = state.data.seasons.find((season) => available.has(season));
            if (firstAvailable) {
                state.season = firstAvailable;
                seasonEl.value = firstAvailable;

                const container = seasonEl.closest(".custom-select-container");
                const selectedText = container?.querySelector(".selected-text");
                const options = container?.querySelectorAll(".custom-select-option");
                if (selectedText) selectedText.textContent = firstAvailable;
                options?.forEach((option) => {
                    option.classList.toggle("selected", option.dataset.value === firstAvailable);
                    option.toggleAttribute("hidden", !available.has(option.dataset.value));
                });
            }
        } else {
            const container = seasonEl.closest(".custom-select-container");
            container?.querySelectorAll(".custom-select-option").forEach((option) => {
                option.toggleAttribute("hidden", !available.has(option.dataset.value));
            });
        }
    }

    function statusBadge(player) {
        if (player.firstTeamStatus === "permanent") {
            return '<span class="academy-player-badge">PRIMER EQUIPO</span>';
        }
        if (player.firstTeamStatus === "debut") {
            return '<span class="academy-player-badge academy-player-badge--debut">DEBUT PRIMER EQUIPO</span>';
        }
        return "";
    }

    function render() {
        if (!state.data) return;

        const filtered = state.data.rosters
            .filter((row) => row.team === state.team && row.season === state.season)
            .sort((a, b) => {
                const na = Number(a.number);
                const nb = Number(b.number);
                if (Number.isFinite(na) && Number.isFinite(nb) && na !== nb) return na - nb;
                if (Number.isFinite(na) && !Number.isFinite(nb)) return -1;
                if (!Number.isFinite(na) && Number.isFinite(nb)) return 1;
                return a.name.localeCompare(b.name, "es");
            });

        const unique = new Map();
        for (const row of filtered) {
            if (!unique.has(row.slug)) unique.set(row.slug, row);
        }
        const players = [...unique.values()];

        selectionEl.textContent = `${state.team} · ${state.season}`;
        countEl.textContent = `${players.length} jugadoras`;

        if (!players.length) {
            rosterEl.hidden = true;
            statusEl.hidden = false;
            statusEl.textContent = "No hay una plantilla documentada para esta selección.";
            return;
        }

        const groups = new Map(POSITION_ORDER.map((key) => [key, []]));
        players.forEach((player) => groups.get(positionGroup(player.position)).push(player));

        rosterEl.innerHTML = POSITION_ORDER
            .filter((group) => groups.get(group).length)
            .map((group) => {
                const cards = groups.get(group).map((player) => {
                    const dorsal = player.number
                        ? `<span class="academy-roster-dorsal${String(player.number).length === 1 ? " is-single" : ""}" aria-label="Dorsal ${esc(player.number)}">${esc(player.number)}</span>`
                        : '<span class="academy-roster-dorsal academy-roster-dorsal--empty" aria-hidden="true"></span>';

                    return `
                        <a class="player-portrait-card academy-roster-card" href="${esc(player.profileUrl)}" aria-label="Ver ficha de ${esc(player.name)}">
                            <span class="pg-corner pg-corner-tl" aria-hidden="true"></span>
                            <span class="pg-corner pg-corner-tr" aria-hidden="true"></span>
                            <span class="pg-corner pg-corner-bl" aria-hidden="true"></span>
                            <span class="pg-corner pg-corner-br" aria-hidden="true"></span>
                            <div class="pg-card-glow" aria-hidden="true"></div>

                            <div class="pg-card-photo academy-roster-photo">
                                <img
                                    src="${esc(player.photoUrl || PLACEHOLDER)}"
                                    alt="${esc(player.name)}"
                                    loading="lazy"
                                    decoding="async"
                                    onerror="this.onerror=null;this.src='${PLACEHOLDER}'"
                                />
                            </div>

                            <div class="pg-card-overlay academy-roster-overlay">
                                <span class="pg-card-divider" aria-hidden="true"></span>
                                <div class="academy-roster-mainline">
                                    <div class="academy-roster-copy">
                                        <div class="pg-card-name" title="${esc(player.name)}">${esc(shortName(player.name))}</div>
                                        <div class="academy-roster-position">${esc(player.position || group)}</div>
                                    </div>
                                    ${dorsal}
                                </div>
                                <div class="academy-player-badges">
                                    ${statusBadge(player)}
                                </div>
                            </div>
                        </a>
                    `;
                }).join("");

                return `
                    <section class="academy-position-group">
                        <div class="fabrica-card-head">
                            <span>${esc(group)}</span>
                            <span>${groups.get(group).length}</span>
                        </div>
                        <div class="academy-player-grid">${cards}</div>
                    </section>
                `;
            }).join("");

        statusEl.hidden = true;
        rosterEl.hidden = false;
    }

    teamEl.addEventListener("change", () => {
        state.team = teamEl.value;
        syncSelectAvailability();
        render();
    });

    seasonEl.addEventListener("change", () => {
        state.season = seasonEl.value;
        render();
    });

    const fetchJsonWithTimeout = async (url, timeoutMs = 9000) => {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), timeoutMs);
        try {
            const response = await fetch(url, {
                cache: "default",
                signal: controller.signal,
                headers: { Accept: "application/json" },
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return await response.json();
        } finally {
            clearTimeout(timeout);
        }
    };

    const loadAcademyData = async () => {
        statusEl.hidden = false;
        statusEl.textContent = "Cargando plantilla…";

        try {
            let data;
            try {
                data = await fetchJsonWithTimeout(DATA_URL);
            } catch (firstError) {
                console.warn("[LA FABRICA] Reintentando caché de plantillas:", firstError);
                data = await fetchJsonWithTimeout(`${DATA_URL}?retry=${Date.now()}`, 7000);
            }

            state.data = data;
            state.season = data.seasons?.[0] || state.season;
            seasonEl.value = state.season;
            syncSelectAvailability();
            render();
        } catch (error) {
            console.error("[LA FABRICA] Error cargando plantillas:", error);
            rosterEl.hidden = true;
            statusEl.hidden = false;
            statusEl.innerHTML = 'No se ha podido cargar la plantilla. <button type="button" class="academy-retry-btn" id="academy-retry">Reintentar</button>';
            document.getElementById("academy-retry")?.addEventListener("click", loadAcademyData, { once: true });
        }
    };

    loadAcademyData();
})();
</script>

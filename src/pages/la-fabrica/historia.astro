---
import Layout from "../../layouts/Layout.astro";
import LaFabricaNav from "../../components/LaFabricaNav.astro";
import { fetchFabricaHistory } from "../../utils/fabrica";
import { breadcrumbSchema } from "../../utils/seo";
import "../../styles/la-fabrica.css";

const milestones = await fetchFabricaHistory();
const promotions = milestones.filter((item) => /ascenso/i.test(item.titulo) || /ascend/i.test(item.descripcion)).length;
const youthTitles = milestones.filter((item) => item.categoria === "Juvenil" && /Campeón/i.test(item.titulo)).length;

function formatDate(date: string | null): string {
    if (!date) return "";
    return new Intl.DateTimeFormat("es-ES", {
        timeZone: "UTC",
        year: "numeric",
        month: "long",
    }).format(new Date(date + "T12:00:00Z"));
}
---

<Layout
    title="Historia de La Fábrica | Cantera del Real Madrid Femenino | MFX"
    description="Historia de la cantera del Real Madrid Femenino desde 2020: títulos, ascensos del filial, éxitos del Juvenil y promociones al primer equipo."
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "La Fábrica", path: "/la-fabrica" },
                { name: "Historia", path: "/la-fabrica/historia" },
            ]),
        )}
    />

    <main class="fabrica-page">
        <div class="fabrica-shell">
            <header class="page-header-container fabrica-page-header">
                <h1 class="landing-title">HISTORIA DE LA FÁBRICA</h1>
                <p class="landing-subtitle">De 2020 al primer equipo · títulos, ascensos y formación</p>
            </header>

            <LaFabricaNav />

            <section class="fabrica-kpis" aria-label="Resumen histórico">
                <article class="fabrica-kpi">
                    <strong>2020</strong>
                    <span>nacimiento de la cantera femenina</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>{promotions}</strong>
                    <span>hitos de ascenso registrados en el filial</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>{youthTitles}</strong>
                    <span>títulos juveniles destacados registrados</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>2ª</strong>
                    <span>categoría nacional alcanzada por el Real Madrid B</span>
                </article>
                <article class="fabrica-kpi">
                    <strong>{milestones.length}</strong>
                    <span>hitos documentados actualmente en la base histórica</span>
                </article>
            </section>

            <section class="fabrica-section">
                <div class="section-label">Cronología</div>
                <h2 class="section-title">HITOS DE LA FÁBRICA</h2>
                <p class="fabrica-section-copy">
                    Del primer título invicto del filial a las promociones de futbolistas
                    formadas en Valdebebas.
                </p>

                {milestones.length > 0 ? (
                    <div class="timeline">
                        {milestones.map((item) => (
                            <article class="timeline-card">
                                <div class="fabrica-card-head">
                                    <span>{item.temporada || "Historia"}</span>
                                    <span>{item.categoria}</span>
                                </div>
                                <div class="fabrica-card-body">
                                    <div class="timeline-meta">
                                        {item.fecha && <span class="meta-pill">{formatDate(item.fecha)}</span>}
                                    </div>
                                    <h3>{item.titulo}</h3>
                                    <p>{item.descripcion}</p>
                                    <a
                                        class="source-link"
                                        href={item.fuente_url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Fuente oficial ↗
                                    </a>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : (
                    <div class="fabrica-empty">No hay hitos disponibles.</div>
                )}
            </section>
        </div>
    </main>
</Layout>

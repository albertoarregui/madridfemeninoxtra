---
import NotFound from '../../404.astro';
import redirects from '../../../data/academy-profile-redirects.json';
// Alias históricos de canteranas con al menos una convocatoria registrada.
const target = (redirects as Record<string, string>)[Astro.params.slug || ''];
if (target) return Astro.redirect(target, 301);
Astro.response.status = 410;
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---
<NotFound />

---
import biographies from "../../../data/fabrica-biografias.json";
import Layout from "../../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../../utils/seo";
import "../../../styles/global.css";
import "../../../styles/player-profile.css";
import "../../../styles/la-fabrica.css";

const { slug } = Astro.params;
---

<Layout
    title="Jugadora de La Fábrica | Real Madrid Femenino | MFX"
    description="Ficha histórica de una jugadora de la cantera femenina del Real Madrid."
>
    <script id="academy-biographies" type="application/json" set:html={JSON.stringify(biographies).replace(/</g, "\\u003c")} />
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "La Fábrica", path: "/la-fabrica" },
                { name: "Plantillas", path: "/la-fabrica/plantillas" },
                { name: "Jugadora", path: `/la-fabrica/jugadoras/${slug}` },
            ]),
        )}
    />

    <div id="academy-player-status" class="academy-profile-loading">Cargando ficha…</div>

    <section id="academy-player-hero" class="player-hero academy-first-team-profile" hidden>
        <div class="hero-bg-glow" aria-hidden="true"></div>

        <a href="/la-fabrica/plantillas" class="hero-back-link">← VOLVER A PLANTILLAS</a>

        <div class="hero-inner">
            <div class="hero-photo-col">
                <button id="academy-prev-photo" class="hero-nav-btn hero-nav-prev" aria-label="Foto anterior" hidden>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                </button>

                <img
                    id="academy-player-photo"
                    alt=""
                    class="hero-player-photo"
                    loading="eager"
                    decoding="async"
                    width="460"
                    height="640"
                />

                <div id="academy-photo-season" class="hero-season-badge"></div>

                <button id="academy-next-photo" class="hero-nav-btn hero-nav-next" aria-label="Foto siguiente" hidden>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                </button>
            </div>

            <div class="hero-info-col">
                <div id="academy-hero-chips" class="hero-chips">
                    <span id="academy-position-chip" class="hero-chip hero-chip-gold"></span>
                    <span class="hero-chip hero-chip-canterana" title="Formada en La Fábrica, la cantera del Real Madrid">★ Canterana</span>
                    <span id="academy-nationality-chip" class="hero-chip" hidden></span>
                    <span id="academy-age-chip" class="hero-chip" hidden></span>
                    <span id="academy-status-chip" class="hero-chip academy-first-team-chip" hidden></span>
                </div>

                <div class="hero-player-title">
                    <h1 id="academy-player-name" class="hero-player-name"></h1>
                    <span id="academy-player-dorsal" class="hero-player-dorsal" hidden></span>
                </div>
            </div>
        </div>
    </section>

    <main id="academy-player-content" class="player-content" hidden>
        <div class="content-grid">
            <section class="profile-card ficha-card full-col">
                <h2 class="card-title">FICHA PERSONAL</h2>
                <div id="academy-player-biography" class="card-body"></div>
            </section>
            <section class="profile-card trajectory-card full-col">
                <h2 class="card-title">TRAYECTORIA</h2>
                <div id="academy-player-career" class="card-body" style="padding:1.25rem 1.5rem;"></div>
            </section>
            <section class="profile-card full-col">
                <h2 class="card-title">TRAYECTORIA EN LA FÁBRICA</h2>
                <div class="card-body academy-profile-trajectory-body">
                    <div id="academy-player-trajectory" class="academy-trajectory"></div>
                </div>
            </section>
        </div>
    </main>
</Layout>

<script is:inline data-astro-rerun>
(() => {
    const slug = decodeURIComponent(window.location.pathname.split("/").filter(Boolean).pop() || "");
    const DATA_URL = "https://media.madridfemeninoxtra.com/data/la-fabrica/academy.json";
    const biographies = JSON.parse(document.getElementById("academy-biographies")?.textContent || "{}");
    const PLACEHOLDER = "https://media.madridfemeninoxtra.com/jugadoras/placeholder.png";

    const statusEl = document.getElementById("academy-player-status");
    const heroEl = document.getElementById("academy-player-hero");
    const contentEl = document.getElementById("academy-player-content");

    const esc = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
    }[char]));

    const fetchJsonWithTimeout = async (url, timeoutMs = 9000) => {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), timeoutMs);
        try {
            const response = await fetch(url, {
                cache: "default",
                signal: controller.signal,
                headers: { Accept: "application/json" },
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return await response.json();
        } finally {
            clearTimeout(timeout);
        }
    };

    const loadProfile = async () => {
        statusEl.hidden = false;
        statusEl.textContent = "Cargando ficha…";
        heroEl.hidden = true;
        contentEl.hidden = true;

        try {
            let data;
            try {
                data = await fetchJsonWithTimeout(DATA_URL);
            } catch (firstError) {
                console.warn("[LA FABRICA] Reintentando ficha:", firstError);
                data = await fetchJsonWithTimeout(`${DATA_URL}?retry=${Date.now()}`, 7000);
            }

            const player = data.players?.[slug];
            if (!player) {
                statusEl.innerHTML = 'No se ha encontrado esta jugadora. <a href="/la-fabrica/plantillas">Volver a plantillas</a>';
                return;
            }

            if (player.hasFirstTeamPage && player.profileUrl) {
                window.location.replace(player.profileUrl);
                return;
            }

            const appearances = data.rosters
                .filter((row) => row.slug === slug)
                .sort((a, b) => {
                    const seasonA = data.seasons.indexOf(a.season);
                    const seasonB = data.seasons.indexOf(b.season);
                    if (seasonA !== seasonB) return seasonA - seasonB;
                    const rank = { "Real Madrid B": 1, "Juvenil": 2, "Cadete": 3 };
                    return (rank[a.team] || 9) - (rank[b.team] || 9);
                });

            const latestAppearance = appearances[0];

            document.title = `${player.name} | La Fábrica | MFX`;
            document.getElementById("academy-player-name").textContent = player.name;

            const positionChip = document.getElementById("academy-position-chip");
            positionChip.textContent = `♦ ${player.position || latestAppearance?.position || "Jugadora"} ♦`;

            const dorsal = document.getElementById("academy-player-dorsal");
            if (latestAppearance?.number) {
                dorsal.textContent = latestAppearance.number;
                dorsal.hidden = false;
                dorsal.classList.toggle("is-single", String(latestAppearance.number).length === 1);
            } else {
                dorsal.hidden = true;
            }

            const statusChip = document.getElementById("academy-status-chip");
            if (player.firstTeamStatus === "permanent") {
                statusChip.textContent = "PRIMER EQUIPO";
                statusChip.hidden = false;
            } else if (player.firstTeamStatus === "debut") {
                statusChip.textContent = "DEBUT PRIMER EQUIPO";
                statusChip.hidden = false;
                statusChip.classList.add("academy-first-team-chip--debut");
            } else {
                statusChip.hidden = true;
            }

            const seasonPhotos = Object.entries(player.seasonPhotos || {})
                .map(([season, url]) => ({ season, url }))
                .filter((item) => item.url)
                .sort((a, b) => data.seasons.indexOf(a.season) - data.seasons.indexOf(b.season));

            if (!seasonPhotos.length && player.portraitUrl) {
                seasonPhotos.push({
                    season: latestAppearance?.season || "Actualidad",
                    url: player.portraitUrl,
                });
            }

            if (!seasonPhotos.length) {
                seasonPhotos.push({
                    season: latestAppearance?.season || "Actualidad",
                    url: PLACEHOLDER,
                });
            }

            let photoIndex = 0;
            const image = document.getElementById("academy-player-photo");
            const seasonBadge = document.getElementById("academy-photo-season");
            const prev = document.getElementById("academy-prev-photo");
            const next = document.getElementById("academy-next-photo");

            const renderPhoto = () => {
                const item = seasonPhotos[photoIndex];
                image.src = item.url || PLACEHOLDER;
                image.alt = `Foto de ${player.name} · ${item.season}`;
                seasonBadge.textContent = item.season;
            };

            image.onerror = () => {
                image.onerror = null;
                image.src = PLACEHOLDER;
            };

            if (seasonPhotos.length > 1) {
                prev.hidden = false;
                next.hidden = false;
                prev.onclick = () => {
                    photoIndex = (photoIndex - 1 + seasonPhotos.length) % seasonPhotos.length;
                    renderPhoto();
                };
                next.onclick = () => {
                    photoIndex = (photoIndex + 1) % seasonPhotos.length;
                    renderPhoto();
                };
            } else {
                prev.hidden = true;
                next.hidden = true;
            }

            renderPhoto();

            const bio = { ...biographies[slug], ...player };
            const match = String(bio.birthDate || "").match(/^(\d{4})[-/](\d{2})[-/](\d{2})$/);
            let birth = "No documentada", age = "No documentada";
            if (match) {
                const [, y, m, d] = match.map(Number);
                const date = new Date(Date.UTC(y, m - 1, d));
                const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(new Date());
                const parts = Object.fromEntries(today.map(({ type, value }) => [type, Number(value)]));
                const years = parts.year - y - Number(parts.month < m || (parts.month === m && parts.day < d));
                if (date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d && years >= 0) {
                    birth = `${String(d).padStart(2, "0")}/${String(m).padStart(2, "0")}/${y}`;
                    age = `${years} años`;
                }
            }
            const countryCode = String(bio.nationalityCode || "").toLowerCase();
            const flag = /^[a-z]{2}$/.test(countryCode)
                ? `<img class="flag-icon" src="https://flagcdn.com/w40/${countryCode}.png" alt="" width="20" height="20" loading="lazy" />` : "";
            document.getElementById("academy-player-biography").innerHTML = [
                ["Nombre completo", player.name], ["Fecha de nacimiento", birth], ["Edad", age],
                ["Lugar de nacimiento", bio.birthPlace || "No documentado"], ["Nacionalidad", bio.nationality || "No documentada"],
            ].map(([label, value]) => `<div class="info-row"><span class="info-label">${esc(label)}</span><span class="info-value"${label === "Nacionalidad" ? ' style="display:flex;align-items:center;gap:0.5rem;"' : ""}>${esc(value)}${label === "Nacionalidad" ? flag : ""}</span></div>`).join("");

            const ageChip = document.getElementById("academy-age-chip");
            ageChip.textContent = age;
            ageChip.hidden = age === "No documentada";
            const nationalityChip = document.getElementById("academy-nationality-chip");
            nationalityChip.innerHTML = `${flag.replace('class="flag-icon"', 'class="chip-flag"')}${esc(bio.nationality || "")}`;
            nationalityChip.hidden = !bio.nationality;

            const career = document.getElementById("academy-player-career");
            let careerRows = bio.trajectory || [];
            if (bio.officialTrajectory?.length) {
                let academy = false;
                careerRows = bio.officialTrajectory.flatMap((line) => {
                    if (/^Categorías inferiores del Real Madrid:?$/i.test(line)) {
                        academy = true;
                        return [];
                    }
                    const match = line.match(/^(.*?)\s*\((\d{4})\s*[-–]\s*(\d{4})?\s*\)$/);
                    const club = (match?.[1] || line).replace(/^[-–]\s*/, "");
                    return [{
                        club: academy && /^(Cadete|Juvenil|Real Madrid B)$/i.test(club) ? `Real Madrid · ${club}` : club,
                        startYear: match?.[2] || null, endYear: match?.[3] || null,
                    }];
                });
            }
            career.innerHTML = careerRows.length
                ? `<div class="trajectory-timeline">${[...careerRows].sort((a, b) => Number(b.startYear) - Number(a.startYear)).map((row) => `<div class="timeline-item"><div class="timeline-dot" aria-hidden="true"></div><div class="timeline-body">${row.startYear ? `<span class="timeline-years">${esc(row.startYear)} – ${esc(row.endYear || 'Act.')}</span>` : ""}<span class="timeline-club">${esc(row.club)}</span></div></div>`).join("")}</div>`
                : '<p class="no-data">Sin datos disponibles</p>';

            const trajectory = document.getElementById("academy-player-trajectory");
            trajectory.innerHTML = appearances.map((row) => `
                <article class="academy-trajectory-row">
                    <div class="academy-trajectory-season">${esc(row.season)}</div>
                    <div class="academy-trajectory-main">
                        <strong>${esc(row.team)}</strong>
                        <span>${esc(row.position || player.position || "Jugadora")}</span>
                    </div>
                    <div class="academy-trajectory-side">
                        ${row.number ? `<span class="meta-pill">Dorsal ${esc(row.number)}</span>` : ""}
                    </div>
                </article>
            `).join("");

            statusEl.hidden = true;
            heroEl.hidden = false;
            contentEl.hidden = false;
        } catch (error) {
            console.error("[LA FABRICA] Error cargando ficha:", error);
            statusEl.innerHTML = 'No se ha podido cargar la ficha. <button type="button" class="academy-retry-btn" id="academy-profile-retry">Reintentar</button>';
            document.getElementById("academy-profile-retry")?.addEventListener("click", loadProfile, { once: true });
        }
    };

    loadProfile();
})();
</script>

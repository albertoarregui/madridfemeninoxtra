---
import Layout from "../layouts/Layout.astro";
import { fetchGamesDirectly } from "../utils/partidos";

export const prerender = false;

const todayParts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
}).formatToParts(new Date());
const today = `${todayParts.find((p) => p.type === "year")!.value}-${todayParts.find((p) => p.type === "month")!.value}-${todayParts.find((p) => p.type === "day")!.value}`;

const matches = await fetchGamesDirectly();
const nextMatch = matches.find((match) =>
    !match.isPlayed &&
    match.fecha &&
    String(match.fecha).slice(0, 10) >= today &&
    match.club_local && match.club_visitante,
);
const playsToday = nextMatch && String(nextMatch.fecha).slice(0, 10) === today;
const tv = typeof nextMatch?.tv === "string" ? nextMatch.tv.trim() : nextMatch?.tv;
const hora = nextMatch?.hora ? String(nextMatch.hora).slice(0, 5) : null;
---

<Layout
    title="Dónde ver al Real Madrid Femenino hoy: horario, TV y próximo partido | MFX"
    description="Consulta dónde ver el próximo partido del Real Madrid Femenino: fecha, hora, televisión, rival, competición y estadio. Datos actualizados desde el calendario de MFX."
>
    <main class="watch-page">
        <header class="page-header-container">
            <h1 class="landing-title">Dónde ver al Real Madrid Femenino</h1>
            <p class="landing-subtitle">Horarios, canales y próximos partidos en un solo lugar</p>
        </header>

        <div class="watch-content">
            <p class="watch-intro">
                Consulta cuándo juega el Real Madrid Femenino y qué televisión figura para su próximo encuentro.
                La información procede del <a href="/calendario">calendario de partidos</a> y puede cambiar
                cuando se confirmen el horario o la emisión.
            </p>

            {nextMatch ? (
                <section class="match-panel" aria-labelledby="watch-match-title">
                    <div class="match-topline">
                        <p class="eyebrow">{playsToday ? "Partido de hoy" : "Próximo partido"}</p>
                        {nextMatch.competicion_nombre && <span class="competition-label">{nextMatch.competicion_nombre}</span>}
                    </div>
                    {!playsToday && <p class="today-note">Hoy no hay partido programado. El próximo encuentro es:</p>}
                    <h2 id="watch-match-title" class="sr-only">{nextMatch.club_local} contra {nextMatch.club_visitante}</h2>
                    <div class="match-up">
                        <div class="team">
                            <img src={nextMatch.local_shield_url} alt={`Escudo de ${nextMatch.club_local}`} width="82" height="82" />
                            <span class="team-name">{nextMatch.club_local}</span>
                        </div>
                        <div class="kickoff">
                            <span class="versus" aria-hidden="true">VS</span>
                            <strong>{hora ? `${hora} h` : "Hora por confirmar"}</strong>
                            <span>Hora peninsular española</span>
                        </div>
                        <div class="team">
                            <img src={nextMatch.visitante_shield_url} alt={`Escudo de ${nextMatch.club_visitante}`} width="82" height="82" />
                            <span class="team-name">{nextMatch.club_visitante}</span>
                        </div>
                    </div>
                    <dl class="match-details">
                        <div><dt>Fecha</dt><dd>{nextMatch.fecha_formateada}</dd></div>
                        <div><dt>Estadio</dt><dd>{nextMatch.estadio || "Pendiente de confirmación"}</dd></div>
                        <div class="tv-detail">
                            <dt>Televisión y plataformas</dt>
                            <dd>{tv || "Pendiente de confirmación"}</dd>
                        </div>
                    </dl>
                    <a class="match-link" href={`/partidos/${nextMatch.slug}`}>
                        Ver la ficha del partido <span aria-hidden="true">→</span>
                    </a>
                </section>
            ) : (
                <section class="match-panel" aria-labelledby="watch-match-title">
                    <h2 id="watch-match-title">Próximo partido pendiente</h2>
                    <p>No hay un próximo encuentro confirmado en el calendario. Consulta el <a href="/calendario">calendario completo</a> para conocer las próximas fechas.</p>
                </section>
            )}

            <section class="watch-help" aria-labelledby="watch-help-title">
                <h2 id="watch-help-title">¿Dónde consultar la emisión?</h2>
                <p>
                    Cuando la televisión esté confirmada, aparecerá arriba y en la ficha del encuentro.
                    Si figura «Pendiente de confirmación», todavía no tenemos un canal o plataforma registrado
                    para ese partido. Puedes consultar también los <a href="/partidos">resultados y fichas de partidos anteriores</a>.
                </p>
            </section>
        </div>
    </main>
</Layout>

<style>
    .watch-page { min-height: 100vh; padding-bottom: 5rem; }
    .watch-page .page-header-container { margin-bottom: 1.5rem; }
    .watch-page .landing-title { max-width: 100%; isolation: isolate; overflow-wrap: anywhere; }
    .watch-page .landing-title::before { top: 50%; bottom: auto; transform: translate(-50%, -50%); width: 100%; font-size: clamp(1rem, 3.3vw, 2.8rem); line-height: 1.1; letter-spacing: .04em; opacity: .08; z-index: -1; }
    .watch-page .landing-subtitle { text-transform: none; letter-spacing: .04em; font-size: clamp(.9rem, 2vw, 1.08rem); margin-bottom: 0; }
    .watch-content { max-width: 960px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem); color: var(--text-secondary); line-height: 1.7; }
    .watch-content a { color: var(--primary-color); text-underline-offset: .2em; }
    .watch-content a:hover { color: #f1cb79; }
    .watch-intro { max-width: 72ch; margin: 0 auto 2.25rem; text-align: center; }
    .match-panel { padding: clamp(1.25rem, 4vw, 2.5rem); background: linear-gradient(145deg, rgba(19, 30, 51, .96), rgba(7, 14, 28, .97)); border: 1px solid rgba(212, 168, 67, .38); border-radius: 22px; box-shadow: 0 18px 50px rgba(0, 0, 0, .28); }
    .match-topline { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .65rem 1rem; }
    .eyebrow { margin: 0; color: var(--primary-color); text-transform: uppercase; font-size: .8rem; font-weight: 700; letter-spacing: .15em; }
    .competition-label { padding: .35rem .75rem; border: 1px solid rgba(212, 168, 67, .3); border-radius: 999px; color: var(--primary-color); font-size: .8rem; font-weight: 700; }
    h2 { color: var(--text-primary); font-family: 'Cinzel', serif; line-height: 1.3; }
    .today-note { margin: 1rem 0 0; font-size: .9rem; }
    .match-up { display: grid; grid-template-columns: minmax(0, 1fr) minmax(110px, .65fr) minmax(0, 1fr); align-items: center; gap: 1rem; padding: 2rem 0; text-align: center; }
    .team { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: .9rem; }
    .team img { width: clamp(68px, 10vw, 96px); height: clamp(68px, 10vw, 96px); object-fit: contain; filter: drop-shadow(0 8px 14px rgba(0, 0, 0, .35)); }
    .team-name { color: var(--text-primary); font-family: 'Cinzel', serif; font-size: clamp(1rem, 2.5vw, 1.55rem); font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
    .kickoff { display: flex; flex-direction: column; align-items: center; gap: .25rem; line-height: 1.35; }
    .versus { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; margin-bottom: .4rem; border-radius: 50%; border: 1px solid rgba(212, 168, 67, .4); background: rgba(212, 168, 67, .1); color: var(--primary-color); font-family: 'Cinzel', serif; font-weight: 700; }
    .kickoff strong { font-size: clamp(1.1rem, 2.6vw, 1.5rem); color: var(--text-primary); }
    .kickoff > span:last-child { font-size: .75rem; color: var(--text-muted); }
    .match-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 0 0 1.5rem; }
    .match-details div { border-top: 1px solid rgba(255, 255, 255, .14); padding: .9rem .25rem 0; }
    .match-details dt { color: var(--primary-color); font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; }
    .match-details dd { margin: .3rem 0 0; color: var(--text-primary); font-weight: 500; overflow-wrap: anywhere; }
    .match-details .tv-detail { grid-column: 1 / -1; padding: 1rem 1.2rem; border: 1px solid rgba(212, 168, 67, .22); border-radius: 12px; background: rgba(212, 168, 67, .08); }
    .tv-detail dd { font-size: 1.2rem; font-weight: 700; }
    .match-link { display: inline-flex; gap: .5rem; align-items: center; font-weight: 700; }
    .watch-help { margin-top: 3rem; }
    .watch-help h2 { font-size: 1.35rem; }
    .watch-help p { max-width: 72ch; }
    @media (max-width: 600px) {
        .watch-page .landing-title::before { font-size: 4.5vw; letter-spacing: .01em; }
        .match-up { gap: .4rem; grid-template-columns: minmax(0, 1fr) minmax(85px, .8fr) minmax(0, 1fr); }
        .team { gap: .5rem; }
        .team img { width: 62px; height: 62px; }
        .team-name { font-size: .9rem; }
        .versus { width: 2.5rem; height: 2.5rem; }
        .kickoff > span:last-child { font-size: .65rem; }
    }
</style>

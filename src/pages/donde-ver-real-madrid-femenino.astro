---
import Layout from "../layouts/Layout.astro";
import { fetchGamesDirectly } from "../utils/partidos";
import ligaFLogo from "../assets/competiciones/liga_f.png";
import uwclLogo from "../assets/competiciones/uwcl.png";
import copaLogo from "../assets/competiciones/copa_de_la_reina.png";
import supercopaLogo from "../assets/competiciones/supercopa_de_espana.png";
import daznLogo from "../assets/tv/DAZN.png";
import teledeporteLogo from "../assets/tv/teledeporte.svg?url";
import rtveLogo from "../assets/tv/rtve.svg?url";
import disneyLogo from "../assets/tv/disney-plus.svg?url";
import espnLogo from "../assets/tv/espn.svg?url";

export const prerender = false;

const todayParts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
}).formatToParts(new Date());
const today = `${todayParts.find((p) => p.type === "year")!.value}-${todayParts.find((p) => p.type === "month")!.value}-${todayParts.find((p) => p.type === "day")!.value}`;

const matches = await fetchGamesDirectly();
const nextMatch = matches.find((match) =>
    !match.isPlayed &&
    match.fecha &&
    String(match.fecha).slice(0, 10) >= today &&
    match.club_local && match.club_visitante,
);
const playsToday = nextMatch && String(nextMatch.fecha).slice(0, 10) === today;
const tv = typeof nextMatch?.tv === "string" ? nextMatch.tv.trim() : nextMatch?.tv;
const hora = nextMatch?.hora ? String(nextMatch.hora).slice(0, 5) : null;
type Channel = { name: string; logo: string; dark: boolean };
const channels: Record<string, Channel> = {
    dazn: { name: "DAZN", logo: daznLogo.src, dark: true },
    teledeporte: { name: "Teledeporte", logo: teledeporteLogo, dark: false },
    rtve: { name: "RTVE", logo: rtveLogo, dark: false },
    disney: { name: "Disney+", logo: disneyLogo, dark: false },
    espn: { name: "ESPN", logo: espnLogo, dark: false },
};
const competitions = [
    { name: "Liga F", logo: ligaFLogo.src, channels: [channels.dazn, channels.teledeporte, channels.rtve] },
    { name: "UWCL", logo: uwclLogo.src, channels: [channels.disney, channels.espn] },
    { name: "Copa de la Reina", logo: copaLogo.src, channels: [channels.rtve] },
    { name: "Supercopa de España", logo: supercopaLogo.src, channels: [channels.rtve] },
];
const competitionLogo = competitions.find((competition) => competition.name === nextMatch?.competicion_nombre)?.logo
    || nextMatch?.competicion_foto_url;
const matchChannels = typeof tv === "string"
    ? tv.split("/").map((name) =>
        Object.values(channels).find((channel) => channel.name.toLowerCase().replace(/\s/g, "") === name.trim().toLowerCase().replace(/\s/g, "")),
    ).filter((channel) => channel !== undefined)
    : [];
---

<Layout
    title="Dónde ver al Real Madrid Femenino hoy: horario, TV y próximo partido | MFX"
    description="Consulta dónde ver el próximo partido del Real Madrid Femenino: fecha, hora, televisión, rival, competición y estadio. Datos actualizados desde el calendario de MFX."
    showMatchCountdown={false}
>
    <main class="watch-page">
        <header class="page-header-container">
            <h1 class="landing-title">Dónde ver al Real Madrid Femenino</h1>
            <p class="landing-subtitle">Horarios, canales y próximos partidos en un solo lugar</p>
        </header>

        <div class="watch-content">
            <p class="watch-intro">
                Consulta cuándo juega el Real Madrid Femenino y qué televisión figura para su próximo encuentro.
                La información procede del <a href="/calendario">calendario de partidos</a> y puede cambiar
                cuando se confirmen el horario o la emisión.
            </p>

            {nextMatch ? (
                <section class="match-panel" aria-labelledby="watch-match-title">
                    <div class="match-topline">
                        <p class="eyebrow">{playsToday ? "Partido de hoy" : "Próximo partido"}</p>
                        {nextMatch.competicion_nombre && <span class="competition-label">
                            {competitionLogo && <img src={competitionLogo} alt="" width="34" height="34" />}
                            {nextMatch.competicion_nombre}
                        </span>}
                    </div>
                    {!playsToday && <p class="today-note">Hoy no hay partido programado. El próximo encuentro es:</p>}
                    <h2 id="watch-match-title" class="sr-only">{nextMatch.club_local} contra {nextMatch.club_visitante}</h2>
                    <div class="match-up">
                        <div class="team">
                            <img src={nextMatch.local_shield_url} alt={`Escudo de ${nextMatch.club_local}`} width="82" height="82" />
                            <span class="team-name">{nextMatch.club_local}</span>
                        </div>
                        <div class="kickoff">
                            <span class="versus" aria-hidden="true">VS</span>
                            <strong>{hora ? `${hora} h` : "Hora por confirmar"}</strong>
                            <span>Hora peninsular española</span>
                        </div>
                        <div class="team">
                            <img src={nextMatch.visitante_shield_url} alt={`Escudo de ${nextMatch.club_visitante}`} width="82" height="82" />
                            <span class="team-name">{nextMatch.club_visitante}</span>
                        </div>
                    </div>
                    <dl class="match-details">
                        <div><dt>Fecha</dt><dd>{nextMatch.fecha_formateada}</dd></div>
                        <div><dt>Estadio</dt><dd>{nextMatch.estadio || "Pendiente de confirmación"}</dd></div>
                        <div class="tv-detail">
                            <dt>Televisión y plataformas</dt>
                            <dd>
                                {tv || "Pendiente de confirmación"}
                                {matchChannels.length > 0 && <span class="match-channel-logos" aria-hidden="true">
                                    {matchChannels.map((channel) => <span class:list={["brand-logo", { "brand-logo--dark": channel.dark }]}>
                                        <img src={channel.logo} alt="" loading="lazy" />
                                    </span>)}
                                </span>}
                            </dd>
                        </div>
                    </dl>
                    <a class="match-link" href={`/partidos/${nextMatch.slug}`}>
                        Ver la ficha del partido <span aria-hidden="true">→</span>
                    </a>
                </section>
            ) : (
                <section class="match-panel" aria-labelledby="watch-match-title">
                    <h2 id="watch-match-title">Próximo partido pendiente</h2>
                    <p>No hay un próximo encuentro confirmado en el calendario. Consulta el <a href="/calendario">calendario completo</a> para conocer las próximas fechas.</p>
                </section>
            )}

            <section class="channels-section" aria-labelledby="channels-title">
                <h2 id="channels-title">CANALES</h2>
                <p class="channels-intro">Dónde ver al Real Madrid Femenino según la competición. La emisión concreta de cada encuentro puede variar: consulta la televisión confirmada arriba o en la <a href={nextMatch ? `/partidos/${nextMatch.slug}` : "/calendario"}>ficha del partido</a>.</p>
                <div class="channels-grid">
                    {competitions.map((competition) => <article class="channel-card">
                        <div class="channel-competition">
                            <img src={competition.logo} alt="" width="48" height="48" loading="lazy" />
                            <h3>{competition.name}</h3>
                        </div>
                        <ul class="channel-list">
                            {competition.channels.map((channel) => <li>
                                <span class:list={["brand-logo", { "brand-logo--dark": channel.dark }]}>
                                    <img src={channel.logo} alt="" loading="lazy" />
                                </span>
                                <span>{channel.name}</span>
                            </li>)}
                        </ul>
                    </article>)}
                </div>
            </section>
        </div>
    </main>
</Layout>

<style>
    .watch-page { min-height: 100vh; padding-bottom: 5rem; }
    .watch-page .page-header-container { margin-bottom: 1.5rem; }
    .watch-page .landing-title { max-width: 100%; overflow-wrap: anywhere; }
    .watch-page .landing-subtitle { text-transform: none; letter-spacing: .04em; font-size: clamp(.9rem, 2vw, 1.08rem); margin-bottom: 0; }
    .watch-content { max-width: 960px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem); color: var(--text-secondary); line-height: 1.7; }
    .watch-content a { color: var(--primary-color); text-underline-offset: .2em; }
    .watch-content a:hover { color: #f1cb79; }
    .watch-intro { max-width: 72ch; margin: 0 auto 2.25rem; text-align: center; }
    .match-panel { padding: clamp(1.25rem, 4vw, 2.5rem); background: linear-gradient(145deg, rgba(19, 30, 51, .96), rgba(7, 14, 28, .97)); border: 1px solid rgba(212, 168, 67, .38); border-radius: 22px; box-shadow: 0 18px 50px rgba(0, 0, 0, .28); }
    .match-topline { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .65rem 1rem; }
    .eyebrow { margin: 0; color: var(--primary-color); text-transform: uppercase; font-family: 'Cinzel', serif; font-size: clamp(1.05rem, 2.5vw, 1.45rem); font-weight: 700; letter-spacing: .1em; }
    .competition-label { display: inline-flex; align-items: center; gap: .5rem; padding: .25rem .7rem .25rem .3rem; border: 1px solid rgba(212, 168, 67, .3); border-radius: 999px; color: var(--primary-color); font-size: .85rem; font-weight: 700; }
    .competition-label img { width: 34px; height: 34px; object-fit: contain; }
    h2 { color: var(--text-primary); font-family: 'Cinzel', serif; line-height: 1.3; }
    .today-note { margin: 1rem 0 0; font-size: .9rem; }
    .match-up { display: grid; grid-template-columns: minmax(0, 1fr) minmax(110px, .65fr) minmax(0, 1fr); align-items: center; gap: 1rem; padding: 2rem 0; text-align: center; }
    .team { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: .9rem; }
    .team img { width: clamp(68px, 10vw, 96px); height: clamp(68px, 10vw, 96px); object-fit: contain; filter: drop-shadow(0 8px 14px rgba(0, 0, 0, .35)); }
    .team-name { color: var(--text-primary); font-family: 'Cinzel', serif; font-size: clamp(1rem, 2.5vw, 1.55rem); font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
    .kickoff { display: flex; flex-direction: column; align-items: center; gap: .25rem; line-height: 1.35; }
    .versus { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; margin-bottom: .4rem; border-radius: 50%; border: 1px solid rgba(212, 168, 67, .4); background: rgba(212, 168, 67, .1); color: var(--primary-color); font-family: 'Cinzel', serif; font-weight: 700; }
    .kickoff strong { font-size: clamp(1.1rem, 2.6vw, 1.5rem); color: var(--text-primary); }
    .kickoff > span:last-child { font-size: .75rem; color: var(--text-muted); }
    .match-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 0 0 1.5rem; }
    .match-details div { border-top: 1px solid rgba(255, 255, 255, .14); padding: .9rem .25rem 0; text-align: center; }
    .match-details dt { color: var(--primary-color); font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; }
    .match-details dd { margin: .3rem 0 0; color: var(--text-primary); font-weight: 500; overflow-wrap: anywhere; }
    .match-details .tv-detail { grid-column: 1 / -1; padding: 1rem 1.2rem; border: 1px solid rgba(212, 168, 67, .22); border-radius: 12px; background: rgba(212, 168, 67, .08); }
    .tv-detail dd { font-size: 1.3rem; font-weight: 700; }
    .match-channel-logos { display: flex; justify-content: center; flex-wrap: wrap; gap: .65rem; margin-top: 1rem; }
    .match-link { display: inline-flex; gap: .5rem; align-items: center; font-weight: 700; }
    .channels-section { margin-top: clamp(3rem, 7vw, 5rem); }
    .channels-section h2 { margin: 0 0 .7rem; text-align: center; color: var(--primary-color); font-size: clamp(1.7rem, 4vw, 2.5rem); text-transform: uppercase; letter-spacing: .1em; }
    .channels-intro { max-width: 72ch; margin: 0 auto 2rem; text-align: center; }
    .channels-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .channel-card { min-width: 0; padding: clamp(1.2rem, 3vw, 1.8rem); border: 1px solid rgba(212, 168, 67, .25); border-radius: 18px; background: rgba(10, 20, 40, .84); }
    .channel-competition { display: flex; align-items: center; justify-content: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255, 255, 255, .12); text-align: center; }
    .channel-competition img { width: 48px; height: 48px; flex: 0 0 48px; object-fit: contain; }
    .channel-competition h3 { margin: 0; color: var(--text-primary); font-family: 'Cinzel', serif; font-size: clamp(1rem, 2.5vw, 1.25rem); }
    .channel-list { display: flex; justify-content: center; flex-wrap: wrap; gap: .85rem 1rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
    .channel-list li { display: flex; align-items: center; gap: .5rem; color: var(--text-primary); font-size: .88rem; font-weight: 700; }
    .brand-logo { display: grid; place-items: center; width: 64px; height: 46px; padding: .35rem; flex: 0 0 64px; border-radius: 9px; background: #f5f6f8; }
    .brand-logo--dark { background: #0a0e18; border: 1px solid rgba(255, 255, 255, .22); }
    .brand-logo img { width: 100%; height: 100%; object-fit: contain; }
    @media (max-width: 600px) {
        .watch-intro { text-align: left; }
        .match-up { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem .5rem; padding: 1.75rem 0; }
        .match-up .team:first-child { grid-column: 1; grid-row: 1; }
        .match-up .team:last-child { grid-column: 2; grid-row: 1; }
        .kickoff { grid-column: 1 / -1; grid-row: 2; }
        .team { gap: .5rem; }
        .team img { width: 70px; height: 70px; }
        .team-name { font-size: clamp(.85rem, 3.5vw, 1.1rem); }
        .versus { width: 2.5rem; height: 2.5rem; }
        .match-details { grid-template-columns: 1fr; gap: .65rem; }
        .match-details .tv-detail { grid-column: 1; }
        .channels-grid { grid-template-columns: 1fr; }
        .channels-intro { text-align: left; }
        .channel-list { gap: .7rem; }
    }
</style>

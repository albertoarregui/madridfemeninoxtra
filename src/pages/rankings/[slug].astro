---
// Los rankings sueltos se integraron en /rankings: cada antigua URL redirige
// a la misma estadística dentro de la página única.
const STAT: Record<string, string> = {"maximas-goleadoras": "goles", "maximas-asistentes": "asistencias", "mas-partidos": "partidos", "mas-minutos": "minutos", "mas-capitanias": "capitanias", "porterias-a-cero": "porterias_cero"};
const stat = STAT[String(Astro.params.slug || "")];
return Astro.redirect(stat ? `/rankings?estadistica=${stat}` : "/rankings", 301);
---

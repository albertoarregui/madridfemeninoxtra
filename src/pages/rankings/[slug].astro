---
import Layout from "../../layouts/Layout.astro";
import { fetchRankingsDirectly } from "../../utils/rankings";
import { fetchPlayersDirectly, getPlayerImageUrl } from "../../utils/players";
import { breadcrumbSchema } from "../../utils/seo";
import "../../styles/global.css";

type RankingConfig = {
    key: string;
    title: string;
    h1: string;
    description: string;
    label: string;
    keep?: (row: any) => boolean;
};

const CONFIG: Record<string, RankingConfig> = {
    "maximas-goleadoras": {
        key: "goles",
        title: "Máximas goleadoras históricas del Real Madrid Femenino | MFX",
        h1: "Máximas goleadoras del Real Madrid Femenino",
        description: "Ranking histórico de máximas goleadoras del Real Madrid Femenino en partidos oficiales.",
        label: "goles",
    },
    "maximas-asistentes": {
        key: "asistencias",
        title: "Máximas asistentes históricas del Real Madrid Femenino | MFX",
        h1: "Máximas asistentes del Real Madrid Femenino",
        description: "Ranking histórico de jugadoras con más asistencias del Real Madrid Femenino en partidos oficiales.",
        label: "asistencias",
    },
    "mas-partidos": {
        key: "partidos",
        title: "Jugadoras con más partidos en el Real Madrid Femenino | MFX",
        h1: "Jugadoras con más partidos en el Real Madrid Femenino",
        description: "Ranking histórico de apariciones con el Real Madrid Femenino en partidos oficiales.",
        label: "partidos",
    },
    "mas-minutos": {
        key: "minutos",
        title: "Jugadoras con más minutos en el Real Madrid Femenino | MFX",
        h1: "Jugadoras con más minutos en el Real Madrid Femenino",
        description: "Ranking histórico de minutos jugados con el Real Madrid Femenino en partidos oficiales.",
        label: "minutos",
    },
    "mas-capitanias": {
        key: "capitanias",
        title: "Jugadoras con más capitanías en el Real Madrid Femenino | MFX",
        h1: "Jugadoras con más capitanías en el Real Madrid Femenino",
        description: "Ranking histórico de capitanías del Real Madrid Femenino en partidos oficiales.",
        label: "capitanías",
    },
    "porterias-a-cero": {
        key: "porterias_cero",
        title: "Porteras con más porterías a cero del Real Madrid Femenino | MFX",
        h1: "Porteras con más porterías a cero del Real Madrid Femenino",
        description: "Ranking histórico de porteras del Real Madrid Femenino con más partidos sin encajar en competiciones oficiales.",
        label: "porterías a cero",
        keep: (row: any) => /porter/i.test(String(row.posicion || "")),
    },
};

const { slug } = Astro.params;
const config = CONFIG[String(slug || "")];
if (!config) return Astro.redirect("/404");

const OFFICIAL = new Set([
    "Liga F",
    "Primera Iberdrola",
    "UWCL",
    "Copa de la Reina",
    "Supercopa de España",
]);

const [rankingRows, allPlayers] = await Promise.all([
    fetchRankingsDirectly(),
    fetchPlayersDirectly(),
]);

const playerById = new Map(
    allPlayers.map((player: any) => [String(player.id_jugadora), player]),
);

const getRankingPlayerImage = (id: string, name: string): string => {
    const player = playerById.get(String(id));
    if (!player) return getPlayerImageUrl({ nombre: name, foto_perfil_url: undefined });

    const seasons = Object.keys(player.season_photos || {}).sort().reverse();
    for (const season of seasons) {
        const photo = player.season_photos?.[season];
        if (photo) {
            return getPlayerImageUrl({ ...player, foto_url: photo, foto_perfil_url: undefined });
        }
    }

    return getPlayerImageUrl({
        ...player,
        foto_url: player.foto_url || player.nombre,
        foto_perfil_url: undefined,
    });
};

const rows = rankingRows.filter(
    (row: any) => OFFICIAL.has(row.competicion) && (!config.keep || config.keep(row)),
);

const grouped = new Map<string, any>();
for (const row of rows) {
    const id = String(row.id_jugadora || row.slug || row.nombre);
    const previous = grouped.get(id) || {
        nombre: row.nombre,
        slug: row.slug,
        posicion: row.posicion,
        imageUrl: getRankingPlayerImage(id, row.nombre),
        value: 0,
    };
    previous.value += Number((row as any)[config.key] || 0);
    grouped.set(id, previous);
}

const ranking = [...grouped.values()]
    .filter((row) => row.value > 0)
    .sort((a, b) => b.value - a.value || a.nombre.localeCompare(b.nombre, "es"));

const itemList = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: config.h1,
    itemListElement: ranking.slice(0, 50).map((row, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `https://www.madridfemeninoxtra.com/jugadoras/${row.slug}`,
        name: row.nombre,
    })),
};

const nav = Object.entries(CONFIG).map(([key, value]) => ({
    href: `/rankings/${key}`,
    label: value.h1
        .replace(" del Real Madrid Femenino", "")
        .replace("Jugadoras con ", "")
        .replace("Porteras con ", ""),
}));
---

<Layout title={config.title} description={config.description}>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "Rankings", path: "/rankings" },
                { name: config.h1, path: `/rankings/${slug}` },
            ]),
        )}
    />

    <main class="ranking-page max-w-5xl mx-auto px-6 py-12">
        <header class="page-header-container">
            <h1 class="landing-title">{config.h1}</h1>
            <p class="landing-subtitle">Datos acumulados de partidos oficiales desde la creación del Real Madrid Femenino</p>
        </header>

        <nav class="rank-nav" aria-label="Otros rankings históricos">
            {nav.map((item) => (
                <a class={item.href.endsWith(String(slug)) ? "active" : ""} href={item.href}>{item.label}</a>
            ))}
        </nav>

        <section class="rank-grid" aria-label={config.h1}>
            {ranking.map((row: any, index: number) => (
                <a class="rank-card" href={`/jugadoras/${row.slug}`}>
                    <div class="rank-card-header">
                        <span class="rank-card-title">POSICIÓN</span>
                        <span class="rank-pos">{index + 1}</span>
                    </div>
                    <div class="rank-card-body">
                        <div class="rank-player">
                            <span class="rank-avatar" aria-hidden="true">
                                <img src={row.imageUrl} alt="" width="64" height="64" loading="lazy" decoding="async" />
                            </span>
                            <span class="rank-name">
                                <strong>{row.nombre}</strong>
                                <small>{row.posicion || "Jugadora"}</small>
                            </span>
                        </div>
                        <span class="rank-value">
                            {Number(row.value).toLocaleString("es-ES")}
                            <small>{config.label}</small>
                        </span>
                    </div>
                </a>
            ))}
        </section>

        <p class="rank-note">
            Consulta todos los filtros por temporada y competición en <a href="/rankings">Estadísticas y rankings</a>,
            o navega por <a href="/temporadas">todas las temporadas</a>.
        </p>
    </main>
</Layout>

<style>
    .rank-nav {
        display: flex;
        gap: 0.55rem;
        flex-wrap: wrap;
        justify-content: center;
        margin: 0 0 2rem;
    }
    .rank-nav a {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(212, 168, 67, 0.18);
        border-radius: 4px;
        background: rgba(8, 16, 34, 0.85);
        padding: 0.6rem 0.8rem;
        color: #b9b9c0;
        text-decoration: none;
        font: 600 0.72rem "DM Sans", sans-serif;
        transition: 0.18s ease;
    }
    .rank-nav a::before,
    .rank-nav a::after {
        content: "";
        position: absolute;
        width: 8px;
        height: 8px;
        pointer-events: none;
    }
    .rank-nav a::before {
        top: 0; left: 0;
        border-top: 1px solid rgba(212, 168, 67, 0.45);
        border-left: 1px solid rgba(212, 168, 67, 0.45);
    }
    .rank-nav a::after {
        right: 0; bottom: 0;
        border-right: 1px solid rgba(212, 168, 67, 0.45);
        border-bottom: 1px solid rgba(212, 168, 67, 0.45);
    }
    .rank-nav a:hover,
    .rank-nav a.active {
        color: #d4a843;
        border-color: rgba(212, 168, 67, 0.5);
        background: rgba(10, 20, 42, 0.92);
    }
    .rank-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.8rem;
    }
    .rank-card {
        display: block;
        position: relative;
        overflow: hidden;
        background: rgba(8, 16, 34, 0.85);
        border: 1px solid rgba(212, 168, 67, 0.18);
        border-radius: 4px;
        color: #eee;
        text-decoration: none;
        transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }
    .rank-card::before,
    .rank-card::after {
        content: "";
        position: absolute;
        width: 12px;
        height: 12px;
        pointer-events: none;
        z-index: 2;
    }
    .rank-card::before {
        top: 0; left: 0;
        border-top: 1px solid rgba(212, 168, 67, 0.5);
        border-left: 1px solid rgba(212, 168, 67, 0.5);
    }
    .rank-card::after {
        right: 0; bottom: 0;
        border-right: 1px solid rgba(212, 168, 67, 0.5);
        border-bottom: 1px solid rgba(212, 168, 67, 0.5);
    }
    .rank-card:hover {
        transform: translateY(-2px);
        border-color: rgba(212, 168, 67, 0.42);
        background: rgba(10, 20, 42, 0.92);
    }
    .rank-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.82rem 1.2rem;
        border-bottom: 1px solid rgba(212, 168, 67, 0.12);
        background: rgba(212, 168, 67, 0.03);
    }
    .rank-card-title {
        font-family: "Cinzel", serif;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        color: rgba(212, 168, 67, 0.75);
        text-transform: uppercase;
    }
    .rank-pos {
        font: 700 1.05rem "Cinzel", serif;
        color: #d4a843;
        line-height: 1;
    }
    .rank-card-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 1.25rem;
        padding: 1rem 1.2rem;
    }
    .rank-player {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-width: 0;
    }
    .rank-avatar {
        width: 64px;
        height: 64px;
        flex: 0 0 64px;
        overflow: hidden;
        border-radius: 50%;
        border: 1px solid rgba(212, 168, 67, 0.42);
        background: rgba(212, 168, 67, 0.06);
        box-shadow: inset 0 0 0 2px rgba(6, 13, 28, 0.75);
    }
    .rank-avatar img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center 18%;
    }
    .rank-name {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }
    .rank-name strong {
        font-family: "Cinzel", serif;
        font-size: 0.98rem;
        line-height: 1.25;
        overflow-wrap: anywhere;
    }
    .rank-name small,
    .rank-value small {
        color: #8f8f99;
        font: 0.68rem "DM Sans", sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .rank-value {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        font: 700 1.2rem "DM Sans", sans-serif;
        color: #d4a843;
        white-space: nowrap;
    }
    .rank-note {
        color: #aaa;
        margin: 1.5rem 0 0;
        font: 0.85rem "DM Sans", sans-serif;
    }
    .rank-note a { color: #d4a843; }
    @media (max-width: 520px) {
        .ranking-page { padding-left: 1rem; padding-right: 1rem; }
        .rank-card-header { padding: 0.72rem 0.9rem; }
        .rank-card-body { gap: 0.7rem; padding: 0.85rem 0.9rem; }
        .rank-player { gap: 0.7rem; }
        .rank-avatar { width: 52px; height: 52px; flex-basis: 52px; }
        .rank-name strong { font-size: 0.86rem; }
        .rank-name small,
        .rank-value small { font-size: 0.58rem; }
        .rank-value { font-size: 1rem; }
    }
</style>

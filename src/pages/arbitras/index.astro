---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { fetchRefereesDirectly } from "../../utils/arbitras";
import RefereesTable from "../../components/RefereesTable";

const referees = await fetchRefereesDirectly();
---

<Layout
    title="Árbitras del Real Madrid Femenino: historial y estadísticas | MFX"
    description="Historial de árbitras del Real Madrid Femenino: partidos dirigidos, balance de resultados, tarjetas, penaltis y estadísticas."
>
    <main class="max-w-[1700px] mx-auto px-6 md:px-0">
        <header class="page-header-container">
            <h1 class="landing-title" data-title="ÁRBITRAS">Árbitras del Real Madrid Femenino</h1>
            <p class="landing-subtitle">Todas las árbitras que han dirigido partidos del Real Madrid Femenino a lo largo de su historia</p>
        </header>

        <RefereesTable client:load referees={referees} />
    </main>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";
import "../../styles/global.css";
import {
    fetchRefereesDirectly,
    fetchMatchesByReferee,
} from "../../utils/arbitras";
import { generateSlug } from "../../utils/url-helper";

import { getAssetUrl } from "../../utils/assets";
import { getFlagSrc } from "../../utils/flags";
import { competitionDisplayName } from "../../utils/competiciones";

const competitionLogos: Record<string, string> = {
    "Liga F": getAssetUrl("competiciones", "liga_f.png"),
    "Primera Iberdrola": getAssetUrl("competiciones", "primera_iberdrola.png"),
    UWCL: getAssetUrl("competiciones", "uwcl.png"),
    "Copa de la Reina": getAssetUrl("competiciones", "copa_de_la_reina.png"),
    "Supercopa de España": getAssetUrl(
        "competiciones",
        "supercopa_de_espana.png",
    ),
};

const { slug } = Astro.params;
const referees = await fetchRefereesDirectly();
const referee = referees.find((r) => generateSlug(r.nombre) === slug);

if (!referee) {
    return Astro.redirect("/404");
}

const rawMatches = await fetchMatchesByReferee(referee.nombre);

const matches = rawMatches.map((m) => {
    const isLocal =
        m.club_local.toLowerCase().trim().includes("real madrid") ||
        m.club_local.toLowerCase().trim() === "real madrid cf";

    const d = new Date(m.fecha);
    const year = d.getFullYear();
    const month = d.getMonth() + 1;
    const startYear = month >= 8 ? year : year - 1;
    const endYear = startYear + 1;
    const season = `${startYear}/${endYear.toString().slice(-2)}`;

    return {
        ...m,
        esLocal: isLocal,
        golesRM: parseInt(m.goles_rm) || 0,
        golesRival: parseInt(m.goles_rival) || 0,
        yellowCards: parseInt(m.amarillas) || 0,
        redCards: parseInt(m.rojas) || 0,
        penaltiesFor: parseInt(m.penalties_for) || 0,
        penaltiesAgainst: parseInt(m.penalties_against) || 0,
        yellowCardsAgainst: parseInt(m.yellow_cards_against) || 0,
        redCardsAgainst: parseInt(m.red_cards_against) || 0,
        foulsCommitted: parseInt(m.faltas_cometidas) || 0,
        foulsReceived: parseInt(m.faltas_recibidas) || 0,
        season,
        resultado: (() => {
            const rm = parseInt(m.goles_rm) || 0;
            const rival = parseInt(m.goles_rival) || 0;
            if (rm > rival) return "V";
            if (rm < rival) return "D";
            if (m.penaltis === 1 || m.penaltis === "1") return "V";
            if (m.penaltis === 0 || m.penaltis === "0") return "D";
            return "E";
        })(),
        cleanSheet: (parseInt(m.goles_rival) || 0) === 0,
        conceded: (parseInt(m.goles_rival) || 0) > 0,
    };
});

interface StatBlock {
    pj: number;
    pg: number;
    pe: number;
    pp: number;
    ta: number;
    tr: number;
    pf: number;
    pc: number;
    ta_c: number;
    tr_c: number;
    fc: number;
    fr: number;
}

const initialStatBlock = (): StatBlock => ({
    pj: 0,
    pg: 0,
    pe: 0,
    pp: 0,
    ta: 0,
    tr: 0,
    pf: 0,
    pc: 0,
    ta_c: 0,
    tr_c: 0,
    fc: 0,
    fr: 0,
});

const calculateBlock = (block: StatBlock, m: any) => {
    block.pj++;
    block.ta += m.yellowCards;
    block.tr += m.redCards;
    block.pf += m.penaltiesFor;
    block.pc += m.penaltiesAgainst;
    block.ta_c += m.yellowCardsAgainst;
    block.tr_c += m.redCardsAgainst;
    block.fc += m.foulsCommitted;
    block.fr += m.foulsReceived;

    if (m.resultado === "V") block.pg++;
    else if (m.resultado === "E") block.pe++;
    else block.pp++;
};

const seasonsMap = new Map<string, any>();

matches.forEach((m) => {
    if (!seasonsMap.has(m.season)) {
        seasonsMap.set(m.season, {
            temporada: m.season,
            total: initialStatBlock(),
            competiciones: new Map<string, any>(),
        });
    }
    const seasonData = seasonsMap.get(m.season);
    calculateBlock(seasonData.total, m);

    if (!seasonData.competiciones.has(m.competicion)) {
        seasonData.competiciones.set(m.competicion, {
            competicion: m.competicion,
            ...initialStatBlock(),
        });
    }
    calculateBlock(seasonData.competiciones.get(m.competicion), m);
});

const refereeDeepStats = Array.from(seasonsMap.values())
    .map((s) => ({
        ...s,
        competiciones: Array.from(s.competiciones.values()),
    }))
    .sort((a, b) => (a.temporada < b.temporada ? 1 : -1));

const totalStats = initialStatBlock();
matches.forEach((m) => calculateBlock(totalStats, m));

const uniqueSeasons = [...new Set(matches.map((m) => m.season))]
    .sort()
    .reverse();
const esAmistoso = (comp: string) => /amistoso|friendly/i.test(comp || "");
const hayAmistosos = matches.some((m) => esAmistoso(m.competicion));

const uniqueCompetitions = [
    ...new Set(matches.map((m) => m.competicion)),
]
    .filter((c) => !esAmistoso(c))
    .sort();

const circumference = 220;
const totalMatches = totalStats.pj;
const winsArc =
    totalMatches > 0
        ? Math.round((totalStats.pg / totalMatches) * circumference)
        : 0;
const drawsArc =
    totalMatches > 0
        ? Math.round((totalStats.pe / totalMatches) * circumference)
        : 0;
const lossesArc =
    totalMatches > 0
        ? Math.round((totalStats.pp / totalMatches) * circumference)
        : 0;

const totalCards = totalStats.ta + totalStats.tr;
const yellowArc =
    totalCards > 0
        ? Math.round((totalStats.ta / totalCards) * circumference)
        : 0;
const redArc =
    totalCards > 0
        ? Math.round((totalStats.tr / totalCards) * circumference)
        : 0;

const totalCardsFavor = totalStats.ta_c + totalStats.tr_c;
const yellowArcFavor =
    totalCardsFavor > 0
        ? Math.round((totalStats.ta_c / totalCardsFavor) * circumference)
        : 0;
const redArcFavor =
    totalCardsFavor > 0
        ? Math.round((totalStats.tr_c / totalCardsFavor) * circumference)
        : 0;

const bioParts: string[] = [];
if (totalStats.pj) {
    let s1 = `${referee.nombre} es una de las colegiadas que ha arbitrado al Real Madrid Femenino`;
    s1 += referee.colegio ? `, perteneciente al colegio arbitral de ${referee.colegio}.` : ".";
    s1 += referee.pais_origen
        ? ` Procedente de ${referee.pais_origen}, ha dirigido ${totalStats.pj} de los partidos del equipo`
        : ` Ha dirigido ${totalStats.pj} de los partidos del equipo`;
    s1 += `, con un balance para el conjunto blanco de ${totalStats.pg} victorias, ${totalStats.pe} empates y ${totalStats.pp} derrotas.`;
    bioParts.push(s1);
    if (totalStats.ta || totalStats.tr) {
        bioParts.push(`En esos choques, las madridistas vieron ${totalStats.ta} tarjetas amarillas y ${totalStats.tr} rojas con ella como árbitra.`);
    }
} else {
    bioParts.push(`Aquí encontrarás el historial completo de arbitraje de ${referee.nombre}${referee.colegio ? `, del colegio arbitral de ${referee.colegio},` : ""} en los partidos del Real Madrid Femenino.`);
}
const bio = bioParts.join(" ");

const refereeSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: referee.nombre,
    jobTitle: "Árbitra de Fútbol",
    ...(referee.foto_url ? { image: referee.foto_url.startsWith("http") ? referee.foto_url : `https://media.madridfemeninoxtra.com${referee.foto_url}` } : {}),
    ...(referee.pais_origen ? { nationality: referee.pais_origen } : {}),
    ...(referee.colegio ? { memberOf: { "@type": "Organization", name: referee.colegio } } : {}),
    description: bio,
};

const seoTitle = `${referee.nombre}, árbitra: historial con el Real Madrid Femenino | Madrid Femenino Xtra`;
const seoDescription = totalStats.pj
    ? `Historial de ${referee.nombre} como árbitra del Real Madrid Femenino: ${totalStats.pj} partidos, ${totalStats.pg} victorias, ${totalStats.pe} empates y ${totalStats.pp} derrotas. Tarjetas y estadísticas.`
    : `Historial de arbitraje de ${referee.nombre} con el Real Madrid Femenino.`;
---

<Layout title={seoTitle} description={seoDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(refereeSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ name: "Inicio", path: "/home" }, { name: "Árbitras", path: "/arbitras" }, { name: referee.nombre, path: `/arbitras/${slug}` }]))} />
    <section class="referee-hero">
        <div class="hero-bg-glow" aria-hidden="true"></div>

        <a href="/arbitras" class="hero-back-link">← VOLVER A ÁRBITRAS</a>

        <div class="hero-inner">
            <div class="hero-photo-col">
                <div class="hero-photo-frame">
                    {referee.foto_url ? (
                        <img
                            src={referee.foto_url.startsWith("http") ? referee.foto_url : `https://media.madridfemeninoxtra.com${referee.foto_url}`}
                            alt={`Foto de ${referee.nombre}`}
                            class="hero-player-photo"
                            loading="eager"
                            decoding="async"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        />
                    ) : null}
                    <div class="hero-photo-placeholder" style={referee.foto_url ? "display:none" : ""}>
                        <div class="placeholder-initials">
                            {referee.nombre.split(" ").slice(0,2).map((w: string) => w[0]).join("")}
                        </div>
                        <div class="placeholder-role">Árbitra</div>
                    </div>
                    <div class="photo-frame-corner tl"></div>
                    <div class="photo-frame-corner tr"></div>
                    <div class="photo-frame-corner bl"></div>
                    <div class="photo-frame-corner br"></div>
                </div>
            </div>

            <div class="hero-info-col">
                <div class="hero-chips">
                    <span class="hero-chip hero-chip-gold">♦ Árbitra ♦</span>
                    {referee.iso && (
                        <span class="hero-chip">
                            <img src={getFlagSrc(referee.iso)} alt={referee.iso} class="chip-flag" width="16" height="16" loading="lazy" />
                            {referee.pais_origen || referee.iso}
                        </span>
                    )}
                    {referee.colegio && (
                        <span class="hero-chip">{referee.colegio}</span>
                    )}
                </div>

                <h1 class="hero-player-name">{referee.nombre}</h1>

                <div class="hero-quick-stats">
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.pj}</span>
                        <span class="qs-label">Partidos</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.pg}</span>
                        <span class="qs-label">Victorias</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.pe}</span>
                        <span class="qs-label">Empates</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.pp}</span>
                        <span class="qs-label">Derrotas</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number" style="color:rgba(212,168,67,0.9)">{totalStats.ta}</span>
                        <span class="qs-label">Tarjetas Amarillas</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number" style="color:rgba(248,113,113,0.9)">{totalStats.tr}</span>
                        <span class="qs-label">Tarjetas Rojas</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <main class="referee-content">
        <div class="content-grid">

            <section class="profile-card full-col" style="margin-bottom:0;">
                <h2 class="card-title">SOBRE {referee.nombre.toUpperCase()}</h2>
                <div class="card-body">
                    <p style="margin:0;padding:clamp(0.75rem,3vw,1rem) clamp(0.9rem,4vw,1.25rem);line-height:1.75;font-size:clamp(0.92rem,2.6vw,1.05rem);overflow-wrap:break-word;text-wrap:pretty;text-align:justify;box-sizing:border-box;">{bio}</p>
                </div>
            </section>

            <section class="profile-card full-col">
                <h2 class="card-title">FICHA DE {referee.nombre.toUpperCase()}</h2>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Nombre</span>
                        <span class="info-value">{referee.nombre}</span>
                    </div>
                    {referee.pais_origen && (
                        <div class="info-row">
                            <span class="info-label">País</span>
                            <span class="info-value" style="display:flex;align-items:center;gap:0.5rem;justify-content:flex-end;">
                                {referee.pais_origen}
                                {referee.iso && <img src={getFlagSrc(referee.iso)} alt={referee.iso} class="flag-icon" width="18" height="auto" loading="lazy" />}
                            </span>
                        </div>
                    )}
                    {referee.colegio && (
                        <div class="info-row">
                            <span class="info-label">Colegio</span>
                            <span class="info-value">{referee.colegio}</span>
                        </div>
                    )}
                    <div class="info-row">
                        <span class="info-label">Partidos dirigidos</span>
                        <span class="info-value" style="color:#d4a843;font-family:'Cinzel',serif;font-weight:700;">{totalStats.pj}</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Balance (V/E/D)</span>
                        <span class="info-value">
                            <span style="color:rgba(74,222,128,0.9);font-weight:700;">{totalStats.pg}V</span>
                            <span style="color:rgba(212,168,67,0.8);font-weight:700;margin:0 0.35rem;">{totalStats.pe}E</span>
                            <span style="color:rgba(248,113,113,0.85);font-weight:700;">{totalStats.pp}D</span>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Tarjetas en contra</span>
                        <span class="info-value" style="display:flex;align-items:center;gap:0.75rem;justify-content:flex-end;">
                            <span style="display:flex;align-items:center;gap:0.35rem;">
                                <span style="width:10px;height:14px;background:#d4a843;border-radius:2px;display:inline-block;"></span>
                                <span style="color:rgba(212,168,67,0.9);font-weight:700;">{totalStats.ta}</span>
                            </span>
                            <span style="display:flex;align-items:center;gap:0.35rem;">
                                <span style="width:10px;height:14px;background:rgba(220,50,50,0.9);border-radius:2px;display:inline-block;"></span>
                                <span style="color:rgba(248,113,113,0.9);font-weight:700;">{totalStats.tr}</span>
                            </span>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Tarjetas a favor</span>
                        <span class="info-value" style="display:flex;align-items:center;gap:0.75rem;justify-content:flex-end;">
                            <span style="display:flex;align-items:center;gap:0.35rem;">
                                <span style="width:10px;height:14px;background:#d4a843;border-radius:2px;display:inline-block;opacity:0.65;"></span>
                                <span style="color:rgba(212,168,67,0.75);font-weight:700;">{totalStats.ta_c}</span>
                            </span>
                            <span style="display:flex;align-items:center;gap:0.35rem;">
                                <span style="width:10px;height:14px;background:rgba(220,50,50,0.9);border-radius:2px;display:inline-block;opacity:0.65;"></span>
                                <span style="color:rgba(248,113,113,0.75);font-weight:700;">{totalStats.tr_c}</span>
                            </span>
                        </span>
                    </div>
                </div>
            </section>

            <section class="profile-card full-col">
                <h2 class="card-title">ESTADÍSTICAS POR TEMPORADA</h2>
                <div class="card-body" style="padding:0;">
                    <div class="stats-table-wrapper">
                        {refereeDeepStats.length > 0 ? (
                            <table class="stats-table detailed-table">
                                <thead>
                                    <tr>
                                        <th>TEMPORADA</th>
                                        <th>PJ</th>
                                        <th>PG</th>
                                        <th>PE</th>
                                        <th>PP</th>
                                        <th>TA (F)</th>
                                        <th>TR (F)</th>
                                        <th>PF</th>
                                        <th>PC</th>
                                        <th>TA (C)</th>
                                        <th>TR (C)</th>
                                        <th>FC</th>
                                        <th>FR</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {refereeDeepStats.map((season) => (
                                        <>
                                            <tr
                                                class="season-total-row"
                                                onclick={`toggleSeason('${season.temporada.replace(/\//g, "-")}')`}
                                                style="cursor:pointer;"
                                            >
                                                <td>
                                                    <div class="flex items-center justify-start gap-2 w-full">
                                                        <strong>{season.temporada}</strong>
                                                        <span class="toggle-icon">▼</span>
                                                    </div>
                                                </td>
                                                <td><strong>{season.total.pj}</strong></td>
                                                <td><strong>{season.total.pg}</strong></td>
                                                <td><strong>{season.total.pe}</strong></td>
                                                <td><strong>{season.total.pp}</strong></td>
                                                <td><strong>{season.total.ta}</strong></td>
                                                <td><strong>{season.total.tr}</strong></td>
                                                <td><strong>{season.total.pf}</strong></td>
                                                <td><strong>{season.total.pc}</strong></td>
                                                <td><strong>{season.total.ta_c}</strong></td>
                                                <td><strong>{season.total.tr_c}</strong></td>
                                                <td><strong>{season.total.fc}</strong></td>
                                                <td><strong>{season.total.fr}</strong></td>
                                            </tr>
                                            {season.competiciones.map((comp: any) => (
                                                <tr
                                                    class={`competition-row season-${season.temporada.replace(/\//g, "-")}`}
                                                    style="display:none;"
                                                >
                                                    <td class="competition-name">
                                                        <div class="competition-name-wrapper">
                                                            {competitionLogos[comp.competicion] && (
                                                                <img
                                                                    src={competitionLogos[comp.competicion]}
                                                                    alt={comp.competicion}
                                                                    class="competition-logo"
                                                                />
                                                            )}
                                                            {competitionDisplayName(comp.competicion, { temporada: season.temporada })}
                                                        </div>
                                                    </td>
                                                    <td>{comp.pj}</td>
                                                    <td>{comp.pg}</td>
                                                    <td>{comp.pe}</td>
                                                    <td>{comp.pp}</td>
                                                    <td>{comp.ta}</td>
                                                    <td>{comp.tr}</td>
                                                    <td>{comp.pf}</td>
                                                    <td>{comp.pc}</td>
                                                    <td>{comp.ta_c}</td>
                                                    <td>{comp.tr_c}</td>
                                                    <td>{comp.fc}</td>
                                                    <td>{comp.fr}</td>
                                                </tr>
                                            ))}
                                        </>
                                    ))}
                                    <tr class="career-total-row">
                                        <td style="text-align:left!important;"><strong>TOTAL</strong></td>
                                        <td><strong>{totalStats.pj}</strong></td>
                                        <td><strong>{totalStats.pg}</strong></td>
                                        <td><strong>{totalStats.pe}</strong></td>
                                        <td><strong>{totalStats.pp}</strong></td>
                                        <td><strong>{totalStats.ta}</strong></td>
                                        <td><strong>{totalStats.tr}</strong></td>
                                        <td><strong>{totalStats.pf}</strong></td>
                                        <td><strong>{totalStats.pc}</strong></td>
                                        <td><strong>{totalStats.ta_c}</strong></td>
                                        <td><strong>{totalStats.tr_c}</strong></td>
                                        <td><strong>{totalStats.fc}</strong></td>
                                        <td><strong>{totalStats.fr}</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        ) : (
                            <p style="color:rgba(150,160,175,0.5);font-style:italic;font-size:0.85rem;padding:1.5rem;">No hay estadísticas disponibles</p>
                        )}
                    </div>
                </div>
            </section>

            <section class="profile-card full-col">
                <h2 class="card-title">GRÁFICAS</h2>
                <div class="card-body">
                    <div class="filters-container">
                        <div class="custom-select-container" id="container-temporada">
                            <div class="custom-select-trigger" id="trigger-temporada">
                                <span class="selected-text">Todas las Temporadas</span>
                                <div class="custom-select-arrow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                                </div>
                            </div>
                            <div class="custom-select-options">
                                <div class="custom-select-option selected" data-value="all">Todas las Temporadas</div>
                                {uniqueSeasons.map((season) => (
                                    <div class="custom-select-option" data-value={season}>{season}</div>
                                ))}
                            </div>
                            <select id="season-filter" style="display:none;">
                                <option value="all">Todas las Temporadas</option>
                                {uniqueSeasons.map((season) => (
                                    <option value={season}>{season}</option>
                                ))}
                            </select>
                        </div>
                        <div class="custom-select-container" id="container-competicion">
                            <div class="custom-select-trigger" id="trigger-competicion">
                                <span class="selected-text">Todas las Competiciones</span>
                                <div class="custom-select-arrow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                                </div>
                            </div>
                            <div class="custom-select-options">
                                <div class="custom-select-option selected" data-value="all">Todas las Competiciones</div>
                                {hayAmistosos && (
                                    <div class="custom-select-option" data-value="amistosos">Amistosos</div>
                                )}
                                {uniqueCompetitions.map((comp) => (
                                    <div class="custom-select-option" data-value={comp}>{comp}</div>
                                ))}
                            </div>
                            <select id="competition-filter" style="display:none;">
                                <option value="all">Todas las Competiciones</option>
                                {hayAmistosos && <option value="amistosos">Amistosos</option>}
                                {uniqueCompetitions.map((comp) => (
                                    <option value={comp}>{comp}</option>
                                ))}
                            </select>
                        </div>
                    </div>
                    <div class="charts-row">
                        <div class="chart-item">
                            <h4 class="chart-label">RESULTADOS</h4>
                            <svg viewBox="0 0 100 100" class="pie-chart" id="results-chart">
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(74,222,128,0.75)" stroke-width="20" stroke-dasharray={`${winsArc} ${circumference - winsArc}`} transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(212,168,67,0.7)" stroke-width="20" stroke-dasharray={`${drawsArc} ${circumference - drawsArc}`} stroke-dashoffset={-winsArc} transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(248,113,113,0.75)" stroke-width="20" stroke-dasharray={`${lossesArc} ${circumference - lossesArc}`} stroke-dashoffset={-(winsArc + drawsArc)} transform="rotate(-90 50 50)"></circle>
                            </svg>
                            <div class="chart-legend" id="results-legend">
                                <div><span class="dot green"></span> Ganados ({totalStats.pg})</div>
                                <div><span class="dot orange"></span> Empatados ({totalStats.pe})</div>
                                <div><span class="dot red"></span> Perdidos ({totalStats.pp})</div>
                            </div>
                        </div>

                        <div class="chart-item">
                            <h4 class="chart-label">TARJETAS EN CONTRA</h4>
                            <svg viewBox="0 0 100 100" class="pie-chart" id="cards-chart">
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(212,168,67,0.8)" stroke-width="20" stroke-dasharray={`${yellowArc} ${circumference - yellowArc}`} transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(248,113,113,0.8)" stroke-width="20" stroke-dasharray={`${redArc} ${circumference - redArc}`} stroke-dashoffset={-yellowArc} transform="rotate(-90 50 50)"></circle>
                            </svg>
                            <div class="chart-legend" id="cards-legend">
                                <div><span class="dot yellow"></span> Amarillas ({totalStats.ta})</div>
                                <div><span class="dot red"></span> Rojas ({totalStats.tr})</div>
                            </div>
                        </div>

                        <div class="chart-item">
                            <h4 class="chart-label">TARJETAS A FAVOR</h4>
                            <svg viewBox="0 0 100 100" class="pie-chart" id="cards-favor-chart">
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(212,168,67,0.8)" stroke-width="20" stroke-dasharray={`${yellowArcFavor} ${circumference - yellowArcFavor}`} transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(248,113,113,0.8)" stroke-width="20" stroke-dasharray={`${redArcFavor} ${circumference - redArcFavor}`} stroke-dashoffset={-yellowArcFavor} transform="rotate(-90 50 50)"></circle>
                            </svg>
                            <div class="chart-legend" id="cards-favor-legend">
                                <div><span class="dot yellow"></span> Amarillas ({totalStats.ta_c})</div>
                                <div><span class="dot red"></span> Rojas ({totalStats.tr_c})</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="profile-card full-col">
                <h2 class="card-title">PARTIDOS DIRIGIDOS</h2>
                <div class="card-body" style="padding:0;">
                    <div class="stats-table-wrapper">
                        <table class="matches-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Competición</th>
                                    <th>Local</th>
                                    <th>Res.</th>
                                    <th>Visitante</th>
                                    <th>Estadio</th>
                                </tr>
                            </thead>
                            <tbody>
                                {matches.map((match, index) => (
                                    <tr
                                        class={`match-row ${index >= 10 ? "hidden-match" : ""}`}
                                        style={index >= 10 ? "display:none;" : ""}
                                    >
                                        <td>{new Date(match.fecha).toLocaleDateString("es-ES")}</td>
                                        <td>
                                            {competitionLogos[match.competicion] && (
                                                <img src={competitionLogos[match.competicion]} alt={match.competicion} class="competition-logo-small" title={match.competicion} />
                                            )}
                                            {!competitionLogos[match.competicion] && match.competicion}
                                        </td>
                                        <td class={match.club_local.toLowerCase().includes("real madrid") ? "font-bold" : ""}>{match.club_local}</td>
                                        <td class={match.resultado === "V" ? "resultado-victoria" : match.resultado === "E" ? "resultado-empate" : "resultado-derrota"}>
                                            {match.goles_rm} - {match.goles_rival}
                                        </td>
                                        <td class={match.club_visitante.toLowerCase().includes("real madrid") ? "font-bold" : ""}>{match.club_visitante}</td>
                                        <td>
                                            {match.estadio && (
                                                <a href={`/estadios/${generateSlug(match.estadio)}`} class="estadio-link">{match.estadio}</a>
                                            )}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    {matches.length > 10 && (
                        <div class="matches-footer">
                            <button id="show-more-matches" class="btn-more">
                                Ver todos los partidos ({matches.length})
                            </button>
                        </div>
                    )}
                </div>
            </section>

        </div>
    </main>
</Layout>

<script define:vars={{ initialMatches: matches }}>
    window.toggleSeason = function (season) {
        const rows = document.querySelectorAll(
            `.competition-row.season-${season}`,
        );
        const icon = document.querySelector(
            `.season-total-row[onclick*="${season}"] .toggle-icon`,
        );

        rows.forEach((row) => {
            if (row.style.display === "none") {
                row.style.display = "table-row";
                if (icon) icon.textContent = "▲";
            } else {
                row.style.display = "none";
                if (icon) icon.textContent = "▼";
            }
        });
    };

    function calculateStatsDoubleFilter(matches) {
        const stats = {
            pj: 0,
            pg: 0,
            pe: 0,
            pp: 0,
            ta: 0,
            tr: 0,
            pf: 0,
            pc: 0,
            ta_c: 0,
            tr_c: 0,
        };

        matches.forEach((m) => {
            stats.pj++;
            stats.ta += parseInt(m.yellowCards) || 0;
            stats.tr += parseInt(m.redCards) || 0;
            stats.pf += parseInt(m.penaltiesFor) || 0;
            stats.pc += parseInt(m.penaltiesAgainst) || 0;
            stats.ta_c += parseInt(m.yellowCardsAgainst) || 0;
            stats.tr_c += parseInt(m.redCardsAgainst) || 0;

            if (m.resultado === "V") stats.pg++;
            else if (m.resultado === "E") stats.pe++;
            else stats.pp++;
        });
        return stats;
    }

    function updateCharts(stats) {
        const circumference = 220;
        const totalMatches = stats.pj;

        const updateCircle = (id, idx, val, total, offset = 0) => {
            const chart = document.getElementById(id);
            if (!chart) return;
            const circle = chart.querySelectorAll("circle")[idx];
            if (!circle) return;

            const arc =
                total > 0 ? Math.round((val / total) * circumference) : 0;
            circle.setAttribute(
                "stroke-dasharray",
                `${arc} ${circumference - arc}`,
            );
            if (offset !== 0) circle.setAttribute("stroke-dashoffset", -offset);
            return arc;
        };

        const winsArc = updateCircle(
            "results-chart",
            0,
            stats.pg,
            totalMatches,
        );
        const drawsArc = updateCircle(
            "results-chart",
            1,
            stats.pe,
            totalMatches,
            winsArc,
        );
        updateCircle(
            "results-chart",
            2,
            stats.pp,
            totalMatches,
            winsArc + drawsArc,
        );

        document.querySelector(
            "#results-legend div:nth-child(1) .dot",
        ).nextSibling.textContent = ` Ganados (${stats.pg})`;
        document.querySelector(
            "#results-legend div:nth-child(2) .dot",
        ).nextSibling.textContent = ` Empatados (${stats.pe})`;
        document.querySelector(
            "#results-legend div:nth-child(3) .dot",
        ).nextSibling.textContent = ` Perdidos (${stats.pp})`;

        const totalCards = stats.ta + stats.tr;
        const yellowArc = updateCircle("cards-chart", 0, stats.ta, totalCards);
        updateCircle("cards-chart", 1, stats.tr, totalCards, yellowArc);

        document.querySelector(
            "#cards-legend div:nth-child(1) .dot",
        ).nextSibling.textContent = ` Amarillas (${stats.ta})`;
        document.querySelector(
            "#cards-legend div:nth-child(2) .dot",
        ).nextSibling.textContent = ` Rojas (${stats.tr})`;
    }

    const seasonFilter = document.getElementById("season-filter");
    const competitionFilter = document.getElementById("competition-filter");

    function initCustomSelects() {
        const containers = document.querySelectorAll(
            ".custom-select-container",
        );

        containers.forEach((container) => {
            const trigger = container.querySelector(".custom-select-trigger");
            const select = container.querySelector("select");
            const options = container.querySelectorAll(".custom-select-option");
            const selectedText = trigger?.querySelector(".selected-text");

            trigger?.addEventListener("click", (e) => {
                e.stopPropagation();
                containers.forEach((c) => {
                    if (c !== container) c.classList.remove("open");
                });
                container.classList.toggle("open");
            });

            options.forEach((option) => {
                option.addEventListener("click", () => {
                    const value = option.dataset.value;
                    const text = option.textContent;

                    if (selectedText) selectedText.textContent = text;
                    options.forEach((opt) => opt.classList.remove("selected"));
                    option.classList.add("selected");

                    if (select && value) {
                        select.value = value;
                        select.dispatchEvent(new Event("change"));
                    }

                    container.classList.remove("open");
                });
            });
        });

        document.addEventListener("click", () => {
            containers.forEach((c) => c.classList.remove("open"));
        });
    }

    initCustomSelects();

    function filterDataAndCharts() {
        const allMatches = initialMatches;

        const selectedSeason = seasonFilter.value;
        const selectedComp = competitionFilter.value;

        let filtered = allMatches;

        if (selectedSeason !== "all") {
            filtered = filtered.filter((m) => m.season === selectedSeason);
        }
        if (selectedComp === "amistosos") {
            filtered = filtered.filter((m) =>
                /amistoso|friendly/i.test(m.competicion || ""),
            );
        } else if (selectedComp !== "all") {
            filtered = filtered.filter((m) => m.competicion === selectedComp);
        }

        const stats = calculateStatsDoubleFilter(filtered);
        updateCharts(stats);
    }

    if (seasonFilter)
        seasonFilter.addEventListener("change", filterDataAndCharts);
    if (competitionFilter)
        competitionFilter.addEventListener("change", filterDataAndCharts);

    const showMoreBtn = document.getElementById("show-more-matches");
    if (showMoreBtn) {
        showMoreBtn.addEventListener("click", () => {
            document.querySelectorAll(".hidden-match").forEach((row) => {
                row.style.display = "table-row";
                row.classList.remove("hidden-match");
            });
            showMoreBtn.style.display = "none";
        });
    }
</script>


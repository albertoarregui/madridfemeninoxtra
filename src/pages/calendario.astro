---
import Layout from "../layouts/Layout.astro";
import { fetchGamesDirectly } from "../utils/partidos";
import CalendarArchive from "../components/CalendarArchive";
import { getCurrentSeason } from "../utils/season";
import { breadcrumbSchema } from "../utils/seo";
import "../styles/global.css";

export const prerender = false;

let matches: any[] = [];
let error = null;
const currentSeason = getCurrentSeason();

try {
    const allMatches = await fetchGamesDirectly();

    matches = allMatches.filter(
        (m) =>
            m.temporada_nombre === currentSeason ||
            (!m.temporada_nombre && !m.isPlayed),
    );
} catch (e: any) {
    console.error("Error fetching matches for calendar:", e);
    error = e.message;
}

const title = `Partidos del Real Madrid Femenino ${currentSeason}: calendario y resultados | MFX`;
const description =
    `Calendario y resultados del Real Madrid Femenino en la temporada ${currentSeason}. Consulta fechas, horarios, rivales y próximos partidos.`;
---

<Layout title={title} description={description}
    ogTitle={`Calendario, próximos partidos y resultados del Real Madrid Femenino | Madrid Femenino Xtra`}
    ogDescription="Calendario completo del Real Madrid Femenino: próximos partidos, fechas, horarios, rivales, competiciones y resultados actualizados del conjunto blanco."
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema([
        { name: "Inicio", path: "/" }, { name: "Calendario", path: "/calendario" },
    ]))} />
    <main class="calendar-page">
        <header class="page-header-container">
            <h1 class="landing-title">Partidos del Real Madrid Femenino {currentSeason}</h1>
            <p class="landing-subtitle">
                Calendario, horarios, resultados y próximos partidos · <a href="/partidos">Historial de otras temporadas</a>
            </p>
        </header>

        <section
            class="calendar-content-section max-w-7xl mx-auto px-6 md:px-0"
        >
            {
                error && (
                    <div class="p-10 bg-red-50 text-red-600 rounded-3xl border border-red-100 font-bold">
                        Error cargando el calendario: {error}
                    </div>
                )
            }

            <CalendarArchive matches={matches} client:load />
            <p class="watch-reference">Información sobre la emisión del próximo partido: <a href="/donde-ver-real-madrid-femenino">dónde ver al Real Madrid Femenino</a>.</p>
        </section>
    </main>
</Layout>

<style>
    .calendar-page {
        min-height: 100vh;
    }
    .landing-subtitle a { color: #d4a843; text-decoration: underline; }
    .watch-reference { margin: 2rem 0 3rem; color: #c8c8c8; font-size: .9rem; }
    .watch-reference a { color: #d4a843; text-underline-offset: .2em; }
</style>

---
import Layout from "../layouts/Layout.astro";
import { fetchGamesDirectly } from "../utils/partidos";
import CalendarArchive from "../components/CalendarArchive";
import { getCurrentSeason } from "../utils/season";
import "../styles/global.css";

export const prerender = false;

let matches: any[] = [];
let error = null;
const currentSeason = getCurrentSeason();

try {
    const allMatches = await fetchGamesDirectly();

    matches = allMatches.filter(
        (m) =>
            m.temporada_nombre === currentSeason ||
            (!m.temporada_nombre && !m.isPlayed),
    );
} catch (e: any) {
    console.error("Error fetching matches for calendar:", e);
    error = e.message;
}

const title = `Partidos del Real Madrid Femenino ${currentSeason}: calendario y resultados | MFX`;
const description =
    `Calendario y resultados del Real Madrid Femenino en la temporada ${currentSeason}. Consulta fechas, horarios, rivales y próximos partidos.`;
const nextMatch = matches.find((match) => !match.isPlayed);
const lastResult = [...matches].reverse().find((match) => match.isPlayed);
const scoreFor = (match: any) => {
    const madridAtHome = match.club_local?.toLowerCase().includes("real madrid");
    return madridAtHome
        ? `${match.goles_rm}-${match.goles_rival}`
        : `${match.goles_rival}-${match.goles_rm}`;
};
---

<Layout title={title} description={description}>
    <main class="calendar-page">
        <header class="page-header-container">
            <h1 class="landing-title">Partidos del Real Madrid Femenino {currentSeason}</h1>
            <p class="landing-subtitle">
                Calendario, horarios, resultados y próximos partidos · <a href="/partidos">Historial de otras temporadas</a>
            </p>
        </header>

        {(nextMatch || lastResult) && (
            <section class="season-highlights" aria-label="Próximo partido y último resultado">
                {nextMatch && (
                    <p><strong>Próximo partido</strong> <a href={`/partidos/${nextMatch.slug}`}>
                        {nextMatch.club_local} - {nextMatch.club_visitante} · {nextMatch.fecha_formateada}
                    </a></p>
                )}
                {lastResult && (
                    <p><strong>Último resultado</strong> <a href={`/partidos/${lastResult.slug}`}>
                        {lastResult.club_local} - {lastResult.club_visitante} · {scoreFor(lastResult)}
                    </a></p>
                )}
            </section>
        )}

        <section
            class="calendar-content-section max-w-7xl mx-auto px-6 md:px-0"
        >
            {
                error && (
                    <div class="p-10 bg-red-50 text-red-600 rounded-3xl border border-red-100 font-bold">
                        Error cargando el calendario: {error}
                    </div>
                )
            }

            <CalendarArchive matches={matches} client:load />
        </section>
    </main>
</Layout>

<style>
    .calendar-page {
        min-height: 100vh;
    }
    .season-highlights {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        max-width: 1200px;
        margin: 0 auto 2rem;
        padding: 0 2rem;
        color: #c8c8c8;
    }
    .season-highlights p { margin: 0; }
    .season-highlights strong { color: #d4a843; margin-right: .5rem; }
    .season-highlights a, .landing-subtitle a { color: #d4a843; text-decoration: underline; }
</style>

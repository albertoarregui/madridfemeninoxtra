---
import Layout from "../../layouts/Layout.astro";
import UnoPorUno from "../../components/UnoPorUno.astro";
import { getUnoPorUnoPartido } from "../../utils/uno-por-uno";
export const prerender = false;
const { partidoId } = Astro.params;
let data = null;
try { data = await getUnoPorUnoPartido(String(partidoId ?? "")); }
catch (error) { console.error("[uno-por-uno]", error); }
if (!data) Astro.response.status = 404;
---
<Layout title={data ? `${data.titulo} | Madrid Femenino Xtra` : "1x1 no disponible | Madrid Femenino Xtra"} noindex={!data}>
  <main style="min-height:60vh;padding:3rem 1rem">
    {data ? <UnoPorUno data={data} /> : <div style="max-width:900px;margin:auto"><h1>El 1x1 no está disponible</h1><p>Las valoraciones de este partido todavía no están publicadas.</p></div>}
  </main>
</Layout>
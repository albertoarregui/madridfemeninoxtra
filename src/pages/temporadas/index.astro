---
import Layout from "../../layouts/Layout.astro";
import { fetchGamesDirectly } from "../../utils/partidos";
import { breadcrumbSchema } from "../../utils/seo";
import "../../styles/global.css";

const games = await fetchGamesDirectly();
const seasonMap = new Map<string, { season: string; played: number; upcoming: number }>();

for (const game of games) {
    const season = String(game.temporada_nombre || "").trim();
    if (!season) continue;
    const current = seasonMap.get(season) || { season, played: 0, upcoming: 0 };
    if (game.isPlayed) current.played += 1;
    else current.upcoming += 1;
    seasonMap.set(season, current);
}

const seasons = [...seasonMap.values()].sort((a, b) => b.season.localeCompare(a.season));
---

<Layout
    title="Temporadas del Real Madrid Femenino: resultados y estadísticas | MFX"
    description="Archivo por temporadas del Real Madrid Femenino con partidos, resultados, goleadoras, asistentes, minutos y estadísticas."
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "Temporadas", path: "/temporadas" },
            ]),
        )}
    />

    <main class="season-index max-w-5xl mx-auto px-6 py-12">
        <header class="page-header-container">
            <h1 class="landing-title">Temporadas del Real Madrid Femenino</h1>
            <p class="landing-subtitle">Archivo histórico temporada a temporada</p>
        </header>

        <div class="season-grid">
            {seasons.map((season) => (
                <a class="season-card" href={`/temporadas/${season.season.replace("/", "-")}`}>
                    <div class="season-card-head">Temporada</div>
                    <div class="season-card-body">
                        <strong>{season.season}</strong>
                        <span>
                            {season.played} partidos disputados
                            {season.upcoming ? ` · ${season.upcoming} programados` : ""}
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </main>
</Layout>

<style>
    .season-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1rem;
    }
    .season-card {
        display: block;
        position: relative;
        overflow: hidden;
        text-decoration: none;
        border: 1px solid rgba(212, 168, 67, 0.18);
        border-radius: 4px;
        background: rgba(8, 16, 34, 0.85);
        transition: 0.2s ease;
    }
    .season-card::before,
    .season-card::after {
        content: "";
        position: absolute;
        width: 11px;
        height: 11px;
        pointer-events: none;
    }
    .season-card::before {
        top: 0; left: 0;
        border-top: 1px solid rgba(212, 168, 67, 0.5);
        border-left: 1px solid rgba(212, 168, 67, 0.5);
    }
    .season-card::after {
        right: 0; bottom: 0;
        border-right: 1px solid rgba(212, 168, 67, 0.5);
        border-bottom: 1px solid rgba(212, 168, 67, 0.5);
    }
    .season-card:hover {
        border-color: rgba(212, 168, 67, 0.5);
        background: rgba(10, 20, 42, 0.92);
        transform: translateY(-3px);
    }
    .season-card-head {
        padding: 0.78rem 1rem;
        border-bottom: 1px solid rgba(212, 168, 67, 0.12);
        background: rgba(212, 168, 67, 0.03);
        color: rgba(212, 168, 67, 0.78);
        font: 600 0.66rem "Cinzel", serif;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }
    .season-card-body {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.1rem;
    }
    .season-card strong {
        font: 700 1.45rem "Cinzel", serif;
        color: #d4a843;
    }
    .season-card span {
        font: 0.78rem "DM Sans", sans-serif;
        color: #aaa;
    }
</style>

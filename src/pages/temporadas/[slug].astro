---
import Layout from "../../layouts/Layout.astro";
import { fetchGamesDirectly } from "../../utils/partidos";
import { fetchRankingsDirectly } from "../../utils/rankings";
import { fetchPlayersDirectly, getPlayerImageUrl } from "../../utils/players";
import { breadcrumbSchema } from "../../utils/seo";
import "../../styles/global.css";

const { slug } = Astro.params;
if (!/^\d{4}-\d{2}$/.test(String(slug || ""))) return Astro.redirect("/404");

const season = String(slug).replace("-", "/");
const [allGames, allRankingRows, allPlayers] = await Promise.all([
    fetchGamesDirectly(),
    fetchRankingsDirectly(),
    fetchPlayersDirectly(),
]);
const games = allGames.filter((game: any) => String(game.temporada_nombre || "") === season);
const rankingRows = allRankingRows.filter((row: any) => String(row.temporada || "") === season);

if (!games.length && !rankingRows.length) return Astro.redirect("/404");

const playerById = new Map(allPlayers.map((player: any) => [String(player.id_jugadora), player]));
const getFrontPhoto = (id: string, name: string): string => {
    const player = playerById.get(String(id));
    if (!player) return getPlayerImageUrl({ nombre: name, foto_perfil_url: undefined });

    const exact = player.season_photos?.[season];
    if (exact) return getPlayerImageUrl({ ...player, foto_url: exact, foto_perfil_url: undefined });

    const seasons = Object.keys(player.season_photos || {}).sort().reverse();
    for (const seasonKey of seasons) {
        const photo = player.season_photos?.[seasonKey];
        if (photo) return getPlayerImageUrl({ ...player, foto_url: photo, foto_perfil_url: undefined });
    }

    return getPlayerImageUrl({
        ...player,
        foto_url: player.foto_url || player.nombre,
        foto_perfil_url: undefined,
    });
};

const played = games
    .filter((game: any) => game.isPlayed)
    .sort((a: any, b: any) => String(b.fecha).localeCompare(String(a.fecha)));
const upcoming = games
    .filter((game: any) => !game.isPlayed)
    .sort((a: any, b: any) => String(a.fecha).localeCompare(String(b.fecha)));

let wins = 0;
let draws = 0;
let losses = 0;
let gf = 0;
let ga = 0;

for (const game of played) {
    const goalsFor = Number(game.goles_rm || 0);
    const goalsAgainst = Number(game.goles_rival || 0);
    const penalties = String(game.penaltis ?? "").trim();
    gf += goalsFor;
    ga += goalsAgainst;
    if (goalsFor > goalsAgainst || (goalsFor === goalsAgainst && penalties === "1")) wins += 1;
    else if (goalsFor < goalsAgainst || (goalsFor === goalsAgainst && penalties === "0")) losses += 1;
    else draws += 1;
}

const OFFICIAL = new Set([
    "Liga F",
    "Primera Iberdrola",
    "UWCL",
    "Copa de la Reina",
    "Supercopa de España",
]);
const grouped = new Map<string, any>();
for (const row of rankingRows.filter((item: any) => OFFICIAL.has(item.competicion))) {
    const key = String(row.id_jugadora || row.slug || row.nombre);
    const current = grouped.get(key) || {
        id: key,
        nombre: row.nombre,
        slug: row.slug,
        posicion: row.posicion,
        imageUrl: getFrontPhoto(key, row.nombre),
        goles: 0,
        asistencias: 0,
        partidos: 0,
        minutos: 0,
    };
    current.goles += Number(row.goles || 0);
    current.asistencias += Number(row.asistencias || 0);
    current.partidos += Number(row.partidos || 0);
    current.minutos += Number(row.minutos || 0);
    grouped.set(key, current);
}
const players = [...grouped.values()];
const top = (key: string) =>
    players
        .filter((player) => player[key] > 0)
        .sort((a, b) => b[key] - a[key])
        .slice(0, 5);

const competitions = [...new Set(games.map((game: any) => game.competicion_nombre).filter(Boolean))];

const resultScore = (game: any) => {
    const madridHome = String(game.club_local || "").toLowerCase().includes("real madrid");
    return madridHome
        ? `${game.goles_rm}-${game.goles_rival}`
        : `${game.goles_rival}-${game.goles_rm}`;
};

const schema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Real Madrid Femenino ${season}`,
    url: `https://www.madridfemeninoxtra.com/temporadas/${slug}`,
    about: { "@type": "SportsTeam", name: "Real Madrid Femenino" },
};
---

<Layout
    title={`Real Madrid Femenino ${season}: plantilla, partidos y estadísticas | MFX`}
    description={`Temporada ${season} del Real Madrid Femenino: ${played.length} partidos, resultados, balance, goleadoras, asistentes y estadísticas.`}
    ogTitle={`Temporada ${season} del Real Madrid Femenino: resultados y estadísticas | Madrid Femenino Xtra`}
    ogDescription={`Toda la información de la temporada ${season} del Real Madrid Femenino: plantilla, partidos, resultados, competiciones, goleadoras, asistentes y estadísticas completas.`}
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "Temporadas", path: "/temporadas" },
                { name: season, path: `/temporadas/${slug}` },
            ]),
        )}
    />

    <main class="season-page max-w-6xl mx-auto px-6 py-12">
        <header class="page-header-container">
            <h1 class="landing-title">Real Madrid Femenino {season}</h1>
            <p class="landing-subtitle">Partidos, balance, goleadoras, asistentes y protagonistas de la temporada</p>
        </header>

        <section class="summary" aria-label={`Balance de la temporada ${season}`}>
            <div><strong>{played.length}</strong><span>Partidos</span></div>
            <div><strong>{wins}</strong><span>Victorias</span></div>
            <div><strong>{draws}</strong><span>Empates</span></div>
            <div><strong>{losses}</strong><span>Derrotas</span></div>
            <div><strong>{gf}</strong><span>GF</span></div>
            <div><strong>{ga}</strong><span>GC</span></div>
        </section>

        {competitions.length > 0 && (
            <p class="competitions"><strong>Competiciones:</strong> {competitions.join(" · ")}</p>
        )}

        <section class="leaders">
            {[
                ["Máximas goleadoras", "goles", "goles"],
                ["Máximas asistentes", "asistencias", "asistencias"],
                ["Más partidos", "partidos", "partidos"],
                ["Más minutos", "minutos", "minutos"],
            ].map(([title, key, label]) => (
                <div class="leader">
                    <div class="leader-head">{title}</div>
                    <div class="leader-body">
                        {top(key).map((row: any, index: number) => (
                            <a href={`/jugadoras/${row.slug}`}>
                                <span class="leader-player">
                                    <span class="leader-avatar" aria-hidden="true">
                                        <img src={row.imageUrl} alt="" width="48" height="48" loading="lazy" decoding="async" />
                                    </span>
                                    <span class="leader-name">
                                        <strong>{row.nombre}</strong>
                                        <small>{index + 1}. {row.posicion || "Jugadora"}</small>
                                    </span>
                                </span>
                                <b>{Number(row[key]).toLocaleString("es-ES")} <small>{label}</small></b>
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </section>

        {upcoming.length > 0 && (
            <section class="matches">
                <div class="matches-head">Próximos partidos</div>
                <div class="matches-body">
                    {upcoming.slice(0, 6).map((game: any) => (
                        <a href={`/partidos/${game.slug}`}>
                            <span>{game.fecha_formateada}</span>
                            <strong>{game.club_local} - {game.club_visitante}</strong>
                        </a>
                    ))}
                </div>
            </section>
        )}

        {played.length > 0 && (
            <section class="matches">
                <div class="matches-head">Últimos resultados</div>
                <div class="matches-body">
                    {played.slice(0, 8).map((game: any) => (
                        <a href={`/partidos/${game.slug}`}>
                            <span>{game.fecha_formateada}</span>
                            <strong>{game.club_local} {resultScore(game)} {game.club_visitante}</strong>
                        </a>
                    ))}
                </div>
            </section>
        )}

        <nav class="season-links" aria-label="Más datos del Real Madrid Femenino">
            <a href="/rankings">Rankings históricos</a>
            <a href="/partidos">Todos los partidos</a>
            <a href="/plantilla">Plantilla actual</a>
            <a href="/estadisticas-real-madrid-femenino">Centro de datos</a>
        </nav>
    </main>
</Layout>

<style>
    .summary {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }
    .summary div,
    .leader,
    .matches,
    .season-links a {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(212, 168, 67, 0.18);
        border-radius: 4px;
        background: rgba(8, 16, 34, 0.85);
    }
    .summary div::before,
    .leader::before,
    .matches::before,
    .season-links a::before,
    .summary div::after,
    .leader::after,
    .matches::after,
    .season-links a::after {
        content: "";
        position: absolute;
        width: 10px;
        height: 10px;
        pointer-events: none;
    }
    .summary div::before,
    .leader::before,
    .matches::before,
    .season-links a::before {
        top: 0; left: 0;
        border-top: 1px solid rgba(212, 168, 67, 0.5);
        border-left: 1px solid rgba(212, 168, 67, 0.5);
    }
    .summary div::after,
    .leader::after,
    .matches::after,
    .season-links a::after {
        right: 0; bottom: 0;
        border-right: 1px solid rgba(212, 168, 67, 0.5);
        border-bottom: 1px solid rgba(212, 168, 67, 0.5);
    }
    .summary div {
        padding: 1rem;
        text-align: center;
    }
    .summary strong {
        display: block;
        color: #d4a843;
        font: 700 1.5rem "Cinzel", serif;
    }
    .summary span {
        font: 0.68rem "DM Sans", sans-serif;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .competitions {
        color: #aaa;
        font: 0.82rem "DM Sans", sans-serif;
    }
    .competitions strong { color: #d4a843; }
    .leaders {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin: 2rem 0;
    }
    .leader-head,
    .matches-head {
        padding: 0.85rem 1.1rem;
        border-bottom: 1px solid rgba(212, 168, 67, 0.12);
        background: rgba(212, 168, 67, 0.03);
        color: rgba(212, 168, 67, 0.82);
        font: 600 0.7rem "Cinzel", serif;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }
    .leader-body { padding: 0.2rem 1rem 0.4rem; }
    .leader a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        color: #ddd;
        text-decoration: none;
        padding: 0.65rem 0;
        border-bottom: 1px solid rgba(212, 168, 67, 0.07);
    }
    .leader a:last-child { border-bottom: 0; }
    .leader-player {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
    }
    .leader-avatar {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        overflow: hidden;
        border-radius: 50%;
        border: 1px solid rgba(212, 168, 67, 0.42);
        background: rgba(212, 168, 67, 0.06);
        box-shadow: inset 0 0 0 2px rgba(6, 13, 28, 0.75);
    }
    .leader-avatar img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center 18%;
    }
    .leader-name {
        display: flex;
        flex-direction: column;
        gap: 0.16rem;
        min-width: 0;
    }
    .leader-name strong {
        color: #eee;
        font: 700 0.84rem "Cinzel", serif;
        line-height: 1.25;
    }
    .leader-name small,
    .leader b small {
        color: #8f8f99;
        font: 0.58rem "DM Sans", sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .leader b {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        color: #d4a843;
        font: 700 0.9rem "DM Sans", sans-serif;
        white-space: nowrap;
    }
    .matches { margin: 2rem 0; }
    .matches-body { padding: 0.15rem 1rem 0.35rem; }
    .matches-body > a {
        display: flex;
        gap: 1rem;
        align-items: center;
        text-decoration: none;
        color: #eee;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(212, 168, 67, 0.07);
    }
    .matches-body > a:last-child { border-bottom: 0; }
    .matches-body > a span {
        min-width: 110px;
        color: #999;
        font-size: 0.75rem;
    }
    .matches-body > a:hover strong { color: #d4a843; }
    .season-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.7rem;
        margin-top: 2rem;
    }
    .season-links a {
        color: #d4a843;
        padding: 0.65rem 0.8rem;
        text-decoration: none;
        font-size: 0.78rem;
        transition: 0.18s ease;
    }
    .season-links a:hover {
        border-color: rgba(212, 168, 67, 0.5);
        background: rgba(10, 20, 42, 0.92);
    }
    @media (max-width: 760px) {
        .summary { grid-template-columns: repeat(3, 1fr); }
        .leaders { grid-template-columns: 1fr; }
    }
    @media (max-width: 430px) {
        .summary { grid-template-columns: repeat(2, 1fr); }
        .matches-body > a {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.2rem;
        }
        .leader-avatar {
            width: 44px;
            height: 44px;
            flex-basis: 44px;
        }
    }
</style>

---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import "../../styles/buscador.css";
import { getMatchFilterOptions } from "../../utils/buscador-filtros";
import BuscadorPartidos from "../../components/BuscadorPartidos";

const { seasons, competitions, rivals } = await getMatchFilterOptions();
---

<Layout
    title="Buscador Avanzado de Partidos | Madrid Femenino Xtra"
    description="Busca, filtra y ordena todos los partidos del Real Madrid Femenino por temporada, competición, rival, resultado y estadísticas de equipo."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <header class="page-header-container">
            <h1 class="landing-title" data-title="BUSCADOR DE PARTIDOS">BUSCADOR DE PARTIDOS</h1>
            <p class="landing-subtitle">
                Filtra y ordena los partidos por temporada, competición, rival, resultado y estadísticas
            </p>
        </header>

        <BuscadorPartidos
            client:load
            seasons={seasons}
            competitions={competitions}
            rivals={rivals}
        />
    </main>
</Layout>

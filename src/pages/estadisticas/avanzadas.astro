---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import AdvancedStats from "../../components/AdvancedStats";
---

<Layout
    title="Gráficos | Madrid Femenino Xtra"
    description="Tracker de xG y red de asistencias interactiva del Real Madrid Femenino."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <header class="page-header-container">
            <h1 class="landing-title" data-title="GRÁFICOS">GRÁFICOS</h1>
            <p class="landing-subtitle">
                Tracker de xG y red de asistencias del Real Madrid Femenino
            </p>
        </header>

        <AdvancedStats client:only="react" />
    </main>
</Layout>

<style is:global>
.adv-root {
    max-width: 900px;
    margin: 0 auto 5rem;
    padding: 0 0.5rem;
}

.adv-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 2.5rem;
    padding: 1rem 1.25rem;
    background: rgba(6,13,28,0.7);
    border-radius: 10px;
    border: 1px solid rgba(212,168,67,0.2);
}

.adv-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 160px;
    flex: 1 1 160px;
}

.adv-filter-label {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 1.5px;
    color: rgba(212,168,67,0.7);
    text-transform: uppercase;
}

.adv-custom-select  { position: relative; }

.adv-custom-trigger {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600;
    color: rgba(200,210,220,0.9); background: rgba(6,13,28,0.6);
    border: 1px solid rgba(212,168,67,0.3); border-radius: 6px;
    padding: 0.5rem 0.9rem; cursor: pointer; width: 100%;
    transition: border-color 0.15s, box-shadow 0.15s;
    white-space: nowrap;
}
.adv-custom-trigger:hover  { border-color: rgba(212,168,67,0.6); }
.adv-custom-select.open .adv-custom-trigger {
    border-color: #d4a843;
    border-bottom-left-radius: 0; border-bottom-right-radius: 0;
    box-shadow: 0 0 0 2px rgba(212,168,67,0.15);
}

.adv-custom-text  { flex: 1; min-width: 0; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.adv-custom-arrow { flex-shrink: 0; transition: transform 0.2s; }
.adv-custom-select.open .adv-custom-arrow { transform: rotate(180deg); }

.adv-custom-options {
    position: absolute; top: calc(100% - 1px); left: 0; right: 0;
    background: rgba(8,16,35,0.98); border: 1px solid #d4a843; border-top: none;
    border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5); z-index: 400;
    list-style: none; padding: 0.3rem 0; margin: 0;
    max-height: 220px; overflow-y: auto;
}

.adv-custom-option {
    padding: 0.45rem 1rem;
    font-family: 'DM Sans', sans-serif; font-size: 0.85rem;
    color: rgba(200,210,220,0.85); cursor: pointer; text-align: center;
    transition: background 0.12s;
}
.adv-custom-option:hover    { background: rgba(212,168,67,0.1); }
.adv-custom-option.selected { background: rgba(212,168,67,0.2); color: #d4a843; font-weight: 600; }

.adv-section       { margin-bottom: 3rem; }
.adv-section-header { margin-bottom: 1rem; }

.adv-section-title {
    font-family: 'Cinzel', serif;
    font-size: 1.4rem; letter-spacing: 2px;
    color: #d4a843; margin: 0 0 0.2rem;
}

.adv-section-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem; color: rgba(200,210,220,0.5); margin: 0;
}

.adv-card {
    background: rgba(6,13,28,0.7);
    border-radius: 10px;
    border: 1px solid rgba(212,168,67,0.15);
    padding: 1.5rem 1rem 1rem;
    overflow: hidden;
}
.adv-card-graph { padding: 0; }

.adv-loading {
    display: flex; align-items: center; justify-content: center;
    min-height: 200px;
}
.adv-spinner {
    display: inline-block; width: 28px; height: 28px;
    border: 3px solid rgba(212,168,67,0.2); border-top-color: #d4a843;
    border-radius: 50%; animation: adv-spin 0.7s linear infinite;
}
@keyframes adv-spin { to { transform: rotate(360deg); } }

.adv-empty {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; min-height: 200px;
    font-family: 'DM Sans', sans-serif; font-size: 0.9rem;
    color: rgba(200,210,220,0.4); text-align: center;
}
.adv-empty p { margin: 0; }

.adv-tooltip {
    background: rgba(8,16,35,0.98); border-radius: 8px;
    border: 1px solid rgba(212,168,67,0.3);
    padding: 0.65rem 0.9rem;
    font-family: 'DM Sans', sans-serif; font-size: 0.78rem;
    color: rgba(200,210,220,0.85); line-height: 1.7;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}
.adv-tooltip-title {
    font-family: 'Cinzel', serif;
    font-size: 0.9rem; letter-spacing: 1px;
    color: #d4a843; margin: 0;
}
.adv-tooltip-sub   { color: rgba(200,210,220,0.5); margin: 0; font-size: 0.74rem; }
.adv-tooltip-divider { border: none; border-top: 1px solid rgba(212,168,67,0.15); margin: 0.35rem 0; }

.adv-graph-outer   { display: flex; flex-direction: column; gap: 0; }
.adv-graph-wrap    { position: relative; overflow: hidden; }

.adv-graph-tooltip {
    display: none;
    position: absolute;
    background: rgba(8,16,35,0.98); border-radius: 6px;
    border: 1px solid rgba(212,168,67,0.3);
    padding: 0.45rem 0.75rem;
    font-family: 'DM Sans', sans-serif; font-size: 0.78rem;
    color: rgba(200,210,220,0.85); line-height: 1.6; white-space: nowrap;
    pointer-events: none; z-index: 100;
    box-shadow: 0 4px 16px rgba(0,0,0,0.5);
}

.adv-node-panel {
    background: rgba(6,13,28,0.85);
    border-top: 2px solid #d4a843;
    padding: 1.1rem 1.25rem 1.25rem;
    animation: adv-slide-in 0.18s ease;
}
@keyframes adv-slide-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}

.adv-node-panel-header {
    display: flex; align-items: center; gap: 0.85rem;
    margin-bottom: 1rem; position: relative;
}
.adv-node-panel-img {
    width: 52px; height: 64px;
    object-fit: cover; object-position: top center;
    border-radius: 6px; border: 1px solid rgba(212,168,67,0.3);
    flex-shrink: 0;
}
.adv-node-panel-name {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem; letter-spacing: 1px;
    color: rgba(200,210,220,0.95); margin: 0 0 0.15rem;
}
.adv-node-panel-stats {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem; color: rgba(200,210,220,0.5); margin: 0;
}
.adv-node-panel-close {
    position: absolute; top: 0; right: 0;
    background: none; border: none; cursor: pointer;
    font-size: 1rem; color: rgba(200,210,220,0.4); padding: 0.2rem 0.4rem;
    line-height: 1; transition: color 0.15s;
}
.adv-node-panel-close:hover { color: #d4a843; }

.adv-node-panel-cols {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
}
.adv-node-panel-col-title {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem; letter-spacing: 1.5px;
    color: rgba(212,168,67,0.7); margin: 0 0 0.5rem; text-transform: uppercase;
}
.adv-node-panel-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(212,168,67,0.1);
}
.adv-node-panel-row:last-child { border-bottom: none; }
.adv-node-panel-player {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem; color: rgba(200,210,220,0.8);
}
.adv-node-panel-badge {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem; color: #d4a843;
    background: rgba(212,168,67,0.15); border-radius: 4px;
    padding: 0.05rem 0.55rem; min-width: 24px; text-align: center;
}
.adv-node-panel-empty {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem; color: rgba(200,210,220,0.35); margin: 0;
}

.adv-funnel-note {
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    color: rgba(200,210,220,0.55);
    margin: 0.4rem 0 0;
}
.adv-funnel-note strong { color: #d4a843; }

.adv-player-pick {
    max-width: 280px;
    margin: 0 auto 1.25rem;
}

@media (max-width: 640px) {
    .adv-root { padding: 0 0.25rem; }
    .adv-filters { padding: 0.75rem; gap: 0.5rem; margin-bottom: 1.75rem; }
    .adv-filter-group { min-width: 0; flex: 1 1 100%; }
    .adv-section { margin-bottom: 2rem; }
    .adv-section-title { font-size: 1.2rem; }
    .adv-card { padding: 1rem 0.25rem 0.75rem; }
    .adv-node-panel { padding: 0.85rem 0.85rem 1rem; }
    .adv-node-panel-cols { grid-template-columns: 1fr; gap: 0.75rem; }
    .adv-graph-tooltip { display: none !important; }
}

@media (max-width: 420px) {
    .adv-section-title { font-size: 1.05rem; letter-spacing: 1px; }
    .adv-section-sub { font-size: 0.72rem; }
    .adv-node-panel-name { font-size: 0.98rem; }
    .adv-node-panel-img { width: 44px; height: 56px; }
    .adv-node-panel-badge { font-size: 0.78rem; }
}

@media (min-width: 1280px) {
    .adv-root { max-width: 980px; }
}
</style>

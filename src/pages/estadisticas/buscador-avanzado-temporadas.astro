---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import "../../styles/buscador.css";
import { getMatchFilterOptions } from "../../utils/buscador-filtros";
import BuscadorTemporadas from "../../components/BuscadorTemporadas";
import BreadcrumbTrail from "../../components/BreadcrumbTrail.astro";
import EditorialInfoCards from "../../components/EditorialInfoCards.astro";

const { competitions } = await getMatchFilterOptions();
---

<Layout
    title="Comparador de temporadas del Real Madrid Femenino | MFX"
    description="Compara las temporadas del Real Madrid Femenino: balance, goles, puntos, xG, posesión y estadísticas de equipo, en totales o por partido."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <BreadcrumbTrail items={[
            { label: "Inicio", href: "/" },
            { label: "Hub", href: "/estadisticas-real-madrid-femenino" },
            { label: "Buscador de temporadas" },
        ]} />
        <header class="page-header-container">
            <h1 class="landing-title" data-title="BUSCADOR DE TEMPORADAS">BUSCADOR DE TEMPORADAS</h1>
            <p class="landing-subtitle">
                Compara y ordena las temporadas por balance, goles, puntos y estadísticas de equipo
            </p>
        </header>

        <EditorialInfoCards
            introduction="Compara la evolución colectiva del Real Madrid Femenino entre temporadas mediante resultados, goles, puntos y estadísticas de rendimiento."
            utility="Ordena los datos en valores totales o por partido para identificar las temporadas con mejor balance y comparar competiciones equivalentes."
            methodology="Los cálculos incluyen únicamente partidos finalizados. Las métricas avanzadas se muestran cuando existen registros suficientes y los campos ausentes se omiten."
        />

        <BuscadorTemporadas
            client:load
            competitions={competitions}
        />
    </main>
</Layout>

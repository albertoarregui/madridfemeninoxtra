---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import "../../styles/buscador.css";
import { getMatchFilterOptions } from "../../utils/buscador-filtros";
import BuscadorTemporadas from "../../components/BuscadorTemporadas";

const { competitions } = await getMatchFilterOptions();
---

<Layout
    title="Buscador Avanzado de Temporadas | Madrid Femenino Xtra"
    description="Compara las temporadas del Real Madrid Femenino: balance, goles, puntos, xG, posesión y estadísticas de equipo, en totales o por partido."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <header class="page-header-container">
            <h1 class="landing-title" data-title="BUSCADOR DE TEMPORADAS">BUSCADOR DE TEMPORADAS</h1>
            <p class="landing-subtitle">
                Compara y ordena las temporadas por balance, goles, puntos y estadísticas de equipo
            </p>
        </header>

        <BuscadorTemporadas
            client:load
            competitions={competitions}
        />
    </main>
</Layout>

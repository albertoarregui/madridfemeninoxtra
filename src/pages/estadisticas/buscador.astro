---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { fetchPlayersDirectly } from "../../utils/players";
import { fetchRankingsDirectly } from "../../utils/rankings";
import BuscadorAvanzado from "../../components/BuscadorAvanzado";

const playersData = await fetchPlayersDirectly();
const rankingsData = await fetchRankingsDirectly();

const playerImageMap = Object.fromEntries(
    playersData.map((p: any) => [p.slug, p.imageUrl]),
);

const uniqueSeasons = [
    ...new Set(
        rankingsData.map((r: any) => r.temporada).filter((s: any): s is string => !!s),
    ),
].sort().reverse();

const competitionOrder = ["Liga F", "UWCL", "Copa de la Reina", "Supercopa de España", "Amistosos"];
const uniqueCompetitions = [
    ...new Set(
        rankingsData.map((r: any) => r.competicion).filter((c: any): c is string => !!c),
    ),
].sort((a, b) => {
    const ia = competitionOrder.indexOf(a);
    const ib = competitionOrder.indexOf(b);
    if (ia !== -1 && ib !== -1) return ia - ib;
    if (ia !== -1) return -1;
    if (ib !== -1) return 1;
    return a.localeCompare(b);
});
---

<Layout
    title="Buscador Avanzado de Estadísticas | Madrid Femenino Xtra"
    description="Busca, filtra y ordena las estadísticas del Real Madrid Femenino por jugadora, temporada, competición, posición y mucho más."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <header class="page-header-container">
            <h1 class="landing-title" data-title="BUSCADOR AVANZADO">BUSCADOR AVANZADO</h1>
            <p class="landing-subtitle">
                Filtra y ordena las estadísticas por jugadora, temporada y competición
            </p>
        </header>

        <BuscadorAvanzado
            client:load
            seasons={uniqueSeasons}
            competitions={uniqueCompetitions}
            playerImageMap={playerImageMap}
        />
    </main>
</Layout>

<style is:global>
.bus-root {
    max-width: 1100px;
    margin: 0 auto 5rem;
}

.bus-filters-panel {
    background: rgba(6,13,28,0.7);
    border-radius: 10px;
    border: 1px solid rgba(212,168,67,0.2);
    padding: 1rem 1.25rem;
    margin-bottom: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.bus-search-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
}

.bus-search-wrap {
    position: relative;
    flex: 1 1 200px;
    min-width: 160px;
}

.bus-search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(200,210,220,0.35);
    pointer-events: none;
}

.bus-search-input {
    width: 100%;
    padding: 0.58rem 2.3rem 0.58rem 2.1rem;
    border: 1px solid rgba(212,168,67,0.25);
    border-radius: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.86rem;
    color: rgba(200,210,220,0.9);
    background: rgba(6,13,28,0.6);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box;
}
.bus-search-input:focus {
    border-color: #d4a843;
    box-shadow: 0 0 0 2px rgba(212,168,67,0.15);
}
.bus-search-input::placeholder { color: rgba(200,210,220,0.3); }

.bus-search-clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(200,210,220,0.35);
    padding: 0;
    display: flex;
    align-items: center;
    transition: color 0.15s;
}
.bus-search-clear:hover { color: #d4a843; }

.bus-filter-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    border: 1px solid rgba(212,168,67,0.25);
    background: rgba(6,13,28,0.6);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.83rem;
    font-weight: 600;
    color: rgba(200,210,220,0.65);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    position: relative;
    white-space: nowrap;
    flex-shrink: 0;
}
.bus-filter-toggle:hover, .bus-filter-toggle.open {
    border-color: #d4a843;
    color: rgba(200,210,220,0.9);
}

.bus-filter-badge {
    position: absolute;
    top: 5px;
    right: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d4a843;
}

.bus-filters-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.5rem 0.6rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(212,168,67,0.12);
}

.bus-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
}

.bus-filter-group:nth-child(1),
.bus-filter-group:nth-child(2),
.bus-filter-group:nth-child(3),
.bus-filter-group:nth-child(4) {
    grid-row: 1;
    grid-column: span 3;
}

.bus-filter-group.bus-filter-partido {
    grid-row: 2 !important;
    grid-column: 1 / -1 !important;
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
}
.selected-text {
    flex: 1;
    min-width: 0;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bus-filter-group.bus-filter-partido .custom-select-container {
    width: 100% !important;
    max-width: none !important;
}
.bus-filter-group.bus-filter-partido .custom-select-trigger {
    width: 100% !important;
    max-width: none !important;
}

.bus-filter-group:nth-child(5),
.bus-filter-group:nth-child(6) {
    grid-row: 3;
    grid-column: span 2;
}

.bus-filter-group:nth-child(8) {
    grid-row: 3;
    grid-column: span 8;
}

.bus-filter-label {
    font-family: 'Cinzel', serif;
    font-size: 0.55rem;
    letter-spacing: 1.2px;
    color: rgba(212,168,67,0.65);
    text-transform: uppercase;
}

.bus-date-input {
    padding: 0.38rem 1.9rem 0.38rem 0.65rem;
    border: 1px solid rgba(212,168,67,0.3);
    border-radius: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    color: rgba(200,210,220,0.9);
    background: rgba(6,13,28,0.6);
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
    box-sizing: border-box;
}
.bus-date-input:focus { border-color: #d4a843; box-shadow: 0 0 0 2px rgba(212,168,67,0.15); }
.bus-date-input::placeholder { color: rgba(200,210,220,0.3); }
.bus-date-input::-webkit-calendar-picker-indicator {
    cursor: pointer;
    border-radius: 4px;
    margin-right: 0;
    opacity: 0.5;
    filter: invert(1);
}
.bus-date-input::-webkit-calendar-picker-indicator:hover {
    opacity: 0.9;
}

.bus-date-wrap {
    position: relative;
    display: flex;
    align-items: center;
}

.bus-date-clear {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(200,210,220,0.35);
    padding: 0;
    display: flex;
    align-items: center;
    transition: color 0.15s;
}
.bus-date-clear:hover { color: #d4a843; }

.bus-min-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    border: 1px solid rgba(212,168,67,0.3);
    border-radius: 6px;
    padding: 0.38rem 0.75rem;
    background: rgba(6,13,28,0.6);
}
.bus-min-input {
    border: none;
    outline: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(200,210,220,0.9);
    background: transparent;
    width: 45px;
    text-align: center;
}
.bus-min-unit {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    color: rgba(200,210,220,0.45);
}

.bus-per90-toggle {
    display: flex;
    background: rgba(6,13,28,0.8);
    border: 1px solid rgba(212,168,67,0.2);
    border-radius: 6px;
    padding: 3px;
    gap: 2px;
    flex-shrink: 0;
}
.bus-per90-btn {
    padding: 0.38rem 0.85rem;
    border-radius: 4px;
    border: none;
    background: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(200,210,220,0.5);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
}
.bus-per90-btn.active {
    background: rgba(212,168,67,0.2);
    color: #d4a843;
}

.bus-reset-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.42rem 0.85rem;
    border-radius: 6px;
    border: 1px solid rgba(212,168,67,0.2);
    background: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(200,210,220,0.45);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
}
.bus-reset-btn:hover { border-color: rgba(212,168,67,0.5); color: rgba(200,210,220,0.8); }

.bus-groups-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
}
.bus-group-btn {
    padding: 0.4rem 1.05rem;
    border-radius: 6px;
    border: 1px solid rgba(212,168,67,0.2);
    background: rgba(6,13,28,0.5);
    font-family: 'Cinzel', serif;
    font-size: 0.78rem;
    letter-spacing: 0.5px;
    color: rgba(200,210,220,0.55);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.bus-group-btn:hover { border-color: rgba(212,168,67,0.5); color: rgba(200,210,220,0.85); }
.bus-group-btn.active { background: rgba(212,168,67,0.2); border-color: #d4a843; color: #d4a843; font-weight: 700; }

.bus-meta-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.6rem;
    min-height: 1.6rem;
}
.bus-results-count {
    font-family: 'Cinzel', serif;
    font-size: 0.9rem;
    letter-spacing: 1px;
    color: rgba(200,210,220,0.7);
}
.bus-per90-badge {
    font-family: 'Cinzel', serif;
    font-size: 0.75rem;
    letter-spacing: 1px;
    background: rgba(212,168,67,0.2);
    color: #d4a843;
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
}
.bus-loading-inline {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(212,168,67,0.2);
    border-top-color: #d4a843;
    border-radius: 50%;
    animation: bus-spin 0.7s linear infinite;
    flex-shrink: 0;
    vertical-align: middle;
}

.bus-table-wrap {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid rgba(212,168,67,0.15);
}

.bus-table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.84rem;
}

.bus-th {
    background: rgba(212,168,67,0.1);
    color: rgba(212,168,67,0.85);
    padding: 0.7rem 0.8rem;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.5px;
}
.bus-th-player {
    text-align: left;
    min-width: 180px;
    position: sticky;
    left: 0;
    z-index: 2;
}
.bus-th-stat {
    text-align: right;
    cursor: pointer;
    user-select: none;
    min-width: 52px;
}
.bus-th-stat:hover { background: rgba(212,168,67,0.15); }
.bus-th-stat.sorted { background: rgba(212,168,67,0.2) !important; color: #d4a843; }
.bus-th-stat.sorted:hover { background: rgba(212,168,67,0.25) !important; }

.bus-th-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
}
.bus-sort-neutral {
    opacity: 0.3;
    font-size: 0.7rem;
}

.bus-td {
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid rgba(212,168,67,0.07);
    vertical-align: middle;
}
.bus-td-player {
    text-align: left;
    position: sticky;
    left: 0;
    background: rgba(6,13,28,0.95);
    z-index: 1;
}
.bus-td-stat {
    text-align: right;
    color: rgba(200,210,220,0.8);
    font-variant-numeric: tabular-nums;
}
.bus-td-stat.sorted {
    background: rgba(212,168,67,0.07) !important;
    font-weight: 600;
    color: rgba(200,210,220,0.95);
}
.bus-td-stat.top3 {
    color: #d4a843;
    font-weight: 700;
}

.bus-tr .bus-td { background-color: rgba(6,13,28,0.85); }
.bus-tr .bus-td-player { background-color: rgba(6,13,28,0.95); }
.bus-tr.alt .bus-td { background-color: rgba(6,13,28,0.7); }
.bus-tr.alt .bus-td-player { background-color: rgba(6,13,28,0.85); }
.bus-tr:hover .bus-td { background-color: rgba(212,168,67,0.07) !important; }
.bus-tr:hover .bus-td-player { background-color: rgba(212,168,67,0.07) !important; }

.bus-player-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    padding: 0.1rem 0;
}

.bus-rank {
    font-family: 'Cinzel', serif;
    font-size: 0.78rem;
    color: rgba(200,210,220,0.3);
    min-width: 20px;
    text-align: right;
    flex-shrink: 0;
}

.bus-player-img {
    width: 28px;
    height: 34px;
    object-fit: cover;
    object-position: top center;
    border-radius: 4px;
    border: 1px solid rgba(212,168,67,0.2);
    flex-shrink: 0;
}

.bus-player-img-ph {
    width: 28px;
    height: 34px;
    border-radius: 4px;
    background: rgba(212,168,67,0.08);
    flex-shrink: 0;
}

.bus-player-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
}
.bus-player-name {
    font-weight: 600;
    color: rgba(200,210,220,0.9);
    font-size: 0.84rem;
    transition: color 0.12s;
    line-height: 1.2;
}
.bus-player-link:hover .bus-player-name { color: #d4a843; }

.bus-player-pos {
    font-size: 0.7rem;
    color: rgba(200,210,220,0.4);
}

.bus-loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 200px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: rgba(200,210,220,0.4);
}

.bus-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(212,168,67,0.15);
    border-top-color: #d4a843;
    border-radius: 50%;
    animation: bus-spin 0.9s linear infinite;
    flex-shrink: 0;
}
@keyframes bus-spin { to { transform: rotate(360deg); } }

.bus-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: rgba(200,210,220,0.35);
    padding: 2rem;
    text-align: center;
}

.bus-hint {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    color: rgba(200,210,220,0.3);
    text-align: center;
    margin-top: 0.85rem;
}

.bus-root .custom-select-container {
    position: relative;
    width: 100%;
    max-width: none !important;
}
.bus-root .custom-select-trigger {
    width: 100%;
    box-sizing: border-box;
}

@media (max-width: 640px) {
    .bus-filters-panel {
        padding: 0.75rem;
        overflow: hidden;
        width: 100%;
        box-sizing: border-box;
    }
    .bus-filters-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 0.75rem 0.5rem !important;
        width: 100% !important;
        display: grid !important;
    }

    .bus-filter-group {
        grid-row: auto !important;
        grid-column: span 1 !important;
        min-width: 0 !important;
        width: 100% !important;
        margin: 0 !important;
    }

    .bus-filter-partido,
    .bus-filter-group:nth-child(8) {
        grid-column: 1 / -1 !important;
    }

    .bus-min-wrap {
        gap: 0.5rem !important;
        padding: 0.42rem 0.75rem !important;
        width: 100% !important;
        box-sizing: border-box !important;
        margin: 0 !important;
        justify-content: center !important;
    }

    .bus-root .custom-select-container {
        width: 100% !important;
        min-width: 0 !important;
        max-width: none !important;
    }

    .bus-search-wrap { flex: 1 1 100%; }
    .bus-groups-row { gap: 0.3rem; flex-wrap: wrap; }
    .bus-group-btn { font-size: 0.72rem; padding: 0.3rem 0.6rem; }
}

@media (max-width: 480px) {
    .bus-filters-grid {
        grid-template-columns: 1fr !important;
    }
    .bus-filter-group {
        grid-column: 1 / -1 !important;
    }
}
</style>

---
import Layout from '../../layouts/Layout.astro';
import RatingScoreboard from '../../components/RatingScoreboard.astro';
import { ratingMatch, ratingPeople, ratingSummary, ratingsOpen } from '../../lib/ratings';
import { getAssetUrl } from '../../utils/assets';
import { getCurrentSeason } from '../../utils/season';
import { breadcrumbSchema } from '../../utils/seo';
import { ratingHref } from '../../lib/ratings';
import '../../styles/valoraciones.css';
export const prerender = false;
const raw=Astro.params.slug||'';
const found=raw.match(/^(\d{1,8})(?:-|$)/);
const match=found?await ratingMatch(Number(found[1])):null;
if(!match) Astro.response.status=404;
const players=match?await ratingPeople(match.id):[];
const aggregate=match?await ratingSummary(match.id):[];
const starter=players.filter(x=>x.titular);
const substitutes=players.filter(x=>!x.titular);
const open=match?ratingsOpen(match):false;
const demo=process.env.VERCEL_ENV !== 'production';
const manager=match?.entrenador_id?{
 id:-match.entrenador_id,name:match.entrenador_nombre||'Entrenador/a',
 image:match.entrenador_foto_url,number:'',position:'Entrenador/a',minutes:0,coach:true,titular:false
}:null;
const summary=(id:number)=>aggregate.find(a=>a.id===id);
const mvp=aggregate.filter(a=>a.mvpVotes>0&&a.id>0).sort((a,b)=>b.mvpVotes-a.mvpVotes)[0];
const mvpPerson=mvp?players.find(x=>x.id===mvp.id):null;
const totalVotes=aggregate.reduce((a,b)=>a+b.count,0);
const date=match?new Date(match.fecha+'T12:00:00Z').toLocaleDateString('es-ES',{timeZone:'Europe/Madrid',day:'numeric',month:'long',year:'numeric'}):'';
function photo(p:any){
 const url=p.image && /^https?:\/\//.test(p.image)?p.image:null;
 return url||getAssetUrl(p.coach?'entrenadores':'jugadorasPerfil',p.image||p.name)||
 (!p.coach?getAssetUrl('jugadoras',p.name):'');
}
const legend=Array.from({length:10},(_,i)=>i+1);
function scoreColor(n:number){return n<=4?'#db3830':n<=6?'#df8a2f':n===7?'#51bd50':n===8?'#50abc0':'#4c58f7';}
---
<Layout
  title={match?`Valoraciones ${match.club_local} vs ${match.club_visitante}: notas y MVP | MFX`:'Partido no encontrado | MFX'}
  description={match?`Puntúa a las jugadoras y al entrenador del ${match.club_local} vs ${match.club_visitante}, ${match.competicion} ${getCurrentSeason()}. Consulta las medias y vota a la MVP.`:'No encontramos el partido solicitado.'}
  ogTitle={match?`Valoraciones y MVP: ${match.club_local} vs ${match.club_visitante} | MFX`:'Partido no encontrado | MFX'}
  ogDescription={match?`Votaciones del ${match.club_local} vs ${match.club_visitante}, ${match.competicion}. Notas del 1 al 10 y MVP elegida por los aficionados.`:'Partido no encontrado.'}
  canonical={match?ratingHref(match):undefined}
  noindex={!match}
>
  {match && <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema([
    {name:'Inicio',path:'/'},
    {name:'Valoraciones',path:'/valoraciones'},
    {name:`${match.club_local} vs ${match.club_visitante}`,path:ratingHref(match)}
  ]))}/>}
  <main class="mfx-rating-main">
    <div class="mfx-rating-container">
      {match ? <>
        <header class="page-header-container mfx-rating-page-header">
          <h1 class="landing-title">VALORACIONES</h1>
          <p class="landing-subtitle">{match.club_local} VS {match.club_visitante} · {match.competicion} · {date}</p>
        </header>
        <section class="mfx-rating-detail-hero" aria-label="Partido y resultado">
          <span class="mfx-rating-corner mfx-rating-corner-tl" aria-hidden="true"></span>
          <span class="mfx-rating-corner mfx-rating-corner-tr" aria-hidden="true"></span>
          <span class="mfx-rating-corner mfx-rating-corner-bl" aria-hidden="true"></span>
          <span class="mfx-rating-corner mfx-rating-corner-br" aria-hidden="true"></span>
          <div class="mfx-rating-competition" style="margin-bottom:30px">
            {(() => {const src=getAssetUrl('competiciones',match.competicion_foto_url||match.competicion);return src?<img src={src} alt={match.competicion}/>:null;})()}
            {match.competicion} · {date}
          </div>
          <RatingScoreboard match={match} large/>
        </section>
        <section class="mfx-rating-detail-summary">
          <div>
            <p class="mfx-rating-mvp-label">Mejor jugadora del partido (votación popular)</p>
            {mvpPerson?<div class="mfx-rating-mvp-winner">
              {photo(mvpPerson)&&<img src={photo(mvpPerson)} alt={mvpPerson.name}/>}
              <span>{mvpPerson.name}</span>
            </div>:<p class="mfx-rating-detail-copy">Todavía no hay una MVP elegida por los lectores.</p>}
          </div>
          <p class="mfx-rating-detail-copy">{totalVotes} valoraciones individuales · {open?'Votación abierta':'Votación cerrada'}</p>
        </section>
        <h2 class="mfx-rating-subheading">Tus valoraciones</h2>
        <p class="mfx-rating-detail-copy">Puntúa del 1 al 10 al entrenador y a las jugadoras. Puedes dejar alguna sin puntuar y elegir a una sola MVP del partido.</p>
        {demo?<p class="mfx-rating-alert"><strong>Vista previa:</strong> puedes probar la selección de notas y MVP, pero no se guardarán votos ni se enviarán correos.</p>:!open?<p class="mfx-rating-alert">La votación de este encuentro ya se ha cerrado. Puedes consultar los promedios históricos.</p>:null}
        {[
          {title:'ENTRENADOR/A',list:manager?[manager]:[]},
          {title:'ONCE INICIAL',list:starter},
          {title:'SUPLENTES',list:substitutes}
        ].filter(section=>section.list.length).map(section=><section aria-label={section.title}>
          <h2 class="mfx-rating-section-title">{section.title}</h2>
          <div class="mfx-rating-section-rule"></div>
          {section.list.map(p=><div class="mfx-rating-person" data-rating-person={p.id}>
            <div class="mfx-rating-identity">
              {photo(p)&&<img src={photo(p)} alt={p.name} width="92" height="92" loading="lazy"/>}
              <div>
                <div class="mfx-rating-person-pos">{p.coach?'Entrenador/a':p.position}</div>
                <div class="mfx-rating-person-name">{p.name}</div>
                <div class="mfx-rating-person-meta">{p.coach?'Táctica · cambios':`${p.minutes>0?`${p.minutes} min`:'Minutos no disponibles'} · #${p.number||'—'}`}</div>
              </div>
            </div>
            <div>
              <p class="mfx-rating-pick-label">Tu valoración</p>
              <div class="mfx-rating-scores-scroll"><div class="mfx-rating-scores" role="group" aria-label={`Valorar a ${p.name}`}>
                {legend.map(n=><button type="button" class="mfx-rating-score-btn" style={`--scoreColor:${scoreColor(n)}`} aria-pressed="false" data-score={n} disabled={!open&&!demo}>{n}</button>)}
              </div></div>
              {!p.coach&&<div class="mfx-rating-mvp-choice">
                <button type="button" class="mfx-rating-mvp-btn" data-mvp={p.id} aria-pressed="false" disabled={!open&&!demo}>☆ MVP DEL PARTIDO</button>
                <span class="mfx-rating-mvp-count">{summary(p.id)?.mvpVotes||0} votos MVP</span>
              </div>}
            </div>
            <div class="mfx-rating-avg">
              <span class="mfx-rating-avg-label">Media aficionados</span>
              <strong class="mfx-rating-avg-number" style={`color:${scoreColor(Math.round(summary(p.id)?.average||7))}`}>{summary(p.id)?.average?.toFixed(1).replace('.',',')||'—'}</strong>
              <span class="mfx-rating-avg-count">{summary(p.id)?.count||0} valoraciones</span>
            </div>
          </div>)}
        </section>)}
        <div class="mfx-rating-action">
          <button class="mfx-rating-save" type="button" id="mfx-rating-save" disabled={!open&&!demo}>GUARDAR VALORACIONES</button>
          <button class="mfx-rating-mvp-btn" type="button" id="mfx-rating-share">Compartir valoraciones ↗</button>
          <span id="mfx-rating-feedback" class="mfx-rating-feedback" role="status" aria-live="polite"></span>
        </div>
        <p class="mfx-rating-detail-copy">Para publicar votos se requiere iniciar sesión. Cada usuario puede actualizar sus puntuaciones mientras la votación esté abierta. Las notas de lectores no modifican las estadísticas deportivas.</p>
      </> : <div class="mfx-rating-empty"><h1>Partido no encontrado</h1><a href="/valoraciones">Volver a las valoraciones</a></div>}
    </div>
  </main>
</Layout>
{match&&<script is:inline define:vars={{matchId:match.id,isDemo:demo,isOpen:open}}>
  (() => {
    const selected=new Map();
    let mvp=null;
    const rows=[...document.querySelectorAll('[data-rating-person]')];
    for(const row of rows) {
      const id=Number(row.getAttribute('data-rating-person'));
      row.querySelectorAll('[data-score]').forEach(button=>button.addEventListener('click',()=>{
        const score=Number(button.dataset.score);
        if(selected.get(id)===score)selected.delete(id);else selected.set(id,score);
        row.querySelectorAll('[data-score]').forEach(b=>b.setAttribute('aria-pressed',String(selected.get(id)===Number(b.dataset.score))));
        if(mvp===id&&!selected.has(id)){mvp=null;document.querySelectorAll('[data-mvp]').forEach(b=>b.setAttribute('aria-pressed','false'));}
      }));
      const mvpButton=row.querySelector('[data-mvp]');
      if(mvpButton)mvpButton.addEventListener('click',()=>{
        if(!selected.has(id)) {
          const m=document.getElementById('mfx-rating-feedback');
          if(m)m.textContent='Primero selecciona una puntuación para la MVP.';
          return;
        }
        mvp=mvp===id?null:id;
        document.querySelectorAll('[data-mvp]').forEach(b=>{b.setAttribute('aria-pressed',String(Number(b.dataset.mvp)===mvp));b.textContent=Number(b.dataset.mvp)===mvp?'★ MVP SELECCIONADA':'☆ MVP DEL PARTIDO';});
      });
    }
    const feedback=document.getElementById('mfx-rating-feedback');
    document.getElementById('mfx-rating-share')?.addEventListener('click',async()=>{
      const url=location.href;
      if(navigator.share) {try{await navigator.share({title:document.title,url});return;}catch{}}
      try{await navigator.clipboard.writeText(url);feedback.textContent='Enlace copiado.';}catch{feedback.textContent=url;}
    });
    document.getElementById('mfx-rating-save')?.addEventListener('click',async(event)=>{
      if(selected.size===0){feedback.textContent='Selecciona al menos una valoración.';return;}
      if(isDemo){feedback.textContent='Demostración completada. Las notas y MVP no se guardan en la vista previa.';return;}
      if(!isOpen){feedback.textContent='Votación cerrada.';return;}
      const button=event.currentTarget;button.disabled=true;feedback.textContent='Guardando…';
      const scores=[...selected].map(([id,score])=>({id,score,mvp:id===mvp}));
      try{
        const response=await fetch('/api/valoraciones/'+matchId,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({scores})});
        const result=await response.json();
        feedback.textContent=result.ok?'¡Gracias! Tus valoraciones se han guardado.':result.error||'No se pudieron guardar tus votos.';
        if(response.status===401)feedback.textContent='Inicia sesión con el botón del encabezado para poder votar.';
      }catch {feedback.textContent='Error de conexión. Vuelve a intentarlo.'}
      finally{button.disabled=false;}
    });
    // En producción, recuperar las puntuaciones guardadas por el usuario.
    if(!isDemo) fetch('/api/valoraciones/'+matchId,{credentials:'same-origin'}).then(r=>r.json()).then(data=>{
      for(const [key,val] of Object.entries(data.own||{})){
        const id=Number(key),row=rows.find(x=>Number(x.dataset.ratingPerson)===id);
        if(!row)continue;selected.set(id,val.score);
        row.querySelectorAll('[data-score]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.score)===val.score)));
        if(val.mvp)mvp=id;
      }
      document.querySelectorAll('[data-mvp]').forEach(b=>{const picked=Number(b.dataset.mvp)===mvp;b.setAttribute('aria-pressed',String(picked));b.textContent=picked?'★ MVP SELECCIONADA':'☆ MVP DEL PARTIDO';});
    }).catch(()=>{});
  })();
</script>}

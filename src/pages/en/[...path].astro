---
// La traducción conserva las rutas canónicas españolas y el middleware sirve
// el recurso equivalente. Esta ruta hace que el adaptador de Vercel reconozca
// `/en/*` antes de ejecutar la reescritura, evitando un 404 heredado.
import Layout from "../../layouts/Layout.astro";
Astro.response.status = 404;
---

<Layout title="Page not found | Madrid Femenino Xtra" noindex={true}>
  <main class="error-page">
    <h1 class="error-title">404</h1>
    <p>The page you are looking for does not exist.</p>
    <a href="/en/">Back to home</a>
  </main>
</Layout>

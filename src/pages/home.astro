---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import "../styles/home.css";
import ResumenEstadisticas from "../components/ResumenEstadisticas.astro";
import Calendar from "../components/Calendar.astro";
import YoutubeSection from "../components/YoutubeSection.astro";
import PlayerOfTheMonthWidget from "../components/PlayerOfTheMonthWidget.astro";
import HistoryCarousel from "../components/HistoryCarousel.astro";
import ProtagonistasSection from "../components/ProtagonistasSection.astro";
import GaleriasSection from "../components/GaleriasSection.astro";
import { getAssetUrl } from "../utils/assets";

const mapaJugadoras = getAssetUrl("sidebar", "mapa_jugadoras.png");
const mapaPartidos = getAssetUrl("sidebar", "mapa_partidos.png");

import { fetchGamesDirectly, fetchAllGoals } from "../utils/partidos";
import ClubStatsDashboard from "../components/ClubStatsDashboard";

const gamesData = await fetchGamesDirectly();
const allGoals = await fetchAllGoals();

let spotlightNews: any[] = [];
try {
	const { contentfulClient } = await import("../lib/contentful");

	const cronicaEntry = await contentfulClient.getEntries({
		content_type: "noticia",
		limit: 1,
		"fields.category": "CRÓNICA",
		order: ["-sys.createdAt"],
	});
	const previaEntry = await contentfulClient.getEntries({
		content_type: "noticia",
		limit: 1,
		"fields.category": "PREVIA",
		order: ["-sys.createdAt"],
	});

	const cronica = cronicaEntry.items[0];
	const previa = previaEntry.items[0];

	if (previa)
		spotlightNews.push({
			...previa.fields,
			id: previa.sys.id,
			createdAt: previa.sys.createdAt,
		});
	if (cronica)
		spotlightNews.push({
			...cronica.fields,
			id: cronica.sys.id,
			createdAt: cronica.sys.createdAt,
		});
} catch (e) {
	console.error("Error fetching news for home:", e);
}

const CAMPOS_PARTIDO_STATS = [
	"temporada_nombre",
	"competicion_nombre",
	"goles_rm",
	"goles_rival",
	"penaltis",
	"resultado",
	"asistencia",
	"capacidad",
	"estadio",
	"faltas_cometidas",
	"faltas_recibidas",
	"amarillas_rm",
	"amarillas_rival",
	"rojas_rm",
	"rojas_rival",
	"penaltis_rm",
	"penaltis_rival",
	"club_local",
	"club_visitante",
	"fecha",
] as const;

const CAMPOS_GOL_STATS = [
	"id_gol",
	"minuto",
	"temporada",
	"competicion",
	"nombre_goleadora",
	"foto_goleadora",
	"nombre_asistente",
	"foto_asistente",
] as const;

function proyectar<T extends Record<string, any>>(
	filas: T[],
	campos: readonly string[],
): T[] {
	return filas.map((fila) => {
		const salida: Record<string, any> = {};
		for (const campo of campos) {
			if (fila[campo] !== undefined) salida[campo] = fila[campo];
		}
		return salida as T;
	});
}

const statsMatches = proyectar(gamesData, CAMPOS_PARTIDO_STATS);
const statsGoals = proyectar(allGoals, CAMPOS_GOL_STATS);

const uniqueSeasons = [
	...new Set(gamesData.map((g) => g.temporada_nombre).filter((s) => s)),
]
	.sort()
	.reverse();

const competitionOrder = [
	"Liga F",
	"UWCL",
	"Copa de la Reina",
	"Supercopa de España",
	"Amistosos",
];

const uniqueCompetitions = [
	...new Set(gamesData.map((g) => g.competicion_nombre).filter((c) => c)),
].sort((a, b) => {
	const indexA = competitionOrder.indexOf(a as string);
	const indexB = competitionOrder.indexOf(b as string);
	if (indexA !== -1 && indexB !== -1) return indexA - indexB;
	if (indexA !== -1) return -1;
	if (indexB !== -1) return 1;
	return (a as string).localeCompare(b as string);
});

const schema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Madrid Femenino Xtra",
	url: "https://www.madridfemeninoxtra.com",
	potentialAction: {
		"@type": "SearchAction",
		target: "https://www.madridfemeninoxtra.com/search?q={search_term_string}",
		"query-input": "required name=search_term_string",
	},
};

let masLeidas: { slug: string; title: string; subtitle?: string; category?: string; imageUrl?: string }[] = [];
try {
	const { getAnalyticsDbClient } = await import("../db/client");
	const analyticsClient = await getAnalyticsDbClient();
	if (analyticsClient) {
		const topResult = await analyticsClient.execute({
			sql: `SELECT slug FROM article_views ORDER BY views DESC LIMIT 5`,
			args: [],
		});
		const topSlugs = topResult.rows.map((r: any) => String(r.slug));
		if (topSlugs.length > 0) {
			const { contentfulClient } = await import("../lib/contentful");
			const related = await contentfulClient.getEntries({
				content_type: "noticia",
				"fields.slug[in]": topSlugs.join(","),
				select: ["sys.id", "fields.slug", "fields.title", "fields.subtitle", "fields.category", "fields.featuredImage"] as any,
				limit: 5,
			});
			const bySlug = Object.fromEntries(
				related.items.map((i: any) => [i.fields.slug, i.fields])
			);
			masLeidas = topSlugs
				.map((s: string) => bySlug[s])
				.filter(Boolean)
				.map((f: any) => ({
					slug: f.slug,
					title: f.title,
					subtitle: f.subtitle ?? '',
					category: f.category,
					imageUrl: f.featuredImage?.fields?.file?.url
						? `https:${f.featuredImage.fields.file.url}?fm=webp&w=120&h=80&q=75&fit=fill`
						: undefined,
				}));
		}
	}
} catch (_) {}
---

<Layout
	title="Madrid Femenino Xtra | Noticias y actualidad del Real Madrid Femenino"
	description="Tu fuente 100% dedicada al Real Madrid Femenino: Noticias, resultados, clasificación, calendario y estadísticas. ¡Entra y no te pierdas nada!"
>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<h1 class="titulo-seo">
		Real Madrid Femenino: noticias, resultados y estadísticas
	</h1>

	<section class="hero">
		<div class="hero-text">
<ResumenEstadisticas />
		</div>
	</section>

	<div class="w-full overflow-hidden" style="padding: 3rem 0;">
		<HistoryCarousel />
	</div>

	<div class="content-layout">
		<main class="welcome-area">
			<section class="news-content">
				{
					spotlightNews.length > 0 && (
						<div class="spotlight-section mb-[4rem]">
						<div class="title-block" style="margin-bottom:2rem">
							<h2 class="landing-title">NOTICIAS</h2>
						</div>
						<div class="spotlight-news-grid">
							{spotlightNews.map((noticia) => (
								<a
									href={`/noticias/${noticia.slug}`}
									class="spotlight-card"
								>
									<div class="spotlight-image">
										<Image
											src={
												noticia.featuredImage?.fields
													?.file?.url
													? `https:${noticia.featuredImage.fields.file.url}`
													: "/og.png"
											}
											alt={noticia.title}
											width={400}
											height={360}
											quality={72}
											format="webp"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<div class="spotlight-content">
										<span class={`spotlight-tag ${(noticia.category || "").toLowerCase()}`}>
											{noticia.category}
										</span>
										<h3 class="spotlight-title">
											{noticia.title}
										</h3>
										{noticia.subtitle && (
											<p class="spotlight-subtitle">{noticia.subtitle}</p>
										)}
										<time class="spotlight-date">
											{new Date(noticia.createdAt)
												.toLocaleDateString("es-ES", {
													day: "2-digit",
													month: "long",
													year: "numeric",
												})
												.toUpperCase()}
										</time>
									</div>
								</a>
							))}
						</div>
					</div>
					)
				}

				<div
					class="season-stats-section mb-[4rem] w-full"
					id="stats-dashboard"
				>
					<div class="title-block">
						<h2 class="landing-title">ESTADÍSTICAS</h2>
						<p class="landing-subtitle">
							Balance histórico por temporada y competición del Real
							Madrid Femenino
						</p>
					</div>
					<ClubStatsDashboard
						matches={statsMatches}
						goals={statsGoals}
						seasons={uniqueSeasons}
						competitions={uniqueCompetitions}
						client:load
					/>
				</div>

				<div class="protagonistas-container mb-[4rem] w-full">
					<ProtagonistasSection games={gamesData} />
				</div>

				<div class="galerias-container mb-[4rem] w-full">
					<GaleriasSection />
				</div>

				<div class="youtube-container mb-[4rem]">
					<YoutubeSection />
				</div>
			</section>
		</main>

		<aside class="proximo-partido sidebar-right">
			<span class="section-label">♦ CALENDAR ♦</span>
			<h2 class="section-title">CALENDARIO</h2>
			<Calendar />

			<span class="section-label">♦ PLAYER OF THE MONTH ♦</span>
			<h2 class="section-title">JUGADORA DEL MES</h2>
			<PlayerOfTheMonthWidget />

			{masLeidas.length > 0 && (
				<>
					<span class="section-label">♦ MOST READ ♦</span>
					<h2 class="section-title">MÁS LEÍDAS</h2>
					<ol class="mas-leidas-list">
						{masLeidas.map((n, i) => (
							<li class="mas-leidas-item">
								<a href={`/noticias/${n.slug}`} class="mas-leidas-link">
									<span class="mas-leidas-rank">{i + 1}</span>
									{n.imageUrl && (
										<Image
											src={n.imageUrl}
											alt={n.title}
											class="mas-leidas-thumb"
											width={140}
											height={140}
											quality={70}
											format="webp"
											loading="lazy"
											decoding="async"
										/>
									)}
									<div class="mas-leidas-info">
										{n.category && <span class="mas-leidas-cat">{n.category.toUpperCase()}</span>}
										<span class="mas-leidas-title">{n.title}</span>
									</div>
								</a>
							</li>
						))}
					</ol>
				</>
			)}

			<span class="section-label">♦ PLAYERS MAP ♦</span>
			<h2 class="section-title">MAPA DE JUGADORAS</h2>
			<a href="/jugadoras" class="sidebar-map-link">
				<div class="sidebar-map-frame">
					<img
						src={mapaJugadoras}
						alt="Mapa de Jugadoras Real Madrid Femenino"
						class="sidebar-map-img"
						width="450"
						height="180"
						loading="lazy"
					/>
					<div class="sidebar-map-overlay">Ver mapa →</div>
				</div>
			</a>

			<span class="section-label">♦ STADIUMS MAP ♦</span>
			<h2 class="section-title">MAPA DE ESTADIOS</h2>
			<a href="/partidos" class="sidebar-map-link">
				<div class="sidebar-map-frame">
					<img
						src={mapaPartidos}
						alt="Mapa de Estadios Real Madrid Femenino"
						class="sidebar-map-img"
						width="450"
						height="180"
						loading="lazy"
					/>
					<div class="sidebar-map-overlay">Ver mapa →</div>
				</div>
			</a>

			<span class="section-label">♦ STANDINGS ♦</span>
			<h2 class="section-title">CLASIFICACIÓN</h2>
			<div class="standings-frame">
				<iframe
					id="sofa-standings-embed-3739-77723"
					src="https://widgets.sofascore.com/embed/tournament/3739/season/77723/standings/Primera%20Division%2C%20Women%2025%2F26?widgetTitle=Primera%20Division%2C%20Women%2025%2F26&showCompetitionLogo=true"
					style="height:911px!important;max-width:768px!important;width:100%!important;"
					frameborder="0"
					scrolling="no"
					loading="lazy"
					title="Clasificación de Liga F"></iframe>
			</div>
			<div style="font-size:11px;font-family:'DM Sans',Arial,sans-serif;text-align:left;color:rgba(240,240,240,0.4);margin-top:0.4rem;">
				Clasificación ofrecida por <a
					target="_blank"
					href="https://www.sofascore.com/es-la/torneo/futbol/spain/liga-f/1127#id:77723"
					rel="noopener noreferrer"
					style="color:rgba(212,168,67,0.6);text-decoration:none;">Sofascore</a
				>
			</div>
		</aside>
	</div>
</Layout>

<style>
	.titulo-seo {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		border: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.sidebar-map-link {
		display: block;
		text-decoration: none;
		margin-bottom: 2rem;
	}
	.sidebar-map-frame {
		position: relative;
		border-radius: 10px;
		overflow: hidden;
		border: 1px solid rgba(212, 168, 67, 0.25);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
		transition: border-color 0.3s ease;
	}
	.sidebar-map-link:hover .sidebar-map-frame {
		border-color: rgba(212, 168, 67, 0.55);
	}
	.sidebar-map-img {
		display: block;
		width: 100%;
		height: 180px;
		object-fit: cover;
		filter: brightness(0.85);
		transition: filter 0.3s ease, transform 0.4s ease;
	}
	.sidebar-map-link:hover .sidebar-map-img {
		filter: brightness(1);
		transform: scale(1.03);
	}
	.sidebar-map-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 0.5rem 1rem;
		background: linear-gradient(to top, rgba(6, 13, 28, 0.75), transparent);
		color: #d4a843;
		font-family: 'Cinzel', serif;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-align: right;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.sidebar-map-link:hover .sidebar-map-overlay {
		opacity: 1;
	}
	.standings-frame {
		border-radius: 10px;
		overflow: hidden;
		border: 1px solid rgba(212, 168, 67, 0.2);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
		margin-bottom: 0.5rem;
	}
</style>

---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { Image } from "astro:assets";
import { GET } from "./api/search.ts";

const query = Astro.url.searchParams.get("q") || "";

interface SearchResult {
    type: "player" | "rival" | "match" | "coach" | "referee" | "stadium";
    title: string;
    subtitle: string;
    url: string;
    slug: string;
    relevance: number;
    imageUrl?: string;
    shieldUrl?: string;
}

const { fetchAllClubShields } = await import("../utils/rivales");
const clubShields = await fetchAllClubShields();

let results: SearchResult[] = [];
let error = "";

if (query) {
    try {
        const url = new URL(`http://localhost/api/search?q=${encodeURIComponent(query)}`);
        const response = await GET({ url } as any) as Response;
        
        if (response.ok) {
            const data = await response.json();
            results = data.results || [];
        } else {
            error = "Error al realizar la búsqueda";
        }
    } catch (e) {
        console.error("Search error:", e);
        error = "Error al realizar la búsqueda";
    }
}

const playerImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/jugadoras-perfil/*.{png,jpg,jpeg,webp}",
);

const coachImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/entrenadores/*.{png,jpg,jpeg,webp}",
);

async function getImage(result: SearchResult) {
    if (result.type === "rival") {
        if (result.shieldUrl) return { src: result.shieldUrl };

        const remoteShield = clubShields[result.title];
        if (remoteShield) return { src: remoteShield };

        const slugUnderscored = result.slug.replace(/-/g, "_").toLowerCase();
        return { src: `/assets/escudos/${slugUnderscored}.png` };
    }

    if (result.type === "player") {
        if (result.imageUrl) return { src: result.imageUrl };
    }

    if (result.type === "coach") {
        if (result.imageUrl) return { src: result.imageUrl };
    }

    if (result.type === "stadium") {
        try {
            const { getAllStadiums } = await import("../utils/estadios");
            const estadios = await getAllStadiums();
            const estadio = estadios.find((e) => e.slug === result.slug);
            if (estadio?.imageUrl) return { src: estadio.imageUrl };
        } catch (e) {
            console.error("Error fetching stadium image:", e);
        }
        return null;
    }

    let imagesRecord: Record<
        string,
        () => Promise<{ default: ImageMetadata }>
    > = {};
    let folderName = "";

    if (result.type === "player") {
        imagesRecord = playerImages;
        folderName = "jugadoras-perfil";
    } else if (result.type === "coach") {
        imagesRecord = coachImages;
        folderName = "entrenadores";
    } else {
        return null;
    }

    const slugUnderscored = result.slug.replace(/-/g, "_").toLowerCase();
    const slugNormal = result.slug.toLowerCase();

    const candidates = [
        `/src/assets/${folderName}/${slugUnderscored}.png`,
        `/src/assets/${folderName}/${slugNormal}.png`,
        `/src/assets/${folderName}/${slugUnderscored}.jpg`,
        `/src/assets/${folderName}/${slugNormal}.jpg`,
    ];

    for (const key of candidates) {
        if (imagesRecord[key]) {
            return (await imagesRecord[key]()).default;
        }
    }

    const matchingPath = Object.keys(imagesRecord).find((path) => {
        const fileName = path.split("/").pop()?.split(".")[0].toLowerCase();
        return fileName === slugNormal || fileName === slugUnderscored;
    });

    if (matchingPath) {
        return (await imagesRecord[matchingPath]()).default;
    }

    return null;
}

const playerResults = results.filter((r) => r.type === "player");
const rivalResults = results.filter((r) => r.type === "rival");
const coachResults = results.filter((r) => r.type === "coach");
const matchResults = results.filter((r) => r.type === "match");
const refereeResults = results.filter((r) => r.type === "referee");
const stadiumResults = results.filter((r) => r.type === "stadium");

let playerResultsWithImages: any[] = [];
let rivalResultsWithImages: any[] = [];
let coachResultsWithImages: any[] = [];
let stadiumResultsWithImages: any[] = [];

try {
    playerResultsWithImages = await Promise.all(
        playerResults.map(async (r) => ({
            ...r,
            image: await getImage(r).catch((e) => {
                console.error(`Error loading image for ${r.title}:`, e);
                return null;
            }),
        })),
    );

    rivalResultsWithImages = await Promise.all(
        rivalResults.map(async (r) => ({
            ...r,
            image: await getImage(r).catch((e) => {
                console.error(`Error loading image for ${r.title}:`, e);
                return null;
            }),
        })),
    );

    coachResultsWithImages = await Promise.all(
        coachResults.map(async (r) => ({
            ...r,
            image: await getImage(r).catch((e) => {
                console.error(`Error loading image for ${r.title}:`, e);
                return null;
            }),
        })),
    );

    stadiumResultsWithImages = await Promise.all(
        stadiumResults.map(async (r) => ({
            ...r,
            image: await getImage(r).catch((e) => {
                console.error(`Error loading image for ${r.title}:`, e);
                return null;
            }),
        })),
    );
} catch (e) {
    console.error("Critical error resolving search images:", e);
}
---

<Layout
    title={`Búsqueda: ${query} - Madrid Femenino Xtra`}
    ogTitle={`Resultados de búsqueda de ${query || "contenido"} | Madrid Femenino Xtra`}
    ogDescription="Encuentra noticias, jugadoras, partidos, estadísticas y otros contenidos del Real Madrid Femenino relacionados con tu búsqueda."
    noindex={true}
    showAds={false}
>
    <div class="search-page">
        <header class="page-header-container">
            <h1 class="landing-title">BÚSQUEDA</h1>
            <p class="landing-subtitle">Explora jugadoras, partidos, estadios, árbitras y rivales del Real Madrid Femenino</p>
        </header>

        <div class="search-container">

            <div class="search-box">
                <form action="/search" method="get" class="search-form">
                    <input
                        type="search"
                        name="q"
                        value={query}
                        placeholder="Buscar jugadoras, partidos, estadios, árbitras..."
                        class="search-input"
                        autofocus
                    />
                    <button type="submit" class="search-button">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        Buscar
                    </button>
                </form>
            </div>

            {
                query && (
                    <div class="search-results">
                        {error && <p class="error-message">{error}</p>}

                        {!error && results.length === 0 && (
                            <div class="no-results">
                                <p>
                                    No se encontraron resultados para "
                                    <strong>{query}</strong>"
                                </p>
                                <p class="suggestion">
                                    Intenta con otros términos de búsqueda
                                </p>
                            </div>
                        )}

                        {!error && results.length > 0 && (
                            <div class="results-summary">
                                <p>
                                    Se encontraron{" "}
                                    <strong>{results.length}</strong>{" "}
                                    resultado(s) para "<strong>{query}</strong>"
                                </p>
                            </div>
                        )}

                        {playerResultsWithImages.length > 0 && (
                            <section class="results-section">
                                <h2 class="section-title">
                                    Jugadoras ({playerResultsWithImages.length})
                                </h2>
                                <div class="results-grid">
                                    {playerResultsWithImages.map((result) => (
                                        <a
                                            href={result.url}
                                            class="result-card"
                                        >
                                            {result.image && (
                                                <div class="result-image-container player-image">
                                                    <img
                                                        src={result.image.src}
                                                        alt={result.title}
                                                        width="60"
                                                        height="60"
                                                        class="result-image"
                                                    />
                                                </div>
                                            )}
                                            <div class="result-info">
                                                <h3 class="result-title">
                                                    {result.title}
                                                </h3>
                                                <p class="result-subtitle">
                                                    {result.subtitle}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}

                        {rivalResultsWithImages.length > 0 && (
                            <section class="results-section">
                                <h2 class="section-title">
                                    Rivales ({rivalResultsWithImages.length})
                                </h2>
                                <div class="results-grid">
                                    {rivalResultsWithImages.map((result) => (
                                        <a
                                            href={result.url}
                                            class="result-card"
                                        >
                                            {result.image && (
                                                <div class="result-image-container">
                                                    <img
                                                        src={result.image.src}
                                                        alt={result.title}
                                                        width="60"
                                                        height="60"
                                                        class="result-image"
                                                    />
                                                </div>
                                            )}
                                            <div class="result-info">
                                                <h3 class="result-title">
                                                    {result.title}
                                                </h3>
                                                <p class="result-subtitle">
                                                    {result.subtitle}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}

                        {coachResultsWithImages.length > 0 && (
                            <section class="results-section">
                                <h2 class="section-title">
                                    Entrenadores (
                                    {coachResultsWithImages.length})
                                </h2>
                                <div class="results-grid">
                                    {coachResultsWithImages.map((result) => (
                                        <a
                                            href={result.url}
                                            class="result-card"
                                        >
                                            {result.image && (
                                                <div class="result-image-container player-image">
                                                    <img
                                                        src={result.image.src}
                                                        alt={result.title}
                                                        width="60"
                                                        height="60"
                                                        class="result-image"
                                                    />
                                                </div>
                                            )}
                                            <div class="result-info">
                                                <h3 class="result-title">
                                                    {result.title}
                                                </h3>
                                                <p class="result-subtitle">
                                                    {result.subtitle}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}

                        {stadiumResultsWithImages.length > 0 && (
                            <section class="results-section">
                                <h2 class="section-title">
                                    Estadios ({stadiumResultsWithImages.length})
                                </h2>
                                <div class="results-grid">
                                    {stadiumResultsWithImages.map((result) => (
                                        <a
                                            href={result.url}
                                            class="result-card stadium-card"
                                        >
                                            {result.image && (
                                                <div class="stadium-image-container">
                                                    <img
                                                        src={result.image.src}
                                                        alt={result.title}
                                                        class="stadium-image"
                                                    />
                                                </div>
                                            )}
                                            <div class="result-info">
                                                <h3 class="result-title">
                                                    {result.title}
                                                </h3>
                                                <p class="result-subtitle">
                                                    {result.subtitle}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}

                        {refereeResults.length > 0 && (
                            <section class="results-section">
                                <h2 class="section-title">
                                    Árbitras ({refereeResults.length})
                                </h2>
                                <div class="results-grid">
                                    {refereeResults.map((result) => (
                                        <a
                                            href={result.url}
                                            class="result-card"
                                        >
                                            <div class="result-info">
                                                <h3 class="result-title">
                                                    {result.title}
                                                </h3>
                                                <p class="result-subtitle">
                                                    {result.subtitle}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}

                        {matchResults.length > 0 && (
                            <section class="results-section">
                                <h2 class="section-title">
                                    Partidos ({matchResults.length})
                                </h2>
                                <div class="results-grid">
                                    {matchResults.map((result) => (
                                        <a
                                            href={result.url}
                                            class="result-card"
                                        >
                                            <div class="result-info">
                                                <h3 class="result-title">
                                                    {result.title}
                                                </h3>
                                                <p class="result-subtitle">
                                                    {result.subtitle}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}
                    </div>
                )
            }
        </div>
    </div>
</Layout>

<style>
    .search-page {
        min-height: 100vh;
        padding: 0 0 4rem;
        background: transparent;
    }

    .search-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .search-box,
    .search-results {
        position: relative;
        background: rgba(6, 13, 28, 0.88);
        border: 1px solid rgba(212, 168, 67, 0.22);
        border-radius: 4px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
    }

    .search-box {
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .search-box::before,
    .search-results::before {
        content: "";
        position: absolute;
        top: -1px;
        left: -1px;
        width: 24px;
        height: 24px;
        border-top: 2px solid #d4a843;
        border-left: 2px solid #d4a843;
        pointer-events: none;
    }

    .search-box::after,
    .search-results::after {
        content: "";
        position: absolute;
        right: -1px;
        bottom: -1px;
        width: 24px;
        height: 24px;
        border-right: 2px solid #d4a843;
        border-bottom: 2px solid #d4a843;
        pointer-events: none;
    }

    .search-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        max-width: 860px;
        margin: 0 auto;
    }

    .search-input {
        min-width: 0;
        padding: 0.9rem 1.1rem;
        border: 1px solid rgba(212, 168, 67, 0.42);
        border-radius: 3px;
        background: rgba(10, 20, 40, 0.92);
        color: #f0f0f0;
        font-family: "DM Sans", sans-serif;
        font-size: 0.95rem;
        text-align: left;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .search-input::placeholder {
        color: rgba(200, 210, 220, 0.42);
    }

    .search-input:focus {
        outline: none;
        border-color: #d4a843;
        box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.12);
    }

    .search-button {
        min-height: 48px;
        padding: 0.85rem 1.7rem;
        border: 1px solid #d4a843;
        border-radius: 3px;
        background: linear-gradient(135deg, #d4a843 0%, #c49030 100%);
        color: #060d1c;
        font-family: "Cinzel", serif;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
    }

    .search-button:hover {
        transform: translateY(-2px);
        filter: brightness(1.06);
        box-shadow: 0 8px 24px rgba(212, 168, 67, 0.2);
    }

    .search-button:focus-visible {
        outline: 2px solid #f5d483;
        outline-offset: 3px;
    }

    .search-button svg {
        width: 18px;
        height: 18px;
    }

    .search-results {
        padding: 1.5rem;
        overflow: hidden;
    }

    .results-summary,
    .no-results,
    .error-message {
        margin: 0 0 2rem;
        padding: 1rem 1.15rem;
        border-radius: 3px;
        font-family: "DM Sans", sans-serif;
    }

    .results-summary {
        background: rgba(212, 168, 67, 0.07);
        border-left: 3px solid #d4a843;
        color: rgba(240, 240, 240, 0.78);
    }

    .results-summary p {
        margin: 0;
    }

    .results-summary strong {
        color: #d4a843;
    }

    .no-results {
        text-align: center;
        background: rgba(10, 20, 40, 0.74);
        border: 1px solid rgba(212, 168, 67, 0.14);
        color: rgba(200, 210, 220, 0.72);
    }

    .no-results strong {
        color: #f0f0f0;
        overflow-wrap: anywhere;
    }

    .suggestion {
        margin: 0.6rem 0 0;
        font-size: 0.82rem;
        color: rgba(200, 210, 220, 0.48);
    }

    .error-message {
        background: rgba(170, 35, 35, 0.14);
        border: 1px solid rgba(248, 113, 113, 0.35);
        color: #fca5a5;
        text-align: center;
    }

    .results-section {
        margin-bottom: 2.5rem;
    }

    .results-section:last-child {
        margin-bottom: 0;
    }

    .results-section > .section-title {
        margin: 0 0 1.1rem;
        padding-left: 0.85rem;
        border-left: 2px solid #d4a843;
        color: #d4a843;
        font-family: "Cinzel", serif;
        font-size: clamp(1rem, 2.2vw, 1.35rem);
        font-weight: 700;
        letter-spacing: 0.1em;
        line-height: 1.25;
        text-transform: uppercase;
    }

    .results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 0.85rem;
    }

    .result-card {
        min-width: 0;
        min-height: 92px;
        padding: 1rem;
        background: linear-gradient(
            135deg,
            rgba(10, 20, 40, 0.96),
            rgba(6, 13, 28, 0.96)
        );
        border: 1px solid rgba(212, 168, 67, 0.14);
        border-radius: 3px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }

    .result-card:hover,
    .result-card:focus-visible {
        border-color: rgba(212, 168, 67, 0.65);
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.34);
    }

    .result-card:focus-visible {
        outline: 2px solid rgba(212, 168, 67, 0.75);
        outline-offset: 2px;
    }

    .result-image-container {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        border: 1px solid rgba(212, 168, 67, 0.2);
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.04);
    }

    .player-image {
        border-radius: 50%;
    }

    .player-image .result-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        object-position: top;
    }

    .result-image {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .result-info {
        flex: 1;
        min-width: 0;
    }

    .result-title {
        margin: 0 0 0.3rem;
        color: #f0f0f0;
        font-family: "Cinzel", serif;
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.25;
        overflow-wrap: anywhere;
        transition: color 0.2s ease;
    }

    .result-card:hover .result-title,
    .result-card:focus-visible .result-title {
        color: #d4a843;
    }

    .result-subtitle {
        margin: 0;
        color: rgba(200, 210, 220, 0.55);
        font-family: "DM Sans", sans-serif;
        font-size: 0.76rem;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .stadium-card {
        flex-direction: column;
        align-items: stretch;
        min-height: 0;
        padding: 0;
        overflow: hidden;
    }

    .stadium-image-container {
        width: 100%;
        height: 170px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.03);
    }

    .stadium-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s ease;
    }

    .stadium-card:hover .stadium-image {
        transform: scale(1.035);
    }

    .stadium-card .result-info {
        padding: 1rem;
    }

    @media (max-width: 768px) {
        .search-page {
            padding-bottom: 2.5rem;
        }

        .search-container {
            padding: 0 0.85rem;
        }

        .search-box,
        .search-results {
            padding: 1rem;
        }

        .search-form {
            grid-template-columns: 1fr;
            gap: 0.65rem;
        }

        .search-button {
            width: 100%;
        }

        .results-grid {
            grid-template-columns: 1fr;
        }

        .results-summary,
        .no-results,
        .error-message {
            margin-bottom: 1.5rem;
            padding: 0.9rem;
        }

        .results-section {
            margin-bottom: 2rem;
        }

        .result-card {
            min-height: 84px;
            padding: 0.85rem;
        }

        .result-image-container {
            width: 52px;
            height: 52px;
        }

        .stadium-card {
            padding: 0;
        }

        .stadium-image-container {
            height: 155px;
        }

        .stadium-card .result-info {
            padding: 0.9rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .search-button,
        .result-card,
        .stadium-image {
            transition: none;
        }
    }
</style>



---
import FichaTexto from "../../components/FichaTexto.astro";
import { fetchFicha } from "../../utils/fichas";
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";
import "../../styles/global.css";
import {
    fetchAllStadiumsWithStats,
    fetchMatchesByStadium,
    fetchTopPlayersByStadium,
} from "../../utils/estadios";
import { competitionDisplayName } from "../../utils/competiciones";
import { generateSlug } from "../../utils/url-helper";

import { getAssetMetadata, getAssetUrl } from "../../utils/assets";

const competitionLogos: Record<string, any> = {
    "Liga F": getAssetMetadata("competiciones", "liga_f"),
    "Primera Iberdrola": getAssetMetadata("competiciones", "primera_iberdrola"),
    UWCL: getAssetMetadata("competiciones", "uwcl"),
    "Copa de la Reina": getAssetMetadata("competiciones", "copa_de_la_reina"),
    "Supercopa de España": getAssetMetadata(
        "competiciones",
        "supercopa_de_espana",
    ),
};

const { slug } = Astro.params;

const allStadiums = await fetchAllStadiumsWithStats();
const stadium = allStadiums.find((s) => s.slug === slug);

if (!stadium) {
    return Astro.redirect("/404");
}

const rawMatches = await fetchMatchesByStadium(stadium.name);
const stadiumTopPlayers = await fetchTopPlayersByStadium(stadium.name);

const matches = rawMatches.map((m) => {
    const isLocal =
        m.club_local.toLowerCase().trim().includes("real madrid") ||
        m.club_local.toLowerCase().trim() === "real madrid cf";

    const d = new Date(m.fecha);
    const year = d.getFullYear();
    const month = d.getMonth() + 1;
    const startYear = month >= 8 ? year : year - 1;
    const endYear = startYear + 1;
    const season = `${startYear}/${endYear.toString().slice(-2)}`;

    return {
        ...m,
        esLocal: isLocal,
        golesRM: m.goles_rm,
        golesRival: m.goles_rival,
        season,
        competicion: m.competicion,
        resultado: (() => {
            const rm = parseInt(m.goles_rm) || 0;
            const rival = parseInt(m.goles_rival) || 0;
            if (rm > rival) return "V";
            if (rm < rival) return "D";

            if (m.penaltis === 1 || m.penaltis === "1") return "V";
            if (m.penaltis === 0 || m.penaltis === "0") return "D";
            return "E";
        })(),
        cleanSheet: (parseInt(m.goles_rival) || 0) === 0,
        conceded: (parseInt(m.goles_rival) || 0) > 0,
    };
});

interface StatBlock {
    pj: number;
    pg: number;
    pe: number;
    pp: number;
    gf: number;
    gc: number;
    cleanSheets: number;
    conceded: number;
}

const initialStatBlock = (): StatBlock => ({
    pj: 0,
    pg: 0,
    pe: 0,
    pp: 0,
    gf: 0,
    gc: 0,
    cleanSheets: 0,
    conceded: 0,
});

const calculateBlock = (block: StatBlock, m: any) => {
    block.pj++;
    block.gf += parseInt(m.golesRM) || 0;
    block.gc += parseInt(m.golesRival) || 0;
    if (m.resultado === "V") block.pg++;
    else if (m.resultado === "E") block.pe++;
    else block.pp++;

    if (m.cleanSheet) block.cleanSheets++;
    else block.conceded++;
};

const seasonsMap = new Map<string, any>();

matches.forEach((m) => {
    if (!seasonsMap.has(m.season)) {
        seasonsMap.set(m.season, {
            temporada: m.season,
            total: initialStatBlock(),
            competiciones: new Map<string, any>(),
        });
    }
    const seasonData = seasonsMap.get(m.season);
    calculateBlock(seasonData.total, m);

    if (!seasonData.competiciones.has(m.competicion)) {
        seasonData.competiciones.set(m.competicion, {
            competicion: m.competicion,
            ...initialStatBlock(),
        });
    }
    calculateBlock(seasonData.competiciones.get(m.competicion), m);
});

const stadiumDeepStats = Array.from(seasonsMap.values())
    .map((s) => ({
        ...s,
        competiciones: Array.from(s.competiciones.values()),
    }))
    .sort((a, b) => (a.temporada < b.temporada ? 1 : -1));

const totalStats = initialStatBlock();
matches.forEach((m) => calculateBlock(totalStats, m));

const addPercents = (s: StatBlock) => ({
    ...s,
    percPG: s.pj > 0 ? ((s.pg / s.pj) * 100).toFixed(1) : "0.0",
    percPE: s.pj > 0 ? ((s.pe / s.pj) * 100).toFixed(1) : "0.0",
    percPP: s.pj > 0 ? ((s.pp / s.pj) * 100).toFixed(1) : "0.0",
    avg: s.pj > 0 ? (s.gf / s.pj).toFixed(2) : "0.00",
    dif: s.gf - s.gc,
});

const totalStatsEnhanced = addPercents(totalStats);

const uniqueSeasons = [...new Set(matches.map((m) => m.season))]
    .sort()
    .reverse();
const esAmistoso = (comp: string) => /amistoso|friendly/i.test(comp || "");
const hayAmistosos = matches.some((m) => esAmistoso(m.competicion));

const uniqueCompetitions = [
    ...new Set(matches.map((m) => m.competicion)),
]
    .filter((c) => !esAmistoso(c))
    .sort();

const circumference = 220;
const totalMatches = totalStats.pj;
const winsArc =
    totalMatches > 0
        ? Math.round((totalStats.pg / totalMatches) * circumference)
        : 0;
const drawsArc =
    totalMatches > 0
        ? Math.round((totalStats.pe / totalMatches) * circumference)
        : 0;
const lossesArc =
    totalMatches > 0
        ? Math.round((totalStats.pp / totalMatches) * circumference)
        : 0;

const totalGoals = totalStats.gf + totalStats.gc;
const goalsForArc =
    totalGoals > 0
        ? Math.round((totalStats.gf / totalGoals) * circumference)
        : 0;
const goalsAgainstArc =
    totalGoals > 0
        ? Math.round((totalStats.gc / totalGoals) * circumference)
        : 0;

const cleanSheetsArc =
    totalMatches > 0
        ? Math.round((totalStats.cleanSheets / totalMatches) * circumference)
        : 0;
const concededArc =
    totalMatches > 0
        ? Math.round((totalStats.conceded / totalMatches) * circumference)
        : 0;

const joinNatural = (arr: string[]) =>
    arr.length <= 1 ? (arr[0] || "") : `${arr.slice(0, -1).join(", ")} y ${arr[arr.length - 1]}`;

const mainStadium = allStadiums && allStadiums.length ? allStadiums[0] : null;
const isMainStadium = !!(mainStadium && mainStadium.name === stadium.name);

const bioParts: string[] = [];
if (totalStats.pj) {
    const intro = isMainStadium
        ? `El ${stadium.name}${stadium.city ? `, situado en ${stadium.city},` : ""} es el estadio principal del Real Madrid Femenino`
        : `El ${stadium.name}${stadium.city ? `, situado en ${stadium.city},` : ""} es uno de los escenarios por los que ha pasado el Real Madrid Femenino`;
    bioParts.push(`${intro}. Sobre su césped el equipo ha disputado ${totalStats.pj} ${totalStats.pj === 1 ? "partido" : "partidos"}, con un balance de ${totalStats.pg} victorias, ${totalStats.pe} empates y ${totalStats.pp} derrotas.`);
    bioParts.push(`En este recinto las blancas han anotado ${totalStats.gf} goles y han recibido ${totalStats.gc}${stadium.capacity ? `, ante un aforo de hasta ${Number(stadium.capacity).toLocaleString("es-ES")} espectadores` : ""}.`);

    const winsHere = matches.filter((m: any) => m.golesRM != null && m.golesRM !== "" && m.golesRival != null && m.golesRival !== "" && Number(m.golesRM) > Number(m.golesRival));
    const mayorVictoria = winsHere.slice().sort((a: any, b: any) => {
        const da = Number(a.golesRM) - Number(a.golesRival);
        const db = Number(b.golesRM) - Number(b.golesRival);
        return db !== da ? db - da : Number(b.golesRM) - Number(a.golesRM);
    })[0] || null;
    if (mayorVictoria) {
        const rivalMV = mayorVictoria.esLocal ? mayorVictoria.club_visitante : mayorVictoria.club_local;
        bioParts.push(`Su mayor victoria en este estadio es un ${mayorVictoria.golesRM}-${mayorVictoria.golesRival} ante ${rivalMV}.`);
    }

    const sc = (stadiumTopPlayers?.topScorers || []).slice(0, 3).map((p: any) => `${p.nombre} (${p.goles})`);
    const as = (stadiumTopPlayers?.topAssisters || []).slice(0, 3).map((p: any) => `${p.nombre} (${p.asistencias})`);
    const co = (stadiumTopPlayers?.topContributors || []).slice(0, 3).map((p: any) => `${p.nombre} (${p.total})`);
    if (sc.length) bioParts.push(`Las máximas goleadoras madridistas en este recinto son ${joinNatural(sc)}.`);
    if (as.length) bioParts.push(`En asistencias destacan ${joinNatural(as)}.`);
    if (co.length) bioParts.push(`Y en goles generados (G+A), las más determinantes son ${joinNatural(co)}.`);
} else {
    bioParts.push(isMainStadium
        ? `El ${stadium.name} es el estadio principal del Real Madrid Femenino.`
        : `Aquí encontrarás el historial y las estadísticas de todos los partidos del Real Madrid Femenino en el ${stadium.name}${stadium.city ? `, en ${stadium.city}` : ""}.`);
    if (stadium.capacity) {
        bioParts.push(`El recinto tiene una capacidad de ${Number(stadium.capacity).toLocaleString("es-ES")} espectadores.`);
    }
}

if (mainStadium && !isMainStadium) {
    bioParts.push(`El estadio principal del Real Madrid Femenino es el ${mainStadium.name}.`);
}

const bio = bioParts.join(" ");
const ficha = await fetchFicha("estadio", [slug, stadium.id]);

const stadiumSchema = {
    "@context": "https://schema.org",
    "@type": "StadiumOrArena",
    name: stadium.name,
    ...(stadium.city ? { address: stadium.city } : {}),
    ...(stadium.capacity ? { maximumAttendeeCapacity: Number(stadium.capacity) } : {}),
    ...(stadium.coordinates ? { geo: { "@type": "GeoCoordinates", latitude: stadium.coordinates.lat, longitude: stadium.coordinates.lng } } : {}),
    description: bio,
};

const seoTitle = `${stadium.name}: partidos y estadísticas del Real Madrid Femenino | Madrid Femenino Xtra`;
const seoDescription = totalStats.pj
    ? `El Real Madrid Femenino en el ${stadium.name}${stadium.city ? ` (${stadium.city})` : ""}: ${totalStats.pj} partidos, ${totalStats.pg} victorias, ${totalStats.gf} goles a favor. Historial y estadísticas completas.`
    : `Estadísticas e historial de partidos del Real Madrid Femenino en el estadio ${stadium.name}.`;
---

<Layout title={seoTitle} description={seoDescription} image={stadium.imageUrl || undefined}>
    <script type="application/ld+json" set:html={JSON.stringify(stadiumSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ name: "Inicio", path: "/home" }, { name: "Estadios", path: "/estadios" }, { name: stadium.name, path: `/estadios/${slug}` }]))} />
    <section class="stadium-hero">
        <div class="hero-bg-glow" aria-hidden="true"></div>

        <a href="/estadios" class="hero-back-link">← VOLVER A ESTADIOS</a>

        <div class="hero-inner">
            <div class="hero-photo-col">
                <div class="hero-stadium-frame">
                    {stadium.imageUrl ? (
                        <img
                            src={stadium.imageUrl}
                            alt={stadium.name}
                            class="hero-stadium-photo"
                            loading="eager"
                            decoding="async"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        />
                    ) : null}
                    <div class="hero-stadium-placeholder" style={stadium.imageUrl ? "display:none" : ""}>
                        <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="rgba(212,168,67,0.2)" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 18.5l-3 -1.5v-5l3 -1.5l3 1.5v5z"/>
                            <ellipse cx="12" cy="7" rx="8" ry="3"/>
                            <path d="M4 7v6c0 1.657 3.582 3 8 3s8 -1.343 8 -3v-6"/>
                        </svg>
                        <span class="placeholder-stadium-name">{stadium.name}</span>
                    </div>
                    <div class="photo-frame-corner tl"></div>
                    <div class="photo-frame-corner tr"></div>
                    <div class="photo-frame-corner bl"></div>
                    <div class="photo-frame-corner br"></div>
                </div>
            </div>

            <div class="hero-info-col">
                <div class="hero-chips">
                    {stadium.city && (
                        <span class="hero-chip hero-chip-gold">♦ {stadium.city} ♦</span>
                    )}
                    {stadium.capacity && (
                        <span class="hero-chip">
                            {Number(stadium.capacity).toLocaleString()} espectadores
                        </span>
                    )}
                </div>

                <h1 class="hero-stadium-name">{stadium.name}</h1>

                <div class="hero-quick-stats">
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.pj}</span>
                        <span class="qs-label">PARTIDOS</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.pg}</span>
                        <span class="qs-label">VICTORIAS</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.gf}</span>
                        <span class="qs-label">GOLES</span>
                    </div>
                    <div class="qs-card">
                        <span class="qs-number">{totalStats.cleanSheets}</span>
                        <span class="qs-label">PORTERÍAS A CERO</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <main class="stadium-content">
        <div class="content-grid">

            <section class="profile-card full-col" style="margin-bottom:0;">
                <h2 class="card-title">SOBRE EL {stadium.name.toUpperCase()}</h2>
                <div class="card-body">
                    {ficha ? (
                    <FichaTexto html={ficha} />
                ) : (
                    <p style="margin:0;padding:clamp(0.75rem,3vw,1rem) clamp(0.9rem,4vw,1.25rem);line-height:1.75;font-size:clamp(0.92rem,2.6vw,1.05rem);overflow-wrap:break-word;text-wrap:pretty;text-align:justify;box-sizing:border-box;">{bio}</p>
                )}
                </div>
            </section>

            {stadium.coordinates && (
                <section class="profile-card map-card">
                    <h2 class="card-title">UBICACIÓN</h2>
                    <div class="card-body" style="padding:0;overflow:hidden;border-radius:0 0 4px 4px;">
                        <iframe
                            width="100%"
                            height="320"
                            frameborder="0"
                            scrolling="no"
                            marginheight="0"
                            marginwidth="0"
                            src={`https://maps.google.com/maps?q=${stadium.coordinates.lat},${stadium.coordinates.lng}&hl=es&z=14&output=embed`}
                            style="display:block;"
                        />
                    </div>
                </section>
            )}

            <section class="profile-card full-col">
                <h2 class="card-title">ESTADÍSTICAS EN {stadium.name.toUpperCase()}</h2>
                <div class="card-body">
                    <div class="stats-table-wrapper">
                        {stadiumDeepStats.length > 0 ? (
                            <table class="stats-table detailed-table">
                                <thead>
                                    <tr>
                                        <th>TEMPORADA</th>
                                        <th>PJ</th>
                                        <th>PG</th>
                                        <th>PE</th>
                                        <th>PP</th>
                                        <th>GF</th>
                                        <th>GC</th>
                                        <th>Dif</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {stadiumDeepStats.map((season) => (
                                        <>
                                            <tr
                                                class="season-total-row"
                                                onclick={`toggleSeason('${season.temporada.replace(/\//g, "-")}')`}
                                                style="cursor: pointer;"
                                            >
                                                <td>
                                                    <div style="display:flex;align-items:center;gap:0.5rem;">
                                                        <strong>{season.temporada}</strong>
                                                        <span class="toggle-icon">▼</span>
                                                    </div>
                                                </td>
                                                <td><strong>{season.total.pj}</strong></td>
                                                <td><strong>{season.total.pg}</strong></td>
                                                <td><strong>{season.total.pe}</strong></td>
                                                <td><strong>{season.total.pp}</strong></td>
                                                <td><strong>{season.total.gf}</strong></td>
                                                <td><strong>{season.total.gc}</strong></td>
                                                <td><strong>{season.total.gf - season.total.gc}</strong></td>
                                            </tr>
                                            {season.competiciones.map((comp: any) => (
                                                <tr
                                                    class={`competition-row season-${season.temporada.replace(/\//g, "-")}`}
                                                    style="display: none;"
                                                >
                                                    <td class="competition-name">
                                                        <div class="competition-name-wrapper">
                                                            {competitionLogos[comp.competicion] && (
                                                                <img
                                                                    src={competitionLogos[comp.competicion].src}
                                                                    alt={comp.competicion}
                                                                    class="competition-logo"
                                                                />
                                                            )}
                                                            {competitionDisplayName(comp.competicion, { temporada: season.temporada })}
                                                        </div>
                                                    </td>
                                                    <td>{comp.pj}</td>
                                                    <td>{comp.pg}</td>
                                                    <td>{comp.pe}</td>
                                                    <td>{comp.pp}</td>
                                                    <td>{comp.gf}</td>
                                                    <td>{comp.gc}</td>
                                                    <td>{comp.gf - comp.gc}</td>
                                                </tr>
                                            ))}
                                        </>
                                    ))}
                                    <tr class="total-row">
                                        <td><strong>TOTAL</strong></td>
                                        <td>{totalStats.pj}</td>
                                        <td>{totalStats.pg}</td>
                                        <td>{totalStats.pe}</td>
                                        <td>{totalStats.pp}</td>
                                        <td>{totalStats.gf}</td>
                                        <td>{totalStats.gc}</td>
                                        <td>{totalStats.gf - totalStats.gc}</td>
                                    </tr>
                                </tbody>
                            </table>
                        ) : (
                            <div style="padding:1.5rem;text-align:center;color:rgba(150,160,175,0.5);font-style:italic;font-size:0.85rem;">
                                No hay estadísticas disponibles
                            </div>
                        )}
                    </div>
                </div>
            </section>

            <section class="profile-card full-col">
                <h2 class="card-title">GRÁFICAS</h2>
                <div class="card-body" style="padding:1.25rem;">
                    <div class="filters-container">
                        <div class="custom-select-container" id="container-temporada">
                            <div class="custom-select-trigger" id="trigger-temporada">
                                <span class="selected-text">Todas las Temporadas</span>
                                <div class="custom-select-arrow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m6 9 6 6 6-6"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="custom-select-options">
                                <div class="custom-select-option selected" data-value="all">Todas las Temporadas</div>
                                {uniqueSeasons.map((season) => (
                                    <div class="custom-select-option" data-value={season}>{season}</div>
                                ))}
                            </div>
                            <select id="season-filter" style="display: none;">
                                <option value="all">Todas las Temporadas</option>
                                {uniqueSeasons.map((season) => (
                                    <option value={season}>{season}</option>
                                ))}
                            </select>
                        </div>
                        <div class="custom-select-container" id="container-competicion">
                            <div class="custom-select-trigger" id="trigger-competicion">
                                <span class="selected-text">Todas las Competiciones</span>
                                <div class="custom-select-arrow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m6 9 6 6 6-6"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="custom-select-options">
                                <div class="custom-select-option selected" data-value="all">Todas las Competiciones</div>
                                {hayAmistosos && (
                                    <div class="custom-select-option" data-value="amistosos">Amistosos</div>
                                )}
                                {uniqueCompetitions.map((comp) => (
                                    <div class="custom-select-option" data-value={comp}>{comp}</div>
                                ))}
                            </div>
                            <select id="competition-filter" style="display: none;">
                                <option value="all">Todas las Competiciones</option>
                                {hayAmistosos && <option value="amistosos">Amistosos</option>}
                                {uniqueCompetitions.map((comp) => (
                                    <option value={comp}>{comp}</option>
                                ))}
                            </select>
                        </div>
                    </div>
                    <div class="charts-row">
                        <div class="chart-item">
                            <div class="chart-label">VICTORIAS / EMPATES / DERROTAS</div>
                            <svg viewBox="0 0 100 100" class="pie-chart" id="results-chart">
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(74,222,128,0.75)" stroke-width="20"
                                    stroke-dasharray={`${winsArc} ${circumference - winsArc}`}
                                    transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(212,168,67,0.75)" stroke-width="20"
                                    stroke-dasharray={`${drawsArc} ${circumference - drawsArc}`}
                                    stroke-dashoffset={-winsArc}
                                    transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(248,113,113,0.7)" stroke-width="20"
                                    stroke-dasharray={`${lossesArc} ${circumference - lossesArc}`}
                                    stroke-dashoffset={-(winsArc + drawsArc)}
                                    transform="rotate(-90 50 50)"></circle>
                            </svg>
                            <div class="chart-legend" id="results-legend">
                                <div><span class="dot green"></span> Ganados ({totalStats.pg})</div>
                                <div><span class="dot orange"></span> Empatados ({totalStats.pe})</div>
                                <div><span class="dot red"></span> Perdidos ({totalStats.pp})</div>
                            </div>
                        </div>
                        <div class="chart-item">
                            <div class="chart-label">GOLES</div>
                            <svg viewBox="0 0 100 100" class="pie-chart" id="goals-chart">
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(74,222,128,0.75)" stroke-width="20"
                                    stroke-dasharray={`${goalsForArc} ${circumference - goalsForArc}`}
                                    transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(248,113,113,0.7)" stroke-width="20"
                                    stroke-dasharray={`${goalsAgainstArc} ${circumference - goalsAgainstArc}`}
                                    stroke-dashoffset={-goalsForArc}
                                    transform="rotate(-90 50 50)"></circle>
                            </svg>
                            <div class="chart-legend" id="goals-legend">
                                <div><span class="dot green"></span> A favor ({totalStats.gf})</div>
                                <div><span class="dot red"></span> En contra ({totalStats.gc})</div>
                            </div>
                        </div>
                        <div class="chart-item">
                            <div class="chart-label">PORTERÍA A CERO</div>
                            <svg viewBox="0 0 100 100" class="pie-chart" id="clean-sheets-chart">
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(74,222,128,0.75)" stroke-width="20"
                                    stroke-dasharray={`${cleanSheetsArc} ${circumference - cleanSheetsArc}`}
                                    transform="rotate(-90 50 50)"></circle>
                                <circle cx="50" cy="50" r="35" fill="none" stroke="rgba(248,113,113,0.7)" stroke-width="20"
                                    stroke-dasharray={`${concededArc} ${circumference - concededArc}`}
                                    stroke-dashoffset={-cleanSheetsArc}
                                    transform="rotate(-90 50 50)"></circle>
                            </svg>
                            <div class="chart-legend" id="clean-sheets-legend">
                                <div><span class="dot green"></span> P. a cero ({totalStats.cleanSheets})</div>
                                <div><span class="dot red"></span> Con gol ({totalStats.conceded})</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="profile-card full-col">
                <h2 class="card-title">PARTIDOS EN {stadium.name.toUpperCase()}</h2>
                <div class="card-body">
                    <div class="stats-table-wrapper">
                        <table class="matches-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Competición</th>
                                    <th>Local</th>
                                    <th>Res.</th>
                                    <th>Visitante</th>
                                    <th>Árbitra</th>
                                </tr>
                            </thead>
                            <tbody>
                                {matches.map((match, index) => (
                                    <tr
                                        class={`match-row ${index >= 10 ? "hidden-match" : ""}`}
                                        style={index >= 10 ? "display: none;" : ""}
                                    >
                                        <td>{new Date(match.fecha).toLocaleDateString("es-ES")}</td>
                                        <td>
                                            {competitionLogos[match.competicion] && (
                                                <img
                                                    src={competitionLogos[match.competicion].src}
                                                    alt={competitionDisplayName(match.competicion, { temporada: match.season })}
                                                    class="competition-logo-small"
                                                    title={competitionDisplayName(match.competicion, { temporada: match.season })}
                                                />
                                            )}
                                            {!competitionLogos[match.competicion] && competitionDisplayName(match.competicion, { temporada: match.season })}
                                        </td>
                                        <td class={match.club_local.toLowerCase().includes("real madrid") ? "font-bold" : ""}>
                                            {match.club_local}
                                        </td>
                                        <td class={`${match.resultado === "V" ? "resultado-victoria" : match.resultado === "E" ? "resultado-empate" : "resultado-derrota"}`}>
                                            {match.goles_rm} - {match.goles_rival}
                                        </td>
                                        <td class={match.club_visitante.toLowerCase().includes("real madrid") ? "font-bold" : ""}>
                                            {match.club_visitante}
                                        </td>
                                        <td>
                                            {match.arbitra_nombre && (
                                                <a
                                                    href={`/arbitras/${generateSlug(match.arbitra_nombre)}`}
                                                    class="arbitra-link"
                                                >
                                                    {match.arbitra_nombre}
                                                </a>
                                            )}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    {matches.length > 10 && (
                        <div class="matches-footer">
                            <button id="show-more-matches" class="btn-more">
                                Ver todos los partidos ({matches.length})
                            </button>

---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { fetchAllStadiumsWithStats } from "../../utils/estadios";
import { fetchStadiumMapGames } from "../../utils/partidos";
import StadiumsTable from "../../components/StadiumsTable";
import MatchMapWrapper from "../../components/MatchMapWrapper";
import MatchStatsDashboard from "../../components/MatchStatsDashboard";

const stadiums = await fetchAllStadiumsWithStats();
// Enviar a las islas React solo los campos usados por el mapa y el resumen.
// Evita serializar las estadísticas completas de cada partido dos veces.
const gamesData = await fetchStadiumMapGames();
---

<Layout
    title="Estadios del Real Madrid Femenino: historial, mapa y estadísticas | Madrid Femenino Xtra"
    description="Todos los estadios donde ha jugado el Real Madrid Femenino: ubicación, historial de partidos, balance y estadísticas en cada campo."
>
    <main class="max-w-[1700px] mx-auto px-6 md:px-0">
        <header class="page-header-container">
            <h1 class="landing-title">ESTADIOS</h1>
            <p class="landing-subtitle">Todos los estadios donde el Real Madrid Femenino ha disputado partidos a lo largo de su historia</p>
        </header>

        <section class="stadiums-overview" aria-label="Mapa y distancias de los estadios">
            <MatchStatsDashboard matches={gamesData} client:only="react" />
            <div class="stadiums-overview__map">
                <MatchMapWrapper matches={gamesData} client:only="react" />
            </div>
        </section>

        <StadiumsTable client:visible stadiums={stadiums} />
    </main>
</Layout>

<style>
    .stadiums-overview {
        width: min(100%, 1600px);
        margin: 0 auto 4rem;
    }

    .stadiums-overview__map {
        min-width: 0;
        margin-top: 1.25rem;
    }

    .stadiums-table-heading {
        width: min(100%, 1600px);
        margin-inline: auto;
    }

    @media (max-width: 640px) {
        main {
            padding-inline: 1rem;
        }

        .stadiums-overview {
            margin-bottom: 3rem;
        }

    }
</style>

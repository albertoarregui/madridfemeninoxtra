---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { fetchPlayersDirectly } from "../utils/players";
import PlayerRadarComparator from "../components/PlayerRadarComparator";

const players = await fetchPlayersDirectly();

const playerOptions = players
    .map((p: any) => ({
        slug:     p.slug,
        nombre:   p.nombre,
        imageUrl: p.imageUrl,
        posicion: p.posicion ?? '',
    }))
    .sort((a: any, b: any) => a.nombre.localeCompare(b.nombre, 'es'));

const params = Object.fromEntries(Astro.url.searchParams);
const slugA  = params.a ?? '';
const slugB  = params.b ?? '';
---

<Layout
    title="Comparador de Jugadoras | Madrid Femenino Xtra"
    description="Compara las estadísticas de dos jugadoras del Real Madrid Femenino con un gráfico radar interactivo."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <header class="page-header-container">
            <h1 class="landing-title">COMPARADOR</h1>
            <p class="landing-subtitle">
                Compara las estadísticas de carrera de dos jugadoras del Real Madrid Femenino
            </p>
        </header>

        <PlayerRadarComparator
            client:load
            players={playerOptions}
            initialSlugA={slugA}
            initialSlugB={slugB}
        />
    </main>
</Layout>

<style is:global>
.cmp-root {
    max-width: 860px;
    margin: 0 auto 5rem;
    padding: 0 0.5rem;
}

.cmp-selectors {
    display: grid;
    grid-template-columns: 1fr 56px 1fr;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
}

.cmp-side { display: flex; flex-direction: column; gap: 0.4rem; }

.cmp-vs {
    font-family: "Cinzel", serif;
    font-size: 2rem;
    color: #d4a843;
    text-align: center;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-shadow: 0 0 20px rgba(212,168,67,0.3);
}

.cmp-spinner {
    display: inline-block;
    width: 20px; height: 20px;
    border: 3px solid rgba(212,168,67,0.2);
    border-top-color: #d4a843;
    border-radius: 50%;
    animation: cmp-spin 0.7s linear infinite;
}
@keyframes cmp-spin { to { transform: rotate(360deg); } }

.cmp-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 2px solid rgba(212,168,67,0.3);
    border-radius: 25px;
    padding: 0.7rem 1rem;
    background: rgba(8,16,34,0.85);
    transition: box-shadow 0.2s, border-color 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    backdrop-filter: blur(8px);
}
.cmp-input-wrap:focus-within {
    border-color: #d4a843;
    box-shadow: 0 0 0 3px rgba(212,168,67,0.15);
}

.cmp-search-icon {
    width: 16px; height: 16px;
    flex-shrink: 0;
    color: rgba(150,160,175,0.6);
}

.cmp-input {
    flex: 1;
    border: none;
    outline: none;
    font-family: "DM Sans", sans-serif;
    font-size: 0.9rem;
    color: #f0f0f0;
    background: transparent;
    min-width: 0;
}
.cmp-input::placeholder { color: rgba(150,160,175,0.5); }

.cmp-chosen {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border: 2px solid rgba(212,168,67,0.35);
    border-radius: 25px;
    padding: 0.55rem 0.75rem;
    background: rgba(8,16,34,0.85);
    box-shadow: 0 2px 12px rgba(0,0,0,0.3);
    backdrop-filter: blur(8px);
}

.cmp-avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    flex-shrink: 0;
    border: 1px solid rgba(212,168,67,0.3);
}

.cmp-chosen-info {
    display: flex; flex-direction: column;
    flex: 1; min-width: 0;
}

.cmp-chosen-name {
    font-family: "Cinzel", serif;
    font-size: 0.85rem; color: #f0f0f0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    letter-spacing: 0.03em;
}
.cmp-chosen-pos {
    font-family: "DM Sans", sans-serif;
    font-size: 0.68rem; color: rgba(150,160,175,0.6);
}

.cmp-clear {
    background: none; border: none; cursor: pointer;
    color: rgba(150,160,175,0.5); font-size: 1.4rem; font-weight: 700;
    padding: 0.2rem 0.4rem;
    flex-shrink: 0; line-height: 1;
    transition: color 0.15s;
}
.cmp-clear:hover { color: #d4a843; }

.cmp-selector { position: relative; }

.cmp-dropdown {
    position: absolute;
    top: calc(100% + 4px); left: 0; right: 0;
    background: rgba(8,16,34,0.97);
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.6);
    z-index: 300;
    list-style: none; padding: 0; margin: 0;
    overflow: hidden;
    border: 2px solid rgba(212,168,67,0.4);
    backdrop-filter: blur(16px);
}

.cmp-option {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.85rem;
    cursor: pointer;
    border-bottom: 1px solid rgba(212,168,67,0.08);
    transition: background 0.12s;
}
.cmp-option:last-child { border-bottom: none; }
.cmp-option:hover { background: rgba(212,168,67,0.1); }

.cmp-option-img {
    width: 30px; height: 30px;
    border-radius: 50%;
    object-fit: cover; object-position: top center;
    flex-shrink: 0;
    border: 1px solid rgba(212,168,67,0.2);
}

.cmp-option-text { display: flex; flex-direction: column; min-width: 0; }
.cmp-option-name {
    font-family: "Cinzel", serif;
    font-size: 0.82rem; color: #f0f0f0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    letter-spacing: 0.02em;
}
.cmp-option-pos {
    font-family: "DM Sans", sans-serif;
    font-size: 0.65rem; color: rgba(150,160,175,0.6);
}

.cmp-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.75rem;
    padding: 1rem 1.25rem;
    background: rgba(8,16,34,0.85);
    border-radius: 20px;
    border: 1px solid rgba(212,168,67,0.2);
    box-shadow: 0 2px 16px rgba(0,0,0,0.3);
    backdrop-filter: blur(12px);
}

.cmp-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 140px;
}

.cmp-filter-label {
    font-family: "Cinzel", serif;
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    color: rgba(150,160,175,0.6);
    text-transform: uppercase;
}

.cmp-custom-select { position: relative; }

.cmp-custom-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(200,210,220,0.65);
    background: rgba(6,13,28,0.9);
    border: 2px solid rgba(212,168,67,0.3);
    border-radius: 25px;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    width: 100%;
    white-space: nowrap;
}
.cmp-custom-trigger:hover {
    border-color: #d4a843;
    color: #f0f0f0;
}
.cmp-custom-select.open .cmp-custom-trigger {
    border-color: #d4a843;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: 0 0 0 3px rgba(212,168,67,0.12);
    color: #f0f0f0;
}

.cmp-custom-text { flex: 1; min-width: 0; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.cmp-custom-arrow {
    flex-shrink: 0;
    transition: transform 0.2s;
    color: rgba(212,168,67,0.6);
}
.cmp-custom-select.open .cmp-custom-arrow { transform: rotate(180deg); }

.cmp-custom-options {
    position: absolute;
    top: calc(100% - 2px);
    left: 0; right: 0;
    background: rgba(8,16,34,0.97);
    border: 2px solid rgba(212,168,67,0.4);
    border-top: none;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    z-index: 400;
    list-style: none;
    padding: 0.3rem 0;
    margin: 0;
    max-height: 220px;
    overflow-y: auto;
    backdrop-filter: blur(16px);
}

.cmp-custom-option {
    padding: 0.45rem 1rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.85rem;
    color: rgba(200,210,220,0.65);
    cursor: pointer;
    transition: background 0.12s;
    text-align: center;
}
.cmp-custom-option:hover { background: rgba(212,168,67,0.1); color: #f0f0f0; }
.cmp-custom-option.selected { background: rgba(212,168,67,0.2); color: #d4a843; font-weight: 600; }

.cmp-filter-mode { margin-left: auto; }

.cmp-toggle {
    display: flex;
    border-radius: 25px;
    overflow: hidden;
    border: 2px solid rgba(212,168,67,0.3);
    background: rgba(6,13,28,0.9);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}

.cmp-toggle-btn {
    font-family: "DM Sans", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(200,210,220,0.65);
    background: transparent;
    border: none;
    padding: 0.45rem 1.1rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
}
.cmp-toggle-btn.active {
    background: rgba(212,168,67,0.25);
    color: #d4a843;
}
.cmp-toggle-btn:not(.active):hover {
    background: rgba(212,168,67,0.1);
    color: #f0f0f0;
}

.cmp-capture-wrap {
    background: rgba(8,16,34,0.85);
    border-radius: 20px;
    border: 1px solid rgba(212,168,67,0.15);
}

.cmp-cap-header {
    display: none;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.9rem 1.25rem 1.1rem;
    background: rgba(8,16,34,0.9);
    border-bottom: 3px solid rgba(212,168,67,0.4);
    border-radius: 20px 20px 0 0;
}

.cmp-cap-logo {
    align-self: flex-start;
    height: 52px;
    width: auto;
    border-radius: 10px;
}

.cmp-cap-players {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
}

.cmp-cap-player {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
}

.cmp-cap-img-wrap {
    width: 72px;
    height: 88px;
    overflow: hidden;
    border-radius: 10px;
    border: 2px solid rgba(212,168,67,0.4);
    flex-shrink: 0;
}

.cmp-cap-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
}

.cmp-cap-pname {
    font-family: "Cinzel", serif;
    font-size: 0.85rem;
    color: #f0f0f0;
    letter-spacing: 0.5px;
    text-align: center;
    line-height: 1.2;
    word-break: break-word;
}

.cmp-cap-vs {
    font-family: "Cinzel", serif;
    font-size: 2.5rem;
    color: #d4a843;
    line-height: 1;
    flex-shrink: 0;
    font-weight: 700;
}

.cmp-chart-card {
    background: rgba(8,16,34,0.85);
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    border: 1px solid rgba(212,168,67,0.2);
    padding: 1.5rem 1rem 0.75rem;
    margin-bottom: 2rem;
    backdrop-filter: blur(12px);
}

.cmp-tooltip {
    background: rgba(6,13,28,0.97);
    border-radius: 8px;
    padding: 0.5rem 0.85rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.8rem;
    color: #f0f0f0;
    line-height: 1.7;
    border: 1px solid rgba(212,168,67,0.25);
}
.cmp-tooltip-subject {
    font-family: "Cinzel", serif;
    font-size: 0.8rem;
    letter-spacing: 1px;
    color: #d4a843;
    margin: 0 0 2px;
}
.cmp-tooltip-a { color: #d4a843; margin: 0; }
.cmp-tooltip-b { color: rgba(200,210,220,0.65); margin: 0; }

.cmp-table-card {
    background: rgba(8,16,34,0.85);
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    border: 1px solid rgba(212,168,67,0.2);
    overflow: hidden;
    backdrop-filter: blur(12px);
}

.cmp-table-header {
    display: grid;
    grid-template-columns: 1fr 160px 1fr;
    background: rgba(6,13,28,0.9);
    border-bottom: 1px solid rgba(212,168,67,0.2);
    position: sticky;
    top: 0;
    z-index: 10;
}

.cmp-table-player {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
    min-width: 0;
}
.cmp-table-player-a { flex-direction: row; }
.cmp-table-player-b { flex-direction: row-reverse; text-align: right; }

.cmp-table-avatar {
    width: 34px; height: 34px;
    border-radius: 50%;
    object-fit: cover; object-position: top center;
    flex-shrink: 0;
    border: 2px solid rgba(212,168,67,0.3);
}

.cmp-table-pname {
    font-family: "Cinzel", serif;
    font-size: 0.78rem;
    color: #f0f0f0;
    letter-spacing: 0.4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.cmp-table-stat-col {
    display: flex; align-items: center; justify-content: center;
    font-family: "Cinzel", serif;
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    color: #d4a843;
    background: rgba(6,13,28,0.9);
    padding: 0.85rem 0.5rem;
    text-align: center;
}

.cmp-section-header {
    font-family: "Cinzel", serif;
    font-size: 0.65rem;
    letter-spacing: 2px;
    color: #d4a843;
    background: rgba(212,168,67,0.07);
    padding: 0.5rem 1.25rem;
    border-top: 1px solid rgba(212,168,67,0.12);
    border-bottom: 1px solid rgba(212,168,67,0.12);
    text-transform: uppercase;
}

.cmp-row {
    display: grid;
    grid-template-columns: 1fr 160px 1fr;
    border-bottom: 1px solid rgba(212,168,67,0.07);
    transition: background 0.12s;
}
.cmp-row:last-child { border-bottom: none; }
.cmp-row:hover { background: rgba(212,168,67,0.05); }

.cmp-cell {
    padding: 0.7rem 1.25rem;
    font-family: "DM Sans", sans-serif;
    font-size: 1.05rem;
    color: #f0f0f0;
    display: flex;
    align-items: center;
    transition: background 0.15s;
    font-weight: 500;
}

.cmp-cell-a {
    justify-content: flex-end;
    text-align: right;
    border-right: 3px solid transparent;
}
.cmp-cell-stat {
    justify-content: center;
    text-align: center;
    font-family: "DM Sans", sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(150,160,175,0.6);
    letter-spacing: 0.3px;
    text-transform: uppercase;
    background: rgba(6,13,28,0.6);
    border-right: 1px solid rgba(212,168,67,0.1);
    border-left: 1px solid rgba(212,168,67,0.1);
}
.cmp-cell-b {
    justify-content: flex-start;
    text-align: left;
    border-left: 3px solid transparent;
}

.cmp-cell-a.cmp-winner {
    background: rgba(212,168,67,0.1);
    color: #d4a843;
    font-size: 1.15rem;
    border-right-color: #d4a843;
    font-weight: 700;
}
.cmp-cell-b.cmp-winner {
    background: rgba(212,168,67,0.1);
    color: #d4a843;
    font-size: 1.15rem;
    border-left-color: #d4a843;
    font-weight: 700;
}

.cmp-capture-row {
    display: flex;
    justify-content: center;
    margin-top: 1.75rem;
}

.cmp-capture-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Cinzel", serif;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    color: #060d1c;
    background: #d4a843;
    border: none;
    border-radius: 25px;
    padding: 0.8rem 2.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 16px rgba(212,168,67,0.3);
    font-weight: 700;
}
.cmp-capture-btn:hover {
    background: #e0bb60;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(212,168,67,0.4);
}
.cmp-capture-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
}

.cmp-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: rgba(150,160,175,0.6);
    background: rgba(8,16,34,0.5);
    border-radius: 20px;
    border: 2px dashed rgba(212,168,67,0.2);
}
.cmp-empty-icon { width: 56px; height: 56px; margin: 0 auto 1rem; display: block; opacity: 0.4; }
.cmp-empty p {
    font-family: "DM Sans", sans-serif;
    font-size: 0.95rem;
    color: rgba(150,160,175,0.5);
    margin: 0;
}

@media (max-width: 680px) {
    .cmp-selectors {
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }
    .cmp-vs { font-size: 1.5rem; }

    .cmp-filters { padding: 0.75rem; gap: 0.5rem; }
    .cmp-filter-group { min-width: calc(50% - 0.25rem); flex: 1 1 calc(50% - 0.25rem); }
    .cmp-filter-mode { margin-left: 0; flex: 1 1 100%; }
    .cmp-toggle { width: fit-content; }

    .cmp-table-header {
        grid-template-columns: 1fr 108px 1fr;
        position: static;
    }
    .cmp-table-player { padding: 0.65rem 0.75rem; gap: 0.4rem; }
    .cmp-table-avatar { width: 26px; height: 26px; }
    .cmp-table-pname  { font-size: 0.68rem; white-space: normal; word-break: break-word; overflow: visible; line-height: 1.1; }
    .cmp-table-stat-col { padding: 0.65rem 0.2rem; font-size: 0.58rem; white-space: normal; letter-spacing: 0; line-height: 1.2; }

    .cmp-row { grid-template-columns: 1fr 108px 1fr; }

    .cmp-cell        { padding: 0.55rem 0.6rem; font-size: 0.88rem; }
    .cmp-cell-stat   { font-size: 0.58rem; white-space: normal; word-break: normal; overflow: hidden; letter-spacing: 0; }
    .cmp-cell-a.cmp-winner,
    .cmp-cell-b.cmp-winner { font-size: 0.95rem; }

    .cmp-section-header { padding: 0.4rem 0.75rem; font-size: 0.6rem; }

    .cmp-chart-card { padding: 1rem 0.25rem 0.5rem; }

    .cmp-capture-btn { padding: 0.7rem 1.5rem; font-size: 0.8rem; }

    .cmp-custom-options { max-height: 180px; }
}

@media (max-width: 400px) {
    .cmp-filter-group { min-width: 0; flex: 1 1 100%; }

    .cmp-table-header { grid-template-columns: 1fr 88px 1fr; }
    .cmp-row          { grid-template-columns: 1fr 88px 1fr; }
    .cmp-cell         { padding: 0.5rem 0.3rem; font-size: 0.8rem; }
    .cmp-cell-stat    { font-size: 0.52rem; padding: 0.5rem 0.2rem; }
    .cmp-table-player { padding: 0.5rem 0.4rem; }
    .cmp-table-avatar { display: none; }
    .cmp-table-stat-col { font-size: 0.55rem; padding: 0.5rem 0.15rem; }
}
</style>

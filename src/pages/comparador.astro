---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { fetchPlayersDirectly } from "../utils/players";
import PlayerRadarComparator from "../components/PlayerRadarComparator";
import BreadcrumbTrail from "../components/BreadcrumbTrail.astro";
import "../styles/profile-shared.css";
import "../styles/comparadores.css";
import { getAssetUrl } from "../utils/assets";

const players = await fetchPlayersDirectly();

const playerOptions = players
    .map((p: any) => ({
        slug:     p.slug,
        nombre:   p.nombre,
        imageUrl: p.imageUrl,
        posicion: p.posicion ?? '',
    }))
    .sort((a: any, b: any) => a.nombre.localeCompare(b.nombre, 'es'));

const params = Object.fromEntries(Astro.url.searchParams);
const slugA  = params.a ?? '';
const slugB  = params.b ?? '';
const competitionLogos = Object.fromEntries(
    ["Primera Iberdrola", "Liga F", "UWCL", "Copa de la Reina", "Supercopa de España", "Amistosos"]
        .map((name) => [name, getAssetUrl("competiciones", name === "Amistosos" ? "amistoso" : name) || ""]),
);
---

<Layout
    title="Comparador de Jugadoras | Madrid Femenino Xtra"
    description="Compara las estadísticas de dos jugadoras del Real Madrid Femenino con un gráfico radar interactivo."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <BreadcrumbTrail items={[
            { label: "Inicio", href: "/" },
            { label: "Hub", href: "/estadisticas-real-madrid-femenino" },
            { label: "Comparador" },
        ]} />
        <header class="page-header-container">
            <h1 class="landing-title">COMPARADOR</h1>
            <p class="landing-subtitle">
                Compara las estadísticas de carrera de dos jugadoras del Real Madrid Femenino
            </p>
        </header>

        <PlayerRadarComparator
            client:visible
            players={playerOptions}
            initialSlugA={slugA}
            initialSlugB={slugB}
            competitionLogos={competitionLogos}
        />
    </main>
</Layout>

<style is:global>
.cmp-pickers { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: end; }
.cx-pick { min-width: 0; }
.cx-pick.is-right .pc-panel { left: auto; right: 0; }
.cx-pick .pc-item { width: 100%; border: 0; border-bottom: 1px solid rgba(212, 168, 67, 0.07); background: transparent; text-align: left; cursor: pointer; font: inherit; color: inherit; }
.cmp-swap { display: grid; place-items: center; width: 2.9rem; height: 2.9rem; margin-bottom: 0.15rem; border: 1px solid rgba(212, 168, 67, 0.4); border-radius: 50%; background: rgba(var(--l-bg, 5, 9, 19), 0.7); cursor: pointer; }
.cmp-swap svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: #d4a843; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.cmp-swap:hover:not(:disabled) { border-color: #e3bf65; background: rgba(212, 168, 67, 0.08); }
.cmp-swap:disabled { opacity: 0.4; cursor: default; }
.cmp-filter-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.cmp-season { min-width: 220px; }
.cmp-season .custom-select-container { margin: 0; }
.cmp-filter-row .pt-toggle { margin-left: 0; }
.cmp-capture-wrap { display: grid; gap: 1.25rem; }
.cmp-cap-header { display: none; justify-content: center; padding-top: 1rem; }
.cmp-cap-logo { width: 56px; height: 56px; }
.cmp-radar { margin-bottom: 0.5rem; }
.cmp-capture-row { display: flex; justify-content: center; }
.cmp-tooltip { padding: 0.6rem 0.8rem; border: 1px solid rgba(212, 168, 67, 0.4); border-radius: 10px; background: rgba(8, 15, 31, 0.97); font-size: 0.8rem; }
.cmp-tooltip p { margin: 0.1rem 0; }
.cmp-tooltip-subject { font-weight: 800; color: #e3bf65; }
.cmp-tooltip-a { color: #e3bf65; } .cmp-tooltip-b { color: #9fb3c8; }
.cmp-spinner { width: 18px; height: 18px; border: 2px solid rgba(212, 168, 67, 0.3); border-top-color: #d4a843; border-radius: 50%; animation: cmp-spin 0.8s linear infinite; }
@keyframes cmp-spin { to { transform: rotate(360deg); } }
@media (max-width: 640px) {
    .cmp-pickers { grid-template-columns: minmax(0, 1fr); }
    .cmp-swap { justify-self: center; transform: rotate(90deg); margin: 0; }
    .cx-pick.is-right .pc-panel { right: auto; }
    .cmp-season { width: 100%; }
    .cmp-filter-row .pt-toggle { width: 100%; justify-content: center; }
}
</style>

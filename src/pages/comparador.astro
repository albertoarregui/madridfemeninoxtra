---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { fetchPlayersDirectly } from "../utils/players";
import PlayerRadarComparator from "../components/PlayerRadarComparator";

const players = await fetchPlayersDirectly();

const playerOptions = players
    .map((p: any) => ({
        slug:     p.slug,
        nombre:   p.nombre,
        imageUrl: p.imageUrl,
        posicion: p.posicion ?? '',
    }))
    .sort((a: any, b: any) => a.nombre.localeCompare(b.nombre, 'es'));

const { a: slugA = '', b: slugB = '' } = Astro.url.searchParams
    ? Object.fromEntries(Astro.url.searchParams)
    : {};
---

<Layout
    title="Comparador de Jugadoras | Madrid Femenino Xtra"
    description="Compara las estadísticas de dos jugadoras del Real Madrid Femenino con un gráfico radar interactivo."
>
    <main class="max-w-7xl mx-auto px-6 md:px-0 py-10">
        <header class="page-header-container">
            <h1 class="landing-title">COMPARADOR</h1>
            <p class="landing-subtitle">
                Compara las estadísticas de carrera de dos jugadoras del Real Madrid Femenino
            </p>
        </header>

        <PlayerRadarComparator
            client:load
            players={playerOptions}
            initialSlugA={slugA}
            initialSlugB={slugB}
        />
    </main>
</Layout>

<style>
    /* Selectors */
    :global(.comparador-root) {
        max-width: 900px;
        margin: 0 auto 4rem;
        padding: 0 1rem;
    }

    :global(.comparador-selectors) {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    :global(.comparador-side) {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    :global(.comparador-side-label) {
        font-family: "Bebas Neue", sans-serif;
        font-size: 0.85rem;
        letter-spacing: 2px;
    }

    :global(.comparador-vs) {
        font-family: "Bebas Neue", sans-serif;
        font-size: 2.5rem;
        color: #151e42;
        text-align: center;
        line-height: 1;
        padding-top: 1.6rem;
    }

    :global(.comparador-selector) {
        position: relative;
    }

    :global(.comparador-input-wrap) {
        border: 2px solid #ccc;
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.2s;
    }

    :global(.comparador-input) {
        width: 100%;
        padding: 0.7rem 1rem;
        border: none;
        outline: none;
        font-size: 0.95rem;
        font-family: "Inter", sans-serif;
        background: #fff;
        color: #151e42;
    }

    :global(.comparador-selected) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border: 2px solid;
        border-radius: 12px;
        padding: 0.6rem 0.75rem;
        background: #fff;
    }

    :global(.comparador-avatar) {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        object-position: top center;
        flex-shrink: 0;
    }

    :global(.comparador-selected-info) {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    :global(.comparador-selected-name) {
        font-family: "Bebas Neue", sans-serif;
        font-size: 1rem;
        color: #151e42;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    :global(.comparador-selected-pos) {
        font-family: "Inter", sans-serif;
        font-size: 0.72rem;
        color: #888;
    }

    :global(.comparador-clear) {
        background: none;
        border: none;
        cursor: pointer;
        color: #aaa;
        font-size: 1rem;
        padding: 0 0.25rem;
        flex-shrink: 0;
        transition: color 0.15s;
    }

    :global(.comparador-clear:hover) { color: #151e42; }

    :global(.comparador-dropdown) {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 12px 36px rgba(0,0,0,0.15);
        z-index: 200;
        list-style: none;
        padding: 0;
        margin: 0;
        overflow: hidden;
    }

    :global(.comparador-option) {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.55rem 0.85rem;
        cursor: pointer;
        border-bottom: 1px solid #f3f3f3;
        transition: background 0.12s;
    }

    :global(.comparador-option:last-child) { border-bottom: none; }
    :global(.comparador-option:hover)      { background: #fffbe6; }

    :global(.comparador-option-img) {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        object-position: top center;
        flex-shrink: 0;
    }

    :global(.comparador-option-name) {
        font-family: "Bebas Neue", sans-serif;
        font-size: 0.95rem;
        color: #151e42;
        flex: 1;
    }

    :global(.comparador-option-pos) {
        font-family: "Inter", sans-serif;
        font-size: 0.68rem;
        color: #aaa;
        white-space: nowrap;
    }

    :global(.comparador-loading) {
        font-family: "Inter", sans-serif;
        font-size: 0.8rem;
        color: #aaa;
        margin: 0.3rem 0 0;
    }

    /* Chart */
    :global(.comparador-chart-wrap) {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        padding: 1.5rem 1rem;
        margin-bottom: 2.5rem;
        border: 1px solid #f0f0f0;
    }

    /* Table */
    :global(.comparador-table-wrap) {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        border: 1px solid #f0f0f0;
    }

    :global(.comparador-table) {
        width: 100%;
        border-collapse: collapse;
    }

    :global(.comparador-th) {
        padding: 0.75rem 1rem;
        font-family: "Bebas Neue", sans-serif;
        font-size: 0.85rem;
        letter-spacing: 1px;
        background: #151e42;
        color: #ffde59;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 160px;
    }

    :global(.comparador-th-a)    { text-align: right; }
    :global(.comparador-th-stat) { text-align: center; background: #1e2a55; }
    :global(.comparador-th-b)    { text-align: left; }

    :global(.comparador-tr:nth-child(even)) { background: #fafafa; }

    :global(.comparador-td) {
        padding: 0.65rem 1rem;
        font-family: "Bebas Neue", sans-serif;
        font-size: 1.1rem;
        color: #151e42;
        border-bottom: 1px solid #f0f0f0;
    }

    :global(.comparador-td-a)    { text-align: right; }
    :global(.comparador-td-stat) {
        text-align: center;
        font-family: "Inter", sans-serif;
        font-size: 0.78rem;
        color: #888;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        background: #f7f7f7;
    }
    :global(.comparador-td-b) { text-align: left; }

    :global(.comparador-winner) {
        color: #151e42;
        font-weight: 900;
        background: #fffbe6;
    }

    :global(.comparador-empty) {
        text-align: center;
        padding: 4rem 2rem;
        font-family: "Inter", sans-serif;
        color: #aaa;
        font-size: 1rem;
        background: #fafafa;
        border-radius: 16px;
        border: 2px dashed #e0e0e0;
    }

    :global(.comparador-tooltip) {
        background: #151e42;
        border-radius: 8px;
        padding: 0.5rem 0.85rem;
        font-family: "Inter", sans-serif;
        font-size: 0.82rem;
        color: #fff;
        line-height: 1.6;
    }

    :global(.comparador-tooltip-label) {
        font-family: "Bebas Neue", sans-serif;
        font-size: 0.95rem;
        letter-spacing: 1px;
        color: #ffde59;
        margin: 0 0 2px;
    }

    @media (max-width: 600px) {
        :global(.comparador-selectors) {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        :global(.comparador-vs) {
            text-align: center;
            padding-top: 0;
            font-size: 1.8rem;
        }

        :global(.comparador-th),
        :global(.comparador-td) {
            padding: 0.5rem 0.6rem;
            font-size: 0.9rem;
        }
    }
</style>

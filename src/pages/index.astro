---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { getAssetMetadata } from "../utils/assets";
import heartbeatAudio from "../assets/audio/heartbeat.mp3";
import Footer from "../components/Footer.astro";

const milestones = [
    {
        displayDate: "MAYO 2019",
        title: "EL ORIGEN",
        description: "El CD Tacón logra el ascenso a Primera Iberdrola. La semilla de lo que sería el Real Madrid Femenino.",
        icon: "📍",
        image: getAssetMetadata("intro", "01-ascenso"),
    },
    {
        displayDate: "JUNIO 2019",
        title: "COMUNICADO OFICIAL",
        description: "El Real Madrid anuncia la absorción del CD Tacón. Comienza una nueva era en la historia del club.",
        icon: "📜",
        image: getAssetMetadata("intro", "02-comunicado"),
    },
    {
        displayDate: "JULIO 2019",
        title: "LA PRIMERA GALÁCTICA",
        description: "Kosovare Asllani se convierte en la primera galáctica. La sueca lideraría el proyecto en su año de transición.",
        icon: "⭐",
        image: getAssetMetadata("intro", "03-kosovare_asllani"),
    },
    {
        displayDate: "JULIO 2020",
        title: "EL SUEÑO ES REAL",
        description: "El 1 de julio de 2020 nace oficialmente el Real Madrid Femenino. Un día marcado en oro para el fútbol femenino mundial.",
        icon: "🆕",
        image: getAssetMetadata("intro", "04-comienzo"),
    },
    {
        displayDate: "OCTUBRE 2020",
        title: "EL PRIMER CLÁSICO",
        description: "Debut oficial en Primera Iberdrola con un Clásico histórico.",
        icon: "⚔️",
        image: getAssetMetadata("intro", "05-debut"),
    },
    {
        displayDate: "OCTUBRE 2020",
        title: "EL PRIMER GRITO",
        description: "Kosovare Asllani marca el primer gol oficial de la historia del Real Madrid Femenino contra el Valencia.",
        icon: "⚽",
        image: getAssetMetadata("intro", "06-primer_gol"),
    },
    {
        displayDate: "FEBRERO 2021",
        title: "LA REINA",
        description: "154 segundos: Kosovare Asllani marca el hat-trick más rápido, no solo de la historia del club, sino del fútbol femenino mundial.",
        icon: "👑",
        image: getAssetMetadata("intro", "07-hat_trick_mas_rapido"),
    },
    {
        displayDate: "MARZO 2021",
        title: "PRIMER DERBI GANADO",
        description: "Primera victoria contra el Atlético de Madrid. 0-1, con gol de Sofia Jakobsson.",
        icon: "🔥",
        image: getAssetMetadata("intro", "08-derbi"),
    },
    {
        displayDate: "JUNIO 2021",
        title: "OBJETIVO CUMPLIDO",
        description: "Clasificación a la UWCL en la primera temporada. En solo un año, el equipo ya era de élite europea.",
        icon: "🗺️",
        image: getAssetMetadata("intro", "09-clasificacion_uwcl"),
    },
    {
        displayDate: "SEPTIEMBRE 2021",
        title: "NOCHE MÁGICA",
        description: "Contra todo pronóstico, eliminamos al Manchester City en la previa de UWCL. Europa nos saluda.",
        icon: "🏆",
        image: getAssetMetadata("intro", "10-victoria_vs_city"),
    },
    {
        displayDate: "NOVIEMBRE 2021",
        title: "ERA TORIL",
        description: "Alberto Toril asume el mando del equipo, tras la destitución de David Aznar, en el momento más delicado del equipo.",
        icon: "👔",
        image: getAssetMetadata("intro", "11-alberto_toril"),
    },
    {
        displayDate: "MARZO 2022",
        title: "ENTRE LAS 8 MEJORES",
        description: "Debut histórico en Cuartos de Final de la UWCL. El escudo del Madrid brilla entre las mejores del viejo continente.",
        icon: "🏟️",
        image: getAssetMetadata("intro", "12-debut_cuartos_uwcl"),
    },
    {
        displayDate: "JULIO 2022",
        title: "LA CABRA",
        description: "Caroline Weir llega para dar un nuevo salto de calidad, con una primera temporada histórica sumando 28 goles y 18 asistencias.",
        icon: "🏴󠁧󠁢󠁳󠁣󠁴󠁿",
        image: getAssetMetadata("intro", "13-caroline_weir"),
    },
    {
        displayDate: "AGOSTO 2022",
        title: "DOBLE ELIMINACIÓN AL MANCHESTER CITY",
        description: "Caroline Weir marca una obra de arte para eliminar nuevamente al Manchester City, su exequipo.",
        icon: "🎯",
        image: getAssetMetadata("intro", "14-caroline_weir_vs_city"),
    },
    {
        displayDate: "FEBRERO 2023",
        title: "DIAMANTE EN BRUTO",
        description: "Linda Caicedo elige al Real Madrid. El mayor talento joven del planeta se viste de blanco.",
        icon: "🦋",
        image: getAssetMetadata("intro", "15-linda_caicedo"),
    },
    {
        displayDate: "MAYO 2023",
        title: "PRIMERA FINAL",
        description: "La primera final en la historia del club llegó en la Copa de la Reina.",
        icon: "🥈",
        image: getAssetMetadata("intro", "16-primera_final"),
    },
    {
        displayDate: "AGOSTO 2023",
        title: "CAMPEONAS DEL MUNDO",
        description: "Hasta 8 jugadoras del Real Madrid tocaron el cielo con la selección española en Sydney. Olga Carmona marcó el gol de la victoria.",
        icon: "🌍",
        image: getAssetMetadata("intro", "17-mundial"),
    },
    {
        displayDate: "MARZO 2025",
        title: "SUDOR, BARRO Y CORAZÓN",
        description: "Primera victoria en un partido de los Cuartos de Final de la UWCL. El equipo sigue rompiendo barreras en Europa.",
        icon: "💪",
        image: getAssetMetadata("intro", "18-primera_victoria_cuartos_uwcl"),
    },
    {
        displayDate: "MARZO 2025",
        title: "MONTJUIC CONQUISTADO",
        description: "El Real Madrid Femenino consigue su primera victoria en un Clásico contra el FC Barcelona, con un doblete de Caroline Weir y un gol de Alba Redondo, en Montjuic.",
        icon: "🤍",
        image: getAssetMetadata("intro", "20_clasico"),
    },
    {
        displayDate: "JUNIO 2024",
        title: "HOY",
        description: "Pau Quesada toma las riendas del Real Madrid Femenino, tras la marcha de Alberto Toril. Empieza una nueva etapa.",
        icon: "💎",
        image: getAssetMetadata("intro", "19-pau_quesada"),
    },
];

const heroBg = getAssetMetadata("background", "background.webp");
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#060d1c" />
        <title>Madrid Femenino Xtra | Noticias y actualidad del Real Madrid Femenino</title>
        <meta
            name="description"
            content="Tu fuente 100% dedicada al Real Madrid Femenino: noticias, resultados, calendario y estadísticas históricas de todas las jugadoras, partidos y rivales."
        />
        <link rel="canonical" href="https://www.madridfemeninoxtra.com/home" />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Madrid Femenino Xtra" />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:url" content="https://www.madridfemeninoxtra.com/home" />
        <meta
            property="og:title"
            content="Madrid Femenino Xtra | Noticias y actualidad del Real Madrid Femenino"
        />
        <meta
            property="og:description"
            content="Tu fuente 100% dedicada al Real Madrid Femenino: noticias, resultados, calendario y estadísticas históricas de todas las jugadoras, partidos y rivales."
        />
        <meta
            property="og:image"
            content="https://www.madridfemeninoxtra.com/og.png"
        />
        <meta property="og:image:width" content="1280" />
        <meta property="og:image:height" content="720" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@madridfemxtra" />
        <meta
            name="twitter:title"
            content="Madrid Femenino Xtra | Noticias y actualidad del Real Madrid Femenino"
        />
        <meta
            name="twitter:description"
            content="Tu fuente 100% dedicada al Real Madrid Femenino: noticias, resultados, calendario y estadísticas históricas de todas las jugadoras, partidos y rivales."
        />
        <meta
            name="twitter:image"
            content="https://www.madridfemeninoxtra.com/og.png"
        />

        <link rel="icon" type="image/webp" href="/icon.webp" />
        <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"
            rel="stylesheet"
        />
        <link rel="prefetch" href="/home" />
        <ClientRouter />
    </head>

    <body>
        <div class="fixed inset-0 z-[-1]">
            <div class="absolute inset-0" style="background:#060d1c;"></div>
            <div
                class="absolute inset-0 z-10"
                style="background:linear-gradient(to right,#060d1c 0%,transparent 40%,transparent 60%,#060d1c 100%);"
            ></div>
            {
                heroBg && (
                    <Image
                        src={heroBg}
                        alt=""
                        class="w-full h-full object-cover scale-110 animate-pulse-slow"
                        style="opacity:0.18; object-position: center center;"
                        width={1920}
                        height={1080}
                        format="webp"
                        loading="eager"
                    />
                )
            }
        </div>

        <a
            href="/home"
            data-astro-prefetch="load"
            class="skip-btn"
        >
            Saltar Intro
            <span class="skip-arrow">→</span>
        </a>

        <audio id="heartbeat-audio" src={heartbeatAudio} preload="auto"></audio>
        <div id="particles-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden"></div>

        <div class="page-wrap">

            <header class="tl-header animate-fade-in-down">
                <h1 class="tl-main-title" data-title="NUESTRO LEGADO">NUESTRO LEGADO</h1>
                <p class="tl-subtitle">
                    De cero a la élite. Así se forja la historia de la sección<br class="hidden md:block" />
                    femenina del mejor club del mundo.
                </p>
            </header>

            <div class="tl-body">
                <div class="tl-line"></div>
                <div class="tl-line-cap tl-line-cap--top"></div>

                <div class="tl-items">
                    {
                        milestones.map((item, index) => (
                            <div
                                class={`tl-item timeline-item ${index % 2 === 0 ? "tl-item--even" : "tl-item--odd"}`}
                            >
                                <div class="tl-dot" />

                                <svg
                                    class={`tl-connector ${index % 2 === 0 ? "tl-connector--even" : "tl-connector--odd"}`}
                                    viewBox="0 0 140 30"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M0,15 L30,15 L40,5 L50,25 L60,15 L140,15"
                                        fill="none"
                                        stroke="#d4a843"
                                        stroke-width="2.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        style="filter:drop-shadow(0 0 4px rgba(212,168,67,0.5));"
                                    />
                                </svg>

                                <div
                                    class={`tl-endpoint ${index % 2 === 0 ? "tl-endpoint--even" : "tl-endpoint--odd"}`}
                                />

                                <div
                                    class={`tl-card-side ${index % 2 === 0 ? "tl-card-side--even" : "tl-card-side--odd"}`}
                                >
                                    <div class="tl-mobile-bar" />

                                    <div
                                        class="tl-card timeline-content"
                                        onclick="this.scrollIntoView({behavior:'smooth',block:'center'}); if(window.playHeartbeat) window.playHeartbeat();"
                                    >
                                        <div class="tl-card-img-wrap">
                                            {item.image ? (
                                                <Image
                                                    src={item.image}
                                                    alt={item.title}
                                                    class="tl-card-img"
                                                    width={600}
                                                    height={400}
                                                    format="webp"
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            ) : (
                                                <div class="tl-card-img-placeholder">
                                                    <span>{item.icon}</span>
                                                </div>
                                            )}
                                            <div
                                                class={`tl-badge ${index % 2 === 0 ? "tl-badge--right" : "tl-badge--left"}`}
                                            >
                                                {item.icon}
                                            </div>
                                        </div>

                                        <div
                                            class={`tl-card-text ${index % 2 === 0 ? "" : "tl-card-text--flip"}`}
                                        >
                                            <p class="tl-date">{item.displayDate}</p>
                                            <h3 class="tl-card-title">{item.title}</h3>
                                            <p class="tl-card-desc">{item.description}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div class="tl-line-cap tl-line-cap--bottom"></div>
            </div>

            <div class="tl-cta">
                <a href="/home" data-astro-prefetch="load" class="cta-btn">
                    ENTRA EN MFX
                </a>
            </div>

            <Footer />
        </div>

        <div id="nav-overlay" aria-hidden="true"></div>

        <script>
            (window as unknown as Record<string, unknown>).playHeartbeat = function () {
                const audio = document.getElementById("heartbeat-audio") as HTMLAudioElement;
                if (audio) {
                    audio.volume = 1.0;
                    audio.currentTime = 0;
                    audio.play().catch((e: unknown) => console.error("Audio play failed:", e));
                }
            };

            function navigateTo(url: string) {
                try { localStorage.setItem("madridxtra_intro_seen", "true"); } catch (_) {}
                const overlay = document.getElementById("nav-overlay");
                if (overlay) {
                    overlay.classList.add("active");
                    overlay.addEventListener("transitionend", () => {
                        window.location.href = url;
                    }, { once: true });
                } else {
                    window.location.href = url;
                }
            }

            document.querySelectorAll<HTMLAnchorElement>(".skip-btn, .cta-btn").forEach(link => {
                link.addEventListener("click", (e) => {
                    e.preventDefault();
                    navigateTo(link.getAttribute("href") ?? "/home");
                });
            });

            document.addEventListener("DOMContentLoaded", () => {
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) entry.target.classList.add("is-visible");
                        });
                    },
                    { threshold: 0.15, rootMargin: "0px 0px -50px 0px" }
                );
                document.querySelectorAll(".timeline-item").forEach((el) => observer.observe(el));

                const container = document.getElementById("particles-container");
                if (container) {
                    for (let i = 0; i < 40; i++) {
                        const p = document.createElement("div");
                        const size = Math.random() * 3 + 1;
                        const isGold = Math.random() > 0.65;
                        p.style.cssText = `
                            width:${size}px;height:${size}px;
                            background:${isGold ? "#d4a843" : "rgba(255,255,255,0.18)"};
                            position:absolute;border-radius:50%;
                            left:${Math.random() * 100}vw;top:${Math.random() * 100}vh;
                            animation:float ${Math.random() * 12 + 10}s linear infinite;
                        `;
                        container.appendChild(p);
                    }
                }
            });
        </script>

        <style>
            body {
                background: #060d1c;
                color: #f0f0f0;
                overflow-x: hidden;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            .skip-btn {
                position: fixed;
                top: 1.5rem;
                right: 1.5rem;
                z-index: 50;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.45rem 1.25rem;
                border-radius: 100px;
                border: 1px solid rgba(212, 168, 67, 0.35);
                background: rgba(6, 13, 28, 0.6);
                backdrop-filter: blur(8px);
                color: rgba(212, 168, 67, 0.7);
                font-family: 'DM Sans', sans-serif;
                font-size: 0.78rem;
                font-weight: 500;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                text-decoration: none;
                transition: all 0.25s ease;
            }
            .skip-btn:hover {
                border-color: #d4a843;
                color: #d4a843;
                background: rgba(212, 168, 67, 0.08);
            }
            .skip-arrow { transition: transform 0.2s; display: inline-block; }
            .skip-btn:hover .skip-arrow { transform: translateX(3px); }

            .page-wrap {
                position: relative;
                width: 100%;
                min-height: 100vh;
                padding: clamp(3.5rem, 8vw, 5rem) 1rem 0;
                transition: padding 0.4s ease;
            }

            .tl-header {
                text-align: center;
                margin-bottom: clamp(3rem, 8vw, 7rem);
                position: relative;
                z-index: 10;
                padding: 0 1rem;
                transition: margin 0.4s ease;
            }
            .tl-main-title {
                font-family: 'Cinzel', serif;
                font-size: clamp(2rem, 5.5vw, 4.5rem);
                font-weight: 900;
                color: #d4a843;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                line-height: 1;
                margin: 0 0 1.5rem;
                filter: drop-shadow(0 0 40px rgba(212, 168, 67, 0.25));
                position: relative;
            }
            .tl-main-title::before {
                content: attr(data-title);
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                font-size: min(1.8em, 7vw);
                font-weight: 900;
                font-family: 'Cinzel', serif;
                color: #d4a843;
                opacity: 0.08;
                white-space: nowrap;
                pointer-events: none;
                user-select: none;
                letter-spacing: 0.08em;
                line-height: 1;
                z-index: -1;
            }
            .tl-subtitle {
                font-family: 'DM Sans', sans-serif;
                font-size: clamp(0.95rem, 2.2vw, 1.25rem);
                color: rgba(200, 210, 220, 0.5);
                font-style: italic;
                max-width: 600px;
                margin: 0 auto;
                line-height: 1.75;
            }

            .tl-body {
                position: relative;
                max-width: 1280px;
                margin: 0 auto;
                padding: 3rem 0 3rem;
            }

            .tl-line {
                position: absolute;
                left: 1rem;
                top: 0;
                bottom: 0;
                width: 3px;
                background: #d4a843;
                box-shadow: 0 0 14px rgba(212, 168, 67, 0.45);
                border-radius: 2px;
                z-index: 0;
            }
            .tl-line-cap {
                position: absolute;
                left: 1rem;
                width: 1.75rem;
                height: 1.75rem;
                background: #d4a843;
                transform: translateX(-50%) rotate(45deg);
                box-shadow: 0 0 18px rgba(212, 168, 67, 0.6);
                z-index: 10;
            }
            .tl-line-cap--top { top: -0.875rem; }
            .tl-line-cap--bottom { bottom: -0.875rem; }

            @media (min-width: 1024px) {
                .tl-line { left: 50%; transform: translateX(-50%); }
                .tl-line-cap { left: 50%; }
            }

            .tl-items {
                display: flex;
                flex-direction: column;
                gap: clamp(3rem, 8vw, 6rem);
                padding: clamp(2rem, 5vw, 4rem) 0;
                transition: gap 0.4s ease, padding 0.4s ease;
            }

            .tl-item {
                position: relative;
                display: flex;
                align-items: center;
                flex-direction: column;
                padding-left: 3rem;
            }

            .tl-dot {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translate(-50%, -50%);
                width: 0.9rem;
                height: 0.9rem;
                background: #d4a843;
                border-radius: 50%;
                box-shadow: 0 0 10px rgba(212, 168, 67, 0.7);
                z-index: 10;
            }

            .tl-connector {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                width: 140px;
                height: 30px;
                z-index: 0;
                overflow: visible;
                display: none;
            }

            .tl-endpoint {
                position: absolute;
                top: 50%;
                width: 1.25rem;
                height: 1.25rem;
                background: #d4a843;
                transform: translateY(-50%) rotate(45deg);
                box-shadow: 0 0 12px rgba(212, 168, 67, 0.5);
                z-index: 20;
                display: none;
                transition: transform 0.4s ease, background 0.3s ease;
            }
            .tl-item:hover .tl-endpoint {
                transform: translateY(-50%) rotate(45deg) scale(1.3);
                background: #fff;
            }

            .tl-mobile-bar {
                position: absolute;
                left: -2rem;
                top: 50%;
                transform: translateY(-50%);
                width: 1.75rem;
                height: 2px;
                background: #d4a843;
            }

            .tl-card-side {
                position: relative;
                width: 100%;
            }

            .tl-card {
                position: relative;
                width: 100%;
                max-width: 30rem;
                cursor: pointer;
                transition: transform 0.6s ease;
            }
            .tl-card:hover { transform: scale(1.03); }
            .tl-card:active { transform: scale(0.98); opacity: 0.9; }

            .tl-card-img-wrap { position: relative; }
            .tl-card-img {
                width: 100%;
                height: auto;
                border-radius: 0.9rem;
                border: 1px solid rgba(212, 168, 67, 0.2);
                box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
                display: block;
            }
            .tl-card-img-placeholder {
                width: 100%;
                height: 14rem;
                background: rgba(6, 13, 28, 0.9);
                border-radius: 0.9rem;
                border: 1px solid rgba(212, 168, 67, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2.5rem;
            }

            .tl-badge {
                position: absolute;
                top: -1.4rem;
                width: 3.25rem;
                height: 3.25rem;
                background: #d4a843;
                color: #060d1c;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
                border: 4px solid #060d1c;
                box-shadow: 0 4px 16px rgba(212, 168, 67, 0.4);
                z-index: 30;
            }
            .tl-badge--right { right: -1.4rem; }
            .tl-badge--left  { left:  -1.4rem; }

            .tl-card-text { margin-top: 1.25rem; }

            .tl-date {
                font-family: 'DM Sans', sans-serif;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 0.24em;
                text-transform: uppercase;
                color: #d4a843;
                margin: 0 0 0.3rem;
            }
            .tl-card-title {
                font-family: 'Cinzel', serif;
                font-size: clamp(1.2rem, 2.5vw, 1.6rem);
                font-weight: 700;
                color: #f0f0f0;
                text-transform: uppercase;
                line-height: 1.1;
                letter-spacing: 0.04em;
                margin: 0 0 0.65rem;
            }
            .tl-card-desc {
                font-family: 'DM Sans', sans-serif;
                font-size: 0.88rem;
                color: rgba(200, 210, 220, 0.6);
                line-height: 1.7;
                margin: 0;
                max-width: 28rem;
            }

            @media (min-width: 1024px) {
                .tl-dot  { left: 50%; }
                .tl-connector { display: block; }
                .tl-endpoint  { display: block; }
                .tl-mobile-bar { display: none; }

                .tl-item {
                    flex-direction: row;
                    padding-left: 0;
                }
                .tl-item--even { flex-direction: row-reverse; }
                .tl-item--odd  { flex-direction: row; }

                .tl-connector--even { left: 50%; }
                .tl-connector--odd  { right: 50%; transform: translateY(-50%) scaleX(-1); }

                .tl-endpoint--even { left:  calc(50% + 140px); }
                .tl-endpoint--odd  { right: calc(50% + 140px); }

                .tl-card-side { width: 50%; }
                .tl-item--even .tl-card-side { padding-left: 220px; }
                .tl-item--odd  .tl-card-side { padding-right: 220px; }

                .tl-item--even .tl-card { margin-left: 0; }
                .tl-item--odd  .tl-card { margin-left: auto; }

                .tl-card-text--flip { text-align: right; }
                .tl-card-text--flip .tl-card-desc { margin-left: auto; }
            }

            @media (max-width: 768px) {
                .page-wrap {
                    padding-top: 5rem;
                }
            }

            @media (max-width: 480px) {
                .skip-btn {
                    top: 0.75rem;
                    right: 0.75rem;
                    padding: 0.35rem 0.85rem;
                    font-size: 0.68rem;
                    gap: 0.35rem;
                }
                .page-wrap {
                    padding-top: 5.5rem;
                }
            }

            @media (max-width: 1023px) {
                .tl-line-cap--bottom {
                    display: none;
                }
                .tl-body {
                    padding-bottom: 0;
                }
                .tl-cta {
                    text-align: left;
                    padding: 1.5rem 1rem 2.5rem 3.5rem;
                }
                .tl-cta::before {
                    content: '';
                    position: absolute;
                    left: 1rem;
                    transform: translateX(-50%);
                    top: 0;
                    height: 50%;
                    width: 3px;
                    background: #d4a843;
                    box-shadow: 0 0 14px rgba(212, 168, 67, 0.45);
                }
                .tl-cta::after {
                    content: '';
                    position: absolute;
                    left: 1rem;
                    transform: translateX(-50%) rotate(45deg);
                    top: calc(50% - 0.875rem);
                    width: 1.75rem;
                    height: 1.75rem;
                    background: #d4a843;
                    box-shadow: 0 0 18px rgba(212, 168, 67, 0.6);
                    z-index: 5;
                }
            }

            .tl-cta {
                text-align: center;
                position: relative;
                z-index: 20;
                padding: clamp(3rem, 6vw, 5rem) 0 2rem;
            }
            .cta-btn {
                display: inline-flex;
                align-items: center;
                gap: 1rem;
                padding: 1rem 3.5rem;
                min-height: 44px;
                background: #d4a843;
                color: #060d1c;
                font-family: 'Cinzel', serif;
                font-size: 1rem;
                font-weight: 700;
                letter-spacing: 0.22em;
                text-transform: uppercase;
                text-decoration: none;
                border-radius: 3px;
                transition: all 0.25s ease;
                box-shadow: 0 4px 24px rgba(212, 168, 67, 0.3);
            }
            .cta-btn:hover {
                background: #c49030;
                transform: translateY(-2px);
                box-shadow: 0 8px 32px rgba(212, 168, 67, 0.4);
            }

            #nav-overlay {
                position: fixed;
                inset: 0;
                background: #060d1c;
                opacity: 0;
                pointer-events: none;
                z-index: 9999;
                transition: opacity 0.55s ease;
            }
            #nav-overlay.active {
                opacity: 1;
                pointer-events: all;
            }

            .animate-fade-in-down {
                animation: fadeInDown 1.4s ease-out forwards;
            }
            @keyframes fadeInDown {
                from { opacity: 0; transform: translateY(-24px); }
                to   { opacity: 1; transform: translateY(0); }
            }

            @keyframes float {
                0%   { transform: translateY(0) translateX(0); opacity: 0; }
                10%  { opacity: 0.9; }
                90%  { opacity: 0.9; }
                100% { transform: translateY(-120px) translateX(40px); opacity: 0; }
            }

            .animate-pulse-slow {
                animation: bgPulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
            }
            @keyframes bgPulse {
                0%, 100% { opacity: 0.12; transform: scale(1.1); }
                50%       { opacity: 0.08; transform: scale(1); }
            }

            .timeline-content {
                opacity: 0;
                transform: translateY(18px) scale(0.98);
                transition: opacity 0.85s ease-out, transform 0.85s ease-out;
            }
            .timeline-item.is-visible .timeline-content {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        </style>
    </body>
</html>

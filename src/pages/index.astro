---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import "../styles/home.css";
import ResumenEstadisticas from "../components/ResumenEstadisticas.astro";
import Calendar from "../components/Calendar.astro";
import RecentResults from "../components/RecentResults.astro";
import LigaFStandings from "../components/LigaFStandings.astro";
import YoutubeSection from "../components/YoutubeSection.astro";
import PlayerOfTheMonthWidget from "../components/PlayerOfTheMonthWidget.astro";
import HistoryCarousel from "../components/HistoryCarousel.astro";
import ProtagonistasSection from "../components/ProtagonistasSection.astro";
import { cached } from "../utils/cache";
import { getRequestLocale } from "../i18n/request-locale";
import { compactDashboardPayload } from "../lib/dashboard-payload";

import { fetchGamesDirectly, fetchAllGoals } from "../utils/partidos";
import ClubStatsDashboard from "../components/ClubStatsDashboard";
import { getAssetUrl } from "../utils/assets";

// Estas consultas son independientes; ejecutarlas en paralelo reduce el TTFB.
const [gamesData, allGoals] = await Promise.all([
	fetchGamesDirectly(),
	fetchAllGoals(),
]);

let spotlightNews: any[] = [];
try {
	const { contentfulClient } = await import("../lib/contentful");

	const [cronicaEntry, previaEntry] = await cached(`contentful:home:spotlight-v1:${getRequestLocale()}`, 10 * 60 * 1000, async () => Promise.all([
		contentfulClient.getEntries({
			content_type: "noticia", limit: 1, "fields.category": "CRÓNICA", order: ["-sys.createdAt"],
		}),
		contentfulClient.getEntries({
			content_type: "noticia", limit: 1, "fields.category": "PREVIA", order: ["-sys.createdAt"],
		}),
	]), { tags: ["news", "homepage"] });

	const cronica = cronicaEntry.items[0];
	const previa = previaEntry.items[0];

	if (previa)
		spotlightNews.push({
			...previa.fields,
			id: previa.sys.id,
			createdAt: previa.sys.createdAt,
		});
	if (cronica)
		spotlightNews.push({
			...cronica.fields,
			id: cronica.sys.id,
			createdAt: cronica.sys.createdAt,
		});
} catch (e) {
	console.error("Error fetching news for home:", e);
}

const CAMPOS_PARTIDO_STATS = [
	"temporada_nombre",
	"competicion_nombre",
	"goles_rm",
	"goles_rival",
	"penaltis",
	"resultado",
	"asistencia",
	"capacidad",
	"estadio",
	"faltas_cometidas",
	"faltas_recibidas",
	"amarillas_rm",
	"amarillas_rival",
	"rojas_rm",
	"rojas_rival",
	"penaltis_rm",
	"penaltis_rival",
	"club_local",
	"club_visitante",
	"fecha",
] as const;

const CAMPOS_GOL_STATS = [
	"id_gol",
	"minuto",
	"temporada",
	"competicion",
	"nombre_goleadora",
	"foto_goleadora",
	"nombre_asistente",
	"foto_asistente",
] as const;

function proyectar<T extends Record<string, any>>(
	filas: T[],
	campos: readonly string[],
): T[] {
	return filas.map((fila) => {
		const salida: Record<string, any> = {};
		for (const campo of campos) {
			if (fila[campo] !== undefined) salida[campo] = fila[campo];
		}
		return salida as T;
	});
}

const statsMatches = proyectar(gamesData, CAMPOS_PARTIDO_STATS);
const statsGoals = proyectar(allGoals, CAMPOS_GOL_STATS);
const dashboardPayload = compactDashboardPayload(statsMatches, statsGoals);

const uniqueSeasons = [
	...new Set(gamesData.map((g) => g.temporada_nombre).filter((s) => s)),
]
	.sort()
	.reverse();

const competitionOrder = [
	"Liga F",
	"UWCL",
	"Copa de la Reina",
	"Supercopa de España",
	"Amistosos",
];

const uniqueCompetitions = [
	...new Set(gamesData.map((g) => g.competicion_nombre).filter((c) => c)),
].sort((a, b) => {
	const indexA = competitionOrder.indexOf(a as string);
	const indexB = competitionOrder.indexOf(b as string);
	if (indexA !== -1 && indexB !== -1) return indexA - indexB;
	if (indexA !== -1) return -1;
	if (indexB !== -1) return 1;
	return (a as string).localeCompare(b as string);
});

// Logos de las píldoras de competición del panel de estadísticas.
const competitionLogos = Object.fromEntries(
	["Primera Iberdrola", "Liga F", "UWCL", "Copa de la Reina", "Supercopa de España", "Amistosos"]
		.map((name) => [name, getAssetUrl("competiciones", name === "Amistosos" ? "amistoso" : name) || ""]),
);
---

<Layout
	title="Real Madrid Femenino: noticias, partidos, plantilla y estadísticas | Madrid Femenino Xtra"
	description="Tu fuente 100% dedicada al Real Madrid Femenino: Noticias, resultados, clasificación, calendario y estadísticas. ¡Entra y no te pierdas nada!"
>
	<h1 class="titulo-seo">
		Real Madrid Femenino: noticias, resultados y estadísticas
	</h1>

	<section class="hero">
		<div class="hero-text">
<ResumenEstadisticas />
		</div>
	</section>

	<div class="w-full overflow-hidden" style="padding: 3rem 0;">
		<HistoryCarousel />
	</div>

	<div class="content-layout">
		<main class="welcome-area">
			<section class="news-content">
				{
					spotlightNews.length > 0 && (
						<div class="spotlight-section mb-[4rem]">
						<div class="spotlight-news-grid">
							{spotlightNews.map((noticia) => (
								<a
									href={`/noticias/${noticia.slug}`}
									class="spotlight-card mfx-link-card"
								><span class="mfx-spin" aria-hidden="true"></span>
									<div class="spotlight-image">
										<Image
											src={
												noticia.featuredImage?.fields
													?.file?.url
													? (String(noticia.featuredImage.fields.file.url).startsWith("//") ? `https:${noticia.featuredImage.fields.file.url}` : `${noticia.featuredImage.fields.file.url}`)
													: "/og.png"
											}
											alt={noticia.title}
											width={400}
											height={360}
											quality={72}
											format="webp"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<div class="spotlight-content">
										<span class={`spotlight-tag ${(noticia.category || "").toLowerCase()}`}>
											{noticia.category}
										</span>
										<h3 class="spotlight-title">
											{noticia.title}
										</h3>
										{noticia.subtitle && (
											<p class="spotlight-subtitle">{noticia.subtitle}</p>
										)}
										<time class="spotlight-date">
											{new Date(noticia.createdAt)
												.toLocaleDateString("es-ES", {
													day: "2-digit",
													month: "long",
													year: "numeric",
												})
												.toUpperCase()}
										</time>
									</div>
								</a>
							))}
						</div>
					</div>
					)
				}

				<div
					class="season-stats-section mb-[4rem] w-full"
					id="stats-dashboard"
				>
					<div class="title-block">
						<h2 class="landing-title">ESTADÍSTICAS</h2>
						<p class="landing-subtitle">
							Balance histórico por temporada y competición del Real
							Madrid Femenino
						</p>
					</div>
					<ClubStatsDashboard
						matchRows={dashboardPayload.matchRows}
						goalRows={dashboardPayload.goalRows}
						playerImages={dashboardPayload.playerImages}
						seasons={uniqueSeasons}
						competitions={uniqueCompetitions}
						competitionLogos={competitionLogos}
						client:visible
					/>
				</div>

				<div class="protagonistas-container mb-[4rem] w-full">
					<ProtagonistasSection />
				</div>

				<div class="youtube-container mb-[4rem]">
					<YoutubeSection />
				</div>
			</section>
		</main>

		<aside class="proximo-partido sidebar-right">
			<span class="section-label">♦ CALENDAR ♦</span>
			<h2 class="section-title">CALENDARIO</h2>
			<Calendar />

			<span class="section-label">♦ RECENT RESULTS ♦</span>
			<h2 class="section-title">ÚLTIMOS RESULTADOS</h2>
			<RecentResults games={gamesData} />

			<span class="section-label">♦ PLAYER OF THE MONTH ♦</span>
			<h2 class="section-title">JUGADORA DEL MES</h2>
			<PlayerOfTheMonthWidget />

			<span class="section-label">♦ LIGA F + UWCL ♦</span>
			<h2 class="section-title">CLASIFICACIONES</h2>
			<LigaFStandings />
		</aside>
	</div>
</Layout>

<style>
	.titulo-seo {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		border: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

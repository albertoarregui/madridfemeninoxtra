---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";
import { contentfulClient } from "../../lib/contentful";
import "../../styles/global.css";

let articles: any[] = [];
try {
    const entries = await contentfulClient.getEntries({
        content_type: "noticia",
        order: ["-sys.createdAt"] as any,
        limit: 50,
    });
    articles = entries.items
        .filter((item: any) => String(item.fields?.author || "").toLowerCase().includes("alberto"))
        .slice(0, 12)
        .map((item: any) => ({
            title: item.fields?.title,
            slug: item.fields?.slug,
            category: item.fields?.category,
            date: item.fields?.publishDate || item.sys.createdAt,
        }))
        .filter((item: any) => item.title && item.slug);
} catch (error) {
    console.warn("No se pudieron cargar artículos del autor", error);
}

const pageUrl = "https://www.madridfemeninoxtra.com/autor/alberto-arregui";
const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${pageUrl}#person`,
    name: "Alberto Arregui",
    url: pageUrl,
    jobTitle: "Fundador y director de Madrid Femenino Xtra",
    worksFor: {
        "@type": "Organization",
        name: "Madrid Femenino Xtra",
        url: "https://www.madridfemeninoxtra.com",
    },
    knowsAbout: [
        "Real Madrid Femenino",
        "fútbol femenino",
        "periodismo deportivo",
        "estadística de fútbol",
    ],
    sameAs: [
        "https://x.com/madridfemxtra",
        "https://instagram.com/madridfemxtra",
        "https://tiktok.com/@madridfemeninoxtra",
    ],
};
---

<Layout
    title="Alberto Arregui, fundador de Madrid Femenino Xtra | MFX"
    description="Perfil de Alberto Arregui, fundador y director de Madrid Femenino Xtra, medio especializado en el Real Madrid Femenino y su base de datos histórica."
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(
            breadcrumbSchema([
                { name: "Inicio", path: "/" },
                { name: "Autor", path: "/autor/alberto-arregui" },
                { name: "Alberto Arregui", path: "/autor/alberto-arregui" },
            ]),
        )}
    />

    <main class="author-page max-w-5xl mx-auto px-6 py-12">
        <header class="page-header-container">
            <h1 class="landing-title">Alberto Arregui</h1>
            <p class="landing-subtitle">Fundador y director de Madrid Femenino Xtra</p>
        </header>

        <section class="author-card">
            <div class="author-card-head">Autor y responsable editorial</div>
            <div class="author-card-body">
                <p>
                    Alberto Arregui es el fundador y director de <strong>Madrid Femenino Xtra</strong>,
                    proyecto especializado exclusivamente en el Real Madrid Femenino. Sigue al equipo
                    desde 2019 y puso en marcha la comunidad de MFX en septiembre de 2023; la web y su
                    base de datos histórica se publicaron en diciembre de 2025.
                </p>
                <p>
                    En MFX se encarga de la cobertura editorial, la investigación y mantenimiento de
                    datos, la producción multimedia y el desarrollo del producto. El objetivo es combinar
                    actualidad con un archivo estadístico verificable que permita consultar la historia del
                    equipo por jugadora, partido, rival, estadio, árbitra y temporada.
                </p>
                <p>
                    Consulta la <a href="/politica-editorial">política editorial y metodología de datos</a>
                    para conocer cómo se verifican, corrigen y actualizan las publicaciones y estadísticas.
                </p>
            </div>
        </section>

        {articles.length > 0 && (
            <section class="author-articles">
                <h2>Últimos artículos</h2>
                <div class="article-grid">
                    {articles.map((article: any) => (
                        <a class="article-card" href={`/noticias/${article.slug}`}>
                            <div class="article-card-head">{article.category || "ACTUALIDAD"}</div>
                            <div class="article-card-body">
                                <strong>{article.title}</strong>
                                <time>
                                    {new Date(article.date).toLocaleDateString("es-ES", {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric",
                                    })}
                                </time>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )}
    </main>
</Layout>

<style>
    .author-card,
    .article-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(212, 168, 67, 0.18);
        border-radius: 4px;
        background: rgba(8, 16, 34, 0.85);
    }
    .author-card::before,
    .article-card::before,
    .author-card::after,
    .article-card::after {
        content: "";
        position: absolute;
        width: 11px;
        height: 11px;
        pointer-events: none;
    }
    .author-card::before,
    .article-card::before {
        top: 0; left: 0;
        border-top: 1px solid rgba(212, 168, 67, 0.5);
        border-left: 1px solid rgba(212, 168, 67, 0.5);
    }
    .author-card::after,
    .article-card::after {
        right: 0; bottom: 0;
        border-right: 1px solid rgba(212, 168, 67, 0.5);
        border-bottom: 1px solid rgba(212, 168, 67, 0.5);
    }
    .author-card-head,
    .article-card-head {
        padding: 0.85rem 1.15rem;
        border-bottom: 1px solid rgba(212, 168, 67, 0.12);
        background: rgba(212, 168, 67, 0.03);
        color: rgba(212, 168, 67, 0.82);
        font: 600 0.68rem "Cinzel", serif;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    .author-card-body {
        padding: clamp(1.3rem, 4vw, 2.3rem);
        font-family: "DM Sans", sans-serif;
        line-height: 1.75;
        color: #d7d7dc;
    }
    .author-card-body p:first-child { margin-top: 0; }
    .author-card-body p:last-child { margin-bottom: 0; }
    .author-card strong,
    .author-card a,
    .author-articles h2 { color: #d4a843; }
    .author-card a { text-underline-offset: 0.2em; }
    .author-articles { margin-top: 3rem; }
    .author-articles h2 {
        font-family: "Cinzel", serif;
        font-size: 1.4rem;
        margin-bottom: 1rem;
    }
    .article-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem;
    }
    .article-card {
        display: block;
        text-decoration: none;
        color: #f0f0f0;
        transition: 0.2s ease;
    }
    .article-card:hover {
        border-color: rgba(212, 168, 67, 0.5);
        background: rgba(10, 20, 42, 0.92);
        transform: translateY(-2px);
    }
    .article-card-body {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        padding: 1rem 1.1rem 1.15rem;
    }
    .article-card time {
        font-size: 0.72rem;
        color: #a8a8b0;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
    .article-card strong {
        font-family: "Cinzel", serif;
        line-height: 1.35;
    }
</style>

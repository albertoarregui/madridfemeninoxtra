                                        <td><strong>{playerStats.total_carrera_oficial.convocatorias}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.partidos}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.titularidades}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.minutos}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.cambio_entrada}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.cambio_salida}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.goles}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.asistencias}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.goles_asistencias}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.victorias}</strong></td>

                                        <strong class={`pt-match-score is-${m.result}`}>{m.score}</strong>
                                        <span class="pt-match-player">
                                            <span class="pt-match-role">{m.titular ? "Titular" : "Suplente"} · {m.minutos}'</span>
                                            <span class="pt-match-ga">
                                                {m.goals > 0 && <span title={`${m.goals} ${m.goals === 1 ? "gol" : "goles"}`}>⚽ {m.goals}</span>}
                                                {m.assists > 0 && <span title={`${m.assists} ${m.assists === 1 ? "asistencia" : "asistencias"}`}>🅰 {m.assists}</span>}
                                            </span>
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                        <p class="pt-note">{playerMatches.length} partidos con minutos · los más recientes primero</p>
                    </>
                )}
            </section>
        </div>
        <div class="content-grid pt-panel" id="panel-trayectoria" role="tabpanel" aria-labelledby="tab-trayectoria" data-panel="trayectoria" hidden>
            <section class="profile-card trajectory-card mfx-framed"><span class="mfx-frame" aria-hidden="true"></span>
                <h2 class="card-title">TRAYECTORIA</h2>
                <div class="card-body" style="padding:1.25rem 1.5rem;">
                    {trajectory && trajectory.length > 0 ? (
                        <div class="trajectory-timeline">
                            {trajectory.map((item: any) => (
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-body">
                                        <span class="timeline-years">{item.anio_inicio} – {item.anio_fin || 'Act.'}</span>
                                        <span class="timeline-club">{item.club}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p class="no-data">Sin datos disponibles</p>
                    )}
                </div>
            </section>
        </div>
        <nav class="player-related-links" aria-label="Más información del equipo">
            <a href="/partidos">Partidos del Real Madrid Femenino →</a>
            <a href="/plantilla">Plantilla actual →</a>
        </nav>
    </main>

    <div id="video-modal" class="video-modal-overlay">
        <div class="video-modal-container">
            <div class="video-modal-header">
                <h3 id="video-modal-title">Gol</h3>
                <button class="video-close-btn" onclick="closeVideoModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="video-modal-body">
                <video id="goal-video-player" controls class="goal-video-element">
                    <source id="video-source" src="" type="video/mp4" />
                </video>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ seasonPhotos: seasonPhotosData }}>
        let currentIdx = 0;
        const photoEl = document.getElementById("main-player-photo");
        const badgeEl = document.getElementById("photo-season-badge");
        const prevBtn = document.getElementById("prev-photo");
        const nextBtn = document.getElementById("next-photo");
        function updateCarousel() {
            if (!photoEl || !badgeEl || seasonPhotos.length === 0) return;
            const current = seasonPhotos[currentIdx];
            photoEl.src = current.url;
            badgeEl.textContent = current.season;
            if (prevBtn) prevBtn.disabled = currentIdx === seasonPhotos.length - 1;
            if (nextBtn) nextBtn.disabled = currentIdx === 0;
        }
        if (prevBtn) prevBtn.addEventListener("click", () => { if (currentIdx < seasonPhotos.length - 1) { currentIdx++; updateCarousel(); } });
        if (nextBtn) nextBtn.addEventListener("click", () => { if (currentIdx > 0) { currentIdx--; updateCarousel(); } });
        updateCarousel();
    </script>

    <script is:inline>
        function toggleSeason(season) {
            const rows = document.querySelectorAll(`.competition-row.season-${season}`);
            const icon = document.querySelector(`.season-total-row[onclick*="${season}"] .toggle-icon`);
            rows.forEach(row => {
                if (row.style.display === "none") { row.style.display = "table-row"; if (icon) icon.textContent = "▲"; }
                else { row.style.display = "none"; if (icon) icon.textContent = "▼"; }
            });
        }
        function openVideoModal(url, scorer) {
            const modal = document.getElementById("video-modal");
            const video = document.getElementById("goal-video-player");
            const source = document.getElementById("video-source");
            const title = document.getElementById("video-modal-title");
            title.textContent = `Gol de ${scorer}`;
            source.src = url;
            video.load();
            modal.style.display = "flex";
            video.play().catch(() => {});
            modal.onclick = (e) => { if (e.target === modal) closeVideoModal(); };
        }
        function closeVideoModal() {
            const modal = document.getElementById("video-modal");
            const video = document.getElementById("goal-video-player");
            video.pause();
            modal.style.display = "none";
        }
    </script>
    <script is:inline define:vars={{ perfSeasons, isGoalkeeper }}>
        (() => {
            const root = document.querySelector(".player-content");
            if (!root || root.dataset.tabsReady === "true") return;
            root.dataset.tabsReady = "true";

            // Pestañas: la elegida se guarda en la URL (?seccion=partidos).
            const tabs = [...root.querySelectorAll("[data-tab]")];
            const panels = [...root.querySelectorAll("[data-panel]")];
            const showTab = (key, updateUrl) => {
                if (!panels.some((panel) => panel.dataset.panel === key)) key = "info";
                tabs.forEach((tab) => {
                    const active = tab.dataset.tab === key;
                    tab.classList.toggle("is-active", active);
                    tab.setAttribute("aria-selected", String(active));
                    tab.tabIndex = active ? 0 : -1;
                });
                panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== key; });
                if (updateUrl) {
                    const url = new URL(location.href);
                    if (key === "info") url.searchParams.delete("seccion"); else url.searchParams.set("seccion", key);
                    history.replaceState(history.state, "", url);
                }
            };
            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => showTab(tab.dataset.tab, true));
                tab.addEventListener("keydown", (event) => {
                    if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
                    const next = tabs[(index + (event.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
                    next.focus();
                    showTab(next.dataset.tab, true);
                });
            });
            showTab(new URLSearchParams(location.search).get("seccion") || "info", false);

            // Rendimiento: temporada y competición. "Todas" suma solo competiciones oficiales.
            const perf = root.querySelector("[data-perf]");
            if (perf) {
                const state = { season: "", comp: "" };
                const compsBox = perf.querySelector("[data-perf-comps]");
                const kpisBox = perf.querySelector("[data-perf-kpis]");
                const fmt = (n) => Number(n).toLocaleString("es-ES", { maximumFractionDigits: 1 });
                const render = () => {
                    const seasons = perfSeasons.filter((s) => !state.season || s.season === state.season);
                    const comps = new Map();
                    seasons.forEach((s) => s.comps.forEach((c) => { if (!comps.has(c.key)) comps.set(c.key, c); }));
                    if (state.comp && !comps.has(state.comp)) state.comp = "";
                    compsBox.innerHTML = "";
                    const addPill = (key, label, logo) => {
                        const pill = document.createElement("button");
                        pill.type = "button";
                        pill.className = "pt-pill" + (state.comp === key ? " is-active" : "");
                        if (logo) { const img = document.createElement("img"); img.src = logo; img.alt = ""; img.width = 16; img.height = 16; pill.appendChild(img); }
                        pill.appendChild(document.createTextNode(label));
                        pill.addEventListener("click", () => { state.comp = key; render(); });
                        compsBox.appendChild(pill);
                    };
                    addPill("", "Oficiales");
                    [...comps.values()].forEach((c) => addPill(c.key, c.name, c.logo));

                    const rows = seasons.flatMap((s) => s.comps).filter((c) => state.comp ? c.key === state.comp : c.official);
                    const sum = (field) => rows.reduce((acc, c) => acc + (Number(c[field]) || 0), 0);
                    const t = { partidos: sum("partidos"), titularidades: sum("titularidades"), minutos: sum("minutos"), goles: sum("goles"), asistencias: sum("asistencias"),
                        victorias: sum("victorias"), cero: sum("porterias_cero"), amarillas: sum("amarillas"), rojas: sum("rojas"), capitanias: sum("capitanias") };
                    const pct = (a, b) => b ? `${fmt((a / b) * 100)}%` : "–";
                    const per = (a, b) => b ? fmt(a / b) : "–";
                    const kpis = [
                        ["Partidos", fmt(t.partidos)], ["Titularidades", fmt(t.titularidades)], ["Minutos", fmt(t.minutos)], ["Min. por partido", per(t.minutos, t.partidos)],
                        ...(isGoalkeeper
                            ? [["Porterías a cero", fmt(t.cero)], ["% porterías a cero", pct(t.cero, t.partidos)]]
                            : [["Goles", fmt(t.goles)], ["Asistencias", fmt(t.asistencias)], ["G+A", fmt(t.goles + t.asistencias)], ["Min. por G+A", t.goles + t.asistencias ? fmt(t.minutos / (t.goles + t.asistencias)) : "–"]]),
                        ["% victorias", pct(t.victorias, t.partidos)], ["Amarillas", fmt(t.amarillas)], ["Rojas", fmt(t.rojas)], ["Capitanías", fmt(t.capitanias)],
                    ];
                    kpisBox.innerHTML = "";
                    kpis.forEach(([label, value]) => {
                        const item = document.createElement("div"); item.className = "pt-kpi";
                        const strong = document.createElement("strong"); strong.textContent = value;
                        const span = document.createElement("span"); span.textContent = label;
                        item.append(strong, span); kpisBox.appendChild(item);
                    });
                };
                perf.querySelectorAll("[data-perf-season]").forEach((pill) => pill.addEventListener("click", () => {
                    state.season = pill.dataset.perfSeason;
                    perf.querySelectorAll("[data-perf-season]").forEach((p) => p.classList.toggle("is-active", p === pill));
                    render();
                }));
                render();
            }

            // Partidos: filtro por temporada.
            const matches = root.querySelector("[data-pmatches]");
            if (matches) {
                const pills = [...matches.querySelectorAll("[data-match-season]")];
                pills.forEach((pill) => pill.addEventListener("click", () => {
                    const season = pill.dataset.matchSeason;
                    pills.forEach((p) => p.classList.toggle("is-active", p === pill));
                    matches.querySelectorAll("li[data-season]").forEach((li) => { li.hidden = Boolean(season) && li.dataset.season !== season; });
                }));
            }
        })();
    </script>
</Layout>



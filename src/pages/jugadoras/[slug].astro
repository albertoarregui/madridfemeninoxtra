                                                    <td><strong>{season.total.minutos}</strong></td>
                                                    <td><strong>{season.total.cambio_entrada}</strong></td>
                                                    <td><strong>{season.total.cambio_salida}</strong></td>
                                                    <td><strong>{season.total.goles}</strong></td>
                                                    <td><strong>{season.total.asistencias}</strong></td>
                                                    <td><strong>{season.total.goles_asistencias}</strong></td>
                                                    <td><strong>{season.total.victorias}</strong></td>

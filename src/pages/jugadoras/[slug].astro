---
import Layout from "../../layouts/Layout.astro";
import {
    fetchPlayersDirectly,
    fetchPlayerStats,
    fetchPlayerDebut,
    fetchPlayerTrajectory,
} from "../../utils/players";

import { getAssetUrl } from "../../utils/assets";
import { getFlagSrc } from "../../utils/flags";
import { fetchAllGoals } from "../../utils/partidos";
import { fetchAllClubShields } from "../../utils/rivales";

const { slug } = Astro.params;
const allPlayers = await fetchPlayersDirectly();
const player = allPlayers.find((p) => p.slug === slug);
if (!player) {
    return Astro.redirect("/404");
}

const resolvedImage = getAssetUrl("jugadoras", player.imageUrl);
const seasonPhotosData = Object.entries(player.season_photos || {})
    .sort((a, b) => b[0].localeCompare(a[0]))
    .map(([season, url]) => ({ season, url }));

const initialSeasonIndex = 0;
const currentImageUrl = (
    seasonPhotosData.length > 0
        ? seasonPhotosData[initialSeasonIndex].url
        : resolvedImage
) as string;
const currentSeasonName =
    seasonPhotosData.length > 0
        ? seasonPhotosData[initialSeasonIndex].season
        : player.temporada || "Actualidad";

const isGoalkeeper = player.posicion === "Portera";
const playerStats = await fetchPlayerStats(player.id_jugadora, isGoalkeeper);
if (playerStats) {
    playerStats.jugadora = { id: player.id_jugadora, nombre: player.nombre };
}

const allSeasonKeys = allPlayers.flatMap(p => Object.keys(p.dorsales || {}));
const latestRegisteredSeason = [...new Set(allSeasonKeys)].sort().reverse()[0];
const latestDorsal = latestRegisteredSeason && player.dorsales?.[latestRegisteredSeason]
    ? String(player.dorsales[latestRegisteredSeason])
    : null;

const flagUrl = getFlagSrc(player.iso || player.pais_origin || player.pais_origen);

const formatShortDate = (dateString: string | null | undefined): string => {
    if (!dateString) return "-";
    try {
        const date = new Date(dateString.split("T")[0]);
        if (isNaN(date.getTime())) return "-";
        return date.toLocaleDateString("es-ES", { day: "2-digit", month: "2-digit", year: "numeric" });
    } catch { return "-"; }
};

const calculateAge = (dateString: string | null | undefined): number | null => {
    if (!dateString) return null;
    try {
        const birthDate = new Date(dateString.split("T")[0]);
        if (isNaN(birthDate.getTime())) return null;
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
        return age;
    } catch { return null; }
};

const fechaNacimiento = formatShortDate(player.fecha_nacimiento);
const edad = calculateAge(player.fecha_nacimiento);
const alturaDisplay = player.altura ? `${player.altura} m.` : null;
const debutInfo = await fetchPlayerDebut(player.id_jugadora);
const debutDisplay =
    debutInfo && debutInfo.fecha_debut
        ? `${formatShortDate(debutInfo.fecha_debut)}${debutInfo.rival ? ` vs ${debutInfo.rival}` : ""}`
        : "-";
const trajectory = await fetchPlayerTrajectory(player.id_jugadora);

const allGoals = await fetchAllGoals();
const officialComps = ["Liga F", "UWCL", "Copa de la Reina", "Supercopa de España"];
const clubShields = await fetchAllClubShields();

const milestones = allGoals
    .filter((g) => {
        const isCurrentPlayer = g.goleadora === player.id_jugadora || g.nombre_goleadora === player.nombre;
        return isCurrentPlayer && officialComps.includes(g.competicion);
    })
    .sort((a, b) => {
        const diff = new Date(a.fecha).getTime() - new Date(b.fecha).getTime();
        return diff !== 0 ? diff : parseInt(a.minuto) - parseInt(b.minuto);
    })
    .map((g, index) => ({
        ...g,
        goalNumber: index + 1,
        rival: g.club_local === "Real Madrid" ? g.club_visitante : g.club_local,
    }))
    .filter((g) => g.goalNumber % 10 === 0);

const getPlayerCoordinates = (pos: string) => {
    const p = pos.toLowerCase();
    let left = "50%", top = "50%";
    if (p.includes("portera")) { left = "10%"; }
    else if (p.includes("defensa") || p.includes("central")) { left = "30%"; }
    else if (p.includes("lateral")) {
        left = "30%";
        top = p.includes("izquierd") ? "20%" : p.includes("derech") ? "80%" : "20%";
    } else if (p.includes("centrocampista") || p.includes("pivote") || p.includes("interior") || p.includes("mediapunta")) { left = "55%"; }
    else if (p.includes("delantera") || p.includes("ariete")) { left = "80%"; }
    else if (p.includes("extremo")) {
        left = "80%";
        top = p.includes("izquierd") ? "20%" : p.includes("derech") ? "80%" : "20%";
    }
    return { left, top };
};
const playerPosition = getPlayerCoordinates(player.posicion || "");

const schema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: player.nombre,
    jobTitle: "Jugadora de Fútbol",
    affiliation: { "@type": "SportsTeam", name: "Real Madrid Femenino" },
    image: resolvedImage || player.imageUrl,
    birthDate: player.fecha_nacimiento,
    birthPlace: { "@type": "Place", name: player.lugar_nacimiento },
    height: player.altura ? `${player.altura} m` : undefined,
    weight: player.peso ? `${player.peso} kg` : undefined,
    nationality: player.pais_origin,
};

const quickStats = playerStats ? [
    { value: playerStats.total_carrera_oficial.partidos, label: 'PARTIDOS' },
    { value: playerStats.total_carrera_oficial.titularidades, label: 'TITULAR' },
    ...(!isGoalkeeper ? [
        { value: playerStats.total_carrera_oficial.goles, label: 'GOLES' },
        { value: playerStats.total_carrera_oficial.asistencias, label: 'ASIST.' },
    ] : [
        { value: playerStats.total_carrera_oficial.porterias_cero ?? 0, label: 'P. A CERO' },
    ]),
    { value: playerStats.total_carrera_oficial.victorias, label: 'VICT.' },
] : [];
---

<Layout
    title={`${player.nombre} | Madrid Femenino Xtra`}
    description={`Ficha completa de ${player.nombre}, jugadora del Real Madrid Femenino. Estadísticas, posición, trayectoria y récords.`}
>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <section class="player-hero">
        <div class="hero-bg-glow" aria-hidden="true"></div>

        <a href={`/jugadoras#card-${slug}`} class="hero-back-link">← VOLVER A JUGADORAS</a>

        <div class="hero-inner">
            <div class="hero-photo-col" transition:name={`player-${slug}`}>
                {seasonPhotosData.length > 1 && (
                    <button id="prev-photo" class="hero-nav-btn hero-nav-prev" aria-label="Foto anterior">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                    </button>
                )}
                <img
                    id="main-player-photo"
                    src={currentImageUrl}
                    alt={`Foto de ${player.nombre}`}
                    class="hero-player-photo"
                    loading="eager"
                    decoding="async"
                    width={460}
                    height={640}
                />
                <div id="photo-season-badge" class="hero-season-badge">{currentSeasonName}</div>
                {seasonPhotosData.length > 1 && (
                    <button id="next-photo" class="hero-nav-btn hero-nav-next" aria-label="Foto siguiente">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </button>
                )}
            </div>

            <div class="hero-info-col">
                {latestDorsal && (
                    <span class="hero-ghost-dorsal" aria-hidden="true">{latestDorsal}</span>
                )}

                <div class="hero-chips">
                    <span class="hero-chip hero-chip-gold">♦ {player.posicion} ♦</span>
                    {(player.pais_origin || player.pais_origen) && (
                        <span class="hero-chip">
                            {flagUrl && <img src={flagUrl} alt="" class="chip-flag" width="16" height="16" loading="lazy" />}
                            {player.pais_origin || player.pais_origen}
                        </span>
                    )}
                    {edad && <span class="hero-chip">{edad} años</span>}
                </div>

                <h1 class="hero-player-name" data-dorsal={latestDorsal || undefined}>{player.nombre}</h1>

                {quickStats.length > 0 && (
                    <div class="hero-quick-stats">
                        {quickStats.map(qs => (
                            <div class="qs-card">
                                <span class="qs-number">{qs.value}</span>
                                <span class="qs-label">{qs.label}</span>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </section>

    <main class="player-content">
        <div class="content-grid">

            <section class="profile-card ficha-card full-col">
                <h2 class="card-title">FICHA PERSONAL</h2>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Nombre completo</span>
                        <span class="info-value">{player.nombre}</span>
                    </div>
                    {player.fecha_nacimiento && (
                        <div class="info-row">
                            <span class="info-label">Fecha de nac.</span>
                            <span class="info-value">{fechaNacimiento}</span>
                        </div>
                    )}
                    {player.lugar_nacimiento && (
                        <div class="info-row">
                            <span class="info-label">Lugar de nac.</span>
                            <span class="info-value">{player.lugar_nacimiento}</span>
                        </div>
                    )}
                    {player.pais_origin && (
                        <div class="info-row">
                            <span class="info-label">Nacionalidad</span>
                            <span class="info-value" style="display:flex;align-items:center;gap:0.5rem;">
                                {player.pais_origin}
                                {flagUrl && <img class="flag-icon" src={flagUrl} alt="" width="20" height="20" loading="lazy" />}
                            </span>
                        </div>
                    )}
                    {player.altura && (
                        <div class="info-row">
                            <span class="info-label">Altura</span>
                            <span class="info-value">{player.altura} m.</span>
                        </div>
                    )}
                    {player.peso && (
                        <div class="info-row">
                            <span class="info-label">Peso</span>
                            <span class="info-value">{player.peso} kg</span>
                        </div>
                    )}
                    <div class="info-row">
                        <span class="info-label">Debut</span>
                        <span class="info-value">{debutDisplay}</span>
                    </div>
                    {latestDorsal && (
                        <div class="info-row">
                            <span class="info-label">Dorsal</span>
                            <span class="info-value" style="color:#d4a843;font-family:'Cinzel',serif;font-weight:700;">#{latestDorsal}</span>
                        </div>
                    )}
                </div>
            </section>

            <section class="profile-card position-card">
                <h2 class="card-title">POSICIÓN</h2>
                <div class="card-body" style="padding:1.25rem;">
                    <div class="field-diagram">
                        <svg viewBox="0 0 100 65" class="field-svg">
                            <rect x="0" y="0" width="100" height="65" fill="#2d5a1b"/>
                            <rect x="0" y="0" width="10" height="65" fill="#265016" opacity="0.4"/>
                            <rect x="20" y="0" width="10" height="65" fill="#265016" opacity="0.4"/>
                            <rect x="40" y="0" width="10" height="65" fill="#265016" opacity="0.4"/>
                            <rect x="60" y="0" width="10" height="65" fill="#265016" opacity="0.4"/>
                            <rect x="80" y="0" width="10" height="65" fill="#265016" opacity="0.4"/>
                            <rect x="0" y="0" width="100" height="65" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/>
                            <line x1="50" y1="0" x2="50" y2="65" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/>
                            <circle cx="50" cy="32.5" r="8" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/>
                            <rect x="0" y="20" width="15" height="25" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/>
                            <rect x="0" y="26" width="5" height="13" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/>
                            <rect x="85" y="20" width="15" height="25" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/>
                            <rect x="95" y="26" width="5" height="13" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/>
                        </svg>
                        <div class="player-marker" style={`left: ${playerPosition.left}; top: ${playerPosition.top};`}>
                            <div class="marker-icon"></div>
                        </div>
                    </div>
                    <div style="text-align:center;margin-top:0.75rem;">
                        <span style="font-family:'Cinzel',serif;font-size:0.7rem;letter-spacing:0.15em;color:rgba(212,168,67,0.7);text-transform:uppercase;">{player.posicion}</span>
                    </div>
                </div>
            </section>

            <section class="profile-card trajectory-card">
                <h2 class="card-title">TRAYECTORIA</h2>
                <div class="card-body" style="padding:1.25rem 1.5rem;">
                    {trajectory && trajectory.length > 0 ? (
                        <div class="trajectory-timeline">
                            {trajectory.map((item: any) => (
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-body">
                                        <span class="timeline-years">{item.anio_inicio} – {item.anio_fin || 'Act.'}</span>
                                        <span class="timeline-club">{item.club}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p class="no-data">Sin datos disponibles</p>
                    )}
                </div>
            </section>

            {milestones.length > 0 && (
                <section class="profile-card full-col">
                    <h2 class="card-title">HITOS GOLEADORES</h2>
                    <div class="card-body" style="padding:1.25rem;">
                        <div class="milestones-grid">
                            {milestones.map((g) => {
                                const rivalShield = clubShields[g.rival];
                                return (
                                    <div class={`milestone-card${g.video_url ? ' has-video' : ''}`}
                                        onclick={g.video_url ? `openVideoModal('${g.video_url}','${player.nombre}')` : undefined}>
                                        {g.video_url && (
                                            <div class="video-indicator">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
                                            </div>
                                        )}
                                        <div class="milestone-number">
                                            <span class="m-count">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M12 7l4.76 3.45l-1.76 5.55h-6l-1.76 -5.55l4.76 -3.45"/><path d="M12 7v-4m3 13l2.5 3m-.74 -8.55l3.74 -1.45m-11.44 7.05l-2.56 2.95m.74 -8.55l-3.74 -1.45"/></svg>
                                                {g.goalNumber}
                                            </span>
                                            <span class="m-label">GOL</span>
                                        </div>
                                        <div class="milestone-content">
                                            <div class="m-match-info">
                                                {rivalShield && (
                                                    <div class="m-rival-shield">
                                                        <img src={rivalShield} alt={g.rival} />
                                                    </div>
                                                )}
                                                <div class="m-details">
                                                    <span class="m-rival-name">{g.rival}</span>
                                                    <span class="m-date">{g.fecha ? new Date(g.fecha).toLocaleDateString('es-ES') : ''} · {g.competicion}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </section>
            )}

            {playerStats && (
                <section class="profile-card full-col">
                    <h2 class="card-title">ESTADÍSTICAS OFICIALES</h2>
                    <div class="card-body" style="padding:0;">
                        <div class="stats-table-wrapper">
                            <table class="stats-table">
                                <thead>
                                    <tr>
                                        <th>Temporada</th>
                                        <th title="Convocatorias">Conv.</th>
                                        <th title="Partidos">Part.</th>
                                        <th title="Titularidades">Tit.</th>
                                        <th title="Minutos">Min.</th>
                                        <th title="Cambio Entrada">Ent.</th>
                                        <th title="Cambio Salida">Sal.</th>
                                        <th title="Goles">Goles</th>
                                        <th title="Asistencias">Asist.</th>
                                        <th title="Goles + Asistencias">G+A</th>
                                        <th title="Victorias">Vict.</th>
                                        {playerStats.jugadora.es_portera && <th title="Porterías a cero">P.0</th>}
                                        <th title="Tarjetas Amarillas">TA</th>
                                        <th title="Tarjetas Rojas">TR</th>
                                        <th title="Capitanías">Cap.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {playerStats.estadisticas
                                        .filter((s: any) => s.total.partidos > 0)
                                        .map((season: any) => (
                                            <>
                                                <tr class="season-total-row" onclick={`toggleSeason('${season.temporada.replace(/\//g, "-")}')`} style="cursor:pointer;">
                                                    <td><div class="flex items-center justify-start gap-2 w-full"><strong>{season.temporada}</strong><span class="toggle-icon">▼</span></div></td>
                                                    <td><strong>{season.total.convocatorias}</strong></td>
                                                    <td><strong>{season.total.partidos}</strong></td>
                                                    <td><strong>{season.total.titularidades}</strong></td>
                                                    <td><strong>{season.total.minutos}</strong></td>
                                                    <td><strong>{season.total.cambio_entrada}</strong></td>
                                                    <td><strong>{season.total.cambio_salida}</strong></td>
                                                    <td><strong>{season.total.goles}</strong></td>
                                                    <td><strong>{season.total.asistencias}</strong></td>
                                                    <td><strong>{season.total.goles_asistencias}</strong></td>
                                                    <td><strong>{season.total.victorias}</strong></td>
                                                    {playerStats.jugadora.es_portera && <td><strong>{season.total.porterias_cero}</strong></td>}
                                                    <td><strong>{season.total.tarjetas_amarillas}</strong></td>
                                                    <td><strong>{season.total.tarjetas_rojas}</strong></td>
                                                    <td><strong>{season.total.capitanias}</strong></td>
                                                </tr>
                                                {season.competiciones.map((comp: any) => (
                                                    <tr class={`competition-row season-${season.temporada.replace(/\//g, "-")}`} style="display:none;">
                                                        <td class="competition-name">
                                                            <div class="competition-name-wrapper">
                                                                {getAssetUrl("competiciones", comp.competicion.toLowerCase().includes("amistoso") ? "amistoso" : comp.competicion) && (
                                                                    <img src={getAssetUrl("competiciones", comp.competicion.toLowerCase().includes("amistoso") ? "amistoso" : comp.competicion)} alt={comp.competicion} class="competition-logo" />
                                                                )}
                                                                {comp.competicion}
                                                            </div>
                                                        </td>
                                                        <td>{comp.convocatorias}</td>
                                                        <td>{comp.partidos}</td>
                                                        <td>{comp.titularidades}</td>
                                                        <td>{comp.minutos}</td>
                                                        <td>{comp.cambio_entrada}</td>
                                                        <td>{comp.cambio_salida}</td>
                                                        <td>{comp.goles}</td>
                                                        <td>{comp.asistencias}</td>
                                                        <td>{comp.goles_asistencias}</td>
                                                        <td>{comp.victorias}</td>
                                                        {playerStats.jugadora.es_portera && <td>{comp.porterias_cero}</td>}
                                                        <td>{comp.tarjetas_amarillas}</td>
                                                        <td>{comp.tarjetas_rojas}</td>
                                                        <td>{comp.capitanias}</td>
                                                    </tr>
                                                ))}
                                            </>
                                        ))}
                                    <tr class="career-total-row">
                                        <td style="text-align:left!important;"><strong>TOTAL</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.convocatorias}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.partidos}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.titularidades}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.minutos}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.cambio_entrada}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.cambio_salida}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.goles}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.asistencias}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.goles_asistencias}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.victorias}</strong></td>
                                        {playerStats.jugadora.es_portera && <td><strong>{playerStats.total_carrera_oficial.porterias_cero}</strong></td>}
                                        <td><strong>{playerStats.total_carrera_oficial.tarjetas_amarillas}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.tarjetas_rojas}</strong></td>
                                        <td><strong>{playerStats.total_carrera_oficial.capitanias}</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            )}

        </div>
    </main>

    <div id="video-modal" class="video-modal-overlay">
        <div class="video-modal-container">
            <div class="video-modal-header">
                <h3 id="video-modal-title">Gol</h3>
                <button class="video-close-btn" onclick="closeVideoModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="video-modal-body">
                <video id="goal-video-player" controls class="goal-video-element">
                    <source id="video-source" src="" type="video/mp4" />
                </video>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ seasonPhotos: seasonPhotosData }}>
        let currentIdx = 0;
        const photoEl = document.getElementById("main-player-photo");
        const badgeEl = document.getElementById("photo-season-badge");
        const prevBtn = document.getElementById("prev-photo");
        const nextBtn = document.getElementById("next-photo");
        function updateCarousel() {
            if (!photoEl || !badgeEl || seasonPhotos.length === 0) return;
            const current = seasonPhotos[currentIdx];
            photoEl.src = current.url;
            badgeEl.textContent = current.season;
            if (prevBtn) prevBtn.disabled = currentIdx === seasonPhotos.length - 1;
            if (nextBtn) nextBtn.disabled = currentIdx === 0;
        }
        if (prevBtn) prevBtn.addEventListener("click", () => { if (currentIdx < seasonPhotos.length - 1) { currentIdx++; updateCarousel(); } });
        if (nextBtn) nextBtn.addEventListener("click", () => { if (currentIdx > 0) { currentIdx--; updateCarousel(); } });
        updateCarousel();
    </script>

    <script is:inline>
        function toggleSeason(season) {
            const rows = document.querySelectorAll(`.competition-row.season-${season}`);
            const icon = document.querySelector(`.season-total-row[onclick*="${season}"] .toggle-icon`);
            rows.forEach(row => {
                if (row.style.display === "none") { row.style.display = "table-row"; if (icon) icon.textContent = "▲"; }
                else { row.style.display = "none"; if (icon) icon.textContent = "▼"; }
            });
        }
        function openVideoModal(url, scorer) {
            const modal = document.getElementById("video-modal");
            const video = document.getElementById("goal-video-player");
            const source = document.getElementById("video-source");
            const title = document.getElementById("video-modal-title");
            title.textContent = `Gol de ${scorer}`;
            source.src = url;
            video.load();
            modal.style.display = "flex";
            video.play().catch(() => {});
            modal.onclick = (e) => { if (e.target === modal) closeVideoModal(); };
        }
        function closeVideoModal() {
            const modal = document.getElementById("video-modal");
            const video = document.getElementById("goal-video-player");
            video.pause();
            modal.style.display = "none";
        }
    </script>
</Layout>


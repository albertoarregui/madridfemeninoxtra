---
import FichaTexto from "../../components/FichaTexto.astro";
import { fetchFicha } from "../../utils/fichas";
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";
import {
    fetchPlayersDirectly,
    fetchPlayerStats,
    fetchPlayerDebut,
    fetchPlayerTrajectory,
    fetchPlayerContract,
    fetchPlayerSocials,
    fetchPlayerInjuries,
    fetchPlayerMatchLineups,
} from "../../utils/players";

import { getAssetUrl } from "../../utils/assets";
import { getFlagSrc } from "../../utils/flags";
import { fetchAllGoals, fetchGamesDirectly, slugify as matchSlugify } from "../../utils/partidos";
import { fetchAllClubShields } from "../../utils/rivales";
import { competitionDisplayName } from "../../utils/competiciones";
import { getCurrentSeason } from "../../utils/season";
import { getNewsForPlayer } from "../../utils/noticias";
import { hasSubstantiveHtml } from "../../lib/content-quality";
import PlayerNewsSection from "../../components/PlayerNewsSection.astro";
import GaleriaGrid from "../../components/GaleriaGrid.astro";
import { fetchPlayerPhotos, photoUrl, faceThumbStyle } from "../../utils/galerias";
import "../../styles/player-profile.css";

const { slug } = Astro.params;
if (slug === "elisa-sen") {
    return Astro.redirect("/jugadoras/elisa-senss", 301);
}
const allPlayers = await fetchPlayersDirectly();
const player = allPlayers.find((p) => p.slug === slug);
if (!player) {
    return Astro.redirect("/404");
}

const resolvedImage = getAssetUrl("jugadoras", player.imageUrl);
// En el encabezado, la foto de perfil de cada temporada si existe; si no, la
// foto de temporada.
const profilePhotos: Record<string, string> = player.profile_photos || {};
const seasonPhotos: Record<string, string> = player.season_photos || {};
const seasonPhotosData = [...new Set([...Object.keys(profilePhotos), ...Object.keys(seasonPhotos)])]
    .sort((a, b) => b.localeCompare(a))
    .map((season) => ({ season, url: profilePhotos[season] || seasonPhotos[season] }))
    .filter((photo) => Boolean(photo.url));

const initialSeasonIndex = 0;
const currentImageUrl = (
    seasonPhotosData.length > 0
        ? seasonPhotosData[initialSeasonIndex].url
        : resolvedImage
) as string;
const currentSeasonName =
    seasonPhotosData.length > 0
        ? seasonPhotosData[initialSeasonIndex].season
        : player.temporada || "Actualidad";

// Galería oculta de momento (pendiente de decidir qué hacer con ella). Se
// conserva el código; mientras esté desactivada no se piden sus fotos.
const SHOW_PLAYER_GALLERY = false;
const playerPhotos = SHOW_PLAYER_GALLERY ? await fetchPlayerPhotos(slug!) : [];
const totalGaleria = playerPhotos.length;
const galeriaFotos = playerPhotos.map((p) => ({
    src: photoUrl(p.route, p.f),
    alt: `${player.nombre} — Real Madrid Femenino`,
    pos: faceThumbStyle(p.face),
    caption: [player.nombre, p.competicion, p.temporada].filter(Boolean).join(" · "),
    temporada: p.temporada,
    competicion: p.competicion,
}));
const isGoalkeeper = player.posicion === "Portera";
const playerStats = await fetchPlayerStats(player.id_jugadora, isGoalkeeper);
if (playerStats) {
    playerStats.jugadora = { id: player.id_jugadora, nombre: player.nombre };
}

const allSeasonKeys = allPlayers.flatMap(p => Object.keys(p.dorsales || {}));
const latestRegisteredSeason = [...new Set(allSeasonKeys)].sort().reverse()[0];
const latestDorsal = latestRegisteredSeason && player.dorsales?.[latestRegisteredSeason]
    ? String(player.dorsales[latestRegisteredSeason])
    : null;

const flagUrl = getFlagSrc(player.iso || player.pais_origin || player.pais_origen);

const formatShortDate = (dateString: string | null | undefined): string => {
    if (!dateString) return "-";
    try {
        const date = new Date(dateString.split("T")[0]);
        if (isNaN(date.getTime())) return "-";
        return date.toLocaleDateString("es-ES", { day: "2-digit", month: "2-digit", year: "numeric" });
    } catch { return "-"; }
};

const calculateAge = (dateString: string | null | undefined): number | null => {
    if (!dateString) return null;
    try {
        const birthDate = new Date(dateString.split("T")[0]);
        if (isNaN(birthDate.getTime())) return null;
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
        return age;
    } catch { return null; }
};

const fechaNacimiento = formatShortDate(player.fecha_nacimiento);
const edad = calculateAge(player.fecha_nacimiento);
const alturaDisplay = player.altura ? `${player.altura} m.` : null;
const debutInfo = await fetchPlayerDebut(player.id_jugadora);
const debutDisplay =
    debutInfo && debutInfo.fecha_debut
        ? `${formatShortDate(debutInfo.fecha_debut)}${debutInfo.rival ? ` vs ${debutInfo.rival}` : ""}`
        : "-";
const trajectory = await fetchPlayerTrajectory(player.id_jugadora);
const contract = await fetchPlayerContract(player.id_jugadora);
const socials = await fetchPlayerSocials(player.id_jugadora);
const { injuries, isInjured } = await fetchPlayerInjuries(player.id_jugadora);
const playerNews = await getNewsForPlayer(player.id_jugadora, player.nombre, 6);

const finContratoDisplay = contract?.fecha_fin ? formatShortDate(contract.fecha_fin) : null;

const formatMarketValue = (value: number | null | undefined): string | null => {
    if (value == null || isNaN(value) || value <= 0) return null;
    return `${Math.round(value).toLocaleString("es-ES")} euros`;
};
const valorMercadoDisplay = formatMarketValue(contract?.valor_mercado);

const socialLinks = socials
    ? [
          { url: socials.instagram, label: "Instagram" },
          { url: socials.x, label: "X" },
          { url: socials.tiktok, label: "TikTok" },
      ].filter((s): s is { url: string; label: string } => Boolean(s.url))
    : [];

const allGoals = await fetchAllGoals();

// ── Pestañas de la ficha ──────────────────────────────────────────────────
const OFFICIAL_COMPETITIONS = ["Liga F", "Primera Iberdrola", "UWCL", "Copa de la Reina", "Supercopa de España"];
const isRealMadridClub = (name: unknown) =>
    String(name ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().includes("real madrid");
const shortMonths = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const shortDate = (fecha: unknown) => {
    const [y, m, d] = String(fecha ?? "").slice(0, 10).split("-").map(Number);
    return y && m && d ? `${d} ${shortMonths[m - 1]} ${y}` : "";
};
const competitionLogoFor = (name: unknown) => getAssetUrl("competiciones", String(name ?? ""));

// Info: resumen de la última temporada con partidos oficiales.
const seasonsWithStats = (playerStats?.estadisticas ?? [])
    .filter((s: any) => s.total?.partidos > 0)
    .sort((a: any, b: any) => String(b.temporada).localeCompare(String(a.temporada)));
const latestOfficial = seasonsWithStats.find((s: any) => s.official_total?.partidos > 0);
const infoSummary = latestOfficial ? {
    season: latestOfficial.temporada,
    items: [
        { value: latestOfficial.official_total.partidos, label: "Partidos" },
        { value: latestOfficial.official_total.minutos, label: "Minutos" },
        ...(isGoalkeeper
            ? [{ value: latestOfficial.official_total.porterias_cero ?? 0, label: "Porterías a cero" }]
            : [{ value: latestOfficial.official_total.goles, label: "Goles" }, { value: latestOfficial.official_total.asistencias, label: "Asistencias" }]),
    ],
} : null;

// Rendimiento: datos por temporada y competición (se filtran en el navegador).
const perfSeasons = seasonsWithStats.map((s: any) => ({
    season: s.temporada,
    comps: s.competiciones
        .filter((c: any) => c.partidos > 0)
        .map((c: any) => ({
            name: competitionDisplayName(c.competicion, { temporada: s.temporada }),
            key: c.competicion,
            logo: competitionLogoFor(c.competicion),
            official: OFFICIAL_COMPETITIONS.includes(c.competicion),
            partidos: c.partidos, titularidades: c.titularidades, minutos: c.minutos, goles: c.goles,
            asistencias: c.asistencias, victorias: c.victorias, porterias_cero: c.porterias_cero ?? 0,
            amarillas: c.tarjetas_amarillas, rojas: c.tarjetas_rojas, capitanias: c.capitanias,
        })),
}));

// Partidos: cada partido con minutos, con sus goles y asistencias.
const [allGamesList, playerLineups] = await Promise.all([
    fetchGamesDirectly(),
    fetchPlayerMatchLineups(player.id_jugadora),
]);
const gamesById = new Map(allGamesList.map((g: any) => [Number(g.id_partido), g]));
const playerMatches = playerLineups
    .map((lineup) => {
        const g: any = gamesById.get(lineup.id_partido);
        if (!g || !g.isPlayed) return null;
        const home = isRealMadridClub(g.club_local);
        const goalsInMatch = allGoals.filter((goal: any) => Number(goal.id_partido) === lineup.id_partido);
        return {
            slug: g.slug,
            fecha: String(g.fecha ?? "").slice(0, 10),
            date: shortDate(g.fecha),
            season: String(g.temporada_nombre ?? ""),
            competition: competitionDisplayName(g.competicion_nombre, { temporada: g.temporada_nombre }),
            competitionLogo: g.competicion_foto_url || competitionLogoFor(g.competicion_nombre),
            rival: home ? g.club_visitante : g.club_local,
            rivalShield: home ? g.visitante_shield_url : g.local_shield_url,
            home,
            score: `${g.goles_rm} - ${g.goles_rival}`,
            result: g.resultado === "V" ? "win" : g.resultado === "D" ? "loss" : "draw",
            titular: lineup.titular,
            minutos: lineup.minutos,
            goals: goalsInMatch.filter((goal: any) => Number(goal.goleadora) === Number(player.id_jugadora)).length,
            assists: goalsInMatch.filter((goal: any) => Number(goal.asistente) === Number(player.id_jugadora)).length,
        };
    })
    .filter((m): m is NonNullable<typeof m> => m !== null)
    .sort((a, b) => b.fecha.localeCompare(a.fecha));
const matchSeasons = [...new Set(playerMatches.map((m) => m.season))];
const officialComps = ["Liga F", "Primera Iberdrola", "UWCL", "Copa de la Reina", "Supercopa de España"];
const clubShields = await fetchAllClubShields();

const milestones = allGoals
    .filter((g) => {
        const isCurrentPlayer = g.goleadora === player.id_jugadora || g.nombre_goleadora === player.nombre;
        return isCurrentPlayer && officialComps.includes(g.competicion);
    })
    .sort((a, b) => {
        const diff = new Date(a.fecha).getTime() - new Date(b.fecha).getTime();
        return diff !== 0 ? diff : parseInt(a.minuto) - parseInt(b.minuto);
    })
    .map((g, index) => ({
        ...g,
        goalNumber: index + 1,
        rival: g.club_local === "Real Madrid" ? g.club_visitante : g.club_local,
        matchPath: /^\d{4}-\d{2}-\d{2}$/.test(String(g.fecha || '').slice(0, 10)) && g.club_local && g.club_visitante
            ? `/partidos/${matchSlugify(g.club_local)}-vs-${matchSlugify(g.club_visitante)}-${String(g.fecha).slice(0, 10)}`
            : null,
    }))
    .filter((g) => g.goalNumber % 10 === 0);

const getPlayerCoordinates = (pos: string) => {
    const p = pos.toLowerCase();
    let left = "50%", top = "50%";
    if (p.includes("portera")) { left = "10%"; }
    else if (p.includes("defensa") || p.includes("central")) { left = "30%"; }
    else if (p.includes("lateral")) {
        left = "30%";
        top = p.includes("izquierd") ? "20%" : p.includes("derech") ? "80%" : "20%";
    } else if (p.includes("centrocampista") || p.includes("pivote") || p.includes("interior") || p.includes("mediapunta")) { left = "55%"; }
    else if (p.includes("delantera") || p.includes("ariete")) { left = "80%"; }
    else if (p.includes("extremo")) {
        left = "80%";
        top = p.includes("izquierd") ? "20%" : p.includes("derech") ? "80%" : "20%";
    }
    return { left, top };
};
const playerPosition = getPlayerCoordinates(player.posicion || "");
const currentSquadInfo = player.season_info?.[getCurrentSeason()];
const isCurrentSquad = Boolean(currentSquadInfo && (
    currentSquadInfo.id_categoria === 4 ||
    (Number(currentSquadInfo.dorsal) >= 1 && Number(currentSquadInfo.dorsal) <= 24)
));

const schema = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `https://www.madridfemeninoxtra.com/jugadoras/${slug}#persona`,
    url: `https://www.madridfemeninoxtra.com/jugadoras/${slug}`,
    name: player.nombre,
    jobTitle: "Jugadora de Fútbol",
    ...(isCurrentSquad ? { affiliation: { "@type": "SportsTeam", name: "Real Madrid Femenino" } } : {}),
    ...(resolvedImage || player.imageUrl ? { image: resolvedImage || player.imageUrl } : {}),
    ...(/^\d{4}-\d{2}-\d{2}$/.test(String(player.fecha_nacimiento || '').slice(0, 10))
        ? { birthDate: String(player.fecha_nacimiento).slice(0, 10) } : {}),
    ...(player.lugar_nacimiento ? { birthPlace: { "@type": "Place", name: player.lugar_nacimiento } } : {}),
    height: player.altura ? `${player.altura} m` : undefined,
    weight: player.peso ? `${player.peso} kg` : undefined,
    ...(player.pais_origin ? { nationality: player.pais_origin } : {}),
};

const quickStats = playerStats ? [
    { value: playerStats.total_carrera_oficial.partidos, label: 'PARTIDOS OFICIALES' },
    { value: playerStats.total_carrera_oficial.titularidades, label: 'TITULARIDADES OFICIALES' },
    ...(!isGoalkeeper ? [
        { value: playerStats.total_carrera_oficial.goles, label: 'GOLES OFICIALES' },
        { value: playerStats.total_carrera_oficial.asistencias, label: 'ASISTENCIAS OFICIALES' },
    ] : [
        { value: playerStats.total_carrera_oficial.porterias_cero ?? 0, label: 'PORTERÍAS A CERO OFICIALES' },
    ]),
    { value: playerStats.total_carrera_oficial.victorias, label: 'VICTORIAS OFICIALES' },
] : [];

const posLower = player.posicion ? player.posicion.toLowerCase() : "jugadora";
const nat = player.pais_origin || player.pais_origen || "";
const tco = playerStats?.total_carrera_oficial;
const joinNatural = (arr: string[]) =>
    arr.length <= 1 ? (arr[0] || "") : `${arr.slice(0, -1).join(", ")} y ${arr[arr.length - 1]}`;

const esCanterana = player.tipo === "Club-trained";
const lugarNac = player.lugar_nacimiento || "";

const equiposPrevios = [
    ...new Set(
        (trajectory || [])
            .map((t: any) => t.club)
            .filter((c: string) => c && !/real madrid|tac[oó]n/i.test(c)),
    ),
] as string[];

const bioParts: string[] = [];
let s1 = `${player.nombre} es ${posLower} del Real Madrid Femenino${esCanterana ? " y formada en La Fábrica" : ""}${(lugarNac || nat) ? `, originaria de ${lugarNac || nat}` : ""}${edad ? `, ${edad} años` : ""}.`;
if (latestDorsal) s1 += ` Actualmente viste el dorsal ${latestDorsal} del conjunto blanco.`;
bioParts.push(s1);

const fisico: string[] = [];
if (player.altura) fisico.push(`mide ${player.altura} m`);
if (player.peso) fisico.push(`pesa ${player.peso} kg`);
if (fisico.length) bioParts.push(`Físicamente, ${joinNatural(fisico)}.`);

if (debutInfo && debutInfo.fecha_debut) {
    bioParts.push(`Su estreno con la camiseta madridista llegó el ${formatShortDate(debutInfo.fecha_debut)}${debutInfo.rival ? ` ante ${debutInfo.rival}` : ""}.`);
}

if (equiposPrevios.length) {
    bioParts.push(`A lo largo de su carrera también ha jugado en ${joinNatural(equiposPrevios)}.`);
}

if (tco && tco.partidos) {
    if (isGoalkeeper) {
        bioParts.push(`Con el Real Madrid ha defendido la portería en ${tco.partidos} partidos oficiales${tco.porterias_cero ? `, dejando su puerta a cero en ${tco.porterias_cero} de ellos` : ""}${tco.victorias ? `, con ${tco.victorias} victorias` : ""}${tco.capitanias ? `, y ha ejercido de capitana en ${tco.capitanias} ${tco.capitanias === 1 ? "ocasión" : "ocasiones"}` : ""}.`);
    } else {
        bioParts.push(`Con el Real Madrid acumula ${tco.partidos} partidos oficiales${tco.titularidades ? ` (${tco.titularidades} como titular)` : ""}, en los que ha aportado ${tco.goles} goles y ${tco.asistencias} asistencias${tco.victorias ? `, con ${tco.victorias} victorias` : ""}${tco.capitanias ? `, además de lucir el brazalete de capitana en ${tco.capitanias} ${tco.capitanias === 1 ? "partido" : "partidos"}` : ""}.`);
    }
}
const bio = bioParts.join(" ");
const ficha = await fetchFicha("jugadora", [slug, player.id_jugadora]);
const indexablePlayer = Boolean(
    Number(tco?.partidos ?? 0) > 0 ||
    (trajectory?.length ?? 0) >= 2 ||
    hasSubstantiveHtml(ficha) ||
    hasSubstantiveHtml(bio, 240),
);
(schema as any).description = bio;
if (esCanterana) (schema as any).alumniOf = { "@type": "SportsOrganization", name: "La Fábrica (cantera del Real Madrid)" };

const primerParrafoFicha = ficha
    ?.match(/<p\b[^>]*>([\s\S]*?)<\/p>/i)?.[1]
    ?.replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;|&#160;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&quot;/gi, '"')
    .replace(/&#(?:39|x27);/gi, "'")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&#(\d+);/g, (_, numero: string) => String.fromCodePoint(Number(numero)))
    .replace(/&#x([0-9a-f]+);/gi, (_, numero: string) => String.fromCodePoint(parseInt(numero, 16)))
    .replace(/\s+/g, " ")
    .trim();

const seoTitle = `${player.nombre}${player.posicion ? `, ${player.posicion}` : ""} | Madrid Femenino Xtra`;
const seoDescription = (tco && tco.partidos)
    ? `${player.nombre}, ${posLower} del Real Madrid Femenino${nat ? ` (${nat})` : ""}. ${tco.partidos} partidos${!isGoalkeeper ? `, ${tco.goles} goles y ${tco.asistencias} asistencias` : ""} en su carrera oficial. Ficha, estadísticas y trayectoria.`
    : `Ficha de ${player.nombre}, ${posLower} del Real Madrid Femenino. Estadísticas, posición, trayectoria y récords.`;

---

<Layout title={seoTitle} description={seoDescription} ogTitle={`${player.nombre}${player.posicion ? `, ${player.posicion}` : ''} del Real Madrid Femenino | Madrid Femenino Xtra`} ogDescription={primerParrafoFicha || seoDescription} image={currentImageUrl || resolvedImage || undefined} noindex={!indexablePlayer}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Jugadoras", path: "/jugadoras" }, { name: player.nombre, path: `/jugadoras/${slug}` }]))} />

    <section class="player-hero">
        <div class="hero-bg-glow" aria-hidden="true"></div>

        <a href={`/jugadoras#card-${slug}`} class="hero-back-link">← VOLVER A JUGADORAS</a>

        <div class="hero-inner">
            <div class="hero-photo-col" transition:name={`player-${slug}`}>
                {seasonPhotosData.length > 1 && (
                    <button id="prev-photo" class="hero-nav-btn hero-nav-prev" aria-label="Foto anterior">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                    </button>
                )}
                <img
                    id="main-player-photo"
                    src={currentImageUrl}
                    alt={`Foto de ${player.nombre}`}
                    class="hero-player-photo"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    width={460}
                    height={640}
                />
                <div id="photo-season-badge" class="hero-season-badge">{currentSeasonName}</div>
                {seasonPhotosData.length > 1 && (
                    <button id="next-photo" class="hero-nav-btn hero-nav-next" aria-label="Foto siguiente">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </button>
                )}
            </div>

            <div class="hero-info-col">
                <div class="hero-chips">
                    <span class="hero-chip hero-chip-gold">♦ {player.posicion} ♦</span>
                    {esCanterana && <span class="hero-chip hero-chip-canterana" title="Formada en La Fábrica, la cantera del Real Madrid">★ Canterana</span>}
                    {(player.pais_origin || player.pais_origen) && (
                        <span class="hero-chip">
                            {flagUrl && <img src={flagUrl} alt="" class="chip-flag" width="16" height="16" loading="lazy" />}
                            {player.pais_origin || player.pais_origen}
                        </span>
                    )}
                    {edad && <span class="hero-chip">{edad} años</span>}
                    {isInjured && (
                        <span class="hero-chip hero-chip-injured" title="Lesionada actualmente">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2h8a2 2 0 0 1 2 2v4l2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10l2-2V4a2 2 0 0 1 2-2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
                            Lesionada
                        </span>
                    )}
                </div>

                <div class="hero-player-title">
                    <h1 class="hero-player-name">{player.nombre}</h1>
                    {latestDorsal && (
                        <span
                            class:list={['hero-player-dorsal', String(latestDorsal).length === 1 && 'is-single']}
                            aria-label={`Dorsal ${latestDorsal}`}
                        >
                            {latestDorsal}
                        </span>
                    )}
                </div>

                {quickStats.length > 0 && (
                    <div class="hero-quick-stats" style={`--quick-stat-count: ${quickStats.length}`}>
                        {quickStats.map(qs => (
                            <div class="qs-card mfx-framed"><span class="mfx-frame" aria-hidden="true"></span>
                                <span class="qs-number">{qs.value}</span>
                                <span class="qs-label">{qs.label}</span>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </section>

    <main class="player-content">
        <div class="pt-tabs" role="tablist" aria-label="Secciones de la ficha">
            <button type="button" role="tab" id="tab-info" class="pt-tab is-active" aria-selected="true" aria-controls="panel-info" data-tab="info">Info</button>
            <button type="button" role="tab" id="tab-estadisticas" class="pt-tab" aria-selected="false" aria-controls="panel-estadisticas" data-tab="estadisticas">Estadísticas</button>
            <button type="button" role="tab" id="tab-rendimiento" class="pt-tab" aria-selected="false" aria-controls="panel-rendimiento" data-tab="rendimiento">Rendimiento</button>

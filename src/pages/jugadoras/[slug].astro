                <h3 id="video-modal-title">Gol</h3>
                <button class="video-close-btn" onclick="closeVideoModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="video-modal-body">
                <video id="goal-video-player" controls class="goal-video-element">
                    <source id="video-source" src="" type="video/mp4" />
                </video>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ seasonPhotos: seasonPhotosData }}>
        let currentIdx = 0;
        const photoEl = document.getElementById("main-player-photo");
        const badgeEl = document.getElementById("photo-season-badge");
        const prevBtn = document.getElementById("prev-photo");
        const nextBtn = document.getElementById("next-photo");
        function updateCarousel() {
            if (!photoEl || !badgeEl || seasonPhotos.length === 0) return;
            const current = seasonPhotos[currentIdx];
            photoEl.src = current.url;
            badgeEl.textContent = current.season;
            if (prevBtn) prevBtn.disabled = currentIdx === seasonPhotos.length - 1;
            if (nextBtn) nextBtn.disabled = currentIdx === 0;
        }
        if (prevBtn) prevBtn.addEventListener("click", () => { if (currentIdx < seasonPhotos.length - 1) { currentIdx++; updateCarousel(); } });
        if (nextBtn) nextBtn.addEventListener("click", () => { if (currentIdx > 0) { currentIdx--; updateCarousel(); } });
        updateCarousel();
    </script>

    <script is:inline>
        function toggleSeason(season) {
            const rows = document.querySelectorAll(`.competition-row.season-${season}`);
            const icon = document.querySelector(`.season-total-row[onclick*="${season}"] .toggle-icon`);
            rows.forEach(row => {
                if (row.style.display === "none") { row.style.display = "table-row"; if (icon) icon.textContent = "▲"; }
                else { row.style.display = "none"; if (icon) icon.textContent = "▼"; }
            });
        }
        function openVideoModal(url, scorer) {
            const modal = document.getElementById("video-modal");
            const video = document.getElementById("goal-video-player");
            const source = document.getElementById("video-source");
            const title = document.getElementById("video-modal-title");
            title.textContent = `Gol de ${scorer}`;
            source.src = url;
            video.load();
            modal.style.display = "flex";
            video.play().catch(() => {});
            modal.onclick = (e) => { if (e.target === modal) closeVideoModal(); };
        }
        function closeVideoModal() {
            const modal = document.getElementById("video-modal");
            const video = document.getElementById("goal-video-player");
            video.pause();
            modal.style.display = "none";
        }
    </script>
</Layout>


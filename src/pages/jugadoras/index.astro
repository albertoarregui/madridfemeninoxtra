---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { fetchPlayersDirectly } from "../../utils/players";
import PlayerMapWrapper from "../../components/PlayerMapWrapper";
import PlayersSection from "../../components/PlayersSection.astro";
import { getFlagSrc } from "../../utils/flags";

let playersRaw = await fetchPlayersDirectly();
if (!playersRaw) playersRaw = [];

const playersData = playersRaw.map((player) => {
    const { iso, pais_origin } = player;
    return {
        ...player,
        countryName: pais_origin || iso || "",
        flagUrl: getFlagSrc(pais_origin, iso),
    };
});

const mapPlayers = playersData.map((player) => ({
    nombre: player.nombre,
    lugar_nacimiento: player.lugar_nacimiento,
    pais_origen: player.pais_origen,
    pais_origin: player.pais_origin,
    lat: player.lat,
    lng: player.lng,
    imageUrl: player.imageUrl,
    slug: player.slug,
    posicion: player.posicion,
    fecha_nacimiento: player.fecha_nacimiento,
}));
---

<Layout
    title="Jugadoras del Real Madrid Femenino: todas las de su historia | Madrid Femenino Xtra"
    description="Todas las jugadoras del Real Madrid Femenino a lo largo de su historia: ficha técnica, posiciones, dorsales, estadísticas y trayectoria."
>
    <main class="py-10">
        <div class="max-w-7xl mx-auto px-6 md:px-4">
            <header class="page-header-container">
                <h1 class="landing-title">JUGADORAS</h1>
                <p class="landing-subtitle">Todas las jugadoras del Real Madrid Femenino a lo largo de su historia</p>
            </header>
        </div>

        <div class="max-w-[1500px] mx-auto px-4 md:px-6 mt-6">
            <PlayerMapWrapper players={mapPlayers} client:only="react" />
            <div class="mt-10">
                <PlayersSection players={playersData} />
            </div>
        </div>
    </main>
</Layout>

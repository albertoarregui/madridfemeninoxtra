---
import Layout from "../../layouts/Layout.astro";
import GalleryViewer from "../../components/GalleryViewer";
import { contentfulClient } from "../../lib/contentful";
import "../../styles/global.css";

export const prerender = false;

const { slug } = Astro.params;

let albumData: any = null;
try {
    const entries = await contentfulClient.getEntries({
        content_type: "gallery",
        "fields.slug": slug,
        limit: 1,
    });

    if (entries && entries.items.length > 0) {
        const f = entries.items[0].fields as any;

        const getV = (label: string) => {
            const search = label.toLowerCase().replace(/\s/g, "");
            const key = Object.keys(f).find((k) => k.toLowerCase() === search);
            return key ? f[key] : null;
        };

        const title = getV("title") || getV("titulo") || "Sin Título";
        const subtitle = getV("competition") || getV("competicion") || "";
        const dateRaw = getV("date") || getV("fecha");
        const total = getV("totalphotos") || getV("totalFotos") || 0;
        const folder = getV("route") || getV("rutaDeCarpetas") || "";

        albumData = {
            title: title,
            subtitle: subtitle,
            date: dateRaw
                ? new Date(dateRaw)
                      .toLocaleDateString("es-ES", {
                          day: "2-digit",
                          month: "long",
                          year: "numeric",
                      })
                      .toUpperCase()
                : "SIN FECHA",
            photos: Array.from(
                { length: Number(total) },
                (_, i) =>
                    encodeURI(`https://media.madridfemeninoxtra.com/galerias/${folder}/${folder}${i + 1}.webp`),
            ),
        };
    }
} catch (e) {
    console.error("Error fetching gallery detail:", e);
}

if (!albumData) {
    return Astro.redirect("/404");
}
---

<Layout
    title={`${albumData.title} | Fotogalerías | Madrid Femenino Xtra`}
    description={`Explora las fotos de ${albumData.title} del Real Madrid Femenino.`}
>
    <main class="gal-detail-page">
        <div class="gal-container">
            <a href="/fotogalerias" class="gal-back-link">← VOLVER A FOTOGALERÍAS</a>

            <header class="gal-album-header">
                <div class="gal-accent-bar"></div>
                <div class="gal-header-content">
                    <h1 class="gal-album-title">{albumData.title}</h1>
                    <p class="gal-album-meta">
                        {albumData.subtitle && <span>{albumData.subtitle}</span>}
                        {albumData.subtitle && <span class="gal-sep">·</span>}
                        <span>{albumData.date}</span>
                    </p>
                </div>
            </header>

            <GalleryViewer album={albumData} client:only="react" />
        </div>
    </main>
</Layout>

<style>
    .gal-detail-page {
        min-height: 100vh;
        background: #060d1c;
        color: #f0f0f0;
        padding-top: calc(56px + 2rem);
        padding-bottom: 5rem;
    }
    .gal-container {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }
    .gal-back-link {
        display: inline-block;
        margin-bottom: 2rem;
        font-family: 'Cinzel', serif;
        font-size: 0.58rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(212,168,67,0.55);
        text-decoration: none;
        transition: color 0.2s;
    }
    .gal-back-link:hover { color: #d4a843; }

    .gal-album-header {
        display: flex;
        align-items: stretch;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }
    .gal-accent-bar {
        width: 4px;
        background: #d4a843;
        border-radius: 2px;
        flex-shrink: 0;
    }
    .gal-header-content {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.25rem 0;
    }
    .gal-album-title {
        font-family: 'Cinzel', serif;
        font-size: clamp(1.6rem, 4vw, 3rem);
        font-weight: 700;
        text-transform: uppercase;
        line-height: 1.05;
        letter-spacing: 0.02em;
        background: linear-gradient(180deg, #f5f0e8 20%, #d4a843 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }
    .gal-album-meta {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(212,168,67,0.6);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .gal-sep { color: rgba(212,168,67,0.4); }

    @media (max-width: 640px) {
        .gal-detail-page { padding-top: calc(56px + 1.25rem); }
        .gal-container { padding: 0 1rem; }
    }
</style>

---
import Layout from "../layouts/Layout.astro";
import Form from "../components/Form.astro";
import { getAssetUrl } from "../utils/assets";
import "../styles/global.css";
---

<Layout
    title="Contacto | Madrid Femenino Xtra"
    description="¿Quieres anunciarte o colaborar? Ponte en contacto con el equipo de Madrid Femenino Xtra, el medio de referencia para la afición del Real Madrid Femenino."
>
    <main class="contacto-page">

        <header class="page-header-container">
            <h1 class="landing-title">CONTACTO</h1>
            <p class="landing-subtitle">Canal directo con la redacción de Madrid Femenino Xtra</p>
        </header>

        <div class="contact-grid">
            <div class="contact-sidebar">
                <div class="contact-card">
                    <span class="contact-card-label">♦ Email</span>
                    <a href="mailto:contacto@madridfemeninoxtra.com" class="contact-email">
                        contacto@madridfemeninoxtra.com
                    </a>
                    <p class="contact-card-note">Tiempo de respuesta habitual: 24–48 horas.</p>
                </div>

                <div class="contact-card">
                    <span class="contact-card-label">♦ Redes Sociales</span>
                    <div class="social-links">
                        <a href="https://x.com/MadridFemXtra" target="_blank" rel="noopener noreferrer" class="social-link">
                            <img src={getAssetUrl("redes", "x")} alt="X" width="18" height="18" />
                            <span>Twitter / X</span>
                        </a>
                        <a href="https://www.youtube.com/@MadridFemeninoXtra" target="_blank" rel="noopener noreferrer" class="social-link">
                            <img src={getAssetUrl("redes", "youtube")} alt="YouTube" width="18" height="18" />
                            <span>YouTube</span>
                        </a>
                        <a href="https://www.instagram.com/madridfemeninoxtra/" target="_blank" rel="noopener noreferrer" class="social-link">
                            <img src={getAssetUrl("redes", "instagram")} alt="Instagram" width="18" height="18" />
                            <span>Instagram</span>
                        </a>
                        <a href="https://www.tiktok.com/@madridfemeninoxtra" target="_blank" rel="noopener noreferrer" class="social-link">
                            <img src={getAssetUrl("redes", "tiktok")} alt="TikTok" width="18" height="18" />
                            <span>TikTok</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="contact-form-wrapper">
                <div class="form-card">
                    <span class="contact-card-label">♦ Formulario de Contacto</span>
                    <Form />
                </div>
            </div>
        </div>

        <section class="colabs-section">
            <header class="page-header-container" style="padding-top:3rem;margin-bottom:2.5rem;">
                <h2 class="landing-title" style="font-size:2.2rem;">COLABORACIONES</h2>
                <p class="landing-subtitle">Amplifica tu marca llegando a la mayor comunidad de seguidores del Real Madrid Femenino</p>
            </header>

            <div class="stats-grid">
                <div class="stat-card">
                    <span class="pg-corner pg-corner-tl"></span>
                    <span class="pg-corner pg-corner-tr"></span>
                    <span class="pg-corner pg-corner-bl"></span>
                    <span class="pg-corner pg-corner-br"></span>
                    <div class="stat-platform">
                        <img src={getAssetUrl("redes", "x")} alt="X" width="28" height="28" />
                        <span class="stat-platform-name">Twitter / X</span>
                    </div>
                    <div class="stat-main-number">+7.5K</div>
                    <div class="stat-main-label">Seguidores</div>
                    <div class="stat-divider"></div>
                    <div class="stat-details">
                        <div class="stat-detail">
                            <strong>18.9M</strong>
                            <span>Impresiones</span>
                        </div>
                        <div class="stat-detail">
                            <strong>1.5M</strong>
                            <span>Interacciones</span>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <span class="pg-corner pg-corner-tl"></span>
                    <span class="pg-corner pg-corner-tr"></span>
                    <span class="pg-corner pg-corner-bl"></span>
                    <span class="pg-corner pg-corner-br"></span>
                    <div class="stat-platform">
                        <img src={getAssetUrl("redes", "youtube")} alt="YouTube" width="28" height="28" />
                        <span class="stat-platform-name">YouTube</span>
                    </div>
                    <div class="stat-main-number">+2.8K</div>
                    <div class="stat-main-label">Suscriptores</div>
                    <div class="stat-divider"></div>
                    <div class="stat-details">
                        <div class="stat-detail">
                            <strong>+400K</strong>
                            <span>Visualizaciones</span>
                        </div>
                        <div class="stat-detail">
                            <strong>20.9K</strong>
                            <span>Audiencia mensual</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cta-contact">
                <p>¿Interesado en colaborar? Escríbenos a <a href="mailto:contacto@madridfemeninoxtra.com">contacto@madridfemeninoxtra.com</a> y te respondemos con todas las opciones disponibles.</p>
            </div>
        </section>

    </main>
</Layout>

<style>
.contacto-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2rem;
    margin-bottom: 5rem;
    align-items: start;
}

.contact-card,
.form-card {
    background: rgba(8,16,34,0.85);
    border: 1px solid rgba(212,168,67,0.18);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
    position: relative;
}
.contact-card::before, .form-card::before {
    content: ''; position: absolute; top: 0; left: 0;
    width: 12px; height: 12px;
    border-top: 1px solid rgba(212,168,67,0.45);
    border-left: 1px solid rgba(212,168,67,0.45);
}
.contact-card::after, .form-card::after {
    content: ''; position: absolute; bottom: 0; right: 0;
    width: 12px; height: 12px;
    border-bottom: 1px solid rgba(212,168,67,0.45);
    border-right: 1px solid rgba(212,168,67,0.45);
}

.contact-card-label {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: rgba(212,168,67,0.6);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.9rem;
}

.contact-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }

.contact-email {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: rgba(200,210,220,0.75);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
}
.contact-email:hover { color: #d4a843; }

.contact-card-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    color: rgba(200,210,220,0.35);
    margin: 0;
    line-height: 1.5;
}

.social-links { display: flex; flex-direction: column; gap: 0.55rem; }

.social-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(200,210,220,0.5);
    text-decoration: none;
    padding: 0.45rem 0.6rem;
    border: 1px solid rgba(212,168,67,0.1);
    border-radius: 2px;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.social-link:hover {
    border-color: rgba(212,168,67,0.4);
    color: #d4a843;
    background: rgba(212,168,67,0.04);
}
.social-link img { flex-shrink: 0; filter: brightness(0) invert(1); opacity: 0.6; transition: opacity 0.2s; }
.social-link:hover img { opacity: 1; }

.form-card { padding: 1.75rem 2rem; }

.colabs-section { text-align: center; }

.stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
}

.stat-card {
    background: rgba(8,16,34,0.85);
    border: 1px solid rgba(212,168,67,0.18);
    border-radius: 4px;
    padding: 2rem 1.75rem;
    position: relative;
    overflow: hidden;
    text-align: center;
    transition: border-color 0.2s;
}
.stat-card:hover { border-color: rgba(212,168,67,0.38); }

.pg-corner {
    position: absolute;
    width: 12px; height: 12px;
    transition: width 0.25s ease, height 0.25s ease, border-color 0.25s ease;
}
.pg-corner-tl { top: 0; left: 0; border-top: 2px solid rgba(212,168,67,0.45); border-left: 2px solid rgba(212,168,67,0.45); }
.pg-corner-tr { top: 0; right: 0; border-top: 2px solid rgba(212,168,67,0.45); border-right: 2px solid rgba(212,168,67,0.45); }
.pg-corner-bl { bottom: 0; left: 0; border-bottom: 2px solid rgba(212,168,67,0.45); border-left: 2px solid rgba(212,168,67,0.45); }
.pg-corner-br { bottom: 0; right: 0; border-bottom: 2px solid rgba(212,168,67,0.45); border-right: 2px solid rgba(212,168,67,0.45); }
.stat-card:hover .pg-corner { width: 20px; height: 20px; border-color: #d4a843; }

.stat-platform {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
}
.stat-platform-name {
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(200,210,220,0.6);
}

.stat-main-number {
    font-family: 'Cinzel', serif;
    font-size: 3rem;
    font-weight: 700;
    color: #d4a843;
    line-height: 1;
    margin-bottom: 0.3rem;
}
.stat-main-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: rgba(200,210,220,0.45);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
}
.stat-divider {
    width: 60%;
    height: 1px;
    background: rgba(212,168,67,0.12);
    margin: 0 auto 1.25rem;
}
.stat-details {
    display: flex;
    justify-content: center;
    gap: 2rem;
}
.stat-detail {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}
.stat-detail strong {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    color: #f0f0f0;
    font-weight: 700;
}
.stat-detail span {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    color: rgba(200,210,220,0.4);
    letter-spacing: 0.06em;
}

.cta-contact {
    max-width: 600px;
    margin: 2rem auto 0;
}
.cta-contact p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: rgba(200,210,220,0.55);
    line-height: 1.7;
}
.cta-contact a {
    color: rgba(212,168,67,0.8);
    text-decoration: none;
    border-bottom: 1px solid rgba(212,168,67,0.3);
    transition: color 0.2s;
}
.cta-contact a:hover { color: #d4a843; }

@media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); max-width: 600px; }
}
@media (max-width: 540px) {
    .contacto-page { padding: 0 1rem 3rem; }
    .stats-grid { grid-template-columns: 1fr; max-width: 380px; }
    .form-card { padding: 1.25rem 1rem; }
    .contact-card, .form-card { padding: 1.25rem 1rem; }
    .colabs-section .landing-title { font-size: clamp(1.3rem, 7vw, 2.2rem) !important; }
    .colabs-section .landing-title::before { font-size: 5.5vw; }
}
</style>

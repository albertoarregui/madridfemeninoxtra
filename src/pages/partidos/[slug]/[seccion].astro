---
// Pestañas pesadas de la ficha de partido (Estadísticas, Análisis y Galería).
// Es un fragmento HTML que la ficha pide al abrir la pestaña; se guarda en el
// almacén ISR con las mismas etiquetas que la ficha.
import MatchTeamStats from "../../../components/match/MatchTeamStats.astro";
import MatchAnalysis from "../../../components/analisis/MatchAnalysis.astro";
import GaleriaGrid from "../../../components/GaleriaGrid.astro";
import { fetchMatchDetail, isRealMadridLocal, matchCachePolicy, MISSING_MATCH_TAGS } from "../../../utils/match-detail";
import { fetchMatchAnalysisCached } from "../../../utils/analisis";
import { fetchGalleryForMatch, fetchPlayerNames, photoAlt, photoUrl } from "../../../utils/galerias";
import { matchPlayerHref, matchShieldSrc } from "../../../lib/match-view";

export const partial = true;

const SECTIONS = new Set(["estadisticas", "analisis", "galeria"]);
const MATCH_GALERIA_PREVIEW = 21;
// Estilo en línea: el fragmento no trae su propia hoja de estilos.
const EMPTY_STYLE = "margin:0;padding:2.5rem 1rem;text-align:center;font:500 0.9rem/1.4 'DM Sans',sans-serif;color:rgba(var(--l-ink, 200, 210, 220), 0.6);";
const { slug = "", seccion = "" } = Astro.params;

const notFound = () => new Response(null, {
    status: 404,
    headers: { "Vercel-Cache-Tag": MISSING_MATCH_TAGS.join(","), "X-Robots-Tag": "noindex" },
});

if (!SECTIONS.has(seccion)) return notFound();
const detail = await fetchMatchDetail(slug);
if (!detail) return notFound();

const { game } = detail;
const policy = matchCachePolicy(game);
Astro.response.headers.set("Vercel-Cache-Tag", policy.tags.join(","));
Astro.response.headers.set("X-Robots-Tag", "noindex");

const isLocalRM = isRealMadridLocal(game);
const localShield = matchShieldSrc(game.club_local, game.local_foto_url);
const visitorShield = matchShieldSrc(game.club_visitante, game.visitante_foto_url);
const rivalName = isLocalRM ? game.club_visitante : game.club_local;

// Estadísticas por partes y análisis comparten una sola lectura en caché.
const needsAnalysis = seccion === "analisis" || (seccion === "estadisticas" && detail.analysis.periodos > 0);
const analysis = needsAnalysis ? await fetchMatchAnalysisCached(game.id_partido, policy.tags, policy.ttlMs) : null;
const hasAnalysis = Boolean(analysis && (analysis.tiros.length || analysis.posiciones.length || analysis.dominio.length));

const gallery = seccion === "galeria" ? await fetchGalleryForMatch(Number(game.id_partido)) : null;
const galleryNames = gallery ? await fetchPlayerNames() : {};
const galleryCaption = `${game.club_local} vs ${game.club_visitante}`;
const galleryPhotos = (gallery?.photos ?? []).slice(0, MATCH_GALERIA_PREVIEW).map((p) => ({
    src: photoUrl(gallery!.route, p.f),
    alt: photoAlt(p.p, galleryNames, galleryCaption),
    caption: galleryCaption,
}));
---

{seccion === "estadisticas" && (
    <MatchTeamStats game={game} isLocalRM={isLocalRM} localShield={localShield} visitorShield={visitorShield} periodos={analysis?.periodos} />
)}
{seccion === "analisis" && (hasAnalysis && analysis
    ? <MatchAnalysis data={analysis} rivalName={rivalName} playerHref={(nombre) => matchPlayerHref(nombre)} />
    : <p style={EMPTY_STYLE}>Este partido no tiene datos de análisis.</p>)}
{seccion === "galeria" && (galleryPhotos.length > 0
    ? (
        <GaleriaGrid
            fotos={galleryPhotos}
            subtitulo={`${gallery?.count ?? galleryPhotos.length} fotos de este partido`}
            verTodasLabel="VER GALERÍA COMPLETA"
            minCol="170px"
        />
    )
    : <p style={EMPTY_STYLE}>Este partido no tiene galería.</p>)}


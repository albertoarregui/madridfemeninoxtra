---
import Layout from "../../layouts/Layout.astro";
import {
    fetchGamesDirectly,
    fetchMatchLineups,
    fetchMatchSubstitutions,
    fetchStadiumStats,
    fetchRefereeStats,
    fetchMatchEvents,
    fetchMatchKit,
    slugify,
} from "../../utils/partidos";
import { fetchCalendarFromDb } from "../../utils/calendar";
import { getPlayerImage } from "../../utils/player-images";
import { getAssetUrl } from "../../utils/assets";
import { getMatchStatus } from "../../utils/date-helper";
import { competitionDisplayName } from "../../utils/competiciones";
import { breadcrumbSchema } from "../../utils/seo";
import { fetchCronicaPartido } from "../../utils/fichas";
import PlayerStatsModal from "../../components/PlayerStatsModal.astro";
import GaleriaGrid from "../../components/GaleriaGrid.astro";
import { fetchGalleryForMatch, photoUrl, fetchPlayerNames, photoAlt } from "../../utils/galerias";
import { isFreshMatchSlug } from "../../lib/match-freshness";
import { hasMatchMetrics, isIndexableMatchDetail } from "../../lib/content-quality";
import MatchTabs from "../../components/match/MatchTabs.astro";
import MatchPitch from "../../components/match/MatchPitch.astro";
import MatchTimelineH from "../../components/match/MatchTimelineH.astro";
import MatchTeamStats from "../../components/match/MatchTeamStats.astro";
import MatchRatings from "../../components/match/MatchRatings.astro";
import { fetchCoachesDirectly, getCoachImageUrl } from "../../utils/entrenadores";
import { getFlagSrc } from "../../utils/flags";
import { ratingSummary } from "../../lib/ratings";
import { cached } from "../../utils/cache";

const { slug } = Astro.params;
const matchSlug = slug ?? "";
const freshMatchData = isFreshMatchSlug(matchSlug);
const matchReadOptions = { fresh: freshMatchData };

const [allGames, calendarMatches] = await Promise.all([
    fetchGamesDirectly(matchReadOptions),
    fetchCalendarFromDb(),
]);
let game = allGames.find((g) => g.slug === slug);

if (!game) {
    const calendarMatch = calendarMatches.find((m) => {
        const dateSlug = m.date.split(" ")[0];
        const mSlug = `${slugify(m.club_local)}-vs-${slugify(m.club_visitante)}-${dateSlug}`;
        return mSlug === slug;
    });

    if (calendarMatch) {
        game = {
            id_partido: calendarMatch.id,
            club_local: calendarMatch.club_local,
            club_visitante: calendarMatch.club_visitante,
            local_foto_url: calendarMatch.local_foto_url,
            visitante_foto_url: calendarMatch.visitante_foto_url,
            estadio: calendarMatch.estadio,
            competicion_nombre: calendarMatch.competicion,
            competicion_foto_url: calendarMatch.competicion_foto_url,
            fecha: calendarMatch.fecha,
            hora: calendarMatch.hora,
            jornada: calendarMatch.jornada,
            slug: slug,
            isPlayed: calendarMatch.goles_rm !== null && calendarMatch.goles_rival !== null,
            goles_rm: calendarMatch.goles_rm,
            goles_rival: calendarMatch.goles_rival,
            asistencia: null,
            mvp: null,
            estadio_foto_url: calendarMatch.estadio_foto_url,
            ciudad: calendarMatch.ciudad,
            pais: calendarMatch.pais,
            capacidad: calendarMatch.capacidad,
            id_arbitra: calendarMatch.id_arbitra,
            arbitra_nombre: calendarMatch.arbitra_nombre,
        };
    }
}

if (!game) {
    return Astro.redirect("/404");
}

const formatDate = (dateString: string | null | undefined): string => {
    if (!dateString) return "-";
    try {
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return "-";
        return date.toLocaleDateString("es-ES", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
        });
    } catch {
        return "-";
    }
};

const formatStatRatio = (completados: number | string | null | undefined, totales: number | string | null | undefined): string => {
    const comp = Number(completados) || 0;
    const tot = Number(totales) || 0;
    if (tot === 0) return `${comp}/${tot}`;
    const pct = Math.round((comp / tot) * 100);
    return `${comp}/${tot} (${pct}%)`;
};

const formatTime = (timeString: string | null | undefined): string => {
    if (!timeString) return "-";
    return timeString.substring(0, 5);
};

const playerRating = (player: any): number | null => {
    const rawRating = player?.stats?.valoracion;
    const rating = typeof rawRating === "string"
        ? Number(rawRating.replace(",", "."))
        : Number(rawRating);
    return Number.isFinite(rating) && rating > 0 ? rating : null;
};

const playerRatingClass = (player: any): string => {
    const rating = playerRating(player);
    if (rating === null) return "";
    if (rating >= 10) return "perfect";
    if (rating >= 9) return "excellent";
    if (rating >= 7) return "good";
    if (rating >= 5) return "average";
    return "poor";
};

const matchStatus = getMatchStatus(game.fecha, game.hora);
const isLiveOrPlayed = game.isPlayed || matchStatus.status === 'in-progress';

// Alineación, cambios, eventos y equipación se leen también antes del inicio:
// si se cargan en Turso una hora antes (p. ej. el once), aparecen en la ficha
// sin esperar al pitido inicial. Fuera de la ventana de partido van cacheadas.
const [lineup, subs, stadiumStats, matchKit] = await Promise.all([
    fetchMatchLineups(game.id_partido, matchReadOptions),
    fetchMatchSubstitutions(game.id_partido, matchReadOptions),
    fetchStadiumStats(game.estadio, matchReadOptions),
    fetchMatchKit(game.id_partido, matchReadOptions),
]);
const timelineEvents = await fetchMatchEvents(game.id_partido, game.goles_rm, matchReadOptions, subs);

const MATCH_GALERIA_PREVIEW = 21;
const matchGallery = await fetchGalleryForMatch(game.id_partido);
const galeriaRoute = matchGallery?.route ?? "";
const totalGaleria = matchGallery?.count ?? 0;
const galeriaNames = matchGallery ? await fetchPlayerNames() : {};
const galeriaFotos = (matchGallery?.photos ?? [])
    .slice(0, MATCH_GALERIA_PREVIEW)
    .map((p) => ({
        src: photoUrl(galeriaRoute, p.f),
        alt: photoAlt(p.p, galeriaNames, `${game.club_local} vs ${game.club_visitante}`),
        caption: `${game.club_local} vs ${game.club_visitante}`,
    }));

let mvpPlayer;

const slugifyForImages = (text: string | null | undefined): string => {
    if (!text) return "";
    return text
        .toLowerCase()
        .trim()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[-\s]+/g, "_");
};

mvpPlayer = game.mvp ? {
    name: game.mvp_nombre || `MVP #${game.mvp}`,
    image: game.mvp_nombre
        ? getPlayerImage(slugifyForImages(game.mvp_nombre))
        : null,
    id: String(game.mvp),
} : null;

const stadiumUrl = game.estadio_foto_url;
const hasExternalStadium =
    stadiumUrl &&
    typeof stadiumUrl === "string" &&
    (stadiumUrl.startsWith("http://") || stadiumUrl.startsWith("https://"));
const stadiumImageSrc = hasExternalStadium
    ? stadiumUrl
    : getAssetUrl("estadios", game.estadio);

const getShieldSrc = (
    teamName: string | null | undefined,
    remoteUrl?: string | null | undefined,
) => {
    if (
        remoteUrl &&
        typeof remoteUrl === "string" &&
        (remoteUrl.startsWith("http://") || remoteUrl.startsWith("https://"))
    ) {
        return remoteUrl;
    }
    return getAssetUrl("escudos", teamName || "placeholder");
};

const localShield = getShieldSrc(game.club_local, game.local_foto_url);
const visitorShield = getShieldSrc(
    game.club_visitante,
    game.visitante_foto_url,
);

const isLocalRM =
    game.club_local?.toLowerCase().includes("real madrid") ?? false;

const arbitraSlug = game.arbitra_nombre ? slugify(game.arbitra_nombre) : "";
const estadioSlug = game.estadio ? slugify(game.estadio) : "";

// Historial contra el rival: sale de los partidos ya cargados, sin otra lectura.
const normalizeClub = (name: unknown) =>
    String(name ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
const h2hRival = normalizeClub(isLocalRM ? game.club_visitante : game.club_local);
// En partidos ya jugados cuenta solo los enfrentamientos anteriores a este.
const h2hMatches = allGames
    .filter((g) => g.isPlayed && g.slug !== game.slug
        && String(g.fecha ?? "") < String(game.fecha ?? "")
        && [g.club_local, g.club_visitante].map(normalizeClub).includes(h2hRival))
    .sort((a, b) => String(b.fecha ?? "").localeCompare(String(a.fecha ?? "")));
const h2hStats = h2hMatches.length === 0 ? null : h2hMatches.reduce((acc, g) => {
    acc.rmGoals += Number(g.goles_rm) || 0;
    acc.rivalGoals += Number(g.goles_rival) || 0;
    if (g.resultado === "V") acc.wins++;
    else if (g.resultado === "D") acc.losses++;
    else acc.draws++;
    return acc;
}, { totalMatches: h2hMatches.length, wins: 0, draws: 0, losses: 0, rmGoals: 0, rivalGoals: 0 });
const H2H_LIMIT = 10;
const h2hMonths = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const h2hDate = (fecha: unknown) => {
    const [year, month, day] = String(fecha ?? "").slice(0, 10).split("-").map(Number);
    return year && month && day ? `${day} ${h2hMonths[month - 1]} ${year}` : "";
};
const rmShieldSrc = isLocalRM ? localShield : visitorShield;
const rivalShieldSrc = isLocalRM ? visitorShield : localShield;

const localScore = isLocalRM ? (game.goles_rm ?? 0) : (game.goles_rival ?? 0);
const visitorScore = isLocalRM ? (game.goles_rival ?? 0) : (game.goles_rm ?? 0);
const rmGoals = game.goles_rm ?? 0;
const rivalGoals = game.goles_rival ?? 0;
const rivalName = isLocalRM ? game.club_visitante : game.club_local;
const rivalHref = `/rivales/${slugify(rivalName)}`;
const playerHref = (player: { name?: string; slug?: string } | string | null | undefined) => {
    const name = typeof player === "string" ? player : player?.name;
    const playerSlug = typeof player === "string" ? slugify(player) : (player?.slug || slugify(name || ""));
    return playerSlug && playerSlug !== "#" ? `/jugadoras/${playerSlug}` : null;
};

const fechaLarga = game.fecha
    ? (() => { try { return new Date(game.fecha).toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" }); } catch { return ""; } })()
    : "";
const fechaCorta = formatDate(game.fecha);

const venueText = game.estadio ? ` en el ${game.estadio}${game.ciudad ? ` (${game.ciudad})` : ""}` : "";

const jornadaLabel = (() => {
    const j = game.jornada;
    if (!j) return "";
    const lower = String(j).toLowerCase();
    if (lower.includes("amistoso")) return "";
    if (!isNaN(Number(j))) return `la jornada ${j}`;
    return String(j);
})();
const competicionDisplay = competitionDisplayName(game.competicion_nombre, { idTemporada: game.id_temporada });
const compLabel = competicionDisplay
    ? `${jornadaLabel ? `${jornadaLabel} de ` : ""}${competicionDisplay}`
    : "";

const rmScorers = (timelineEvents || [])
    .filter((e: any) => e.type === "goal" && e.team === "local" && e.scorer && !e.isOwnGoal)
    .map((e: any) => `${e.scorer}${e.displayMinute && e.displayMinute !== "P" ? ` (${e.displayMinute}')` : ""}`);

const margin = rmGoals - rivalGoals;
const homeAway = isLocalRM ? "como local" : "a domicilio";
const resultVerb = margin >= 3 ? "goleó a"
    : margin > 0 ? "se impuso a"
    : margin === 0 ? "firmó tablas ante"
    : margin >= -2 ? "cayó ante"
    : "cayó con claridad ante";
const joinNatural = (arr: string[]) =>
    arr.length <= 1 ? (arr[0] || "") : `${arr.slice(0, -1).join(", ")} y ${arr[arr.length - 1]}`;

const lineupNames = (lineup || []).map((p: any) => p.name).filter(Boolean);

const cambios = (subs || [])
    .filter((s: any) => s.playerIn?.name || s.playerOut?.name)
    .map((s: any) => `${s.playerIn?.name || "?"} por ${s.playerOut?.name || "?"}${s.minute ? ` (min. ${s.minute})` : ""}`);

const kitMap: Record<string, string> = { local: "primera equipación", visitante: "segunda equipación", tercera: "tercera equipación", portera: "equipación de portera" };
const kitText = matchKit?.tipo
    ? (kitMap[matchKit.tipo.toLowerCase()] || `equipación ${matchKit.tipo.toLowerCase()}`)
    : "";

const numOrNull = (v: any) => (v == null || v === "" || Number.isNaN(Number(v)) || Number(v) === 0 ? null : Number(v));
const posRm = numOrNull(game.posesion_rm);
const tirosRm = numOrNull(game.rm_tiros);
const tirosPuertaRm = numOrNull(game.rm_tiros_puerta);
const statsBits: string[] = [];
if (posRm != null) statsBits.push(`un ${posRm}% de posesión`);
if (tirosRm != null) statsBits.push(`${tirosRm} tiros${tirosPuertaRm != null ? ` (${tirosPuertaRm} a puerta)` : ""}`);

let cronica = "";
if (isLiveOrPlayed) {
    cronica = `El ${fechaLarga}, el Real Madrid Femenino ${resultVerb} ${rivalName} por ${rmGoals}-${rivalGoals}${compLabel ? ` en ${compLabel}` : ""}.`;
    cronica += ` El encuentro${game.hora ? `, con inicio a las ${formatTime(game.hora)},` : ""} se disputó ${homeAway}${venueText}`;
    cronica += game.arbitra_nombre ? ` y estuvo dirigido por la colegiada ${game.arbitra_nombre}` : "";
    cronica += game.asistencia ? `, con ${Number(game.asistencia).toLocaleString("es-ES")} espectadores en las gradas.` : `.`;
    if (lineupNames.length) cronica += ` El once inicial del Real Madrid lo formaron ${joinNatural(lineupNames)}.`;
    if (rmScorers.length) {
        cronica += rmScorers.length === 1
            ? ` El gol blanco lo firmó ${rmScorers[0]}.`
            : ` Las goleadoras del Real Madrid fueron ${joinNatural(rmScorers)}.`;
    }
    if (rmGoals > 0 && rivalGoals === 0) cronica += ` El equipo dejó su portería a cero.`;
    if (cambios.length) cronica += ` En el banquillo hubo movimiento: entraron ${joinNatural(cambios)}.`;
    if (statsBits.length) cronica += ` En el plano estadístico, el conjunto blanco firmó ${joinNatural(statsBits)}.`;
    if (kitText) cronica += ` Para la ocasión, el equipo vistió su ${kitText}.`;
    if (game.mvp && game.mvp_nombre) cronica += ` ${game.mvp_nombre} se llevó el premio a la MVP del partido.`;
}

const matchKeys = [game.id_partido, slug];
const fichaCronica = await fetchCronicaPartido(matchKeys, game.isPlayed ? 'CRÓNICA' : 'PREVIA')
    ?? await fetchCronicaPartido(matchKeys);
// En la ficha de partido la crónica va sin fotos.
const sinFotos = (html: string) => html
    .replace(/<figure\b[\s\S]*?<\/figure>/gi, "")
    .replace(/<picture\b[\s\S]*?<\/picture>/gi, "")
    .replace(/<img\b[^>]*>/gi, "")
    .replace(/<p>\s*<\/p>/gi, "");
const cronicaVisible = sinFotos(fichaCronica?.visible ?? "");
const cronicaResto = sinFotos(fichaCronica?.resto ?? "");
const matchArticleCategory = fichaCronica?.articleCategory?.toUpperCase();
const matchArticleLabel = matchArticleCategory === 'CRÓNICA'
    ? 'Leer la crónica completa'
    : matchArticleCategory === 'PREVIA' ? 'Leer la previa completa' : 'Leer el artículo completo';
const tieneCronica = Boolean(cronicaVisible);
const hasMatchMetricsData = hasMatchMetrics(game);
const indexableMatch = isIndexableMatchDetail(game, {
    hasEditorial: tieneCronica,
    lineupCount: lineup.length,
    eventCount: timelineEvents.length,
    galleryCount: totalGaleria,
});
const cronicaHeading = tieneCronica
    ? matchArticleCategory === 'CRÓNICA' ? "CRÓNICA" : "CONTEXTO DEL PARTIDO"
    : "RESUMEN DEL PARTIDO";

const seoTitle = isLiveOrPlayed
    ? `${game.club_local} ${localScore}-${visitorScore} ${game.club_visitante}${compLabel ? ` · ${compLabel}` : ""} | Madrid Femenino Xtra`
    : `${game.club_local} vs ${game.club_visitante}${compLabel ? ` · ${compLabel}` : ""} | Madrid Femenino Xtra`;
const seoDescription = isLiveOrPlayed
    ? `${game.club_local} ${localScore}-${visitorScore} ${game.club_visitante} (${fechaCorta}). Resultado, goleadoras, alineaciones y estadísticas completas${compLabel ? ` de ${compLabel}` : ""}.`
    : `${game.club_local} vs ${game.club_visitante} (${fechaCorta}). Previa, horario, alineaciones y estadísticas del partido${compLabel ? ` de ${compLabel}` : ""}.`;

const matchDay = String(game.fecha || '').slice(0, 10);
const confirmedKickoff = String(game.hora || '').match(/^(\d{2}:\d{2})/);
const madridOffset = matchDay && confirmedKickoff
    ? new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Madrid', timeZoneName: 'longOffset' })
        .formatToParts(new Date(`${matchDay}T12:00:00Z`))
        .find((part) => part.type === 'timeZoneName')?.value.replace('GMT', '')
    : null;
const matchStartISO = /^\d{4}-\d{2}-\d{2}$/.test(matchDay) && confirmedKickoff && madridOffset
    ? `${matchDay}T${confirmedKickoff[1]}:00${madridOffset}`
    : null;
const matchSchema = matchStartISO ? {
    "@context": "https://schema.org",
    "@type": "SportsEvent",
    name: `${game.club_local} vs ${game.club_visitante}`,
    sport: "Football",
    startDate: matchStartISO,
    url: `https://www.madridfemeninoxtra.com/partidos/${slug}`,
    ...(!game.isPlayed ? { eventStatus: "https://schema.org/EventScheduled" } : {}),
    ...(game.estadio
        ? { location: { "@type": "Place", name: game.estadio, ...(game.ciudad || game.pais ? { address: [game.ciudad, game.pais].filter(Boolean).join(", ") } : {}) } }
        : {}),
    homeTeam: { "@type": "SportsTeam", name: game.club_local },
    awayTeam: { "@type": "SportsTeam", name: game.club_visitante },
} : null;


// ── Pestañas (Partido / Valoraciones) ────────────────────────────────────
// Se activan en cuanto hay alineación o el partido se ha jugado.
const tabbed = lineup.length > 0 || Boolean(game.isPlayed);
const availableTabs = ["info", "timeline", "alineacion", "estadisticas", ...(h2hStats ? ["h2h"] : [])];
const requestedTab = Astro.url.searchParams.get("seccion") ?? "info";
const activeTab = [...availableTabs, "valoraciones"].includes(requestedTab) ? requestedTab : "info";

const coachRows = tabbed && game.entrenador_nombre
    ? await cached("coaches:directory-v1", 24 * 60 * 60 * 1000, () => fetchCoachesDirectly()).catch(() => [])
    : [];
const coachRow: any = coachRows.find((c: any) => c.nombre === game.entrenador_nombre);
const matchCoach = game.entrenador_nombre ? {
    name: game.entrenador_nombre,
    image: coachRow ? getCoachImageUrl(coachRow) : undefined,
    flag: coachRow?.iso ? getFlagSrc(coachRow.iso) : undefined,
    country: coachRow?.pais ?? undefined,
    href: `/entrenadores/${slugify(game.entrenador_nombre)}`,
} : null;

const fanRatings = tabbed
    ? await cached(`ratings:summary:${game.id_partido}`, 10 * 60 * 1000, () => ratingSummary(Number(game.id_partido)), { remote: false }).catch(() => [])
    : [];
const ratingSlug = `${game.club_local}-vs-${game.club_visitante}`.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const ratingsUrl = `/valoraciones/${game.id_partido}-${ratingSlug}-${String(game.fecha ?? "").slice(0, 10)}`;
---

<Layout title={seoTitle} description={seoDescription} ogTitle={isLiveOrPlayed ? `${game.club_local} ${localScore}-${visitorScore} ${game.club_visitante} | ${compLabel || 'Partido'} | Madrid Femenino Xtra` : `${game.club_local} vs ${game.club_visitante} | ${compLabel || 'Partido'} | Madrid Femenino Xtra`} ogDescription={isLiveOrPlayed ? `Resultado y ficha completa del ${game.club_local} contra ${game.club_visitante} (${fechaCorta}): goles, asistencias, alineaciones, estadísticas avanzadas y protagonistas del encuentro.` : `Previa del ${game.club_local} contra ${game.club_visitante} del ${fechaCorta} en ${compLabel || 'competición oficial'}: horario, estadio, información del partido y alineaciones cuando estén disponibles.`} noindex={!indexableMatch}>
    {matchSchema && <script type="application/ld+json" set:html={JSON.stringify(matchSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Partidos", path: "/partidos" }, { name: `${game.club_local} vs ${game.club_visitante}`, path: `/partidos/${slug}` }]))} />
    <main class="match-details-page">
        <a href="/partidos" class="back-link">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Volver al resto de partidos
        </a>
        <div class:list={["match-header-grid", { "is-single": tabbed }]}>
            <section class="match-card-new mfx-framed"><span class="mfx-frame" aria-hidden="true"></span>
                <h1 class="section-header">
                    <span aria-hidden="true">FICHA DEL PARTIDO</span>
                    <span class="match-page-title">
                        {isLiveOrPlayed
                            ? `${game.club_local} ${localScore}-${visitorScore} ${game.club_visitante}${compLabel ? ` · ${compLabel}` : ""}`
                            : `${game.club_local} vs ${game.club_visitante}${compLabel ? ` · ${compLabel}` : ""}`}
                    </span>
                </h1>
                <div class="match-content-body">
                    <div class="match-metadata-top">
                        <span class="metadata-text">
                            {competicionDisplay}
                            {
                                (() => {
                                    const jornada = game.jornada;
                                    if (!jornada) return "";
                                    const lower = String(jornada).toLowerCase();
                                    if (lower.includes("amistoso")) return "";
                                    if (!isNaN(Number(jornada)))
                                        return ` (J${jornada})`;
                                    return ` (${jornada})`;
                                })()
                            }
                            <span class="bullet">•</span>
                            {formatDate(game.fecha)} - {formatTime(game.hora)}
                        </span>
                        <div class="match-status-row">
                            <span
                                class={`match-status-badge match-status-${matchStatus.status}`}
                                id="live-status-badge"
                                data-status={matchStatus.status}
                                data-fecha={game.fecha}
                                data-hora={game.hora || "00:00"}
                            >
                                {matchStatus.label.toUpperCase()}
                            </span>
                        </div>
                    </div>
                    <div class="match-main-content">
                        <div class="team-block-large">
                            <div class="shield-container-large">
                                {
                                    localShield && (
                                        <img
                                            src={localShield}
                                            alt={game.club_local}
                                            width="120"
                                            height="120"
                                            class="team-shield-xl"
                                            data-proxy-fallback
                                        />
                                    )
                                }
                            </div>
                            {isLocalRM ? (
                                <span class="team-name-xl">{game.club_local}</span>
                            ) : (
                                <a class="team-name-xl entity-link" href={rivalHref}>{game.club_local}</a>
                            )}
                        </div>
                        <div class="score-block-large">
                            {isLiveOrPlayed ? (
                                <span class="score-xl">

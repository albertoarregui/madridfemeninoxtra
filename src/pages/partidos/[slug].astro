<script>
    document.querySelectorAll<HTMLImageElement>('img[data-proxy-fallback]').forEach((image) => {
        image.addEventListener('error', () => {
            if (image.dataset.proxyRetried === 'true') return;
            image.dataset.proxyRetried = 'true';
            const originalUrl = image.currentSrc || image.src;
            image.src = `/api/img-proxy?url=${encodeURIComponent(originalUrl)}`;
        });
    });

    const block = document.querySelector<HTMLElement>('.countdown-block');
    if (block) {
        const fecha = block.dataset.fecha!;
        const hora  = block.dataset.hora!;
        const target = new Date(`${fecha}T${hora}:00`);

        function pad(n: number) { return String(n).padStart(2, '0'); }

        function tick() {
            const diff = target.getTime() - Date.now();
            if (diff <= 0) {
                document.getElementById('cd-days')!.textContent  = '00';
                document.getElementById('cd-hours')!.textContent = '00';
                document.getElementById('cd-mins')!.textContent  = '00';
                document.getElementById('cd-secs')!.textContent  = '00';
                return;
            }
            const days  = Math.floor(diff / 86400000);
            const hours = Math.floor((diff % 86400000) / 3600000);
            const mins  = Math.floor((diff % 3600000)  / 60000);
            const secs  = Math.floor((diff % 60000)    / 1000);
            document.getElementById('cd-days')!.textContent  = pad(days);
            document.getElementById('cd-hours')!.textContent = pad(hours);
            document.getElementById('cd-mins')!.textContent  = pad(mins);
            document.getElementById('cd-secs')!.textContent  = pad(secs);
        }
        tick();
        setInterval(tick, 1000);
    }

    const badge = document.getElementById('live-status-badge') as HTMLElement | null;
    if (badge && badge.dataset.status === 'in-progress') {
        const fecha = badge.dataset.fecha!;
        const hora  = badge.dataset.hora!;
        const kickoff = new Date(`${fecha}T${hora.length === 5 ? hora + ':00' : hora}`);

        function updateMinute() {
            const elapsed = Math.floor((Date.now() - kickoff.getTime()) / 60000);
            if (elapsed >= 0 && elapsed <= 120) {
                badge!.textContent = `EN VIVO: ${elapsed}'`;
            }
        }
        updateMinute();
        setInterval(updateMinute, 10000);
    }
</script>

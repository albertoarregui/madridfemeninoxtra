---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { fetchGamesDirectly } from "../../utils/partidos";
import { getCurrentSeason } from "../../utils/season";
import { breadcrumbSchema } from "../../utils/seo";
import MatchTimeline from "../../components/MatchTimeline.astro";

const currentSeason = getCurrentSeason();
const games = await fetchGamesDirectly();
---

<Layout
    title="Partidos del Real Madrid Femenino: calendario, resultados e historial | Madrid Femenino Xtra"
    description={`Calendario y resultados del Real Madrid Femenino: próximos partidos de la temporada ${currentSeason}, horarios, marcadores y el historial completo por temporada y competición.`}
    ogTitle="Calendario, próximos partidos y resultados del Real Madrid Femenino | Madrid Femenino Xtra"
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema([
        { name: "Inicio", path: "/" }, { name: "Partidos", path: "/partidos" },
    ]))} />
    <main class="w-full max-w-7xl mx-auto px-6 md:px-0">
        <header class="page-header-container">
            <h1 class="landing-title">PARTIDOS</h1>
            <p class="landing-subtitle">
                Historial de partidos disputados por el Real Madrid Femenino a lo largo de su historia, por temporada y competición · Calendario, horarios y resultados de la temporada {currentSeason} · <a href="/donde-ver-real-madrid-femenino">Dónde verlos</a>
            </p>
        </header>

        {games.length > 0 ? (
            <MatchTimeline matches={games} />
        ) : (
            <p class="matches-error">Error al cargar datos o no se encontraron partidos.</p>
        )}
    </main>
</Layout>

<style>
    .landing-subtitle a { color: #d4a843; text-decoration: underline; }
    .matches-error { text-align: center; color: #ff8a8a; padding: 2rem; }
</style>

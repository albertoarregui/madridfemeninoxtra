---
import { getAssetUrl } from "../utils/assets";
import { competitionDisplayName } from "../utils/competiciones";

interface Props {
	matches: any[];
}

const { matches = [] } = Astro.props;

// Partidos visibles al entrar y en cada «cargar más». Todo el HTML ya viene en
// la página (≈30 KB comprimidos) y las imágenes ocultas no se descargan.
const PAGE_SIZE = 100;

const COMPETITION_ORDER = ["Primera Iberdrola", "Liga F", "UWCL", "Copa de la Reina", "Supercopa de España", "Amistosos"];

const isRealMadrid = (name: unknown) =>
	String(name ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().includes("real madrid");

const competitionRank = (name: string) => {
	const index = COMPETITION_ORDER.indexOf(name);
	return index === -1 ? COMPETITION_ORDER.length : index;
};

const formatTime = (hora: unknown) => {
	const match = String(hora ?? "").match(/^(\d{1,2}):(\d{2})/);
	return match && `${match[1]}:${match[2]}` !== "00:00" ? `${match[1].padStart(2, "0")}:${match[2]}` : null;
};

// Las fechas vienen como YYYY-MM-DD: se formatean sin pasar por la zona horaria.
const formatDate = (fecha: unknown) => {
	const [year, month, day] = String(fecha ?? "").slice(0, 10).split("-");
	return year && month && day ? `${day}.${month}.${year.slice(-2)}` : "-";
};

const rows = matches
	.filter((m) => m?.slug && m?.temporada_nombre)
	.map((m) => {
		const played = Boolean(m.isPlayed);
		const localIsRm = isRealMadrid(m.club_local);
		const time = formatTime(m.hora);
		return {
			slug: m.slug,
			key: `${String(m.fecha ?? "").slice(0, 10)} ${time ?? "99:99"}`,
			season: String(m.temporada_nombre),
			competition: String(m.competicion_nombre ?? ""),
			competitionLabel: competitionDisplayName(m.competicion_nombre, { temporada: m.temporada_nombre }),
			competitionLogo: m.competicion_foto_url || getAssetUrl("competiciones", m.competicion_nombre),
			venue: localIsRm ? "local" : "visitante",
			played,
			result: played && ["V", "E", "D"].includes(m.resultado) ? m.resultado : "",
			date: formatDate(m.fecha),
			time,
			local: { name: m.club_local, shield: m.local_shield_url, goals: localIsRm ? m.goles_rm : m.goles_rival },
			visitor: { name: m.club_visitante, shield: m.visitante_shield_url, goals: localIsRm ? m.goles_rival : m.goles_rm },
		};
	});

// Primero los partidos por jugar (el más cercano arriba) y después los
// resultados, del más reciente al más antiguo.
const upcoming = rows.filter((r) => !r.played).sort((a, b) => a.key.localeCompare(b.key));
const played = rows.filter((r) => r.played).sort((a, b) => b.key.localeCompare(a.key));
const ordered = [...upcoming, ...played];

const seasons = [...new Set(rows.map((r) => r.season))].sort().reverse();
const competitions = [...new Set(rows.map((r) => r.competition).filter(Boolean))]
	.sort((a, b) => competitionRank(a) - competitionRank(b) || a.localeCompare(b));
const venues = [["local", "Local"], ["visitante", "Visitante"]];

const filters = [
	{ id: "temporada", label: "Todas las Temporadas", aria: "Filtrar por temporada", options: seasons.map((s) => [s, s]) },
	{ id: "competicion", label: "Todas las Competiciones", aria: "Filtrar por competición", options: competitions.map((c) => [c, c]) },
	{ id: "sede", label: "Local y Visitante", aria: "Filtrar por sede", options: venues },
];
---

<div class="match-list-ui" data-match-timeline data-page-size={PAGE_SIZE}>
	<div class="filters-container">
		{filters.map((filter) => (
			<div class="custom-select-container" data-custom-select="true">
				<div class="custom-select-trigger">
					<span class="selected-text">{filter.label}</span>
					<div class="custom-select-arrow">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
					</div>
				</div>
				<div class="custom-select-options">
					<div class="custom-select-option selected" data-value="todos">{filter.label}</div>
					{filter.options.map(([value, text]) => <div class="custom-select-option" data-value={value}>{text}</div>)}
				</div>
				<select class="native-select" data-filter={filter.id} aria-label={filter.aria} hidden>
					<option value="todos" selected>{filter.label}</option>
					{filter.options.map(([value, text]) => <option value={value}>{text}</option>)}
				</select>
			</div>
		))}
	</div>

	<div class="matches-container">
		{ordered.map((row, index) => (
			<div class="match-item" data-season={row.season} data-competition={row.competition} data-venue={row.venue} hidden={index >= PAGE_SIZE}>
				<div class="match-competition">
					<div class="competition-info">
						{row.competitionLogo && <img src={row.competitionLogo} alt={row.competition} class="competition-logo" width="24" height="24" loading="lazy" decoding="async" />}
						<span class="competition-name">{row.competitionLabel}</span>
					</div>
					{row.played
						? <div class={`result-indicator ${row.result === "V" ? "win" : row.result === "D" ? "loss" : "draw"}`}>{row.result || "E"}</div>
						: <span class="upcoming-label">Próximo</span>}
				</div>

				<a href={`/partidos/${row.slug}`} class="match-detail">
					<div class="match-date-time">{row.date}{row.time ? ` ${row.time}` : ""}</div>
					<div class="match-teams-score">
						<div class="team team-local">
							<span class="team-name">{row.local.name}</span>
							<img src={row.local.shield} alt={row.local.name} class="team-shield" width="28" height="28" loading="lazy" decoding="async" />
						</div>
						<div class="score-wrapper">
							{row.played ? (
								<>
									<span class="score">{row.local.goals}</span>
									<span class="vs">-</span>
									<span class="score">{row.visitor.goals}</span>
								</>
							) : (
								<span class="vs upcoming-vs">VS</span>
							)}
						</div>
						<div class="team team-visitor">
							<img src={row.visitor.shield} alt={row.visitor.name} class="team-shield" width="28" height="28" loading="lazy" decoding="async" />
							<span class="team-name">{row.visitor.name}</span>
						</div>
					</div>
				</a>
			</div>
		))}
		<p class="no-results-message" data-empty hidden>No se encontraron partidos con los filtros seleccionados.</p>
	</div>

	<div class="matches-footer" data-more-wrap hidden={ordered.length <= PAGE_SIZE}>
		<button type="button" class="btn-more" data-more>
			Cargar 100 partidos más (<span data-remaining>{Math.max(0, ordered.length - PAGE_SIZE)}</span> restantes)
		</button>
	</div>
</div>

<script is:inline data-astro-rerun>
	(() => {
		document.querySelectorAll("[data-match-timeline]").forEach((root) => {
			if (root.dataset.ready === "true") return;
			root.dataset.ready = "true";
			const pageSize = Number(root.dataset.pageSize) || 100;
			const items = [...root.querySelectorAll(".match-item")];
			const selects = Object.fromEntries([...root.querySelectorAll("select[data-filter]")].map((s) => [s.dataset.filter, s]));
			const attribute = { temporada: "season", competicion: "competition", sede: "venue" };
			let limit = pageSize;

			// Restaura los filtros de la URL (p. ej. ?temporada=2024/25) en el
			// select oculto y en el desplegable visible.
			const params = new URLSearchParams(location.search);
			Object.entries(selects).forEach(([name, select]) => {
				const value = params.get(name);
				if (!value || ![...select.options].some((o) => o.value === value)) return;
				select.value = value;
				const container = select.closest(".custom-select-container");
				container.querySelectorAll(".custom-select-option").forEach((option) => {
					const selected = option.dataset.value === value;
					option.classList.toggle("selected", selected);
					if (selected) container.querySelector(".selected-text").textContent = option.textContent.trim();
				});
			});

			function apply() {
				const matching = items.filter((item) => Object.entries(selects).every(([name, select]) =>
					select.value === "todos" || item.dataset[attribute[name]] === select.value));
				const shown = new Set(matching.slice(0, limit));
				items.forEach((item) => { item.hidden = !shown.has(item); });
				root.querySelector("[data-empty]").hidden = matching.length > 0;

				const remaining = matching.length - shown.size;
				root.querySelector("[data-more-wrap]").hidden = remaining <= 0;
				root.querySelector("[data-remaining]").textContent = remaining;

				const url = new URL(location.href);
				Object.entries(selects).forEach(([name, select]) => {
					if (select.value === "todos") url.searchParams.delete(name);
					else url.searchParams.set(name, select.value);
				});
				history.replaceState(history.state, "", url);
			}

			Object.values(selects).forEach((select) => select.addEventListener("change", () => { limit = pageSize; apply(); }));
			root.querySelector("[data-more]").addEventListener("click", () => { limit += pageSize; apply(); });
			apply();
		});
	})();
</script>

<style>
	.match-list-ui { width: 100%; max-width: 800px; margin: 0 auto 4rem; }
	.match-list-ui [hidden] { display: none !important; }
	.filters-container { display: flex; gap: 1.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; justify-content: center; align-items: flex-start; }

	.matches-container {
		display: flex; flex-direction: column; position: relative; overflow: hidden;
		background: rgba(8, 16, 34, 0.85); border: 1px solid rgba(212, 168, 67, 0.18); border-radius: 4px;
	}
	.matches-container::before,
	.matches-container::after { content: ""; position: absolute; width: 14px; height: 14px; pointer-events: none; z-index: 1; }
	.matches-container::before { top: 0; left: 0; border-top: 1px solid rgba(212, 168, 67, 0.5); border-left: 1px solid rgba(212, 168, 67, 0.5); }
	.matches-container::after { bottom: 0; right: 0; border-bottom: 1px solid rgba(212, 168, 67, 0.5); border-right: 1px solid rgba(212, 168, 67, 0.5); }

	.match-item { border-bottom: 1px solid rgba(212, 168, 67, 0.07); }
	.match-item:last-of-type { border-bottom: none; }
	.match-competition {
		display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 1rem;
		background: rgba(212, 168, 67, 0.04); border-bottom: 1px solid rgba(212, 168, 67, 0.08);
	}
	.competition-info { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
	.competition-logo { width: 18px; height: 18px; object-fit: contain; opacity: 0.85; }
	.competition-name, .upcoming-label {
		font-family: "Cinzel", serif; font-size: 0.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em;
	}
	.competition-name { color: rgba(212, 168, 67, 0.65); }
	.upcoming-label { padding: 0.35rem 0.55rem; border: 1px solid rgba(212, 168, 67, 0.35); border-radius: 3px; color: #d4a843; }

	.match-detail {
		display: grid; grid-template-columns: 80px 1fr; align-items: center; gap: 1rem;
		padding: 0.9rem 1rem; text-decoration: none; transition: background 0.2s ease;
	}
	.match-detail:hover { background: rgba(212, 168, 67, 0.06); }
	.match-date-time { font-family: "DM Sans", sans-serif; color: rgba(200, 210, 220, 0.4); font-size: 0.78rem; font-weight: 500; text-align: center; }
	.match-teams-score { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
	.team { display: flex; align-items: center; gap: 0.65rem; flex: 1; min-width: 0; }
	.team-local { justify-content: flex-end; text-align: right; }
	.team-visitor { justify-content: flex-start; text-align: left; }
	.team-shield { width: 28px; height: 28px; object-fit: contain; flex-shrink: 0; }
	.team-name {
		font-family: "DM Sans", sans-serif; color: rgba(200, 210, 220, 0.88); font-size: 0.9rem; font-weight: 600;
		white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
	}
	.score-wrapper { display: flex; align-items: center; gap: 0.4rem; justify-content: center; min-width: 60px; }
	.score { font-family: "Cinzel", serif; color: #d4a843; font-size: 1.15rem; font-weight: 700; }
	.vs { font-family: "DM Sans", sans-serif; color: rgba(200, 210, 220, 0.3); font-size: 0.75rem; font-weight: 600; }
	.upcoming-vs { font-family: "Cinzel", serif; color: rgba(212, 168, 67, 0.6); letter-spacing: 0.1em; }

	.result-indicator {
		width: 30px; height: 30px; border-radius: 3px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
		font-family: "Cinzel", serif; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.05em;
	}
	.result-indicator.win { background: rgba(74, 222, 128, 0.15); color: rgba(74, 222, 128, 0.9); border: 1px solid rgba(74, 222, 128, 0.25); }
	.result-indicator.loss { background: rgba(248, 113, 113, 0.12); color: rgba(248, 113, 113, 0.85); border: 1px solid rgba(248, 113, 113, 0.2); }
	.result-indicator.draw { background: rgba(212, 168, 67, 0.1); color: rgba(212, 168, 67, 0.8); border: 1px solid rgba(212, 168, 67, 0.2); }
	.no-results-message { font-family: "DM Sans", sans-serif; color: rgba(200, 210, 220, 0.35); text-align: center; padding: 3rem 1rem; font-size: 0.9rem; margin: 0; }

	.matches-footer { display: flex; justify-content: center; margin-top: 1.5rem; }
	.btn-more {
		display: inline-block; padding: 0.65rem 1.5rem; background: transparent; color: #d4a843; cursor: pointer;
		font-family: "Cinzel", serif; font-weight: 600; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase;
		border: 1px solid rgba(212, 168, 67, 0.4); border-radius: 3px; transition: all 0.2s;
	}
	.btn-more:hover { background: rgba(212, 168, 67, 0.1); border-color: rgba(212, 168, 67, 0.7); color: #f5f0e8; }
	.match-detail:focus-visible, .btn-more:focus-visible { outline: 2px solid #e6c77c; outline-offset: 2px; }

	@media (max-width: 640px) {
		.matches-container { width: calc(100% - 1.5rem); max-width: 31rem; margin-inline: auto; }
		.match-competition { padding: 0.6rem 0.75rem; gap: 0.75rem; }
		.competition-name { line-height: 1.35; }
		.match-detail { grid-template-columns: 1fr; gap: 0.5rem; padding: 0.75rem; }
		.match-date-time { text-align: left; }
		.match-teams-score { gap: 0.5rem; }
		.team { gap: 0.45rem; }
		.team-shield { width: 24px; height: 24px; }
		.team-name { font-size: 0.8rem; }
		.score-wrapper { min-width: 48px; }
		.btn-more { width: calc(100% - 1.5rem); }
	}
</style>

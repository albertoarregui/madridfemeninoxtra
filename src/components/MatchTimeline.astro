---
import { getAssetUrl } from "../utils/assets";

interface Props {
	matches: any[];
	currentSeason: string;
}

const { matches = [], currentSeason } = Astro.props;
const en = Astro.locals.locale === "en";

const COMPETITION_ORDER = ["Primera Iberdrola", "Liga F", "UWCL", "Copa de la Reina", "Supercopa de España", "Amistosos"];
const MONTHS_ES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const MONTHS_EN = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

const t = en
	? {
		upcoming: "UPCOMING", results: "RESULTS", competition: "COMPETITION", venue: "VENUE", season: "SEASON",
		all: "All", home: "Home", away: "Away", label: "♦ CHRONOLOGICAL VIEW ♦", title: "MATCH LIST",
		scheduled: "Scheduled", final: "Full time", tbc: "TBC", empty: "No matches for these filters.",
		w: "W", d: "D", l: "L", open: "Open match",
	}
	: {
		upcoming: "PRÓXIMOS", results: "RESULTADOS", competition: "COMPETICIÓN", venue: "SEDE", season: "TEMPORADA",
		all: "Todas", home: "Local", away: "Visitante", label: "♦ VISTA CRONOLÓGICA ♦", title: "LISTA DE PARTIDOS",
		scheduled: "Programado", final: "Final", tbc: "Por confirmar", empty: "No hay partidos con estos filtros.",
		w: "V", d: "E", l: "D", open: "Ver partido",
	};

const isRealMadrid = (name: unknown) =>
	String(name ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().includes("real madrid");

const competitionRank = (name: string) => {
	const index = COMPETITION_ORDER.indexOf(name);
	return index === -1 ? COMPETITION_ORDER.length : index;
};

// Las fechas vienen como YYYY-MM-DD: se formatean sin pasar por la zona horaria.
const formatDate = (fecha: unknown) => {
	const [year, month, day] = String(fecha ?? "").slice(0, 10).split("-").map(Number);
	if (!year || !month || !day) return "—";
	return en ? `${MONTHS_EN[month - 1]} ${day}, ${year}` : `${day} ${MONTHS_ES[month - 1]} ${year}`;
};

const formatTime = (hora: unknown) => {
	const match = String(hora ?? "").match(/^(\d{1,2}):(\d{2})/);
	return match ? `${match[1].padStart(2, "0")}:${match[2]}` : null;
};

const rows = matches
	.filter((m) => m?.slug && m?.temporada_nombre)
	.map((m) => {
		const competition = String(m.competicion_nombre || (en ? "Other" : "Otras"));
		const played = Boolean(m.isPlayed);
		return {
			slug: m.slug,
			fecha: String(m.fecha ?? ""),
			season: String(m.temporada_nombre),
			competition,
			competitionLogo: m.competicion_foto_url || getAssetUrl("competiciones", competition),
			venue: isRealMadrid(m.club_local) ? "home" : "away",
			played,
			result: played && ["V", "E", "D"].includes(m.resultado) ? m.resultado : "",
			date: formatDate(m.fecha),
			time: formatTime(m.hora),
			teams: [
				{ name: m.club_local, shield: m.local_shield_url, goals: m.goles_rm != null && isRealMadrid(m.club_local) ? m.goles_rm : m.goles_rival, rm: isRealMadrid(m.club_local) },
				{ name: m.club_visitante, shield: m.visitante_shield_url, goals: m.goles_rm != null && isRealMadrid(m.club_visitante) ? m.goles_rm : m.goles_rival, rm: isRealMadrid(m.club_visitante) },
			],
		};
	})
	// Orden cronológico inverso, como en la referencia: lo más lejano arriba.
	.sort((a, b) => b.fecha.localeCompare(a.fecha));

const seasons = [...new Set(rows.map((r) => r.season))].sort().reverse();
const defaultSeason = seasons.includes(currentSeason) ? currentSeason : seasons[0] ?? "";

const competitions = [...new Map(rows.map((r) => [r.competition, r.competitionLogo])).entries()]
	.sort(([a], [b]) => competitionRank(a) - competitionRank(b) || a.localeCompare(b));

const groups = competitions.map(([name, logo]) => ({
	name,
	logo,
	rows: rows.filter((r) => r.competition === name),
}));

const initial = rows.filter((r) => r.season === defaultSeason);
const count = (list: typeof rows) => ({
	upcoming: list.filter((r) => !r.played).length,
	results: list.filter((r) => r.played).length,
	w: list.filter((r) => r.result === "V").length,
	d: list.filter((r) => r.result === "E").length,
	l: list.filter((r) => r.result === "D").length,
});
const initialCount = count(initial);
const initialCompetitions = new Set(initial.map((r) => r.competition));
---

<div class="mt" data-match-timeline data-default-season={defaultSeason}>
	<section class="mt-bar" aria-label={en ? "Summary and filters" : "Resumen y filtros"}>
		<div class="mt-totals">
			<p class="mt-total"><strong data-count="upcoming">{initialCount.upcoming}</strong><span>{t.upcoming}</span></p>
			<p class="mt-total"><strong data-count="results">{initialCount.results}</strong><span>{t.results}</span></p>
			<p class="mt-record" aria-label={en ? "Wins, draws and losses" : "Victorias, empates y derrotas"}>
				<span class="is-w"><b data-count="w">{initialCount.w}</b>{t.w}</span>
				<span class="is-d"><b data-count="d">{initialCount.d}</b>{t.d}</span>
				<span class="is-l"><b data-count="l">{initialCount.l}</b>{t.l}</span>
			</p>
		</div>

		<div class="mt-filters">
			<fieldset class="mt-filter">
				<legend>{t.competition}</legend>
				<div class="mt-pills" role="group">
					<button type="button" class="mt-pill is-active" data-filter="competition" data-value="" aria-pressed="true">{t.all}</button>
					{competitions.map(([name, logo]) => (
						<button type="button" class="mt-pill" data-filter="competition" data-value={name} aria-pressed="false" hidden={!initialCompetitions.has(name)}>
							<img src={logo} alt="" width="18" height="18" loading="lazy" decoding="async" />{name}
						</button>
					))}
				</div>
			</fieldset>

			<fieldset class="mt-filter">
				<legend>{t.venue}</legend>
				<div class="mt-pills" role="group">
					<button type="button" class="mt-pill is-active" data-filter="venue" data-value="" aria-pressed="true">{t.all}</button>
					<button type="button" class="mt-pill" data-filter="venue" data-value="home" aria-pressed="false">{t.home}</button>
					<button type="button" class="mt-pill" data-filter="venue" data-value="away" aria-pressed="false">{t.away}</button>
				</div>
			</fieldset>

			<label class="mt-filter mt-season">
				<span>{t.season}</span>
				<select data-filter="season">
					{seasons.map((season) => <option value={season} selected={season === defaultSeason}>{season}</option>)}
				</select>
			</label>
		</div>
	</section>

	<span class="section-label mt-label">{t.label}</span>
	<h2 class="mt-title">{t.title}</h2>

	<div class="mt-groups">
		{groups.map((group) => (
			<section class="mt-group" data-group={group.name} hidden={!group.rows.some((r) => r.season === defaultSeason)}>
				<h3 class="mt-group-head"><img src={group.logo} alt="" width="30" height="30" loading="lazy" decoding="async" />{group.name}</h3>
				<ul class="mt-list">
					{group.rows.map((row) => (
						<li data-season={row.season} data-competition={row.competition} data-venue={row.venue} data-played={String(row.played)} data-result={row.result} hidden={row.season !== defaultSeason}>
							<a class="mt-row" href={`/partidos/${row.slug}`} aria-label={`${t.open}: ${row.teams[0].name} - ${row.teams[1].name}`}>
								<time datetime={row.fecha.slice(0, 10)}>{row.date}</time>
								<span class="mt-teams">
									{row.teams.map((team) => (
										<span class:list={["mt-team", { "is-rm": team.rm }]}>
											<img src={team.shield} alt="" width="26" height="26" loading="lazy" decoding="async" />
											<span class="mt-team-name">{team.name}</span>
										</span>
									))}
								</span>
								<span class="mt-status">
									{row.played ? (
										<>
											<strong class:list={["mt-result", `is-${row.result.toLowerCase() || "e"}`]}>{row.teams[0].goals} - {row.teams[1].goals}</strong>
											<small>{t.final}</small>
										</>
									) : (
										<>
											<strong class:list={{ "is-tbc": !row.time }}>{row.time ?? t.tbc}</strong>
											<small>{t.scheduled}</small>
										</>
									)}
								</span>
								<svg class="mt-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
		<p class="mt-empty" data-empty hidden>{t.empty}</p>
	</div>
</div>

<script is:inline data-astro-rerun>
	(() => {
		document.querySelectorAll("[data-match-timeline]").forEach((root) => {
			if (root.dataset.ready === "true") return;
			root.dataset.ready = "true";
			const items = [...root.querySelectorAll("li[data-season]")];
			const groups = [...root.querySelectorAll("[data-group]")];
			const seasonSelect = root.querySelector('select[data-filter="season"]');
			const params = new URLSearchParams(location.search);
			const state = {
				season: params.get("temporada") || root.dataset.defaultSeason,
				competition: params.get("competicion") || "",
				venue: params.get("sede") || "",
			};
			if (![...seasonSelect.options].some((o) => o.value === state.season)) state.season = root.dataset.defaultSeason;
			seasonSelect.value = state.season;

			const setCount = (key, value) => { root.querySelector(`[data-count="${key}"]`).textContent = value; };

			function apply() {
				const inSeason = items.filter((li) => li.dataset.season === state.season);
				const available = new Set(inSeason.map((li) => li.dataset.competition));
				if (state.competition && !available.has(state.competition)) state.competition = "";

				root.querySelectorAll(".mt-pill").forEach((pill) => {
					const key = pill.dataset.filter;
					const active = pill.dataset.value === state[key];
					pill.classList.toggle("is-active", active);
					pill.setAttribute("aria-pressed", String(active));
					if (key === "competition" && pill.dataset.value) pill.hidden = !available.has(pill.dataset.value);
				});

				const visible = [];
				items.forEach((li) => {
					const show = li.dataset.season === state.season
						&& (!state.competition || li.dataset.competition === state.competition)
						&& (!state.venue || li.dataset.venue === state.venue);
					li.hidden = !show;
					if (show) visible.push(li);
				});
				groups.forEach((group) => { group.hidden = !group.querySelector("li:not([hidden])"); });
				root.querySelector("[data-empty]").hidden = visible.length > 0;

				setCount("upcoming", visible.filter((li) => li.dataset.played !== "true").length);
				setCount("results", visible.filter((li) => li.dataset.played === "true").length);
				setCount("w", visible.filter((li) => li.dataset.result === "V").length);
				setCount("d", visible.filter((li) => li.dataset.result === "E").length);
				setCount("l", visible.filter((li) => li.dataset.result === "D").length);

				const url = new URL(location.href);
				const sync = (name, value, fallback = "") => value && value !== fallback ? url.searchParams.set(name, value) : url.searchParams.delete(name);
				sync("temporada", state.season, root.dataset.defaultSeason);
				sync("competicion", state.competition);
				sync("sede", state.venue);
				history.replaceState(history.state, "", url);
			}

			root.querySelectorAll(".mt-pill").forEach((pill) => pill.addEventListener("click", () => {
				state[pill.dataset.filter] = pill.dataset.value;
				apply();
			}));
			seasonSelect.addEventListener("change", () => { state.season = seasonSelect.value; apply(); });
			apply();
		});
	})();
</script>

<style>
	.mt { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; min-width: 0; margin-bottom: 4rem; color: #f4f4f6; font-family: "Montserrat", sans-serif; }
	.mt [hidden] { display: none !important; }

	.mt-bar {
		display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem;
		padding: 1.4rem 1.75rem;
		border: 1px solid rgba(201, 164, 77, 0.32); border-radius: 20px;
		background: linear-gradient(145deg, rgba(18, 25, 40, 0.98), rgba(8, 14, 29, 0.98));
		box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
	}
	.mt-totals { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; min-width: 0; }
	.mt-total { display: flex; align-items: baseline; gap: 0.55rem; margin: 0; padding-right: 1.5rem; border-right: 1px solid rgba(255, 255, 255, 0.12); }
	.mt-total strong { font: 800 2.1rem/1 "Montserrat", sans-serif; }
	.mt-total span, .mt-filter legend, .mt-filter > span {
		font: 700 0.62rem/1.2 "Montserrat", sans-serif; letter-spacing: 0.16em; color: rgba(255, 255, 255, 0.56);
	}
	.mt-record { display: flex; gap: 0.75rem; margin: 0; font: 800 1.2rem/1 "Montserrat", sans-serif; }
	.mt-record .is-w { color: #29c79d; } .mt-record .is-d { color: #aeb4c2; } .mt-record .is-l { color: #ff7272; }

	.mt-filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem 1.5rem; min-width: 0; max-width: 100%; }
	.mt-filter { display: grid; gap: 0.5rem; margin: 0; padding: 0; border: 0; min-width: 0; }
	.mt-filter legend { padding: 0; margin-bottom: 0.5rem; }
	.mt-pills {
		display: flex; flex-wrap: wrap; gap: 0.25rem; padding: 0.25rem;
		border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 999px; background: rgba(255, 255, 255, 0.03);
	}
	.mt-pill {
		display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.85rem;
		border: 0; border-radius: 999px; background: transparent; color: #d7d9e0; cursor: pointer;
		font: 600 0.78rem/1 "Montserrat", sans-serif; transition: background 0.2s, color 0.2s;
	}
	.mt-pill img { width: 18px; height: 18px; object-fit: contain; }
	.mt-pill:hover { color: #e3bf65; }
	.mt-pill.is-active { background: #d4a843; color: #16120a; }
	.mt-pill:focus-visible, .mt-season select:focus-visible, .mt-row:focus-visible { outline: 2px solid #e6c77c; outline-offset: 2px; }
	.mt-season select {
		padding: 0.55rem 2rem 0.55rem 0.9rem; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px;
		background: rgba(255, 255, 255, 0.04); color: #f4f4f6; font: 700 0.85rem/1 "Montserrat", sans-serif; cursor: pointer;
	}
	.mt-season option { color: #0c1222; }

	.mt-label { margin: 1rem 0 0; }
	.mt-title { margin: -0.75rem 0 0; font: 700 clamp(1.4rem, 3vw, 2rem)/1.2 "Cinzel", serif; color: #f4f4f6; text-align: center; }

	.mt-groups { display: grid; gap: 1.5rem; }
	.mt-group {
		padding: 1.25rem 1.5rem 0.5rem;
		border: 1px solid rgba(201, 164, 77, 0.25); border-radius: 20px;
		background: linear-gradient(145deg, rgba(18, 25, 40, 0.95), rgba(8, 14, 29, 0.95));
	}
	.mt-group-head { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 0.5rem; font: 700 1rem/1.2 "Montserrat", sans-serif; color: #e3bf65; }
	.mt-group-head img { width: 30px; height: 30px; object-fit: contain; }
	.mt-list { list-style: none; margin: 0; padding: 0; }
	.mt-list li + li { border-top: 1px solid rgba(255, 255, 255, 0.07); }

	.mt-row {
		display: grid; grid-template-columns: 8.5rem minmax(0, 1fr) auto 1rem; align-items: center; gap: 1rem;
		padding: 1rem 0.5rem; border-radius: 12px; color: inherit; text-decoration: none; transition: background 0.2s;
	}
	.mt-row:hover { background: rgba(201, 164, 77, 0.07); }
	.mt-row time { font: 700 0.9rem/1.2 "Montserrat", sans-serif; color: #f4f4f6; }
	.mt-teams { display: grid; gap: 0.45rem; min-width: 0; }
	.mt-team { display: grid; grid-template-columns: 26px minmax(0, 1fr); align-items: center; gap: 0.6rem; color: #c3c6cf; font-size: 0.95rem; }
	.mt-team img { width: 26px; height: 26px; object-fit: contain; }
	.mt-team-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mt-team.is-rm { color: #f4f4f6; font-weight: 700; }
	.mt-status { display: grid; justify-items: end; gap: 0.25rem; text-align: right; }
	.mt-status strong { font: 800 1rem/1 "Montserrat", sans-serif; white-space: nowrap; }
	.mt-status strong.is-tbc { font-size: 0.8rem; color: #d7d9e0; }
	.mt-status small { font-size: 0.72rem; color: rgba(255, 255, 255, 0.55); }
	.mt-result { padding: 0.45rem 0.7rem; border-radius: 10px; }
	.mt-result.is-v { color: #4ce0b5; background: rgba(8, 127, 102, 0.24); }
	.mt-result.is-e { color: #e5e7eb; background: rgba(107, 114, 128, 0.24); }
	.mt-result.is-d { color: #ff8a8a; background: rgba(182, 64, 64, 0.24); }
	.mt-chevron { width: 1rem; height: 1rem; fill: none; stroke: rgba(255, 255, 255, 0.45); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.mt-empty { margin: 0; padding: 2rem; text-align: center; color: rgba(255, 255, 255, 0.6); }

	@media (max-width: 900px) {
		.mt-bar { padding: 1.1rem; }
		.mt-totals { width: 100%; justify-content: space-between; gap: 0.75rem; }
		.mt-total { padding-right: 0.75rem; }
		.mt-total strong { font-size: 1.6rem; }
		.mt-filters { width: 100%; }
		.mt-pills { max-width: 100%; }
	}

	@media (max-width: 600px) {
		.mt-totals { justify-content: flex-start; }
		.mt-total { padding-right: 0.6rem; gap: 0.35rem; }
		.mt-total strong { font-size: 1.35rem; }
		.mt-filter, .mt-season { width: 100%; }
		.mt-season select { width: 100%; }
		.mt-group { padding: 1rem 0.75rem 0.25rem; border-radius: 16px; }
		.mt-row { grid-template-columns: minmax(0, 1fr) auto; gap: 0.5rem 0.75rem; padding: 0.85rem 0.25rem; }
		.mt-row time { grid-column: 1 / -1; font-size: 0.75rem; color: rgba(255, 255, 255, 0.6); }
		.mt-chevron { display: none; }
		.mt-team { font-size: 0.85rem; grid-template-columns: 22px minmax(0, 1fr); }
		.mt-team img { width: 22px; height: 22px; }
		.mt-total span { letter-spacing: 0.08em; }
		.mt-record { font-size: 1rem; }
		.mt-pill { padding: 0.45rem 0.7rem; font-size: 0.72rem; }
		.mt-pills { border-radius: 18px; }
	}
</style>

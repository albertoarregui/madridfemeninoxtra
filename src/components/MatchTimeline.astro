---
import { getAssetUrl } from "../utils/assets";

interface Props {
	matches: any[];
	currentSeason: string;
}

const { matches = [], currentSeason } = Astro.props;
const en = Astro.locals.locale === "en";

// Partidos visibles al entrar y en cada «cargar más». Todo el HTML ya viene en
// la página (≈30 KB comprimidos) y las imágenes ocultas no se descargan.
const PAGE_SIZE = 100;

const COMPETITION_ORDER = ["Primera Iberdrola", "Liga F", "UWCL", "Copa de la Reina", "Supercopa de España", "Amistosos"];
const MONTHS_ES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const MONTHS_EN = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

const t = en
	? {
		upcoming: "UPCOMING", results: "RESULTS", competition: "Competition", venue: "Venue", season: "Season",
		all: "All", allSeasons: "All seasons", allCompetitions: "All competitions", home: "Home", away: "Away", final: "Full time",
		tbc: "TBC", empty: "No matches for these filters.", w: "W", d: "D", l: "L", open: "Open match",
		more: "Load 100 more matches", remaining: "remaining", nextUp: "Upcoming",
	}
	: {
		upcoming: "PRÓXIMOS", results: "RESULTADOS", competition: "Competición", venue: "Sede", season: "Temporada",
		all: "Todas", allSeasons: "Todas las temporadas", allCompetitions: "Todas las competiciones", home: "Local", away: "Visitante", final: "Final",
		tbc: "Por confirmar", empty: "No hay partidos con estos filtros.", w: "V", d: "E", l: "D", open: "Ver partido",
		more: "Cargar 100 partidos más", remaining: "restantes", nextUp: "Por jugar",
	};

const isRealMadrid = (name: unknown) =>
	String(name ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().includes("real madrid");

const competitionRank = (name: string) => {
	const index = COMPETITION_ORDER.indexOf(name);
	return index === -1 ? COMPETITION_ORDER.length : index;
};

// Las fechas vienen como YYYY-MM-DD: se formatean sin pasar por la zona horaria.
const formatDate = (fecha: unknown) => {
	const [year, month, day] = String(fecha ?? "").slice(0, 10).split("-").map(Number);
	if (!year || !month || !day) return "—";
	return en ? `${MONTHS_EN[month - 1]} ${day}, ${year}` : `${day} ${MONTHS_ES[month - 1]} ${year}`;
};

const formatTime = (hora: unknown) => {
	const match = String(hora ?? "").match(/^(\d{1,2}):(\d{2})/);
	return match ? `${match[1].padStart(2, "0")}:${match[2]}` : null;
};

const sortKey = (m: any) => `${String(m.fecha ?? "").slice(0, 10)} ${formatTime(m.hora) ?? "99:99"}`;

const rows = matches
	.filter((m) => m?.slug && m?.temporada_nombre)
	.map((m) => {
		const competition = String(m.competicion_nombre || (en ? "Other" : "Otras"));
		const played = Boolean(m.isPlayed);
		const localIsRm = isRealMadrid(m.club_local);
		return {
			slug: m.slug,
			key: sortKey(m),
			season: String(m.temporada_nombre),
			competition,
			competitionLogo: m.competicion_foto_url || getAssetUrl("competiciones", competition),
			venue: localIsRm ? "home" : "away",
			played,
			result: played && ["V", "E", "D"].includes(m.resultado) ? m.resultado : "",
			date: formatDate(m.fecha),
			time: formatTime(m.hora),
			score: played ? `${localIsRm ? m.goles_rm : m.goles_rival} - ${localIsRm ? m.goles_rival : m.goles_rm}` : "",
			teams: [
				{ name: m.club_local, shield: m.local_shield_url, rm: localIsRm },
				{ name: m.club_visitante, shield: m.visitante_shield_url, rm: isRealMadrid(m.club_visitante) },
			],
		};
	});

// Primero los partidos por jugar (el más cercano arriba) y después los
// resultados, del más reciente al más antiguo.
const upcoming = rows.filter((r) => !r.played).sort((a, b) => a.key.localeCompare(b.key));
const played = rows.filter((r) => r.played).sort((a, b) => b.key.localeCompare(a.key));
const ordered = [...upcoming, ...played];
const orderOf = new Map(ordered.map((row, index) => [row, index]));

const seasons = [...new Set(rows.map((r) => r.season))].sort().reverse();
const competitions = [...new Map(rows.map((r) => [r.competition, r.competitionLogo])).entries()]
	.sort(([a], [b]) => competitionRank(a) - competitionRank(b) || a.localeCompare(b));

// Una tarjeta por temporada, en el orden en que aparecen sus partidos.
const groups = seasons
	.map((season) => ({ season, rows: ordered.filter((r) => r.season === season) }))
	.sort((a, b) => orderOf.get(a.rows[0])! - orderOf.get(b.rows[0])!);

const count = {
	upcoming: upcoming.length,
	results: played.length,
	w: played.filter((r) => r.result === "V").length,
	d: played.filter((r) => r.result === "E").length,
	l: played.filter((r) => r.result === "D").length,
};
const firstPage = new Set(ordered.slice(0, PAGE_SIZE));
---

<div class="mt" data-match-timeline data-page-size={PAGE_SIZE}>
	<section class="mt-bar" aria-label={en ? "Summary and filters" : "Resumen y filtros"}>
		<div class="mt-totals">
			<p class="mt-total"><strong data-count="upcoming">{count.upcoming}</strong><span>{t.upcoming}</span></p>
			<p class="mt-total"><strong data-count="results">{count.results}</strong><span>{t.results}</span></p>
			<p class="mt-record" aria-label={en ? "Wins, draws and losses" : "Victorias, empates y derrotas"}>
				<span class="is-w"><b data-count="w">{count.w}</b>{t.w}</span>
				<span class="is-d"><b data-count="d">{count.d}</b>{t.d}</span>
				<span class="is-l"><b data-count="l">{count.l}</b>{t.l}</span>
			</p>
		</div>

		<div class="mt-filters">
			<div class="mt-filter">
				<span id="mt-competition-label">{t.competition}</span>
				<div class="mt-select" data-dropdown="competition">
					<button type="button" class="mt-select-trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="mt-competition-label mt-competition-value">
						<svg class="mt-select-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4" /></svg>
						<span id="mt-competition-value" data-dropdown-text>{t.allCompetitions}</span>
						<svg class="mt-select-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
					</button>
					<ul class="mt-select-list" role="listbox" aria-labelledby="mt-competition-label" hidden>
						<li role="option" tabindex="-1" class="mt-select-option is-active" data-value="" aria-selected="true">{t.allCompetitions}</li>
						{competitions.map(([name, logo]) => (
							<li role="option" tabindex="-1" class="mt-select-option" data-value={name} aria-selected="false"><img src={logo} alt="" width="18" height="18" loading="lazy" decoding="async" />{name}</li>
						))}
					</ul>
				</div>
			</div>

			<div class="mt-filter" role="group" aria-labelledby="mt-venue-label">
				<span id="mt-venue-label">{t.venue}</span>
				<div class="mt-pills">
					<button type="button" class="mt-pill is-active" data-filter="venue" data-value="" aria-pressed="true">{t.all}</button>
					<button type="button" class="mt-pill" data-filter="venue" data-value="home" aria-pressed="false">{t.home}</button>
					<button type="button" class="mt-pill" data-filter="venue" data-value="away" aria-pressed="false">{t.away}</button>
				</div>
			</div>

			<div class="mt-filter">
				<span id="mt-season-label">{t.season}</span>
				<div class="mt-select" data-dropdown="season">
					<button type="button" class="mt-select-trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="mt-season-label mt-season-value">
						<svg class="mt-select-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
						<span id="mt-season-value" data-dropdown-text>{t.allSeasons}</span>
						<svg class="mt-select-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
					</button>
					<ul class="mt-select-list" role="listbox" aria-labelledby="mt-season-label" hidden>
						{["", ...seasons].map((season) => (
							<li role="option" tabindex="-1" class:list={["mt-select-option", { "is-active": season === "" }]} data-value={season} aria-selected={String(season === "")}>{season || t.allSeasons}</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<div class="mt-groups">
		{groups.map((group) => (
			<section class="mt-group" data-group hidden={!group.rows.some((r) => firstPage.has(r))}>
				<h2 class="mt-group-head">{group.season}{group.season === currentSeason && <span>{en ? "Current season" : "Temporada actual"}</span>}</h2>
				<ul class="mt-list">
					{group.rows.map((row) => (
						<li data-order={orderOf.get(row)} data-season={row.season} data-competition={row.competition} data-venue={row.venue} data-played={String(row.played)} data-result={row.result} hidden={!firstPage.has(row)}>
							<a class="mt-row" href={`/partidos/${row.slug}`} aria-label={`${t.open}: ${row.teams[0].name} - ${row.teams[1].name}`}>
								<span class="mt-when">
									<time>{row.date}</time>
									<span class="mt-comp"><img src={row.competitionLogo} alt="" width="16" height="16" loading="lazy" decoding="async" />{row.competition}</span>
								</span>
								<span class="mt-teams">
									{row.teams.map((team) => (
										<span class:list={["mt-team", { "is-rm": team.rm }]}>
											<img src={team.shield} alt="" width="26" height="26" loading="lazy" decoding="async" />
											<span class="mt-team-name">{team.name}</span>
										</span>
									))}
								</span>
								<span class="mt-status">
									{row.played ? (
										<>
											<strong class:list={["mt-result", `is-${row.result.toLowerCase() || "e"}`]}>{row.score}</strong>
											<small>{t.final}</small>
										</>
									) : (
										<>
											<strong class:list={{ "is-tbc": !row.time }}>{row.time ?? t.tbc}</strong>
											<small class="mt-next">{t.nextUp}</small>
										</>
									)}
								</span>
								<svg class="mt-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
		<p class="mt-empty" data-empty hidden>{t.empty}</p>
		<button type="button" class="mt-more" data-more hidden={ordered.length <= PAGE_SIZE}>
			{t.more} <span>(<b data-remaining>{Math.max(0, ordered.length - PAGE_SIZE)}</b> {t.remaining})</span>
		</button>
	</div>
</div>

<script is:inline data-astro-rerun>
	(() => {
		document.querySelectorAll("[data-match-timeline]").forEach((root) => {
			if (root.dataset.ready === "true") return;
			root.dataset.ready = "true";
			const pageSize = Number(root.dataset.pageSize) || 100;
			const items = [...root.querySelectorAll("li[data-order]")].sort((a, b) => a.dataset.order - b.dataset.order);
			const groups = [...root.querySelectorAll("[data-group]")];
			const dropdowns = Object.fromEntries([...root.querySelectorAll("[data-dropdown]")].map((dropdown) => [dropdown.dataset.dropdown, {
				root: dropdown,
				trigger: dropdown.querySelector(".mt-select-trigger"),
				list: dropdown.querySelector(".mt-select-list"),
				options: [...dropdown.querySelectorAll(".mt-select-option")],
			}]));
			const moreButton = root.querySelector("[data-more]");
			const params = new URLSearchParams(location.search);
			const state = {
				season: params.get("temporada") || "",
				competition: params.get("competicion") || "",
				venue: params.get("sede") || "",
				limit: pageSize,
			};
			Object.entries(dropdowns).forEach(([key, dropdown]) => {
				if (!dropdown.options.some((option) => option.dataset.value === state[key])) state[key] = "";
			});

			const setCount = (key, value) => { root.querySelector(`[data-count="${key}"]`).textContent = value; };

			// Marca la opción activa y copia su texto en el botón.
			const syncDropdown = (key) => {
				const dropdown = dropdowns[key];
				dropdown.options.forEach((option) => {
					const active = option.dataset.value === state[key];
					option.classList.toggle("is-active", active);
					option.setAttribute("aria-selected", String(active));
					if (active) dropdown.root.querySelector("[data-dropdown-text]").textContent = option.textContent.trim();
				});
			};

			function apply() {
				const inSeason = items.filter((li) => !state.season || li.dataset.season === state.season);
				const available = new Set(inSeason.map((li) => li.dataset.competition));
				if (state.competition && !available.has(state.competition)) state.competition = "";
				dropdowns.competition.options.forEach((option) => {
					if (option.dataset.value) option.hidden = !available.has(option.dataset.value);
				});
				syncDropdown("season");
				syncDropdown("competition");

				root.querySelectorAll(".mt-pill").forEach((pill) => {
					const active = pill.dataset.value === state[pill.dataset.filter];
					pill.classList.toggle("is-active", active);
					pill.setAttribute("aria-pressed", String(active));
				});

				const matching = inSeason.filter((li) => (!state.competition || li.dataset.competition === state.competition)
					&& (!state.venue || li.dataset.venue === state.venue));
				const shown = new Set(matching.slice(0, state.limit));
				items.forEach((li) => { li.hidden = !shown.has(li); });
				groups.forEach((group) => { group.hidden = !group.querySelector("li:not([hidden])"); });
				root.querySelector("[data-empty]").hidden = matching.length > 0;

				const remaining = matching.length - shown.size;
				moreButton.hidden = remaining <= 0;
				root.querySelector("[data-remaining]").textContent = remaining;

				setCount("upcoming", matching.filter((li) => li.dataset.played !== "true").length);
				setCount("results", matching.filter((li) => li.dataset.played === "true").length);
				setCount("w", matching.filter((li) => li.dataset.result === "V").length);
				setCount("d", matching.filter((li) => li.dataset.result === "E").length);
				setCount("l", matching.filter((li) => li.dataset.result === "D").length);

				const url = new URL(location.href);
				const sync = (name, value) => value ? url.searchParams.set(name, value) : url.searchParams.delete(name);
				sync("temporada", state.season);
				sync("competicion", state.competition);
				sync("sede", state.venue);
				history.replaceState(history.state, "", url);
			}

			root.querySelectorAll(".mt-pill").forEach((pill) => pill.addEventListener("click", () => {
				state[pill.dataset.filter] = pill.dataset.value;
				state.limit = pageSize;
				apply();
			}));

			const openDropdown = (dropdown, open) => {
				dropdown.list.hidden = !open;
				dropdown.trigger.setAttribute("aria-expanded", String(open));
				if (open) (dropdown.options.find((option) => option.classList.contains("is-active")) || dropdown.options[0]).focus();
			};
			Object.entries(dropdowns).forEach(([key, dropdown]) => {
				const choose = (option) => {
					state[key] = option.dataset.value;
					state.limit = pageSize;
					openDropdown(dropdown, false);
					dropdown.trigger.focus();
					apply();
				};
				dropdown.trigger.addEventListener("click", () => {
					Object.values(dropdowns).forEach((other) => { if (other !== dropdown) openDropdown(other, false); });
					openDropdown(dropdown, dropdown.list.hidden);
				});
				dropdown.options.forEach((option) => option.addEventListener("click", () => choose(option)));
				dropdown.list.addEventListener("keydown", (event) => {
					const visible = dropdown.options.filter((option) => !option.hidden);
					const index = visible.indexOf(document.activeElement);
					if (event.key === "ArrowDown" || event.key === "ArrowUp") {
						event.preventDefault();
						const next = index + (event.key === "ArrowDown" ? 1 : -1);
						visible[Math.max(0, Math.min(visible.length - 1, next))].focus();
					} else if ((event.key === "Enter" || event.key === " ") && index >= 0) {
						event.preventDefault();
						choose(visible[index]);
					}
				});
				dropdown.root.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && !dropdown.list.hidden) { openDropdown(dropdown, false); dropdown.trigger.focus(); }
				});
			});
			document.addEventListener("click", (event) => {
				Object.values(dropdowns).forEach((dropdown) => { if (!dropdown.root.contains(event.target)) openDropdown(dropdown, false); });
			});
			moreButton.addEventListener("click", () => { state.limit += pageSize; apply(); });
			apply();
		});
	})();
</script>

<style>
	.mt { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; width: 100%; max-width: 66rem; min-width: 0; margin: 0 auto 4rem; color: #f4f4f6; font-family: "Montserrat", sans-serif; }
	.mt [hidden] { display: none !important; }

	/* Barra de resumen y filtros */
	.mt-bar {
		display: grid; gap: 1.5rem; padding: 1.6rem 1.9rem;
		border: 1px solid rgba(201, 164, 77, 0.32); border-radius: 22px;
		background:
			radial-gradient(120% 140% at 0% 0%, rgba(212, 168, 67, 0.09), transparent 55%),
			linear-gradient(145deg, rgba(18, 25, 40, 0.98), rgba(8, 14, 29, 0.98));
		box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
	}
	.mt-totals { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; min-width: 0; padding-bottom: 1.4rem; border-bottom: 1px solid rgba(201, 164, 77, 0.18); }
	.mt-total { display: flex; align-items: baseline; gap: 0.6rem; margin: 0; padding-right: 1.75rem; border-right: 1px solid rgba(255, 255, 255, 0.12); }
	.mt-total strong { font: 800 2.2rem/1 "Montserrat", sans-serif; }
	.mt-total span { font: 700 0.62rem/1.2 "Montserrat", sans-serif; letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.56); }
	.mt-record { display: flex; gap: 0.9rem; margin: 0; font: 800 1.3rem/1 "Montserrat", sans-serif; }
	.mt-record .is-w { color: #29c79d; } .mt-record .is-d { color: #aeb4c2; } .mt-record .is-l { color: #ff7272; }

	/* Los tres filtros en una línea; en pantallas estrechas se reparten en varias. */
	.mt-filters { display: flex; flex-wrap: nowrap; align-items: flex-end; gap: 1.5rem; min-width: 0; }
	.mt-filter { display: grid; gap: 0.6rem; margin: 0; padding: 0; border: 0; min-width: 0; max-width: 100%; }
	.mt-filter > span:first-child {
		display: flex; align-items: center; gap: 0.5rem; padding: 0; margin-bottom: 0.6rem;
		font: 700 0.7rem/1 "Cinzel", serif; letter-spacing: 0.22em; text-transform: uppercase; color: #d4a843;
	}
	.mt-filter > span:first-child { margin-bottom: 0; }
	.mt-filter > span:first-child::before { content: "♦"; font-size: 0.55rem; }
	.mt-pills {
		display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; height: 2.75rem; padding: 0 0.3rem; box-sizing: border-box;
		border: 1px solid rgba(201, 164, 77, 0.28); border-radius: 999px; background: rgba(5, 9, 19, 0.55);
	}
	.mt-pill {
		display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.55rem 1rem;
		border: 1px solid transparent; border-radius: 999px; background: transparent; color: #d7d9e0; cursor: pointer;
		font: 700 0.76rem/1 "Montserrat", sans-serif; letter-spacing: 0.03em; transition: background 0.2s, color 0.2s, border-color 0.2s;
	}
	.mt-pill img { width: 18px; height: 18px; object-fit: contain; }
	.mt-pill:hover { color: #f2dfb0; border-color: rgba(201, 164, 77, 0.35); }
	.mt-pill.is-active {
		background: linear-gradient(180deg, #e3bf65, #c99a35); border-color: #e3bf65; color: #16120a;
		box-shadow: 0 6px 18px rgba(212, 168, 67, 0.28);
	}
	.mt-select { position: relative; }
	.mt-select-trigger {
		position: relative; display: flex; align-items: center; min-width: 15rem; height: 2.75rem; padding: 0 2.6rem; box-sizing: border-box;
		border: 1px solid rgba(201, 164, 77, 0.45); border-radius: 999px; background: rgba(5, 9, 19, 0.55);
		color: #f4f4f6; font: 700 0.82rem/1 "Montserrat", sans-serif; cursor: pointer; text-align: left; white-space: nowrap;
	}
	.mt-select-trigger:hover, .mt-select-trigger[aria-expanded="true"] { border-color: #e3bf65; }
	.mt-select-trigger svg { position: absolute; width: 1rem; height: 1rem; fill: none; stroke: #d4a843; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; pointer-events: none; }
	.mt-select-icon { left: 0.95rem; }
	.mt-select-arrow { right: 0.95rem; transition: transform 0.2s; }
	.mt-select-trigger[aria-expanded="true"] .mt-select-arrow { transform: rotate(180deg); }
	.mt-select-list {
		position: absolute; top: calc(100% + 0.5rem); left: 0; z-index: 30; display: grid; gap: 0.2rem;
		min-width: 100%; max-height: 22rem; margin: 0; padding: 0.35rem; overflow-y: auto; list-style: none;
		border: 1px solid rgba(201, 164, 77, 0.45); border-radius: 18px;
		background: linear-gradient(145deg, rgba(18, 25, 40, 0.99), rgba(8, 14, 29, 0.99));
		box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
		scrollbar-width: thin; scrollbar-color: rgba(201, 164, 77, 0.5) transparent;
	}
	.mt-select-option {
		display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; border: 1px solid transparent; border-radius: 999px; color: #d7d9e0; cursor: pointer;
		font: 700 0.78rem/1 "Montserrat", sans-serif; letter-spacing: 0.03em; white-space: nowrap;
		transition: background 0.2s, color 0.2s, border-color 0.2s;
	}

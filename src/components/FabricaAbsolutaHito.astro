---
import { getAssetUrl } from "../utils/assets";

interface Props {
    label?: string;
    title?: string;
}

const {
    label = "Hito histórico",
    title = "De La Fábrica a la absoluta",
} = Astro.props;

const photo = getAssetUrl("premios", "mundial_sub20_2026_silvia_cristobal_mvp_final.webp");
const convocatoriaUrl = "https://rfef.es/es/noticias/las-25-elegidas-para-cerrar-el-ano";

const path = [
    { year: "2024", team: "Sub-17", result: "Campeona de Europa" },
    { year: "2026", team: "Sub-19", result: "Campeona de Europa" },
    { year: "2026", team: "Sub-20", result: "Campeona del mundo · MVP de la final" },
    { year: "2026", team: "Absoluta", result: "Primera convocatoria", current: true },
];
---

<section class="fabrica-section" aria-labelledby="absoluta-hito-title">
    <div class="section-label">{label}</div>
    <h2 class="section-title" id="absoluta-hito-title">{title}</h2>

    <article class="absoluta-hito fabrica-card mfx-framed"><span class="mfx-frame" aria-hidden="true"></span>
        <div class="fabrica-card-head">
            <span>Selección absoluta</span>
            <span>Noviembre 2026</span>
        </div>

        <div class="absoluta-hito-body">
            <figure class="absoluta-hito-photo">
                <div class="absoluta-hito-photo-frame">
                    <img
                        src={photo}
                        alt="Silvia Cristóbal con la camiseta de la selección española"
                        width="900"
                        height="1200"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
                <figcaption>Silvia Cristóbal, con España en el Mundial sub-20 de 2026.</figcaption>
            </figure>

            <div class="absoluta-hito-copy">
                <div class="absoluta-hito-pills">
                    <span class="result-pill">Primera convocatoria</span>
                    <span class="meta-pill">Defensa · Real Madrid</span>
                </div>

                <h3 class="absoluta-hito-name">Silvia Cristóbal</h3>
                <p class="absoluta-hito-lead">
                    La primera canterana de La Fábrica convocada por la selección española absoluta.
                </p>

                <div class="absoluta-hito-records">
                    <div class="absoluta-hito-record">
                        <strong>1ª</strong>
                        <span>canterana del Real Madrid llamada por la absoluta</span>
                    </div>
                    <div class="absoluta-hito-record">
                        <strong>18<small> años</small></strong>
                        <span>la más joven de la cantera blanca en lograrlo, en femenino y masculino</span>
                    </div>
                </div>

                <p class="absoluta-hito-text">
                    Sonia Bermúdez la incluyó el 20 de noviembre de 2026 en la lista de 25 para
                    los amistosos ante Chile (28 de noviembre, León) y Venezuela (4 de diciembre,
                    A Coruña). Tenía 18 años, 6 meses y 19 días. En el club desde 2021, cuando
                    llegó al Cadete, completó en Valdebebas todo el camino hasta el primer equipo.
                </p>

                <ol class="absoluta-hito-path" aria-label="Camino de Silvia Cristóbal con España">
                    {path.map((step) => (
                        <li class:list={["absoluta-hito-step", { "is-current": step.current }]}>
                            <span class="absoluta-hito-step-year">{step.year}</span>
                            <strong>{step.team}</strong>
                            <span>{step.result}</span>
                        </li>
                    ))}
                </ol>

                <div class="tournament-links absoluta-hito-links">
                    <a class="link-pill" href={convocatoriaUrl} target="_blank" rel="noopener noreferrer">
                        RFEF · convocatoria ↗
                    </a>
                    <a class="link-pill" href="/jugadoras/silvia-cristobal">Ficha de Silvia Cristóbal →</a>
                </div>
            </div>
        </div>
    </article>
</section>

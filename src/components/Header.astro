                </div>

                <ul class="submenu" id="submenu-hub">
                    <li class="has-nested-submenu">
                        <div class="nested-submenu-header">
                            <span class="nested-submenu-label">Estadísticas</span>
                        </div>
                        <ul class="nested-submenu">
                            <li><a href="/jugadoras"><span>Jugadoras</span></a></li>
                            <li><a href="/entrenadores"><span>Entrenadores</span></a></li>
                            <li><a href="/arbitras"><span>Árbitras</span></a></li>
                            <li><a href="/partidos"><span>Partidos</span></a></li>
                            <li><a href="/rivales"><span>Rivales</span></a></li>
                            <li><a href="/estadios"><span>Estadios</span></a></li>
                        </ul>
                    </li>
                    <li><a href="/rankings"><span>Rankings</span></a></li>
                    <li><a href="/estadisticas/avanzadas"><span>Gráficos</span></a></li>
                    <li class="has-nested-submenu">
                        <div class="nested-submenu-header">
                            <span class="nested-submenu-label">Buscador avanzado</span>
                        </div>
                        <ul class="nested-submenu">
                            <li><a href="/estadisticas/buscador-avanzado-jugadoras"><span>Jugadoras</span></a></li>
                            <li><a href="/estadisticas/buscador-avanzado-partidos"><span>Partidos</span></a></li>
                            <li><a href="/estadisticas/buscador-avanzado-temporadas"><span>Temporadas</span></a></li>
                        </ul>
                    </li>
                    <li><a href="/records"><span>Récords</span></a></li>
                    <li><a href="/comparador"><span>Comparador</span></a></li>
                </ul>
            </li>
            <li>
                <a
                    href="/sobre-nosotros"
                    class={currentPath === "/sobre-nosotros" ? "active" : ""}
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="nav-icon"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"
                        ></path><path d="M12 9h.01"></path><path
                            d="M11 12h1v4h1"></path></svg
                    >
                    <span>Sobre Nosotros</span>
                </a>
            </li>
            <li>
                <a
                    href="/contacto"
                    class={currentPath === "/contacto" ? "active" : ""}
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="nav-icon"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M5.821 4.91c3.899 -2.765 9.468 -2.539 13.073 .535c3.667 3.129 4.168 8.238 1.152 11.898c-2.841 3.447 -7.965 4.583 -12.231 2.805l-.233 -.101l-4.374 .931l-.04 .006l-.035 .007h-.018l-.022 .005h-.038l-.033 .004l-.021 -.001l-.023 .001l-.033 -.003h-.035l-.022 -.004l-.022 -.002l-.035 -.007l-.034 -.005l-.016 -.004l-.024 -.005l-.049 -.016l-.024 -.005l-.011 -.005l-.022 -.007l-.045 -.02l-.03 -.012l-.011 -.006l-.014 -.006l-.031 -.018l-.045 -.024l-.016 -.011l-.037 -.026l-.04 -.027l-.002 -.004l-.013 -.009l-.043 -.04l-.025 -.02l-.006 -.007l-.056 -.062l-.013 -.014l-.011 -.014l-.039 -.056l-.014 -.019l-.005 -.01l-.042 -.073l-.007 -.012l-.004 -.008l-.007 -.012l-.014 -.038l-.02 -.042l-.004 -.016l-.004 -.01l-.017 -.061l-.007 -.018l-.002 -.015l-.005 -.019l-.005 -.033l-.008 -.042l-.002 -.031l-.003 -.01v-.016l-.004 -.054l.001 -.036l.001 -.023l.002 -.053l.004 -.025v-.019l.008 -.035l.005 -.034l.005 -.02l.004 -.02l.018 -.06l.003 -.013l1.15 -3.45l-.022 -.037c-2.21 -3.747 -1.209 -8.391 2.413 -11.119z"
                        ></path></svg
                    >
                    <span>Contacto</span>
                </a>
            </li>
            <li class="hs-nav-li">
                <HeaderSearch />
            </li>
        </ul>
            <div class="nav-auth-item">
                <Show when="signed-in">
                    <button class="island-auth-btn auth-user-btn" data-action="signout">
                        {userPhoto && <img class="auth-user-avatar" src={userPhoto} alt={userName} />}
                        <span class="auth-user-name">{userName}</span>
                    </button>
                </Show>
                <Show when="signed-out">
                    <button class="island-auth-btn" data-action="signin-google">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/></svg>
                        ENTRAR
                    </button>
                </Show>
            </div>
        </div>

        <div class="mobile-social-icons">
            <a href="https://x.com/madridfemxtra" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter"><X /></a>
            <a href="https://instagram.com/madridfemxtra" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><Instagram /></a>
            <a href="https://tiktok.com/@madridfemeninoxtra" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><TikTok /></a>
        </div>
    </nav>

    <button
        class="menu-toggle"
        id="menu-toggle"
        aria-controls="main-nav"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
    >
        <span class="line"></span>
        <span class="line"></span>
        <span class="line"></span>
    </button>
    <div id="nav-overlay" class="nav-overlay"></div>
    <script is:inline type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "ItemList",
            "itemListElement": [
                {
                    "@type": "SiteNavigationElement",
                    "position": 3,
                    "name": "Plantilla",
                    "description": "Jugadoras del Real Madrid Femenino",
                    "url": "https://www.madridfemeninoxtra.com/plantilla"
                },
                {
                    "@type": "SiteNavigationElement",
                    "position": 4,
                    "name": "Partidos",
                    "description": "Calendario y resultados",
                    "url": "https://www.madridfemeninoxtra.com/partidos"
                },
                {
                    "@type": "SiteNavigationElement",
                    "position": 5,
                    "name": "Rankings",
                    "description": "Clasificación y estadísticas",
                    "url": "https://www.madridfemeninoxtra.com/rankings"
                }
            ]
        }
    </script>
</header>

<script>
    function initNav() {
        const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
        const nav    = document.getElementById('main-nav') as HTMLElement | null;
        const overlay = document.getElementById('nav-overlay') as HTMLElement | null;

        if (!toggle) return;

        function openNav() {
            document.body.classList.add('nav-open');
            nav?.classList.add('is-open');
            toggle?.setAttribute('aria-expanded', 'true');
        }
        function closeNav() {
            document.body.classList.remove('nav-open');
            nav?.classList.remove('is-open');
            toggle?.setAttribute('aria-expanded', 'false');
            document.querySelectorAll<HTMLElement>('.submenu-toggle').forEach(btn => {
                btn.setAttribute('aria-expanded', 'false');
            });
            document.querySelectorAll<HTMLElement>('.submenu').forEach(sub => {
                sub.style.display = '';
            });
        }

        toggle.addEventListener('click', () => {
            document.body.classList.contains('nav-open') ? closeNav() : openNav();
        });

        overlay?.addEventListener('click', closeNav);

        document.querySelectorAll<HTMLElement>('.submenu-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                const expanded = btn.getAttribute('aria-expanded') === 'true';
                btn.setAttribute('aria-expanded', String(!expanded));
                const targetId = btn.getAttribute('aria-controls');
                const submenu = targetId ? document.getElementById(targetId) : null;
                if (submenu) submenu.style.display = expanded ? '' : 'block';
            });
        });
    }

    document.addEventListener('astro:page-load', initNav);

    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const nav = document.getElementById('main-nav');
        const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
        if (nav?.classList.contains('is-open')) {
            document.body.classList.remove('nav-open');
            nav.classList.remove('is-open');
            toggle?.setAttribute('aria-expanded', 'false');
            document.querySelectorAll<HTMLElement>('.submenu-toggle').forEach(btn => {
                btn.setAttribute('aria-expanded', 'false');
            });
            document.querySelectorAll<HTMLElement>('.submenu').forEach(sub => {
                sub.style.display = '';
            });
        }
    });
</script>

<script is:inline>
    document.addEventListener('click', async function(e) {
        var btn = e.target.closest('[data-action]');
        if (!btn) return;

        var action = btn.dataset.action;

        if (action === 'signin-google') {
            if (window.innerWidth <= 1024) {
                window.Clerk.redirectToSignIn({ afterSignInUrl: window.location.href });
            } else {
                window.Clerk.openSignIn({
                    afterSignInUrl: window.location.href,
                    afterSignUpUrl: window.location.href,
                });
            }
        } else if (action === 'signout') {
            try {
                await window.Clerk.signOut();
                window.location.reload();
            } catch (err) {
                console.error('Error al cerrar sesión:', err);
            }
        }
    });
</script>

<style>
    :root {
        --header-bg: #060d1c;
        --header-bg-gradient: linear-gradient(to right, #060d1c, #0a1428);
        --header-text: #ffffff;
        --header-accent: #d4a843;
        --header-hover-bg: rgba(212, 168, 67, 0.1);
    }

    .header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0.75rem 2.5rem;
        background: transparent;
        box-shadow: none;
        border-bottom: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000000;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .header--hidden {
        transform: translateY(-160%);
    }

    .logo {
        display: none;
    }

    .logo a {
        display: flex;
        align-items: center;
    }

    .header-logo-icon {
        height: 48px !important;
        width: auto !important;
        object-fit: contain;
        mix-blend-mode: screen;
        flex-shrink: 0;
    }

    @media (max-width: 1024px) {
        :global(body.nav-open) .logo {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        .logo {
            transition:
                opacity 0.3s ease,
                visibility 0.3s ease;
        }
    }

    .logo a:hover {
        transform: none;
    }

    .nav-island {
        display: flex;
        align-items: center;
        padding: 0.5rem clamp(0.75rem, 2vw, 1.75rem);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 50px;
        background: rgba(4, 10, 24, 0.72);
        backdrop-filter: blur(24px) saturate(1.6);
        -webkit-backdrop-filter: blur(24px) saturate(1.6);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.45),
            inset 0 1px 0 rgba(255, 255, 255, 0.07);
    }

    .island-logo-link {
        display: flex;
        align-items: center;
        padding-right: 1.25rem;
        margin-right: 1.25rem;
        border-right: 1px solid rgba(255, 255, 255, 0.12);
    }

    .island-logo-img {
        height: 36px !important;
        width: auto !important;
        object-fit: contain;
        display: block;
    }

    .island-logo-link::after {
        display: none !important;
    }

    .island-logo-link:hover {
        transform: none;
    }

    .nav-auth-item {
        display: flex;
        align-items: center;
        border-left: 1px solid rgba(255, 255, 255, 0.12);
        padding-left: 1.25rem;
        margin-left: 1.25rem;
    }

    .island-auth-btn {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--header-accent);
        color: #1a1a1a;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        text-transform: uppercase;
        font-weight: 900;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.3s ease;
        box-shadow: 0 2px 12px rgba(212, 168, 67, 0.3);
    }

    .island-auth-btn:hover {
        background: #c49030;
        transform: translateY(-2px);
    }

    .custom-select-container.open {
        z-index: 9999 !important;
    }

    .custom-select-container.open .custom-select-options {
        z-index: 10000 !important;
    }

    .main-nav {
        display: flex;
        justify-content: center;
        justify-self: center;
    }

    .icon-tabler-brand-linkedin {
        width: 1.5rem !important;
        height: 1.5rem !important;
        fill: none !important;
        stroke: currentColor !important;
        stroke-width: 2 !important;
        transition: all 0.3s ease;
    }

    .icon-tabler-brand-linkedin path {
        fill: none !important;
        stroke: currentColor !important;
        transition: all 0.3s ease;
    }

    .mobile-social-icons a:hover .icon-tabler-brand-linkedin {
        stroke: #ffffff !important;
        fill: none !important;
    }

    .mobile-social-icons {
        display: none;
    }

    .nav-list {
        display: flex;
        list-style: none;
        padding: 0.45rem 0;
        margin: 0;
        gap: clamp(1rem, 2vw, 2.5rem);
        flex: 1;
        justify-content: center;
        background: transparent;
        border: none;
    }

    .nav-list a {
        color: var(--header-text);
        text-decoration: none;
        font-weight: 600;
        font-size: clamp(0.78rem, 1.1vw, 0.95rem);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: color 0.3s ease, font-size 0.3s ease;
        padding: 0.5rem 0;
        position: relative;
        white-space: nowrap;
        display: inline-block;
    }

    .nav-icon {
        display: none;
    }

    .linkedin-stroke {
        display: none;
    }

    .nav-list a::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background-color: var(--header-accent);
        transition: width 0.3s ease;
    }

    .nav-list a:hover {
        color: var(--header-accent);
    }

    .nav-list a:hover::after,
    .nav-list a.active::after {
        width: 100%;
    }

    .nav-list a.active {
        color: var(--header-accent);
    }

    .submenu-toggle {
        display: none;
    }

    .mobile-menu-logo {
        display: none;
    }

    .has-submenu {
        position: relative;
    }

    .submenu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        list-style: none;
        padding: 0.5rem;
        min-width: 200px;
        background: #0a1428;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        border-radius: 8px;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s ease;
        z-index: 20;
    }

    .has-submenu:hover .submenu {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }

    .submenu-divider {
        height: 1px;
        background: rgba(212,168,67,0.12);
        margin: 0.35rem 0.75rem;
    }

    .has-nested-submenu {
        position: relative;
    }

    .nested-submenu-header {
        cursor: pointer;
    }

    .nested-submenu-label {
        display: block;
        padding: 0.75rem 1rem;
        color: #e0e0e0;
        border-radius: 4px;
        font-weight: 500;

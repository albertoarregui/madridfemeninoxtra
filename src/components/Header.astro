                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="nav-icon"
                            ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                            ></path><path
                                d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1l0 -10"
                            ></path><path d="M7 20h10"></path><path d="M9 16v4"
                            ></path><path d="M15 16v4"></path><path d="M9 12v-4"
                            ></path><path d="M12 12v-1"></path><path
                                d="M15 12v-2"></path><path d="M12 12v-1"
                            ></path></svg
                        >
                        <span>Hub</span>
                    </a>
                    <button
                        class="submenu-toggle"
                        aria-expanded="false"
                        aria-controls="submenu-hub"
                        aria-label="Abrir submenú de hub">▼</button

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { competitionDisplayName } from "../utils/competiciones";

interface Match {
    id_partido?: number;
    slug: string;
    fecha: string;
    hora?: string;
    competicion_nombre: string;
    club_local: string;
    club_visitante: string;
    goles_rm: number;
    goles_rival: number;
    resultado: string;
    temporada_nombre: string;
    local_shield_url?: string;
    visitante_shield_url?: string;
}

interface Props {
    matches: Match[];
    seasons?: string[];
    competitions?: string[];
}

const { matches, seasons = [], competitions = [] } = Astro.props;

import { getAssetMetadata } from "../utils/assets";

function getCompetitionLogo(competitionName: string) {
    return getAssetMetadata("competiciones", competitionName);
}

function getTeamLogo(teamName: string) {
    return getAssetMetadata("escudos", teamName);
}
---

<div class="match-list-ui">
    <div class="filters-container">
        {
            seasons.length > 0 && (
                <div class="custom-select-container" id="container-temporada">
                    <div class="custom-select-trigger" id="trigger-temporada">
                        <span class="selected-text">Todas las Temporadas</span>
                        <div class="custom-select-arrow">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </div>
                    </div>
                    <div class="custom-select-options">
                        <div
                            class="custom-select-option selected"
                            data-value="todos"
                        >
                            Todas las Temporadas
                        </div>
                        {seasons.map((season) => (
                            <div
                                class="custom-select-option"
                                data-value={season}
                            >
                                {season}
                            </div>
                        ))}
                    </div>
                    <select
                        id="filtro-temporada"
                        aria-label="Filtrar por temporada"
                        style="display: none;"
                    >
                        <option value="todos" selected>
                            Todas las Temporadas
                        </option>
                        {seasons.map((season) => (
                            <option value={season}>{season}</option>
                        ))}
                    </select>
                </div>
            )
        }

        {
            competitions.length > 0 && (
                <div class="custom-select-container" id="container-competicion">
                    <div class="custom-select-trigger" id="trigger-competicion">
                        <span class="selected-text">
                            Todas las Competiciones
                        </span>
                        <div class="custom-select-arrow">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </div>
                    </div>
                    <div class="custom-select-options">
                        <div
                            class="custom-select-option selected"
                            data-value="todos"
                        >
                            Todas las Competiciones
                        </div>
                        {competitions.map((comp) => (
                            <div class="custom-select-option" data-value={comp}>
                                {comp}
                            </div>
                        ))}
                    </div>
                    <select
                        id="filtro-competicion"
                        aria-label="Filtrar por competición"
                        style="display: none;"
                    >
                        <option value="todos" selected>
                            Todas las Competiciones
                        </option>
                        {competitions.map((comp) => (
                            <option value={comp}>{comp}</option>
                        ))}
                    </select>
                </div>
            )
        }
    </div>

    <div id="matches-container" class="matches-container">
        {
            matches.map((match) => {
                const formatDate = (
                    dateString: string,
                    timeString?: string,
                ) => {
                    if (!dateString) return "-";
                    try {
                        const date = new Date(dateString);
                        const day = date.getDate().toString().padStart(2, "0");
                        const month = (date.getMonth() + 1)
                            .toString()
                            .padStart(2, "0");
                        const year = date.getFullYear().toString().slice(-2);

                        let timeDisplay = "00:00";
                        if (timeString && timeString !== "00:00") {
                            timeDisplay = timeString.substring(0, 5);
                        } else {
                            const hours = date
                                .getUTCHours()
                                .toString()
                                .padStart(2, "0");
                            const minutes = date
                                .getUTCMinutes()
                                .toString()
                                .padStart(2, "0");
                            timeDisplay = `${hours}:${minutes}`;
                        }

                        return `${day}.${month}.${year} ${timeDisplay}`;
                    } catch {
                        return "-";
                    }
                };

                const resultClass =
                    match.resultado === "V"
                        ? "win"
                        : match.resultado === "D"
                          ? "loss"
                          : "draw";

                const localLogoSrc =
                    match.local_shield_url || getTeamLogo(match.club_local);
                const visitanteLogoSrc =
                    match.visitante_shield_url ||
                    getTeamLogo(match.club_visitante);
                const competitionLogo = getCompetitionLogo(
                    match.competicion_nombre,
                );

                return (
                    <div
                        class="match-item"
                        data-season={match.temporada_nombre}
                        data-competition={match.competicion_nombre}
                    >
                        <div class="match-competition">
                            <div class="competition-info">
                                {competitionLogo && (
                                    <Image
                                        src={competitionLogo}
                                        alt={match.competicion_nombre}
                                        class="competition-logo"
                                        width={24}
                                        height={24}
                                        format="webp"
                                    />
                                )}
                                <span class="competition-name">
                                    {competitionDisplayName(match.competicion_nombre, { temporada: match.temporada_nombre })}
                                </span>
                            </div>
                        </div>

                        <a
                            href={`/partidos/${match.slug}`}
                            class="match-detail"
                        >
                            <div class="match-date-time">
                                {formatDate(match.fecha, match.hora)}
                            </div>

                            <div class="match-teams-score">
                                <div class="team team-local">
                                    <span class="team-name">
                                        {match.club_local}
                                    </span>
                                    {localLogoSrc ? (
                                        <img
                                            src={
                                                typeof localLogoSrc === "string"
                                                    ? localLogoSrc
                                                    : localLogoSrc.src
                                            }
                                            alt={match.club_local}
                                            class="team-shield"
                                            width={28}
                                            height={28}
                                        />
                                    ) : (
                                        <div class="team-shield-placeholder" />
                                    )}
                                </div>

                                <div class="score-wrapper">
                                    <span class="score">
                                        {(match.club_local || '')
                                            .toLowerCase()
                                            .includes("real madrid")
                                            ? match.goles_rm
                                            : match.goles_rival}
                                    </span>
                                    <span class="vs">-</span>
                                    <span class="score">
                                        {(match.club_local || '')
                                            .toLowerCase()
                                            .includes("real madrid")
                                            ? match.goles_rival
                                            : match.goles_rm}
                                    </span>
                                </div>

                                <div class="team team-visitor">
                                    {visitanteLogoSrc ? (
                                        <img
                                            src={
                                                typeof visitanteLogoSrc ===
                                                "string"
                                                    ? visitanteLogoSrc
                                                    : visitanteLogoSrc.src
                                            }
                                            alt={match.club_visitante}
                                            class="team-shield"
                                            width={28}
                                            height={28}
                                        />
                                    ) : (
                                        <div class="team-shield-placeholder" />
                                    )}
                                    <span class="team-name">
                                        {match.club_visitante}
                                    </span>
                                </div>
                            </div>

                            <div class={`result-indicator ${resultClass}`}>
                                {match.resultado}
                            </div>
                        </a>
                    </div>
                );
            })
        }
    </div>
</div>

<script>
    function filterMatches() {
        const seasonSelect = document.getElementById("filtro-temporada") as HTMLSelectElement;
        const competitionSelect = document.getElementById("filtro-competicion") as HTMLSelectElement;
        const matchesContainer = document.getElementById("matches-container");
        const selectedSeason = seasonSelect?.value || "todos";
        const selectedCompetition = competitionSelect?.value || "todos";
        const matchItems = matchesContainer?.querySelectorAll(".match-item");
        let visibleCount = 0;

        matchItems?.forEach((item) => {
            const el = item as HTMLElement;
            const matchesSeason = selectedSeason === "todos" || el.dataset.season === selectedSeason;
            const matchesComp = selectedCompetition === "todos" || el.dataset.competition === selectedCompetition;
            el.style.display = matchesSeason && matchesComp ? "" : "none";
            if (matchesSeason && matchesComp) visibleCount++;
        });

        const matchesContainer2 = document.getElementById("matches-container");
        const existingMessage = matchesContainer2?.querySelector(".no-results-message");
        if (visibleCount === 0 && !existingMessage) {
            const msg = document.createElement("p");
            msg.className = "no-results-message";
            msg.textContent = "No se encontraron partidos con los filtros seleccionados.";
            matchesContainer2?.appendChild(msg);
        } else if (visibleCount > 0 && existingMessage) {
            existingMessage.remove();
        }
    }

    function initMatchList() {
        const root = document.querySelector(".match-list-ui");
        if (!root) return;

        const seasonSelect = document.getElementById("filtro-temporada");
        const competitionSelect = document.getElementById("filtro-competicion");
        seasonSelect?.addEventListener("change", filterMatches);
        competitionSelect?.addEventListener("change", filterMatches);

        const containers = root.querySelectorAll(".custom-select-container");
        containers.forEach(function(container) {
            const trigger = container.querySelector(".custom-select-trigger");
            const select = container.querySelector("select");
            const options = container.querySelectorAll(".custom-select-option");
            const selectedText = trigger ? trigger.querySelector(".selected-text") : null;

            if (!trigger || !select || container.getAttribute("data-init")) return;
            container.setAttribute("data-init", "true");

            trigger.addEventListener("click", function(e) {
                e.stopPropagation();
                containers.forEach(function(c) { if (c !== container) c.classList.remove("open"); });
                container.classList.toggle("open");
            });

            options.forEach(function(option) {
                option.addEventListener("click", function(e) {
                    e.stopPropagation();
                    const value = option.getAttribute("data-value");
                    if (selectedText) selectedText.textContent = (option.textContent || "").trim();
                    if (select && value) {
                        select.value = value;
                        select.dispatchEvent(new Event("change", { bubbles: true }));
                    }
                    options.forEach(function(opt) { opt.classList.remove("selected"); });
                    option.classList.add("selected");
                    container.classList.remove("open");
                });
            });
        });

        document.addEventListener("click", function() {
            containers.forEach(function(c) { c.classList.remove("open"); });
        });
    }

    document.addEventListener("astro:page-load", initMatchList);
    if (document.readyState === "complete" || document.readyState === "interactive") {
        initMatchList();
    } else {
        document.addEventListener("DOMContentLoaded", initMatchList);
    }
</script>

<style>
    .match-list-ui {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
    }

    .filters-container {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
        justify-content: center;
        align-items: flex-start;
    }

    .matches-container {
        display: flex;
        flex-direction: column;
        gap: 0;
        background: rgba(8,16,34,0.85);
        border: 1px solid rgba(212,168,67,0.18);
        border-radius: 4px;
        overflow: hidden;
        position: relative;
    }
    .matches-container::before {
        content: '';
        position: absolute; top: 0; left: 0;
        width: 14px; height: 14px;
        border-top: 1px solid rgba(212,168,67,0.5);
        border-left: 1px solid rgba(212,168,67,0.5);
        pointer-events: none;
        z-index: 1;
    }
    .matches-container::after {
        content: '';
        position: absolute; bottom: 0; right: 0;
        width: 14px; height: 14px;
        border-bottom: 1px solid rgba(212,168,67,0.5);
        border-right: 1px solid rgba(212,168,67,0.5);
        pointer-events: none;
        z-index: 1;
    }

    .match-item {
        background: transparent;
        border-bottom: 1px solid rgba(212,168,67,0.07);
    }

    .match-item:last-child {
        border-bottom: none;
    }

    .match-competition {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 1rem;
        background: rgba(212,168,67,0.04);
        border-bottom: 1px solid rgba(212,168,67,0.08);
    }

    .competition-info {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .competition-logo {
        width: 18px;
        height: 18px;
        object-fit: contain;
        opacity: 0.85;
    }

    .competition-name {
        font-family: 'Cinzel', serif;
        color: rgba(212,168,67,0.65);
        font-size: 0.6rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .match-detail {
        display: grid;
        grid-template-columns: 80px 1fr 40px;
        align-items: center;
        padding: 0.9rem 1rem;
        gap: 1rem;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .match-detail:hover {
        background: rgba(212,168,67,0.06);
    }

    .match-date-time {
        font-family: 'DM Sans', sans-serif;
        color: rgba(200,210,220,0.4);
        font-size: 0.78rem;
        font-weight: 500;
        text-align: center;
    }

    .match-teams-score {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
    }

    .team {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex: 1;
        min-width: 0;
    }

    .team-local {
        justify-content: flex-end;
        text-align: right;
    }

    .team-visitor {
        justify-content: flex-start;
        text-align: left;
    }

    .team-shield {
        width: 28px;
        height: 28px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .team-shield-placeholder {
        width: 28px;
        height: 28px;
        background: rgba(212,168,67,0.08);
        border-radius: 50%;
        flex-shrink: 0;
    }

    .team-name {
        font-family: 'DM Sans', sans-serif;
        color: rgba(200,210,220,0.88);
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .score-wrapper {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        justify-content: center;
        min-width: 60px;
    }

    .score {
        font-family: 'Cinzel', serif;
        color: #d4a843;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .vs {
        font-family: 'DM Sans', sans-serif;
        color: rgba(200,210,220,0.3);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .result-indicator {
        width: 30px;
        height: 30px;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 0.72rem;
        flex-shrink: 0;
        letter-spacing: 0.05em;
    }

    .result-indicator.win {
        background: rgba(74,222,128,0.15);
        color: rgba(74,222,128,0.9);
        border: 1px solid rgba(74,222,128,0.25);
    }

    .result-indicator.loss {
        background: rgba(248,113,113,0.12);
        color: rgba(248,113,113,0.85);
        border: 1px solid rgba(248,113,113,0.2);
    }

    .result-indicator.draw {
        background: rgba(212,168,67,0.1);
        color: rgba(212,168,67,0.8);
        border: 1px solid rgba(212,168,67,0.2);
    }

    .no-results-message {
        font-family: 'DM Sans', sans-serif;
        color: rgba(200,210,220,0.35);
        text-align: center;
        padding: 3rem 1rem;
        font-size: 0.9rem;
    }

    @media (max-width: 640px) {
        .match-detail {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto auto;
            gap: 0.5rem;
            padding: 0.75rem;
            text-align: center;
        }

        .match-date-time {
            font-size: 0.8rem;
            margin-bottom: 0.25rem;
        }

        .match-teams-score {
            width: 100%;
            justify-content: center;
        }

        .team-name {
            font-size: 0.9rem;
            white-space: normal;
            overflow: visible;
            text-overflow: clip;
            text-align: center;
        }

        .team-local,
        .team-visitor {
            justify-content: center;
            text-align: center;
        }

        .team-shield,
        .team-shield-placeholder {
            width: 24px;
            height: 24px;
        }

        .score {
            font-size: 1.1rem;
        }

        .result-indicator {
            margin: 0 auto;
            width: 28px;
            height: 28px;
            font-size: 0.75rem;
        }

        .result-indicator {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
        }

        .match-item {
            position: relative;
        }
    }
</style>



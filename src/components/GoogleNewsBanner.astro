---
const googleNewsUrl = "https://news.google.com/search?q=site%3Amadridfemeninoxtra.com&hl=es&gl=ES&ceid=ES%3Aes";
---

<aside
    id="mfx-google-news-banner"
    class="mfx-google-news-banner"
    data-version="google-news-v2"
    aria-label="Seguir Madrid Femenino Xtra en Google News"
>
    <div class="mfx-google-news-banner__brand" aria-hidden="true">
        <svg viewBox="0 0 48 48" role="img">
            <rect x="7" y="11" width="25" height="27" rx="3" fill="#4285F4" />
            <rect x="14" y="7" width="27" height="26" rx="3" fill="#34A853" />
            <rect x="10" y="15" width="31" height="24" rx="3" fill="#FBBC04" />
            <rect x="14" y="12" width="27" height="28" rx="3" fill="#FFFFFF" />
            <rect x="18" y="17" width="8" height="8" rx="1.5" fill="#EA4335" />
            <rect x="28" y="17" width="9" height="2.6" rx="1.3" fill="#4285F4" />
            <rect x="28" y="22" width="9" height="2.6" rx="1.3" fill="#4285F4" />
            <rect x="18" y="28" width="19" height="2.6" rx="1.3" fill="#5F6368" />
            <rect x="18" y="33" width="14" height="2.6" rx="1.3" fill="#5F6368" />
        </svg>
    </div>

    <div class="mfx-google-news-banner__copy">
        <span class="mfx-google-news-banner__eyebrow">MADRID FEMENINO XTRA EN GOOGLE NEWS</span>
        <strong class="mfx-google-news-banner__title">
            SÍGUENOS EN GOOGLE NEWS Y PULSA «GUARDAR» ⭐
        </strong>
    </div>

    <a
        class="mfx-google-news-banner__cta"
        href={googleNewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir Madrid Femenino Xtra en Google News"
    >
        ABRIR GOOGLE NEWS
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 16 16 8M10 8h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </a>
</aside>

<script is:inline>
    function placeGoogleNewsBanner() {
        const banner = document.getElementById("mfx-google-news-banner");
        const articleBody = document.querySelector(".news-article-rich-text");
        if (!banner || !articleBody) return;
        if (banner.nextElementSibling === articleBody) return;
        articleBody.parentNode?.insertBefore(banner, articleBody);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", placeGoogleNewsBanner, { once: true });
    } else {
        placeGoogleNewsBanner();
    }
    document.addEventListener("astro:page-load", placeGoogleNewsBanner);
</script>

<style>
    .mfx-google-news-banner {
        width: 100%;
        max-width: 800px;
        margin: 0 auto 2rem;
        padding: 0.95rem 1rem;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.9rem;
        border: 1px solid #e3e7ee;
        border-left: 4px solid #4285f4;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
        font-family: "DM Sans", sans-serif;
    }

    .mfx-google-news-banner__brand {
        width: 48px;
        height: 48px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
    }

    .mfx-google-news-banner__brand svg {
        width: 44px;
        height: 44px;
        display: block;
    }

    .mfx-google-news-banner__copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
        text-align: left;
    }

    .mfx-google-news-banner__eyebrow {
        color: #5f6368;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        line-height: 1.25;
    }

    .mfx-google-news-banner__title {
        color: #171717;
        font-family: "DM Sans", sans-serif;
        font-size: clamp(0.88rem, 0.82rem + 0.2vw, 1.02rem);
        font-weight: 800;
        line-height: 1.35;
        letter-spacing: -0.01em;
        overflow-wrap: anywhere;
    }

    .mfx-google-news-banner__cta {
        min-height: 42px;
        padding: 0.68rem 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        border: 1px solid #4285f4;
        border-radius: 6px;
        background: #4285f4;
        color: #ffffff;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.045em;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
    }

    .mfx-google-news-banner__cta svg {
        width: 15px;
        height: 15px;
        flex: 0 0 auto;
    }

    .mfx-google-news-banner__cta:hover {
        background: #3367d6;
        border-color: #3367d6;
        color: #ffffff;
        transform: translateY(-1px);
    }

    @media (max-width: 700px) {
        .mfx-google-news-banner {
            grid-template-columns: auto minmax(0, 1fr);
            gap: 0.75rem 0.85rem;
            padding: 0.9rem;
        }

        .mfx-google-news-banner__cta {
            grid-column: 1 / -1;
            width: 100%;
            box-sizing: border-box;
        }
    }

    @media (max-width: 430px) {
        .mfx-google-news-banner {
            grid-template-columns: 40px minmax(0, 1fr);
            gap: 0.7rem;
            padding: 0.82rem;
        }

        .mfx-google-news-banner__brand {
            width: 40px;
            height: 40px;
        }

        .mfx-google-news-banner__brand svg {
            width: 38px;
            height: 38px;
        }

        .mfx-google-news-banner__eyebrow {
            font-size: 0.58rem;
            letter-spacing: 0.07em;
        }

        .mfx-google-news-banner__title {
            font-size: 0.82rem;
        }
    }

    @media (prefers-color-scheme: dark) {
        .mfx-google-news-banner {
            border-color: rgba(255, 255, 255, 0.14);
            border-left-color: #4285f4;
            background: #ffffff;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mfx-google-news-banner__cta {
            transition: none;
        }
    }
</style>

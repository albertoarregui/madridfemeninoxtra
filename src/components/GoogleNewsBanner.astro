---
const googleNewsUrl = "https://news.google.com/search?q=site%3Amadridfemeninoxtra.com&hl=es&gl=ES&ceid=ES%3Aes";
---

<aside
    id="mfx-google-news-banner"
    class="mfx-google-news-banner"
    data-version="google-news-official-style"
    aria-label="Seguir Madrid Femenino Xtra en Google News"
>
    <div class="mfx-google-news-banner__brand" aria-hidden="true">
        <svg viewBox="0 0 48 48" role="img">
            <path d="M11 11.5 31.8 4.9a3 3 0 0 1 3.8 2l4.8 15.2-29.4 9.3z" fill="#34A853" />
            <path d="M7.3 17.2 32 10.7a3 3 0 0 1 3.7 2.1l5.4 20.5-29.5 7.8z" fill="#FBBC04" />
            <path d="m14.7 10.5 24.1 6.2a3 3 0 0 1 2.2 3.7l-5.4 20.9-29.8-7.7z" fill="#EA4335" />
            <rect x="8" y="15" width="32" height="27" rx="3.2" fill="#4285F4" />
            <rect x="13" y="20" width="11" height="8" rx="1.2" fill="#fff" />
            <rect x="27" y="20" width="8" height="2.5" rx="1.25" fill="#fff" />
            <rect x="27" y="25" width="8" height="2.5" rx="1.25" fill="#fff" />
            <rect x="13" y="31" width="22" height="2.5" rx="1.25" fill="#fff" />
            <rect x="13" y="36" width="17" height="2.5" rx="1.25" fill="#fff" />
        </svg>
    </div>

    <div class="mfx-google-news-banner__copy">
        <span class="mfx-google-news-banner__product">Google News</span>
        <span class="mfx-google-news-banner__text">Sigue a Madrid Femenino Xtra y guarda la fuente para no perderte ninguna noticia.</span>
    </div>

    <a
        class="mfx-google-news-banner__cta"
        href={googleNewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Seguir Madrid Femenino Xtra en Google News"
    >
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m12 3 2.78 5.63 6.22.9-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.92 1.06-6.2L3 9.53l6.22-.9L12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
        Seguir
    </a>
</aside>

<script is:inline>
    function placeGoogleNewsBanner() {
        const banner = document.getElementById("mfx-google-news-banner");
        const articleBody = document.querySelector(".news-article-rich-text");
        if (!banner || !articleBody) return;
        if (banner.nextElementSibling === articleBody) return;
        articleBody.parentNode?.insertBefore(banner, articleBody);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", placeGoogleNewsBanner, { once: true });
    } else {
        placeGoogleNewsBanner();
    }
    document.addEventListener("astro:page-load", placeGoogleNewsBanner);
</script>

<style>
    .mfx-google-news-banner {
        width: 100%;
        max-width: 800px;
        margin: 0 auto 2rem;
        padding: 14px 16px;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 14px;
        border: 1px solid #dadce0;
        border-radius: 12px;
        background: #fff;
        font-family: Arial, Helvetica, sans-serif;
    }

    .mfx-google-news-banner__brand {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
    }

    .mfx-google-news-banner__brand svg {
        width: 46px;
        height: 46px;
        display: block;
    }

    .mfx-google-news-banner__copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
        text-align: left;
    }

    .mfx-google-news-banner__product {
        color: #202124;
        font-size: 16px;
        font-weight: 500;
        line-height: 1.3;
    }

    .mfx-google-news-banner__text {
        color: #5f6368;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.4;
    }

    .mfx-google-news-banner__cta {
        min-height: 38px;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 1px solid #dadce0;
        border-radius: 19px;
        background: #fff;
        color: #1a73e8;
        font-size: 14px;
        font-weight: 500;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .mfx-google-news-banner__cta svg {
        width: 18px;
        height: 18px;
        flex: 0 0 auto;
    }

    .mfx-google-news-banner__cta:hover {
        background: #f8fafd;
        border-color: #c7d5ea;
        color: #174ea6;
    }

    .mfx-google-news-banner__cta:focus-visible {
        outline: 2px solid #1a73e8;
        outline-offset: 2px;
    }

    @media (max-width: 640px) {
        .mfx-google-news-banner {
            grid-template-columns: 42px minmax(0, 1fr);
            gap: 10px 12px;
            padding: 12px;
            border-radius: 10px;
        }

        .mfx-google-news-banner__brand {
            width: 42px;
            height: 42px;
        }

        .mfx-google-news-banner__brand svg {
            width: 40px;
            height: 40px;
        }

        .mfx-google-news-banner__cta {
            grid-column: 1 / -1;
            width: 100%;
            min-height: 42px;
            box-sizing: border-box;
            border-radius: 21px;
        }
    }

    @media (max-width: 420px) {
        .mfx-google-news-banner__product {
            font-size: 15px;
        }

        .mfx-google-news-banner__text {
            font-size: 12.5px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mfx-google-news-banner__cta {
            transition: none;
        }
    }
</style>

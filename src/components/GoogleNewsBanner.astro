---
const googleNewsUrl = "https://news.google.com/search?q=site%3Amadridfemeninoxtra.com&hl=es&gl=ES&ceid=ES%3Aes";
---

<aside
    id="mfx-google-news-banner"
    class="mfx-google-news-banner"
    data-version="mfx-google-g"
    aria-label="Seguir Madrid Femenino Xtra en Google News"
>
    <div class="mfx-google-news-banner__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" role="img">
            <circle cx="24" cy="24" r="14" fill="none" stroke="#4285F4" stroke-width="6" stroke-dasharray="35 53" stroke-dashoffset="0" transform="rotate(-45 24 24)" />
            <circle cx="24" cy="24" r="14" fill="none" stroke="#34A853" stroke-width="6" stroke-dasharray="18 70" stroke-dashoffset="-34" transform="rotate(-45 24 24)" />
            <circle cx="24" cy="24" r="14" fill="none" stroke="#FBBC05" stroke-width="6" stroke-dasharray="17 71" stroke-dashoffset="-52" transform="rotate(-45 24 24)" />
            <circle cx="24" cy="24" r="14" fill="none" stroke="#EA4335" stroke-width="6" stroke-dasharray="18 70" stroke-dashoffset="-69" transform="rotate(-45 24 24)" />
            <rect x="24" y="21" width="15" height="6" rx="1" fill="#4285F4" />
        </svg>
    </div>

    <div class="mfx-google-news-banner__copy">
        <span class="mfx-google-news-banner__label">GOOGLE NEWS</span>
        <strong class="mfx-google-news-banner__title">
            SÍGUENOS EN GOOGLE NEWS Y PULSA «GUARDAR» ⭐
        </strong>
    </div>

    <a
        class="mfx-google-news-banner__cta"
        href={googleNewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir Madrid Femenino Xtra en Google News"
    >
        SEGUIR
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </a>
</aside>

<script is:inline>
    function placeGoogleNewsBanner() {
        const banner = document.getElementById("mfx-google-news-banner");
        const articleBody = document.querySelector(".news-article-rich-text");
        if (!banner || !articleBody) return;
        if (banner.nextElementSibling === articleBody) return;
        articleBody.parentNode?.insertBefore(banner, articleBody);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", placeGoogleNewsBanner, { once: true });
    } else {
        placeGoogleNewsBanner();
    }
    document.addEventListener("astro:page-load", placeGoogleNewsBanner);
</script>

<style>
    .mfx-google-news-banner {
        width: 100%;
        max-width: 800px;
        margin: 0 auto 2.25rem;
        padding: 1rem 1.1rem;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
        border: 1px solid rgba(212, 168, 67, 0.28);
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(12, 25, 52, 0.98), rgba(6, 13, 28, 0.98));
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
        font-family: "DM Sans", sans-serif;
    }

    .mfx-google-news-banner__icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.16);
    }

    .mfx-google-news-banner__icon svg {
        width: 32px;
        height: 32px;
        display: block;
    }

    .mfx-google-news-banner__copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
        text-align: left;
    }

    .mfx-google-news-banner__label {
        color: rgba(212, 168, 67, 0.72);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        line-height: 1.2;
    }

    .mfx-google-news-banner__title {
        color: #f4f5f7;
        font-family: "Cinzel", serif;
        font-size: clamp(0.82rem, 0.72rem + 0.25vw, 1rem);
        line-height: 1.35;
        letter-spacing: 0.025em;
        overflow-wrap: anywhere;
    }

    .mfx-google-news-banner__cta {
        min-height: 44px;
        padding: 0.7rem 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        border-radius: 10px;
        background: #d4a843;
        color: #060d1c;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .mfx-google-news-banner__cta svg {
        width: 16px;
        height: 16px;
        flex: 0 0 auto;
    }

    .mfx-google-news-banner__cta:hover {
        background: #e2bb5a;
        color: #060d1c;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(212, 168, 67, 0.24);
    }

    @media (max-width: 700px) {
        .mfx-google-news-banner {
            grid-template-columns: auto minmax(0, 1fr);
            gap: 0.8rem 0.9rem;
            padding: 0.95rem;
            border-radius: 14px;
        }

        .mfx-google-news-banner__cta {
            grid-column: 1 / -1;
            width: 100%;
            box-sizing: border-box;
        }
    }

    @media (max-width: 420px) {
        .mfx-google-news-banner {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 0.7rem;
            padding: 0.9rem;
        }

        .mfx-google-news-banner__icon {
            width: 42px;
            height: 42px;
            margin: 0 auto;
        }

        .mfx-google-news-banner__icon svg {
            width: 29px;
            height: 29px;
        }

        .mfx-google-news-banner__copy {
            text-align: center;
        }

        .mfx-google-news-banner__title {
            font-size: 0.82rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mfx-google-news-banner__cta {
            transition: none;
        }
    }
</style>

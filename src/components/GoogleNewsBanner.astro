---
const googleNewsUrl = "https://news.google.com/search?q=site%3Amadridfemeninoxtra.com&hl=es&gl=ES&ceid=ES%3Aes";
const googleLogo = "data:image/png;base64,";
---

<aside
    id="mfx-google-news-banner"
    class="mfx-google-news-banner"
    data-version="mfx-google-logo-inline"
    aria-label="Seguir Madrid Femenino Xtra en Google News"
>
    <div class="mfx-google-news-banner__icon" aria-hidden="true">
        <img src={googleLogo} alt="" width="96" height="96" loading="eager" decoding="async" />
    </div>

    <div class="mfx-google-news-banner__copy">
        <span class="mfx-google-news-banner__label">GOOGLE NEWS</span>
        <strong class="mfx-google-news-banner__title">SÍGUENOS EN GOOGLE NEWS Y PULSA «GUARDAR» ⭐</strong>
    </div>

    <a
        class="mfx-google-news-banner__cta"
        href={googleNewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir Madrid Femenino Xtra en Google News"
    >
        <span>SEGUIR</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </a>
</aside>

<script is:inline>
    function placeGoogleNewsBanner() {
        const banner = document.getElementById("mfx-google-news-banner");
        const articleBody = document.querySelector(".news-article-rich-text");
        if (!banner || !articleBody) return;
        if (banner.nextElementSibling === articleBody) return;
        articleBody.parentNode?.insertBefore(banner, articleBody);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", placeGoogleNewsBanner, { once: true });
    } else {
        placeGoogleNewsBanner();
    }
    document.addEventListener("astro:page-load", placeGoogleNewsBanner);
</script>

<style>
    .mfx-google-news-banner {
        width: min(100%, 800px);
        margin: 0 auto 2.25rem;
        padding: 1rem 1.1rem;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
        min-width: 0;
        overflow: hidden;
        border: 1px solid rgba(212, 168, 67, 0.28);
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(12, 25, 52, 0.98), rgba(6, 13, 28, 0.98));
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
        font-family: "DM Sans", sans-serif;
    }

    .mfx-google-news-banner__icon {
        width: 58px;
        height: 58px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        overflow: visible;
    }

    .mfx-google-news-banner__icon img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: contain;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.22));
    }

    .mfx-google-news-banner__copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
        text-align: left;
    }

    .mfx-google-news-banner__label {
        color: rgba(212, 168, 67, 0.78);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        line-height: 1.2;
    }

    .mfx-google-news-banner__title {
        color: #f4f5f7;
        font-family: "Cinzel", serif;
        font-size: clamp(0.82rem, 0.72rem + 0.25vw, 1rem);
        line-height: 1.35;
        letter-spacing: 0.025em;
        overflow-wrap: anywhere;
    }

    .mfx-google-news-banner__cta {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: 44px;
        padding: 0.7rem 1rem;
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border: 1px solid #d4a843;
        border-radius: 10px;
        background: rgba(212, 168, 67, 0.05);
        color: #d4a843;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: inset 0 0 0 1px rgba(212, 168, 67, 0.05);
        transition: color 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease, transform 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .mfx-google-news-banner__cta::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background: linear-gradient(90deg, #c99734 0%, #d4a843 55%, #e0b95a 100%);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mfx-google-news-banner__cta > span,
    .mfx-google-news-banner__cta > svg {
        position: relative;
        z-index: 1;
    }

    .mfx-google-news-banner__cta svg {
        width: 16px;
        height: 16px;
        flex: 0 0 auto;
        transition: transform 0.28s ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .mfx-google-news-banner__cta:hover {
            color: #ffffff;
            border-color: #d4a843;
            box-shadow: 0 7px 20px rgba(212, 168, 67, 0.25);
            transform: translateY(-1px);
        }

        .mfx-google-news-banner__cta:hover::before {
            transform: scaleX(1);
        }

        .mfx-google-news-banner__cta:hover svg {
            transform: translate(2px, -2px);
        }
    }

    .mfx-google-news-banner__cta:focus-visible,
    .mfx-google-news-banner__cta:active {
        color: #ffffff;
        border-color: #d4a843;
        box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.2), 0 7px 20px rgba(212, 168, 67, 0.2);
        outline: none;
    }

    .mfx-google-news-banner__cta:focus-visible::before,
    .mfx-google-news-banner__cta:active::before {
        transform: scaleX(1);
    }

    @media (max-width: 700px) {
        .mfx-google-news-banner {
            grid-template-columns: auto minmax(0, 1fr);
            gap: 0.8rem 0.9rem;
            padding: 0.95rem;
            border-radius: 14px;
        }

        .mfx-google-news-banner__icon {
            width: 52px;
            height: 52px;
        }

        .mfx-google-news-banner__cta {
            grid-column: 1 / -1;
            width: 100%;
            min-height: 46px;
        }
    }

    @media (max-width: 420px) {
        .mfx-google-news-banner {
            grid-template-columns: 1fr;
            gap: 0.65rem;
            padding: 0.85rem;
            text-align: center;
        }

        .mfx-google-news-banner__icon {
            width: 48px;
            height: 48px;
            margin: 0 auto;
        }

        .mfx-google-news-banner__copy {
            text-align: center;
        }

        .mfx-google-news-banner__label {
            font-size: 0.62rem;
        }

        .mfx-google-news-banner__title {
            font-size: 0.78rem;
            line-height: 1.28;
        }

        .mfx-google-news-banner__cta {
            min-height: 46px;
            padding: 0.72rem 0.85rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mfx-google-news-banner__cta,
        .mfx-google-news-banner__cta::before,
        .mfx-google-news-banner__cta svg {
            transition: none;
        }
    }
</style>

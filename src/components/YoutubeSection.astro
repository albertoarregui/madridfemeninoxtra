---
// La lista UU es la playlist automática de subidas del canal. YouTube la
// mantiene actualizada y evita depender del antiguo feed RSS, que devuelve 404.
const UPLOADS_PLAYLIST_ID = "UUHcGAOmFVh9sH4FsVxE2rhQ";
const PLAYLIST_EMBED_URL =
    `https://www.youtube-nocookie.com/embed/videoseries?list=${UPLOADS_PLAYLIST_ID}`;
---

<section class="youtube-section-container">
    <h2 class="landing-title" data-title="ÚLTIMOS VÍDEOS">
        ÚLTIMOS VÍDEOS
    </h2>
    <p class="landing-subtitle">
        Partidos completos, declaraciones, ruedas de prensa, análisis y toda la
        actualidad del Real Madrid Femenino
    </p>

    <div class="youtube-content">
        <div class="playlist-frame">
            <iframe
                src={PLAYLIST_EMBED_URL}
                title="Últimos vídeos de Madrid Femenino Xtra"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
            ></iframe>
        </div>

        <a
            class="youtube-channel-link"
            href="https://www.youtube.com/@MadridFemXtra/videos"
            target="_blank"
            rel="noopener noreferrer"
        >
            VER TODOS LOS VÍDEOS EN YOUTUBE →
        </a>
    </div>
</section>

<style>
    .youtube-section-container {
        padding: 3.5rem 0 0;
        margin-top: 2.5rem;
        clip-path: inset(0 -9999px -9999px -9999px);
    }

    .landing-title::before {
        white-space: nowrap;
    }

    .youtube-content {
        width: 100%;
        margin-top: 2rem;
    }

    .playlist-frame {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 1px solid rgba(212, 168, 67, 0.3);
        border-radius: 10px;
        background: #000;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .playlist-frame iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .youtube-channel-link {
        display: block;
        width: fit-content;
        margin: 1.25rem auto 0;
        padding: 0.65rem 1.1rem;
        border: 1px solid rgba(212, 168, 67, 0.32);
        border-radius: 4px;
        color: #d4a843;
        font-family: "Cinzel", serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-align: center;
        text-decoration: none;
        transition:
            border-color 0.2s ease,
            background-color 0.2s ease,
            color 0.2s ease;
    }

    .youtube-channel-link:hover,
    .youtube-channel-link:focus-visible {
        border-color: #d4a843;
        background: rgba(212, 168, 67, 0.1);
        color: #f0d58f;
        outline: none;
    }

    @media (max-width: 768px) {
        .youtube-section-container {
            padding-top: 2.25rem;
            margin-top: 1.5rem;
        }

        .youtube-content {
            margin-top: 1.25rem;
        }

        .playlist-frame {
            border-radius: 6px;
        }

        .youtube-channel-link {
            width: 100%;
            font-size: 0.66rem;
        }
    }
</style>

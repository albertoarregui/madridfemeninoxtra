---
/**
 * Alineación sobre el campo (pestaña «Alineación» de la ficha de partido).
 * Las posiciones salen de la demarcación de cada jugadora: portera, defensa,
 * centro del campo, mediapunta y ataque. En escritorio el campo es horizontal
 * (ataque hacia la derecha); en móvil gira a vertical.
 */
interface Props {
  lineup: any[];
  subs: any[];
  coach?: { name: string; image?: string; flag?: string; country?: string; href?: string } | null;
  playerHref: (player: any) => string | null;
}
const { lineup, subs, coach, playerHref } = Astro.props;

type Role = "gk" | "def" | "dm" | "am" | "fw";
const roleOf = (pos: string): Role => {
  const p = (pos || "").toLowerCase();
  if (/porter/.test(p)) return "gk";
  if (/central|defensa|lateral|carriler/.test(p)) return "def";
  if (/mediapunta/.test(p)) return "am";
  if (/extremo|delanter|punta|atacante/.test(p)) return "fw";
  return "dm";
};
// Orden de arriba abajo dentro de cada línea (la banda izquierda queda arriba).
const sideRank = (pos: string): number => {
  const p = (pos || "").toLowerCase();
  if (/izquierd/.test(p)) return 0;
  if (/derech/.test(p)) return 2;
  return 1;
};

const starters = lineup.filter((p: any) => p);
const lines: Record<Role, any[]> = { gk: [], def: [], dm: [], am: [], fw: [] };
for (const player of starters) lines[roleOf(player.pos)].push(player);
for (const role of Object.keys(lines) as Role[]) {
  lines[role].sort((a, b) => sideRank(a.pos) - sideRank(b.pos));
}
// Extremos en las bandas y delanteras en el centro.
if (lines.fw.length >= 3) {
  const wings = lines.fw.filter((p) => /extremo/i.test(p.pos));
  const centre = lines.fw.filter((p) => !/extremo/i.test(p.pos));
  if (wings.length >= 2) lines.fw = [wings[0], ...centre, ...wings.slice(1)];
}
const hasAm = lines.am.length > 0;
const X: Record<Role, number> = { gk: 7, def: 25, dm: hasAm ? 44 : 49, am: 62, fw: hasAm ? 80 : 76 };

const placed = (Object.keys(lines) as Role[]).flatMap((role) =>
  lines[role].map((player, index, list) => ({
    player,
    x: X[role],
    y: ((index + 1) / (list.length + 1)) * 100,
  })),
);

const rating = (player: any): number | null => {
  const raw = player?.stats?.valoracion;
  const value = typeof raw === "string" ? Number(raw.replace(",", ".")) : Number(raw);
  return Number.isFinite(value) && value > 0 ? value : null;
};
const ratingTone = (value: number | null) =>
  value === null ? "" : value >= 8 ? "is-top" : value >= 7 ? "is-good" : value >= 6 ? "is-ok" : "is-low";
const surname = (name: string) => {
  const parts = String(name || "").trim().split(/\s+/);
  if (parts.length <= 1) return parts[0] || "";
  // Apellidos compuestos con partícula: «del Castillo», «de la Cuerda».
  const particle = parts.findIndex((w, i) => i > 0 && /^(de|del|la|van|von|da|dos)$/i.test(w));
  return particle > 0 ? parts.slice(particle).join(" ") : parts[parts.length - 1];
};
const hasPhoto = (url: string | undefined) => Boolean(url) && !String(url).includes("placeholder");
const count = (value: unknown) => Number(value) || 0;
---

<div class="mp-layout">
  <aside class="mp-side">
    {coach && (
      <div class="mp-coach mfx-framed"><span class="mfx-frame" aria-hidden="true"></span>
        {coach.image && <img class="mp-coach-photo" src={coach.image} alt="" width="56" height="56" loading="lazy" decoding="async" />}
        <div class="mp-coach-text">
          <small>Entrenador/a</small>
          {coach.href ? <a class="entity-link" href={coach.href}>{coach.name}</a> : <strong>{coach.name}</strong>}
          {coach.country && <span class="mp-coach-country">{coach.flag && <img src={coach.flag} alt="" width="18" height="12" />}{coach.country}</span>}
        </div>
      </div>
    )}

    <h3 class="mp-subs-title">Sustitutas <span>({subs.length})</span></h3>
    <div class="mp-subs mfx-framed"><span class="mfx-frame" aria-hidden="true"></span>
      {subs.length === 0 && <p class="mp-empty">Sin cambios registrados</p>}
      {subs.map((sub: any) => (
        <div
          class="mp-sub clickable-player-row"
          data-player={encodeURIComponent(JSON.stringify(sub.playerIn ?? {}))}
          role="button"
          tabindex="0"
        >
          <span class="mp-sub-photo">{hasPhoto(sub.playerIn?.imageUrl) && <img src={sub.playerIn.imageUrl} alt="" width="40" height="40" loading="lazy" decoding="async" data-proxy-fallback />}</span>
          <div class="mp-sub-text">
            <span class="mp-sub-name">
              <b>{sub.playerIn?.number ?? ""}</b>
              {playerHref(sub.playerIn) ? <a class="entity-link" href={playerHref(sub.playerIn)!} onclick="event.stopPropagation()">{sub.playerIn?.name}</a> : sub.playerIn?.name}
              {rating(sub.playerIn) !== null && <span class={`mp-rate ${ratingTone(rating(sub.playerIn))}`}>{rating(sub.playerIn)!.toFixed(1)}</span>}
            </span>
            <span class="mp-sub-meta">
              <span class="mp-in" aria-hidden="true">→</span>
              <strong>{sub.minute}'</strong>
              {sub.playerOut?.name && <span>Sale: {sub.playerOut.name}</span>}
            </span>
          </div>
        </div>
      ))}
    </div>
  </aside>

  <div class="mp-pitch mfx-framed" role="img" aria-label="Once inicial sobre el campo">
    <span class="mfx-frame" aria-hidden="true"></span>
    <svg class="mp-lines mp-lines-h" viewBox="0 0 105 68" preserveAspectRatio="none" aria-hidden="true">
      <rect x="1.5" y="1.5" width="102" height="65" />
      <line x1="52.5" y1="1.5" x2="52.5" y2="66.5" />
      <circle cx="52.5" cy="34" r="9.15" />
      <rect x="1.5" y="13.85" width="16.5" height="40.3" /><rect x="1.5" y="24.85" width="5.5" height="18.3" />
      <rect x="87" y="13.85" width="16.5" height="40.3" /><rect x="98" y="24.85" width="5.5" height="18.3" />
    </svg>
    <svg class="mp-lines mp-lines-v" viewBox="0 0 68 105" preserveAspectRatio="none" aria-hidden="true">
      <rect x="1.5" y="1.5" width="65" height="102" />
      <line x1="1.5" y1="52.5" x2="66.5" y2="52.5" />
      <circle cx="34" cy="52.5" r="9.15" />
      <rect x="13.85" y="1.5" width="40.3" height="16.5" /><rect x="24.85" y="1.5" width="18.3" height="5.5" />
      <rect x="13.85" y="87" width="40.3" height="16.5" /><rect x="24.85" y="98" width="18.3" height="5.5" />
    </svg>

    {placed.map(({ player, x, y }) => (
      <div
        class="mp-player clickable-player-row"
        style={`--x:${x};--y:${y.toFixed(2)}`}
        data-player={encodeURIComponent(JSON.stringify(player))}
        role="button"
        tabindex="0"
        aria-label={`${player.number} ${player.name}${rating(player) !== null ? `, nota ${rating(player)!.toFixed(1)}` : ""}`}
      >
        <span class="mp-photo">
          {hasPhoto(player.imageUrl) && <img src={player.imageUrl} alt="" width="64" height="64" loading="lazy" decoding="async" data-proxy-fallback />}
          {rating(player) !== null && <span class={`mp-rate ${ratingTone(rating(player))}`}>{rating(player)!.toFixed(1)}</span>}
          {player.substituted && <span class="mp-out" title="Sustituida">←</span>}
          <span class="mp-icons">
            {Array.from({ length: count(player.goals) }).map(() => <span class="mp-ico mp-ico-goal" title="Gol">⚽</span>)}
            {count(player.assists) > 0 && <span class="mp-ico mp-ico-assist" title="Asistencia">A{count(player.assists) > 1 ? count(player.assists) : ""}</span>}
            {(count(player.redCards) > 0 || count(player.doubleYellows) > 0) ? <span class="mp-card is-red" title="Expulsión" />
              : count(player.yellowCards) > 0 && <span class="mp-card is-yellow" title="Amarilla" />}
          </span>
        </span>
        <span class="mp-name"><b>{player.number}</b> {surname(player.name)}</span>
      </div>
    ))}
    {placed.length === 0 && <p class="mp-empty mp-empty-pitch">Alineación no disponible</p>}
  </div>
</div>

<style>
  .mp-layout { display: grid; grid-template-columns: minmax(250px, 300px) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  .mp-side { display: grid; gap: 1rem; }
  .mp-coach {
    display: flex; align-items: center; gap: 0.85rem; padding: 0.95rem 1rem; border: 1px solid transparent; border-radius: 14px;
    background: rgba(var(--l-card, 8, 16, 34), 0.85);
  }
  .mp-coach-photo { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: top; border: 1px solid rgba(212, 168, 67, 0.45); background: rgba(212, 168, 67, 0.08); }
  .mp-coach-text { display: grid; gap: 0.2rem; min-width: 0; }
  .mp-coach-text small { font: 700 0.6rem/1 'Cinzel', serif; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(var(--l-gold, 212, 168, 67)); }
  .mp-coach-text a, .mp-coach-text strong { font: 700 1.02rem/1.2 'Cinzel', serif; color: rgb(var(--l-ink, 240, 240, 240)); text-decoration: none; }
  .mp-coach-country { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; color: rgba(var(--l-ink, 200, 210, 220), 0.7); }
  .mp-subs-title { margin: 0.4rem 0 0; font: 700 1.05rem/1 'Cinzel', serif; color: rgb(var(--l-ink, 240, 240, 240)); letter-spacing: 0.04em; }
  .mp-subs-title span { font-size: 0.78rem; color: rgba(var(--l-ink, 200, 210, 220), 0.55); }
  .mp-subs { border: 1px solid transparent; border-radius: 14px; background: rgba(var(--l-card, 8, 16, 34), 0.85); overflow: hidden; }
  .mp-sub { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.9rem; border-bottom: 1px solid rgba(var(--l-hi, 255, 255, 255), 0.06); cursor: pointer; transition: background 0.15s; }
  .mp-sub:last-child { border-bottom: 0; }
  .mp-sub:hover, .mp-sub:focus-visible { background: rgba(212, 168, 67, 0.07); outline: none; }
  .mp-sub-photo { width: 40px; height: 40px; flex-shrink: 0; overflow: hidden; border-radius: 50%; border: 1px solid rgba(212, 168, 67, 0.4); background: rgba(212, 168, 67, 0.08); }
  .mp-sub-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .mp-sub-text { display: grid; gap: 0.25rem; min-width: 0; }
  .mp-sub-name { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; color: rgb(var(--l-ink, 240, 240, 240)); }
  .mp-sub-name b { color: rgba(var(--l-ink, 200, 210, 220), 0.6); font-weight: 600; }
  .mp-sub-name a { color: inherit; text-decoration: none; font-weight: 600; }
  .mp-sub-meta { display: flex; align-items: center; gap: 0.4rem; font-size: 0.76rem; color: rgba(var(--l-ink, 200, 210, 220), 0.65); }
  .mp-sub-meta strong { color: rgb(var(--l-green, 74, 222, 128)); }
  .mp-in { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #2fa66a; color: #fff; font-size: 0.72rem; font-weight: 800; }
  .mp-empty { margin: 0; padding: 1rem; color: rgba(var(--l-ink, 200, 210, 220), 0.6); font-size: 0.85rem; text-align: center; }

  .mp-pitch {
    position: relative; aspect-ratio: 105 / 68; border: 1px solid transparent; border-radius: 18px;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 9.5%, transparent 9.5% 19%),
      #2f6a46;
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.35);
  }
  .mp-lines { position: absolute; inset: 4% 3%; width: 94%; height: 92%; fill: none; stroke: rgba(255, 255, 255, 0.45); stroke-width: 0.35; vector-effect: non-scaling-stroke; }
  .mp-lines-v { display: none; }
  .mp-player {
    position: absolute; left: calc(3% + var(--x) * 0.94%); top: calc(4% + var(--y) * 0.92%); transform: translate(-50%, -50%);
    display: grid; justify-items: center; gap: 0.3rem; cursor: pointer; z-index: 2; width: 110px;
  }
  .mp-player:focus-visible { outline: none; }
  .mp-player:focus-visible .mp-photo, .mp-player:hover .mp-photo { border-color: #e3bf65; transform: scale(1.06); }
  .mp-photo {
    position: relative; width: 64px; height: 64px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.92); transition: transform 0.18s, border-color 0.18s; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
  }
  .mp-photo img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: top; }
  .mp-rate {
    display: inline-grid; place-items: center; min-width: 30px; height: 20px; padding: 0 0.3rem; border-radius: 5px;
    font: 800 0.72rem/1 'DM Sans', sans-serif; color: #fff; background: #6b7280;
  }
  .mp-photo .mp-rate { position: absolute; right: -10px; bottom: -4px; }
  .mp-rate.is-top { background: #2f8fb8; }
  .mp-rate.is-good { background: #2fa66a; }
  .mp-rate.is-ok { background: #d98b2b; }
  .mp-rate.is-low { background: #d0453b; }
  .mp-out {
    position: absolute; left: -8px; top: -6px; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
    background: #d0453b; color: #fff; font-size: 0.72rem; font-weight: 800; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }
  .mp-icons { position: absolute; right: -10px; top: -8px; display: flex; flex-direction: column; gap: 2px; align-items: center; }
  .mp-ico { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: #fff; font-size: 0.68rem; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35); }
  .mp-ico-assist { color: #14213d; font-weight: 800; font-size: 0.6rem; }
  .mp-card { width: 11px; height: 15px; border-radius: 2px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35); }
  .mp-card.is-yellow { background: #f4c430; }
  .mp-card.is-red { background: #d0453b; }
  .mp-name {
    max-width: 110px; font: 800 0.78rem/1.1 'DM Sans', sans-serif; color: #fff; text-transform: uppercase; text-align: center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .mp-name b { font-weight: 600; opacity: 0.8; }
  .mp-empty-pitch { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; }

  @media (max-width: 960px) {
    .mp-layout { grid-template-columns: 1fr; }
    .mp-pitch { order: -1; }
  }
  /* Móvil: campo vertical, portería propia abajo. */
  @media (max-width: 640px) {
    .mp-pitch { aspect-ratio: 68 / 105; }
    .mp-lines-h { display: none; }
    .mp-lines-v { display: block; inset: 3% 4%; width: 92%; height: 94%; }
    .mp-player { left: calc(4% + var(--y) * 0.92%); top: calc(97% - var(--x) * 0.94%); width: 76px; }
    .mp-photo { width: 46px; height: 46px; }
    .mp-photo .mp-rate { min-width: 26px; height: 17px; font-size: 0.64rem; right: -12px; }
    .mp-player { width: 70px; }
    .mp-name { max-width: 70px; font-size: 0.6rem; }
    .mp-name b { display: none; }
    .mp-ico { width: 16px; height: 16px; font-size: 0.56rem; }
  }
</style>

---
/**
 * Estadísticas de equipo (pestaña «Estadísticas»). Estructura por categorías
 * con píldoras y filas local / visitante; el mayor valor se resalta en dorado,
 * como en el comparador de jugadoras.
 */
interface Props { game: any; isLocalRM: boolean; localShield?: string; visitorShield?: string; }
const { game, isLocalRM, localShield, visitorShield } = Astro.props;

const num = (v: unknown): number | null => {
  if (v === null || v === undefined || v === "") return null;
  const n = Number(String(v).replace(",", "."));
  return Number.isFinite(n) ? n : null;
};
// Valor del Real Madrid y del rival, colocados como local / visitante.
type Pair = { rm: number | null; rival: number | null };
const side = (pair: Pair) => (isLocalRM ? [pair.rm, pair.rival] : [pair.rival, pair.rm]) as [number | null, number | null];
const pair = (rmKey: string, rivalKey: string): Pair => ({ rm: num(game[rmKey]), rival: num(game[rivalKey]) });
const ratio = (doneKey: string, totalKey: string, team: "rm" | "rival") => {
  const done = num(game[`${team}_${doneKey}`]); const total = num(game[`${team}_${totalKey}`]);
  return done === null || total === null ? null : { done, total };
};

type Row = { label: string; local: string; visitor: string; localValue: number; visitorValue: number; lowerIsBetter?: boolean };
const plain = (label: string, p: Pair, decimals = 0, lowerIsBetter = false): Row | null => {
  const [l, v] = side(p);
  if (l === null || v === null) return null;
  const fmt = (n: number) => n.toLocaleString("es-ES", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  return { label, local: fmt(l), visitor: fmt(v), localValue: l, visitorValue: v, lowerIsBetter };
};
const fraction = (label: string, doneKey: string, totalKey: string): Row | null => {
  const rm = ratio(doneKey, totalKey, "rm"); const rival = ratio(doneKey, totalKey, "rival");
  if (!rm || !rival) return null;
  const fmt = (r: { done: number; total: number }) => `${r.done}/${r.total} (${r.total ? Math.round((r.done / r.total) * 100) : 0}%)`;
  const [l, v] = isLocalRM ? [rm, rival] : [rival, rm];
  return { label, local: fmt(l), visitor: fmt(v), localValue: l.done, visitorValue: v.done };
};

const possession = side({ rm: num(game.posesion_rm), rival: num(game.posesion_rival) });
const xg = plain("Goles esperados (xG)", { rm: num(game.xg_a_favor), rival: num(game.xg_en_contra) }, 2);
const yellows = plain("Tarjetas amarillas", { rm: num(game.amarillas_rm), rival: num(game.amarillas_rival) }, 0, true);
const reds = plain("Tarjetas rojas", { rm: num(game.rojas_rm), rival: num(game.rojas_rival) }, 0, true);
// faltas_cometidas / faltas_recibidas son del Real Madrid: las recibidas son las del rival.
const fouls = plain("Faltas", { rm: num(game.faltas_cometidas), rival: num(game.faltas_recibidas) }, 0, true);

const groups = [
  { key: "top", label: "Destacadas", rows: [
    xg, plain("Tiros", pair("rm_tiros", "rival_tiros")), plain("Tiros a puerta", pair("rm_tiros_puerta", "rival_tiros_puerta")),
    plain("Grandes ocasiones", pair("rm_grandes_ocasiones", "rival_grandes_ocasiones")),
    fraction("Pases completados", "pases_completados", "pases_totales"),
    plain("Córners", pair("rm_corners", "rival_corners")),
    plain("Toques en el área rival", pair("rm_toques_area_rival", "rival_toques_area_rival")), yellows,
  ] },
  { key: "shots", label: "Tiros", rows: [
    plain("Tiros", pair("rm_tiros", "rival_tiros")), plain("Tiros a puerta", pair("rm_tiros_puerta", "rival_tiros_puerta")),
    plain("Tiros al palo", pair("rm_tiros_palo", "rival_tiros_palo")), plain("Grandes ocasiones", pair("rm_grandes_ocasiones", "rival_grandes_ocasiones")),
    plain("Tiros libres", pair("rm_tiros_libres", "rival_tiros_libres")), plain("Toques en el área rival", pair("rm_toques_area_rival", "rival_toques_area_rival")),
  ] },
  { key: "passes", label: "Pases", rows: [
    fraction("Pases completados", "pases_completados", "pases_totales"),
    fraction("Pases en largo", "pases_largo_completados", "pases_largo_totales"),
    fraction("Pases al último tercio", "pases_tercio_completados", "pases_tercio_totales"),
    fraction("Centros", "centros_completados", "centros_totales"),
    plain("Córners", pair("rm_corners", "rival_corners")),
  ] },
  { key: "duels", label: "Duelos", rows: [
    fraction("Duelos en el suelo", "duelos_suelo_ganados", "duelos_suelo_totales"),
    fraction("Duelos aéreos", "duelos_aereos_ganados", "duelos_aereos_totales"),
    plain("Regates", pair("rm_regates", "rival_regates")),
  ] },
  { key: "defense", label: "Defensa", rows: [
    fraction("Entradas ganadas", "entradas_ganadas", "entradas_totales"),
    plain("Intercepciones", pair("rm_intercepciones", "rival_intercepciones")),
    plain("Recuperaciones", pair("rm_recuperaciones", "rival_recuperaciones")),
    plain("Despejes", pair("rm_despejes", "rival_despejes")),
    plain("Paradas", pair("rm_paradas", "rival_paradas")),
  ] },
  { key: "discipline", label: "Disciplina", rows: [fouls, yellows, reds, plain("Fueras de juego", pair("rm_fueras_juego", "rival_fueras_juego"), 0, true)] },
  { key: "xg", label: "Goles esperados (xG)", rows: [
    xg, plain("Asistencias esperadas (xA)", pair("rm_asistencias_esperadas", "rival_asistencias_esperadas"), 2),
    plain("Grandes ocasiones", pair("rm_grandes_ocasiones", "rival_grandes_ocasiones")),
  ] },
].map((group) => ({ ...group, rows: group.rows.filter((row): row is Row => row !== null) }))
 .filter((group) => group.rows.length > 0);

const winner = (row: Row) => {
  if (row.localValue === row.visitorValue) return "none";
  const localBetter = row.lowerIsBetter ? row.localValue < row.visitorValue : row.localValue > row.visitorValue;
  return localBetter ? "local" : "visitor";
};
const hasPossession = possession[0] !== null && possession[1] !== null;
---

<div class="mts mfx-framed" data-team-stats><span class="mfx-frame" aria-hidden="true"></span>
  <header class="mts-head">
    <span class="mts-team">{localShield && <img src={localShield} alt="" width="26" height="26" />}{game.club_local}</span>
    <span class="mts-vs">VS</span>
    <span class="mts-team is-visitor">{game.club_visitante}{visitorShield && <img src={visitorShield} alt="" width="26" height="26" />}</span>
  </header>

  {groups.length === 0 && !hasPossession ? (
    <p class="mts-empty">Las estadísticas del partido todavía no están disponibles.</p>
  ) : (
    <>
      <div class="pt-pills mts-pills" role="tablist" aria-label="Categorías de estadísticas">
        {groups.map((group, index) => (
          <button type="button" role="tab" class:list={["pt-pill", { "is-active": index === 0 }]} aria-selected={index === 0 ? "true" : "false"} data-stats-tab={group.key}>
            {group.label} <span class="mts-count">{group.rows.length}</span>
          </button>
        ))}
      </div>

      {hasPossession && (
        <div class="mts-possession">
          <span class="mts-possession-label">Posesión</span>
          <div class="mts-bar" role="img" aria-label={`Posesión ${possession[0]}% - ${possession[1]}%`}>
            <span class={`mts-bar-side ${isLocalRM ? "is-rm" : "is-rival"}`} style={`width:${possession[0]}%`}>{possession[0]}%</span>
            <span class={`mts-bar-side ${isLocalRM ? "is-rival" : "is-rm"}`} style={`width:${possession[1]}%`}>{possession[1]}%</span>
          </div>
        </div>
      )}

      {groups.map((group, index) => (
        <div class="mts-group" role="tabpanel" data-stats-panel={group.key} hidden={index !== 0}>
          {group.rows.map((row) => (
            <div class="mts-row">
              <span class:list={["mts-value", { "is-best": winner(row) === "local" }]}>{row.local}</span>
              <span class="mts-label">{row.label}</span>
              <span class:list={["mts-value is-right", { "is-best": winner(row) === "visitor" }]}>{row.visitor}</span>
            </div>
          ))}
        </div>
      ))}
    </>
  )}
</div>

<script>
  function setupTeamStats() {
    document.querySelectorAll<HTMLElement>("[data-team-stats]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";
      const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-stats-tab]")];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-stats-panel]")];
      tabs.forEach((tab) => tab.addEventListener("click", () => {
        tabs.forEach((t) => { const on = t === tab; t.classList.toggle("is-active", on); t.setAttribute("aria-selected", String(on)); });
        panels.forEach((panel) => { panel.hidden = panel.dataset.statsPanel !== tab.dataset.statsTab; });
      }));
    });
  }
  setupTeamStats();
  document.addEventListener("astro:page-load", setupTeamStats);
</script>

<style>
  .mts { position: relative; padding: 1.4rem clamp(1rem, 3vw, 1.75rem) 1.6rem; border: 1px solid transparent; border-radius: 14px; background: rgba(var(--l-card, 8, 16, 34), 0.85); }
  .mts-head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-bottom: 1.1rem; }
  .mts-team { display: inline-flex; align-items: center; gap: 0.6rem; font: 700 1rem/1.2 'Cinzel', serif; color: rgb(var(--l-ink, 240, 240, 240)); }
  .mts-team.is-visitor { justify-content: flex-end; text-align: right; }
  .mts-team img { width: 26px; height: 26px; object-fit: contain; }
  .mts-vs { font: 700 0.75rem/1 'Cinzel', serif; letter-spacing: 0.14em; color: rgba(var(--l-ink, 200, 210, 220), 0.5); }
  .mts-pills { margin-bottom: 1.2rem; }
  .mts-count { margin-left: 0.15rem; font-weight: 600; opacity: 0.6; }
  .mts-empty { margin: 0; padding: 1rem; text-align: center; color: rgba(var(--l-ink, 200, 210, 220), 0.6); }

  .mts-possession { display: grid; gap: 0.6rem; margin-bottom: 1.1rem; padding: 1rem 1.1rem; border-radius: 12px; background: rgb(var(--l-field, 12, 22, 42)); }
  .mts-possession-label { text-align: center; font: 700 0.68rem/1 'Cinzel', serif; letter-spacing: 0.16em; text-transform: uppercase; color: rgb(var(--l-gold, 212, 168, 67)); }
  .mts-bar { display: flex; height: 34px; overflow: hidden; border-radius: 999px; background: rgba(var(--l-hi, 255, 255, 255), 0.06); }
  .mts-bar-side { display: flex; align-items: center; padding: 0 0.9rem; font: 800 0.85rem/1 'DM Sans', sans-serif; white-space: nowrap; }
  .mts-bar-side + .mts-bar-side { justify-content: flex-end; }
  .mts-bar-side.is-rm { background: linear-gradient(90deg, #c99a35, #e3bf65); color: #16120a; }
  .mts-bar-side.is-rival { background: rgba(var(--l-hi, 255, 255, 255), 0.12); color: rgb(var(--l-ink, 240, 240, 240)); }

  .mts-group { display: grid; }
  .mts-row {
    display: grid; grid-template-columns: minmax(90px, 1fr) minmax(0, 2fr) minmax(90px, 1fr); align-items: center; gap: 0.75rem;
    padding: 0.7rem 0.4rem; border-bottom: 1px solid rgba(var(--l-hi, 255, 255, 255), 0.06);
  }
  .mts-row:last-child { border-bottom: 0; }
  .mts-label { text-align: center; font: 500 0.88rem/1.3 'DM Sans', sans-serif; color: rgba(var(--l-ink, 200, 210, 220), 0.8); }
  .mts-value { justify-self: start; padding: 0.3rem 0.65rem; border-radius: 999px; font: 800 0.95rem/1 'DM Sans', sans-serif; color: rgb(var(--l-ink, 240, 240, 240)); }
  .mts-value.is-right { justify-self: end; }
  .mts-value.is-best { background: rgba(212, 168, 67, 0.18); color: rgb(var(--l-gold, 212, 168, 67)); box-shadow: inset 0 0 0 1px rgba(212, 168, 67, 0.45); }
  @media (max-width: 640px) {
    .mts-pills { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; border-radius: 999px; }
    .mts-pills::-webkit-scrollbar { display: none; }
    .mts-row { grid-template-columns: minmax(70px, 1fr) minmax(0, 1.4fr) minmax(70px, 1fr); gap: 0.4rem; }
    .mts-label { font-size: 0.76rem; }
    .mts-value { font-size: 0.82rem; padding: 0.25rem 0.5rem; }
    .mts-team { font-size: 0.82rem; }
  }
</style>

---
interface Props {
    introduction: string;
    utility: string;
    methodology: string;
}

const { introduction, utility, methodology } = Astro.props;
const cards = [
    { title: "Introducción", text: introduction },
    { title: "Utilidad", text: utility },
    { title: "Metodología", text: methodology },
];
---

<section class="editorial-info-grid" aria-label="Información sobre la herramienta">
    {cards.map((card) => (
        <article class="editorial-info-card">
            <h2>{card.title}</h2>
            <p>{card.text}</p>
        </article>
    ))}
</section>

<style>
    .editorial-info-grid {
        width: min(100%, 1100px);
        margin: 0 auto 2.5rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.9rem;
    }
    .editorial-info-card {
        position: relative;
        min-width: 0;
        padding: 1.25rem;
        border: 1px solid rgba(212, 168, 67, 0.2);
        border-radius: 4px;
        background: rgba(8, 16, 34, 0.85);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    }
    .editorial-info-card::before,
    .editorial-info-card::after {
        content: "";
        position: absolute;
        width: 12px;
        height: 12px;
        pointer-events: none;
    }
    .editorial-info-card::before {
        top: -1px;
        left: -1px;
        border-top: 1px solid #d4a843;
        border-left: 1px solid #d4a843;
    }
    .editorial-info-card::after {
        right: -1px;
        bottom: -1px;
        border-right: 1px solid #d4a843;
        border-bottom: 1px solid #d4a843;
    }
    h2 {
        margin: 0 0 0.65rem;
        color: #d4a843;
        font-family: "Cinzel", serif;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }
    p {
        margin: 0;
        color: rgba(220, 225, 232, 0.78);
        font-family: "DM Sans", sans-serif;
        font-size: 0.88rem;
        line-height: 1.7;
        text-wrap: pretty;
    }
    @media (max-width: 850px) {
        .editorial-info-grid { grid-template-columns: 1fr; }
        .editorial-info-card { padding: 1rem; }
    }
</style>

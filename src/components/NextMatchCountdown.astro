---
import { fetchCalendarFromDb } from "../utils/calendar";
import { fetchGamesDirectly } from "../utils/partidos";
import { slugify } from "../utils/partidos";
import { getMatchStatus } from "../utils/date-helper";
// @ts-ignore
import "@fontsource/bowlby-one-sc";

const allGames = await fetchGamesDirectly();
const calendarMatches = await fetchCalendarFromDb();
const now = new Date();
const matchDuration = 120 * 60 * 1000;

const liveMatch = allGames.find((game) => {
    if (!game.fecha || !game.hora) return false;
    const h = game.hora?.includes(":") ? (game.hora.split(":").length === 2 ? `${game.hora}:00` : game.hora) : "00:00:00";
    const matchDate = new Date(`${game.fecha}T${h}`);
    return now >= matchDate && now <= new Date(matchDate.getTime() + matchDuration);
});

const nextMatch = liveMatch ||
    (calendarMatches.length > 0
        ? calendarMatches.find((match) => {
              const h = match.hora?.includes(":") ? (match.hora.split(":").length === 2 ? `${match.hora}:00` : match.hora) : "00:00:00";
              return new Date(`${match.fecha}T${h}`) >= now;
          }) || calendarMatches[0]
        : null);

if (!nextMatch) return null;

const targetDate = nextMatch.fecha
    ? `${nextMatch.fecha}T${nextMatch.hora?.includes(":") ? (nextMatch.hora.split(":").length === 2 ? `${nextMatch.hora}:00` : nextMatch.hora) : "00:00:00"}`
    : "";
const matchTimeDisplay = nextMatch.hora?.replace(/[^0-9:]/g, "") || "00:00";

const dateObj = new Date(nextMatch.fecha);
const matchDateShort = `${String(dateObj.getDate()).padStart(2,"0")}/${String(dateObj.getMonth()+1).padStart(2,"0")}/${dateObj.getFullYear()}`;

const dateSlug = nextMatch.fecha.split(" ")[0];
const matchSlug = `${slugify(nextMatch.club_local)}-vs-${slugify(nextMatch.club_visitante)}-${dateSlug}`;

const matchStatus = getMatchStatus(nextMatch.fecha, nextMatch.hora, nextMatch.isPlayed);

let tiempoPartido: string | null = null;
if (matchStatus.status === 'in-progress' && liveMatch?.id_partido) {
    try {
        const { getPlayersDbClient } = await import('../db/client');
        const dbClient = await getPlayersDbClient();
        if (dbClient) {
            const r = await dbClient.execute({ sql: `SELECT tiempo_partido FROM partidos WHERE id_partido = ? LIMIT 1`, args: [liveMatch.id_partido] });
            tiempoPartido = (r.rows[0]?.tiempo_partido as string) ?? null;
        }
    } catch (_) { tiempoPartido = null; }
}

const localShort = nextMatch.club_local.replace("Femenino","").replace("Real Madrid","R. Madrid").trim();
const visitanteShort = nextMatch.club_visitante.replace("Femenino","").replace("Real Madrid","R. Madrid").trim();
---

<div class="cd-island" id="cd-island" data-target={targetDate} data-slug={matchSlug}>

    <div class="cd-header">
        <a class="cd-teams-row" href={`/partidos/${matchSlug}`}>
            <img src={nextMatch.local_foto_url}     alt={nextMatch.club_local}      class="cd-sh" />
            <div class="cd-names">
                <span class="cd-name">{localShort}</span>
                <span class="cd-vs">VS</span>
                <span class="cd-name">{visitanteShort}</span>
            </div>
            <img src={nextMatch.visitante_foto_url} alt={nextMatch.club_visitante}  class="cd-sh" />
        </a>
        <button class="cd-toggle" id="cd-toggle" aria-label="Minimizar" aria-expanded="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6"/>
            </svg>
        </button>
    </div>

    <div class="cd-body" id="cd-body">

        {matchStatus.status === 'in-progress' ? (
            <div class="cd-live-row">
                <span class="cd-live-badge">EN VIVO</span>
                <span class="cd-score">
                    {nextMatch.club_local?.toLowerCase().includes('real madrid') ? (nextMatch.goles_rm ?? 0) : (nextMatch.goles_rival ?? 0)}
                    &nbsp;–&nbsp;
                    {nextMatch.club_local?.toLowerCase().includes('real madrid') ? (nextMatch.goles_rival ?? 0) : (nextMatch.goles_rm ?? 0)}
                </span>
                <span class="cd-minute">
                    {tiempoPartido ?? `${Math.min(Math.floor((now.getTime() - new Date(targetDate).getTime()) / 60000), 90)}'`}
                </span>
            </div>
        ) : (
            <div class="cd-circles" id="cd-circles">
                <div class="cd-unit">
                    <div class="cd-ring">
                        <svg viewBox="0 0 100 100">
                            <circle class="cd-bg"   cx="50" cy="50" r="42"/>
                            <circle class="cd-prog" cx="50" cy="50" r="42" id="prog-d"/>
                        </svg>
                        <span class="cd-val" id="cd-d">00</span>
                    </div>
                    <span class="cd-lab">DÍAS</span>
                </div>
                <div class="cd-unit">
                    <div class="cd-ring">
                        <svg viewBox="0 0 100 100">
                            <circle class="cd-bg"   cx="50" cy="50" r="42"/>
                            <circle class="cd-prog" cx="50" cy="50" r="42" id="prog-h"/>
                        </svg>
                        <span class="cd-val" id="cd-h">00</span>
                    </div>
                    <span class="cd-lab">HORAS</span>
                </div>
                <div class="cd-unit">
                    <div class="cd-ring">
                        <svg viewBox="0 0 100 100">
                            <circle class="cd-bg"   cx="50" cy="50" r="42"/>
                            <circle class="cd-prog" cx="50" cy="50" r="42" id="prog-m"/>
                        </svg>
                        <span class="cd-val" id="cd-m">00</span>
                    </div>
                    <span class="cd-lab">MIN</span>
                </div>
                <div class="cd-unit">
                    <div class="cd-ring">
                        <svg viewBox="0 0 100 100">
                            <circle class="cd-bg"   cx="50" cy="50" r="42"/>
                            <circle class="cd-prog" cx="50" cy="50" r="42" id="prog-s"/>
                        </svg>
                        <span class="cd-val" id="cd-s">00</span>
                    </div>
                    <span class="cd-lab">SEG</span>
                </div>
            </div>
        )}

        <div class="cd-pills">
            <span class="cd-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {matchDateShort}
            </span>
            <span class="cd-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {matchTimeDisplay}
            </span>
            {nextMatch.estadio && (
                <span class="cd-pill cd-pill-stadium">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12a8 2 0 1 0 16 0a8 2 0 1 0 -16 0"/><path d="M4 12v7c0 .94 2.51 1.785 6 2v-3h4v3c3.435-.225 6-1.07 6-2v-7"/><path d="M15 6h4v-3h-4v7"/><path d="M7 6h4v-3h-4v7"/></svg>
                    {nextMatch.estadio}
                </span>
            )}
            {nextMatch.tv && (
                <span class="cd-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>
                    {nextMatch.tv}
                </span>
            )}
        </div>

    </div>
</div>

<style>
    .cd-island {
        position: fixed;
        bottom: 1.75rem;
        right: 1.75rem;
        width: 420px;
        background: rgba(6, 13, 28, 0.97);
        backdrop-filter: blur(24px) saturate(1.4);
        -webkit-backdrop-filter: blur(24px) saturate(1.4);
        border: 1px solid rgba(212, 168, 67, 0.22);
        border-radius: 16px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.6);
        z-index: 999990;
        overflow: hidden;
        transition: box-shadow 0.3s ease;
    }

    .cd-island:hover {
        box-shadow: 0 12px 48px rgba(0,0,0,0.7), 0 0 0 1px rgba(212,168,67,0.15);
    }

    .cd-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 0.85rem 0.7rem 1rem;
        border-bottom: 1px solid rgba(212,168,67,0.1);
    }

    .cd-teams-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex: 1;
        text-decoration: none;
        min-width: 0;
    }

    .cd-sh {
        width: 28px;
        height: 28px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .cd-names {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex: 1;
        min-width: 0;
        overflow: hidden;
    }

    .cd-name {
        font-family: 'Cinzel', serif;
        font-size: 0.65rem;
        font-weight: 700;
        color: #f0f0f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        text-align: center;
        transition: color 0.2s;
    }

    .cd-teams-row:hover .cd-name { color: #d4a843; }

    .cd-vs {
        font-family: 'Cinzel', serif;
        font-size: 0.55rem;
        font-weight: 700;
        color: rgba(212,168,67,0.7);
        flex-shrink: 0;
        letter-spacing: 0.05em;
    }

    .cd-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1px solid rgba(212,168,67,0.25);
        background: transparent;
        color: rgba(212,168,67,0.7);
        cursor: pointer;
        flex-shrink: 0;
        transition: background 0.2s, color 0.2s, transform 0.3s ease;
        padding: 0;
    }

    .cd-toggle:hover {
        background: rgba(212,168,67,0.12);
        color: #d4a843;
    }

    .cd-island.is-mini .cd-toggle {
        transform: rotate(180deg);
    }

    .cd-body {
        max-height: 200px;
        overflow: hidden;
        transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1), padding 0.35s ease;
        padding: 0.85rem 1rem 0.9rem;
    }

    .cd-island.is-mini .cd-body {
        max-height: 0;
        padding-top: 0;
        padding-bottom: 0;
    }

    .cd-circles {
        display: flex;
        justify-content: center;
        gap: 0.85rem;
        margin-bottom: 0.75rem;
    }

    .cd-unit {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
    }

    .cd-ring {
        position: relative;
        width: 52px;
        height: 52px;
    }

    .cd-ring svg {
        transform: rotate(-90deg);
        width: 100%;
        height: 100%;
    }

    .cd-bg   { fill: none; stroke: rgba(255,255,255,0.08); stroke-width: 6; }
    .cd-prog { fill: none; stroke: #d4a843; stroke-width: 6; stroke-linecap: round; transition: stroke-dashoffset 0.5s ease; }

    .cd-val {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%,-50%);
        font-family: 'Bowlby One SC', sans-serif;
        font-size: 1.1rem;
        color: #f0f0f0;
        line-height: 1;
    }

    .cd-lab {
        font-family: 'Cinzel', serif;
        font-size: 0.5rem;
        color: rgba(212,168,67,0.6);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .cd-live-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .cd-live-badge {
        font-family: 'Cinzel', serif;
        font-size: 0.6rem;
        font-weight: 700;
        background: #dc2626;
        color: #fff;
        padding: 0.2rem 0.5rem;
        border-radius: 3px;
        letter-spacing: 0.08em;
    }

    .cd-score {
        font-family: 'Bowlby One SC', sans-serif;
        font-size: 1.8rem;
        color: #f0f0f0;
        line-height: 1;
    }

    .cd-minute {
        font-family: 'Cinzel', serif;
        font-size: 0.7rem;
        color: rgba(212,168,67,0.8);
    }

    .cd-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        justify-content: center;
    }

    .cd-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 50px;
        padding: 0.2rem 0.6rem;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.68rem;
        color: rgba(220,220,220,0.8);
        white-space: nowrap;
    }

    .cd-pill svg { color: rgba(212,168,67,0.7); flex-shrink: 0; }

    .cd-pill-stadium {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @media (max-width: 480px) {
        .cd-island {
            right: 0.75rem;
            bottom: 0.75rem;
            width: calc(100vw - 1.5rem);
            max-width: 340px;
        }
    }
</style>

<script>
    function initCountdown() {
        const island    = document.getElementById('cd-island') as HTMLElement | null;
        const toggleBtn = document.getElementById('cd-toggle') as HTMLButtonElement | null;

        if (!island || island.dataset.cdInit) return;
        island.dataset.cdInit = 'true';

        if (localStorage.getItem('cd-mini') === '1') {
            island.classList.add('is-mini');
            if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        }

        toggleBtn?.addEventListener('click', () => {
            const isMini = island.classList.toggle('is-mini');
            toggleBtn.setAttribute('aria-expanded', String(!isMini));
            localStorage.setItem('cd-mini', isMini ? '1' : '0');
        });

        const targetStr = island.dataset.target || '';
        if (!targetStr) return;

        const R = 42;
        const C = 2 * Math.PI * R;

        function setCircle(id: string, val: number, max: number) {
            const numEl = document.getElementById(`cd-${id}`) as HTMLElement | null;
            const prog  = document.getElementById(`prog-${id}`) as SVGCircleElement | null;
            if (numEl) numEl.textContent = String(val).padStart(2, '0');
            if (prog) {
                prog.style.strokeDasharray  = `${C} ${C}`;
                prog.style.strokeDashoffset = String(C - (val / max) * C);
            }
        }

        function tick() {
            const fmt = new Intl.DateTimeFormat('en-US', {
                timeZone: 'Europe/Madrid',
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
            });
            const p: any = {};
            fmt.formatToParts(new Date()).forEach(x => { p[x.type] = x.value; });
            const nowMs = new Date(`${p.year}-${p.month}-${p.day}T${p.hour}:${p.minute}:${p.second}`).getTime();
            const diff  = new Date(targetStr).getTime() - nowMs;
            if (diff <= 0) return;

            setCircle('d', Math.floor(diff / 86400000),           30);
            setCircle('h', Math.floor(diff % 86400000 / 3600000), 24);
            setCircle('m', Math.floor(diff % 3600000  / 60000),   60);
            setCircle('s', Math.floor(diff % 60000    / 1000),    60);
        }

        tick();
        setInterval(tick, 1000);
    }

    document.addEventListener('astro:page-load', initCountdown);
</script>

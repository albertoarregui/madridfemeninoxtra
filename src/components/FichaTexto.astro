---
interface Props {
    html: string;
}
const { html } = Astro.props;
---

<div class="ficha-texto" set:html={html} />

<style>
    .ficha-texto {
        padding: clamp(0.75rem, 3vw, 1rem) clamp(0.9rem, 4vw, 1.25rem);
        line-height: 1.75;
        font-size: clamp(0.92rem, 2.6vw, 1.05rem);
        overflow-wrap: break-word;
        text-wrap: pretty;
        text-align: justify;
        box-sizing: border-box;
    }

    .ficha-texto :global(p) {
        margin: 0 0 1rem;
    }

    .ficha-texto :global(p:last-child) {
        margin-bottom: 0;
    }

    .ficha-texto :global(h2),
    .ficha-texto :global(h3),
    .ficha-texto :global(h4) {
        font-family: "Cinzel", serif;
        color: #d4a843;
        text-align: left;
        text-wrap: balance;
        font-size: clamp(1.1rem, 2.6vw, 1.3rem);
        margin: 1.6rem 0 0.7rem;
    }

    .ficha-texto :global(a) {
        color: #d4a843;
        text-decoration: none;
    }

    .ficha-texto :global(a:hover) {
        text-decoration: underline;
    }

    .ficha-texto :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1.1rem auto;
    }

    .ficha-texto :global(ul),
    .ficha-texto :global(ol) {
        margin: 0 0 1rem 1.4rem;
        text-align: left;
    }
</style>

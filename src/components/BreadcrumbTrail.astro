---
// Migas de pan solo como datos estructurados para buscadores: la ruta visible
// («Inicio / Hub / …») se retiró de las páginas.
import { breadcrumbSchema } from "../utils/seo";

type BreadcrumbItem = { label: string; href?: string };
interface Props { items: BreadcrumbItem[]; }
const { items } = Astro.props;
const schema = breadcrumbSchema(items.map((item, index) => ({
    name: item.label,
    path: item.href || (index === items.length - 1 ? Astro.url.pathname : "/"),
})));
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

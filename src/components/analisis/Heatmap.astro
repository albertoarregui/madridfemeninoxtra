---
// Mapa de calor acumulado de una jugadora (puntos 0-100 de Sofascore; ataca hacia la derecha).
interface Props { puntos: number[][]; }
const { puntos } = Astro.props;
const COLS = 21; const ROWS = 14;
const grid = Array.from({ length: ROWS }, () => new Array(COLS).fill(0));
for (const [x, y] of puntos) {
  const c = Math.min(COLS - 1, Math.max(0, Math.floor((x / 100) * COLS)));
  const r = Math.min(ROWS - 1, Math.max(0, Math.floor((y / 100) * ROWS)));
  grid[r][c]++;
}
const max = Math.max(1, ...grid.flat());
const cw = 105 / COLS; const rh = 68 / ROWS;
---

<figure class="hm">
  <svg viewBox="-2 -2 109 72" role="img" aria-label={`Mapa de calor con ${puntos.length} acciones`}>
    <rect class="hm-bg" x="0" y="0" width="105" height="68" rx="0.6" />
    {grid.flatMap((row, r) => row.map((v, c) => v > 0 && (
      <rect class="hm-cell" x={(c * cw).toFixed(2)} y={(r * rh).toFixed(2)} width={cw.toFixed(2)} height={rh.toFixed(2)} style={`opacity:${(0.12 + 0.88 * (v / max)).toFixed(2)}`} />
    )))}
    <g class="hm-lines">
      <rect x="0" y="0" width="105" height="68" rx="0.6" />
      <line x1="52.5" y1="0" x2="52.5" y2="68" />
      <circle cx="52.5" cy="34" r="9.15" />
      <rect x="0" y="13.84" width="16.5" height="40.32" /><rect x="88.5" y="13.84" width="16.5" height="40.32" />
    </g>
  </svg>
  <figcaption>{puntos.length} acciones registradas · ataca hacia la derecha · datos: Sofascore</figcaption>
</figure>

<style>
  .hm { margin: 0; display: grid; gap: 0.5rem; }
  .hm svg { width: 100%; height: auto; display: block; }
  .hm-bg { fill: rgb(var(--l-field, 12, 22, 42)); }
  .hm-cell { fill: rgb(var(--l-gold, 212, 168, 67)); }
  .hm-lines rect, .hm-lines line, .hm-lines circle { fill: none; stroke: rgba(var(--l-ink, 220, 225, 235), 0.35); stroke-width: 0.3; }
  .hm figcaption { font: 500 0.78rem/1.2 'DM Sans', sans-serif; color: rgba(var(--l-ink, 200, 210, 220), 0.65); }
</style>

---
// Pestaña "Análisis" de la ficha de partido: mapa de tiros, gráfico de dominio
// y posiciones medias del Madrid (datos de Sofascore).
import type { AnalisisPartido } from "../../utils/analisis";
import ShotMap from "./ShotMap.astro";
interface Props { data: AnalisisPartido; rivalName: string; playerHref?: (nombre: string) => string | null; }
const { data, rivalName, playerHref } = Astro.props;

// Gráfico de dominio
const W = 960; const H = 150; const MID = H / 2;
const maxMin = Math.max(90, ...data.dominio.map((d) => d.minuto));
const xOf = (m: number) => (m / (maxMin + 1)) * W;
const barW = Math.max(2, W / (maxMin + 2) - 2);
const yScale = (v: number) => (Math.max(-100, Math.min(100, v)) / 100) * (MID - 6);
const rmMinutes = data.dominio.filter((d) => d.valor > 0).length;
const pctRm = data.dominio.length ? Math.round((rmMinutes / data.dominio.length) * 100) : 0;

// Posiciones medias
const shortName = (nombre: string) => {
  const t = nombre.split(" ").filter(Boolean);
  if (t.length <= 1) return nombre;
  return t.some((x) => ["del", "de", "da"].includes(x.toLowerCase())) ? t[0] : t[t.length - 1];
};
const maxAcc = Math.max(1, ...data.posiciones.map((p) => p.acciones));
---

<div class="ma">
  {data.tiros.length > 0 && (
    <section class="ma-card">
      <h3 class="ma-title">Mapa de tiros</h3>
      <ShotMap tiros={data.tiros} rivalName={rivalName} />
    </section>
  )}

  {data.dominio.length > 0 && (
    <section class="ma-card">
      <h3 class="ma-title">Dominio del partido</h3>
      <p class="ma-sub">Presión ofensiva minuto a minuto. Hacia arriba, Real Madrid ({pctRm}% de los minutos); hacia abajo, {rivalName}.</p>
      <svg class="ma-dom" viewBox={`0 0 ${W} ${H + 18}`} role="img" aria-label={`Dominio: el Real Madrid dominó el ${pctRm}% de los minutos`}>
        <line class="ma-axis" x1="0" y1={MID} x2={W} y2={MID} />
        <line class="ma-half" x1={xOf(45.5)} y1="4" x2={xOf(45.5)} y2={H - 4} />
        {data.dominio.map((d) => {
          const h = yScale(d.valor);
          return <rect class={d.valor >= 0 ? "is-rm" : "is-rival"} x={(xOf(d.minuto) - barW / 2).toFixed(1)} y={(h >= 0 ? MID - h : MID).toFixed(1)} width={barW.toFixed(1)} height={Math.abs(h).toFixed(1)} rx="1"><title>{`Minuto ${d.minuto}: ${d.valor > 0 ? "Real Madrid" : rivalName} ${Math.abs(d.valor)}`}</title></rect>;
        })}
        {[0, 15, 30, 45, 60, 75, 90].map((m) => <text class="ma-tick" x={Math.max(xOf(m), 2)} y={H + 14} text-anchor={m === 0 ? "start" : "middle"}>{m}'</text>)}
      </svg>
    </section>
  )}

  {data.posiciones.length > 0 && (
    <section class="ma-card">
      <h3 class="ma-title">Posiciones medias del Real Madrid</h3>
      <p class="ma-sub">Dónde estuvo cada jugadora de media con balón. El tamaño indica cuántas acciones tuvo. El Madrid ataca hacia la derecha.</p>
      <svg class="ma-pos" viewBox="-2 -2 109 72" role="img" aria-label="Posiciones medias del Real Madrid">
        <g class="ma-pitch">
          <rect x="0" y="0" width="105" height="68" rx="0.6" />
          <line x1="52.5" y1="0" x2="52.5" y2="68" />
          <circle cx="52.5" cy="34" r="9.15" />
          <rect x="0" y="13.84" width="16.5" height="40.32" /><rect x="88.5" y="13.84" width="16.5" height="40.32" />
        </g>
        {data.posiciones.map((p) => {
          const cx = p.x * 1.05; const cy = p.y * 0.68; const rr = 1.2 + (p.acciones / maxAcc) * 1.3;
          const href = p.id_jugadora && playerHref ? playerHref(p.jugadora) : null;
          const g = (
            <g class="ma-dot">
              <circle cx={cx.toFixed(2)} cy={cy.toFixed(2)} r={rr.toFixed(2)} />
              <text x={cx.toFixed(2)} y={(cy + rr + 1.9).toFixed(2)} text-anchor="middle">{shortName(p.jugadora)}</text>
              <title>{`${p.jugadora}: ${p.acciones} acciones`}</title>
            </g>
          );
          return href ? <a href={href}>{g}</a> : g;
        })}
      </svg>
    </section>
  )}
  <p class="ma-source">Datos: Sofascore.</p>
</div>

<style>
  .ma { display: grid; gap: 1.25rem; }
  .ma-card { padding: 1.25rem clamp(0.9rem, 3vw, 1.6rem); border-radius: 14px; background: rgba(var(--l-card, 8, 16, 34), 0.85); display: grid; gap: 0.75rem; }
  .ma-title { margin: 0; font: 700 0.8rem/1 'Cinzel', serif; letter-spacing: 0.16em; text-transform: uppercase; color: rgb(var(--l-gold, 212, 168, 67)); }
  .ma-sub { margin: 0; font: 500 0.85rem/1.4 'DM Sans', sans-serif; color: rgba(var(--l-ink, 200, 210, 220), 0.75); }
  .ma-dom, .ma-pos { width: 100%; height: auto; display: block; }
  .ma-axis { stroke: rgba(var(--l-ink, 220, 225, 235), 0.35); stroke-width: 1; }
  .ma-half { stroke: rgba(var(--l-ink, 220, 225, 235), 0.25); stroke-dasharray: 4 4; }
  .ma-dom rect.is-rm { fill: rgb(var(--l-gold, 212, 168, 67)); }
  .ma-dom rect.is-rival { fill: rgba(var(--l-rival, 120, 170, 230), 0.75); }
  .ma-tick { font: 600 11px 'DM Sans', sans-serif; fill: rgba(var(--l-ink, 200, 210, 220), 0.6); }
  .ma-pitch rect, .ma-pitch circle, .ma-pitch line { fill: none; stroke: rgba(var(--l-ink, 220, 225, 235), 0.28); stroke-width: 0.3; }
  .ma-pitch > rect:first-child { fill: rgb(var(--l-field, 12, 22, 42)); }
  .ma-dot circle { fill: rgb(var(--l-gold, 212, 168, 67)); stroke: rgb(var(--l-ink, 255, 255, 255)); stroke-width: 0.35; }
  .ma-dot text { font: 700 1.7px 'DM Sans', sans-serif; fill: rgb(var(--l-ink, 240, 240, 240)); paint-order: stroke; stroke: rgb(var(--l-field, 12, 22, 42)); stroke-width: 0.5px; }
  .ma-pos a:hover circle { fill: rgb(var(--l-ink, 255, 255, 255)); }
  .ma-source { margin: 0; text-align: right; font: 500 0.75rem/1 'DM Sans', sans-serif; color: rgba(var(--l-ink, 200, 210, 220), 0.5); }
</style>

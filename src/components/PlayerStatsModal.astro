---

---

<dialog id="player-stats-modal" class="player-modal">
    <div class="player-modal-container">
        <div class="pm-header-bar">
            <span id="pm-header-title" class="pm-header-title">Estadísticas</span>
            <button id="close-player-modal" class="close-modal-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M18 6l-12 12"></path>
                    <path d="M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <div class="pm-scrollable-content">
            <div class="pm-hero">
                <div class="pm-photo-frame">
                    <img id="pm-img" src="" alt="Player image" />
                    <div class="pm-corner tl"></div>
                    <div class="pm-corner tr"></div>
                    <div class="pm-corner bl"></div>
                    <div class="pm-corner br"></div>
                </div>
                <div class="pm-identity">
                    <div class="pm-identity-top">
                        <img id="pm-flag" src="" alt="Flag" class="pm-flag" />
                        <span id="pm-pos" class="pm-pos-chip"></span>
                    </div>
                    <h3 id="pm-name" class="pm-name"></h3>
                    <div id="pm-rating-wrap" class="pm-rating-wrap">
                        <span class="pm-rating-label">VALORACIÓN</span>
                        <div id="pm-rating-val" class="pm-rating-badge"></div>
                    </div>
                </div>
            </div>
            <div class="pm-body">
                <div class="pm-stats-grid" id="pm-stats-grid"></div>
            </div>
            <div class="pm-footer">
                <p>Estadísticas proporcionadas por Sofascore y procesadas por el equipo de análisis de Madrid Femenino Xtra.</p>
            </div>
        </div>
    </div>
</dialog>
<script is:inline>
    document.addEventListener("astro:page-load", setupPlayerModals);
    document.addEventListener("DOMContentLoaded", setupPlayerModals);
    function setupPlayerModals() {
        const modal = document.getElementById("player-stats-modal");
        const clBtn = document.getElementById("close-player-modal");
        if (clBtn && modal) {
            clBtn.addEventListener("click", () => { modal.close(); });
            modal.addEventListener("click", (e) => { if (e.target === modal) modal.close(); });
        }
        const rows = document.querySelectorAll(".clickable-player-row");
        rows.forEach((row) => {
            row.addEventListener("click", (e) => {
                e.preventDefault();
                const playerStr = row.getAttribute("data-player");
                if (!playerStr) return;
                try {
                    const data = JSON.parse(decodeURIComponent(playerStr));
                    openPlayerModal(data);
                } catch (err) {
                    console.error("Error parsing player data:", err);
                }
            });
        });
    }
    function getRatingColor(val) {
        if (!val) return { bg: 'rgba(212,168,67,0.15)', text: '#d4a843' };
        if (val >= 8) return { bg: 'rgba(74,222,128,0.2)', text: 'rgba(74,222,128,0.95)' };
        if (val >= 6.5) return { bg: 'rgba(212,168,67,0.2)', text: '#d4a843' };
        return { bg: 'rgba(248,113,113,0.2)', text: 'rgba(248,113,113,0.9)' };
    }
    function openPlayerModal(player) {
        const modal = document.getElementById("player-stats-modal");
        if (!modal) return;
        const pmHeaderTitle = document.getElementById("pm-header-title");
        const pmImg = document.getElementById("pm-img");
        const pmFlag = document.getElementById("pm-flag");
        const pmName = document.getElementById("pm-name");
        const pmPos = document.getElementById("pm-pos");
        const pmRatingVal = document.getElementById("pm-rating-val");
        const pmRatingWrap = document.getElementById("pm-rating-wrap");
        const pmStatsGrid = document.getElementById("pm-stats-grid");
        if (pmHeaderTitle) pmHeaderTitle.textContent = player.name || "Estadísticas";
        pmImg.src = player.imageUrl || "/src/assets/jugadoras/placeholder.png";
        pmImg.alt = player.name || "Jugadora";
        if (player.flagUrl) { pmFlag.src = player.flagUrl; pmFlag.style.display = "inline-block"; }
        else { pmFlag.style.display = "none"; }
        pmName.textContent = player.name || "";
        pmPos.textContent = player.pos || "";
        const stats = player.stats || {};
        let rawVal = stats.valoracion;
        if (typeof rawVal === 'string') rawVal = rawVal.replace(',', '.');
        const rating = parseFloat(rawVal);
        if (rating && !isNaN(rating)) {
            pmRatingVal.textContent = rating.toFixed(1);
            const colors = getRatingColor(rating);
            pmRatingVal.style.background = colors.bg;
            pmRatingVal.style.color = colors.text;
            pmRatingVal.style.borderColor = colors.text.replace(')', ', 0.4)').replace('rgba', 'rgba').replace('rgb', 'rgba');
            if (pmRatingWrap) pmRatingWrap.style.display = "flex";
        } else {
            if (pmRatingWrap) pmRatingWrap.style.display = "none";
        }
        function formatStatRatio(comp, tot) {
            const numTot = tot || 0;
            if (numTot === 0) return null;
            const numComp = comp || 0;
            const pct = Math.round((numComp / numTot) * 100);
            return `${numComp}/${numTot} (${pct}%)`;
        }
        const metrics = [
            { label: "Goles", val: player.goals },
            { label: "Asistencias", val: player.assists },
            { label: "Pases Clave", val: stats.pases_clave },
            { label: "Tiros", val: stats.tiros_totales },
            { label: "Tiros a Puerta", val: stats.tiros_puerta },
            { label: "Toques", val: stats.toques },
            { label: "Toques Área Rival", val: stats.toques_area_rival },
            { label: "Pases Comp.", val: formatStatRatio(stats.pases_completados, stats.pases_totales) },
            { label: "Pases Últ. Tercio", val: formatStatRatio(stats.pases_ultimo_tercio_completados, stats.pases_ultimo_tercio_totales) },
            { label: "Pases en Largo", val: formatStatRatio(stats.pases_largo_completados, stats.pases_largo_totales) },
            { label: "Centros", val: formatStatRatio(stats.centros_completados, stats.centros_totales) },
            { label: "Fueras de Juego", val: stats.fueras_juego },
            { label: "Regates Comp.", val: formatStatRatio(stats.regates_completados, stats.regates_totales) },
            { label: "Pérdidas", val: stats.perdidas },
            { label: "Entradas", val: stats.entradas },
            { label: "Intercepciones", val: stats.intercepciones },
            { label: "Bloqueos", val: stats.bloqueos },
            { label: "Despejes", val: stats.despejes },
            { label: "Regateada", val: stats.regateada },
            { label: "Duelos Suelo", val: formatStatRatio(stats.duelos_suelo_ganados, stats.duelos_suelo_totales) },
            { label: "Duelos Aéreos", val: formatStatRatio(stats.duelos_aereos_ganados, stats.duelos_aereos_totales) },
            { label: "Faltas Recibidas", val: stats.faltas_recibidas },
            { label: "Faltas Cometidas", val: stats.faltas_cometidas },
        ];
        pmStatsGrid.innerHTML = "";
        metrics.forEach((m) => {
            const hasData = m.val !== undefined && m.val !== null && m.val !== "" && m.val !== "0/0" && m.val !== 0;
            const div = document.createElement("div");
            div.className = `pm-stat-row${!hasData ? " no-data" : ""}`;
            div.innerHTML =
                '<span class="pm-stat-label">' + m.label + '</span>' +
                '<span class="pm-stat-val">' + (hasData ? m.val : "—") + '</span>';
            pmStatsGrid.appendChild(div);
        });
        modal.showModal();
    }
</script>
<style is:global>
    .player-modal {
        border: 1px solid rgba(212,168,67,0.25);
        border-radius: 8px;
        background: rgba(6,13,28,0.98);
        color: rgba(200,210,220,0.85);
        padding: 0;
        max-width: 460px;
        width: 95%;
        box-shadow: 0 40px 80px rgba(0,0,0,0.7), 0 0 0 1px rgba(212,168,67,0.1);
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-height: 88vh;
        overflow: hidden;
    }
    .player-modal-container {
        display: flex;
        flex-direction: column;
        max-height: 88vh;
        width: 100%;
    }
    .pm-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1.25rem;
        background: rgba(212,168,67,0.06);
        border-bottom: 1px solid rgba(212,168,67,0.18);
        flex-shrink: 0;
    }
    .pm-header-title {
        font-family: 'Cinzel', serif;
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(212,168,67,0.8);
        font-weight: 600;
    }
    .close-modal-btn {
        background: transparent;
        border: none;
        color: rgba(200,210,220,0.5);
        cursor: pointer;
        display: flex;
        align-items: center;
        padding: 4px;
        border-radius: 4px;
        transition: color 0.2s;
    }
    .close-modal-btn:hover { color: #d4a843; }
    .pm-scrollable-content {
        overflow-y: auto;
        flex: 1;
        scrollbar-width: thin;
        scrollbar-color: rgba(212,168,67,0.3) transparent;
    }
    .pm-scrollable-content::-webkit-scrollbar { width: 5px; }
    .pm-scrollable-content::-webkit-scrollbar-track { background: transparent; }
    .pm-scrollable-content::-webkit-scrollbar-thumb { background: rgba(212,168,67,0.3); border-radius: 4px; }
    .player-modal::backdrop {
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(8px);
    }

    .pm-hero {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        padding: 1.5rem 1.5rem 1rem;
        border-bottom: 1px solid rgba(212,168,67,0.1);
    }
    .pm-photo-frame {
        position: relative;
        width: 110px;
        flex-shrink: 0;
        aspect-ratio: 3/4;
        border: 1px solid rgba(212,168,67,0.22);
        overflow: hidden;
        background: rgba(8,16,34,0.9);
    }
    .pm-photo-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
    }
    .pm-corner {
        position: absolute;
        width: 10px;
        height: 10px;
        pointer-events: none;
        z-index: 2;
    }
    .pm-corner.tl { top: -1px; left: -1px; border-top: 1.5px solid #d4a843; border-left: 1.5px solid #d4a843; }
    .pm-corner.tr { top: -1px; right: -1px; border-top: 1.5px solid #d4a843; border-right: 1.5px solid #d4a843; }
    .pm-corner.bl { bottom: -1px; left: -1px; border-bottom: 1.5px solid #d4a843; border-left: 1.5px solid #d4a843; }
    .pm-corner.br { bottom: -1px; right: -1px; border-bottom: 1.5px solid #d4a843; border-right: 1.5px solid #d4a843; }

    .pm-identity {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-top: 0.25rem;
    }
    .pm-identity-top {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .pm-flag {
        width: 22px;
        height: auto;
        border-radius: 2px;
        display: none;
    }
    .pm-pos-chip {
        font-family: 'Cinzel', serif;
        font-size: 0.52rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(212,168,67,0.7);
        background: rgba(212,168,67,0.08);
        border: 1px solid rgba(212,168,67,0.22);
        padding: 0.2rem 0.6rem;
        border-radius: 100px;
    }
    .pm-name {
        font-family: 'Cinzel', serif;
        font-size: clamp(1.1rem, 4vw, 1.6rem);
        font-weight: 700;
        color: #f0f0f0;
        line-height: 1.1;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }
    .pm-rating-wrap {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.25rem;
    }
    .pm-rating-label {
        font-family: 'Cinzel', serif;
        font-size: 0.52rem;
        letter-spacing: 0.18em;
        color: rgba(200,210,220,0.4);
        text-transform: uppercase;
    }
    .pm-rating-badge {
        font-family: 'Cinzel', serif;
        font-size: 1.4rem;
        font-weight: 700;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        border: 1px solid;
        line-height: 1;
    }

    .pm-body {
        padding: 0.75rem 1.25rem 0.5rem;
    }
    .pm-stats-grid {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .pm-stat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.55rem 0.75rem;
        border-radius: 3px;
        gap: 0.5rem;
        transition: background 0.15s;
    }
    .pm-stat-row:nth-child(even) { background: rgba(212,168,67,0.04); }
    .pm-stat-row:hover { background: rgba(212,168,67,0.09); }
    .pm-stat-row.no-data { opacity: 0.28; }
    .pm-stat-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        color: rgba(200,210,220,0.72);
        flex-shrink: 0;
    }
    .pm-stat-val {
        font-family: 'Cinzel', serif;
        font-size: 0.82rem;
        font-weight: 700;
        color: #d4a843;
        text-align: right;
    }

    .pm-footer {
        padding: 0.75rem 1.25rem 1rem;
        border-top: 1px solid rgba(212,168,67,0.07);
    }
    .pm-footer p {
        margin: 0;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.68rem;
        color: rgba(200,210,220,0.25);
        font-style: italic;
        line-height: 1.5;
        text-align: center;
    }

    @media (max-width: 480px) {
        .pm-hero { padding: 1.25rem 1rem 0.75rem; gap: 1rem; }
        .pm-photo-frame { width: 90px; }
        .pm-name { font-size: 1rem; }
    }
</style>

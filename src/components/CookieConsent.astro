---
interface Props {
    showAds?: boolean;
}

const { showAds = true } = Astro.props;
---

{
    showAds && (
        <script
            is:inline
            async
            crossorigin="anonymous"
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3753331336777901"
        ></script>
    )
}

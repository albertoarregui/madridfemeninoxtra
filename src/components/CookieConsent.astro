---
interface Props {
    showAds?: boolean;
}

const { showAds = true } = Astro.props;
---

{
    showAds && (
        <div id="cookie-banner" class="cookie-banner hidden">
            <div class="cookie-inner">
                <div class="cookie-text-block">
                    <span class="cookie-label">♦ Cookies</span>
                    <p class="cookie-text">
                        Utilizamos cookies propias y de terceros para mejorar tu experiencia
                        y mostrarte publicidad relacionada con tus preferencias.{" "}
                        <a href="/politica-cookies" class="cookie-link">Más información</a>
                    </p>
                </div>
                <div class="cookie-actions">
                    <button id="reject-cookies" class="btn-reject">Rechazar</button>
                    <button id="accept-cookies" class="btn-accept">Aceptar</button>
                </div>
            </div>
        </div>
    )
}

<script is:inline>
    function loadAdSense() {
        const script = document.createElement("script");
        script.src =
            "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3753331336777901";
        script.async = true;
        script.crossOrigin = "anonymous";
        document.head.appendChild(script);
    }

    document.addEventListener("DOMContentLoaded", () => {
        const banner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("accept-cookies");
        const rejectBtn = document.getElementById("reject-cookies");

        if (!banner) return;

        const cookieConsent = localStorage.getItem("cookie_consent");

        if (cookieConsent === "accepted") {
            loadAdSense();
        } else if (!cookieConsent) {
            banner.classList.remove("hidden");
        }

        acceptBtn?.addEventListener("click", () => {
            localStorage.setItem("cookie_consent", "accepted");
            banner.classList.add("hidden");
            loadAdSense();
        });

        rejectBtn?.addEventListener("click", () => {
            localStorage.setItem("cookie_consent", "rejected");
            banner.classList.add("hidden");
        });
    });
</script>

<style>
    .cookie-banner {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 999990;
        background: rgba(4, 9, 20, 0.97);
        border-top: 1px solid rgba(212, 168, 67, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 -4px 32px rgba(0, 0, 0, 0.6);
    }

    .cookie-banner.hidden {
        display: none;
    }

    .cookie-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }

    .cookie-text-block {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .cookie-label {
        font-family: 'Cinzel', serif;
        font-size: 0.58rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(212, 168, 67, 0.6);
    }

    .cookie-text {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        color: rgba(200, 210, 220, 0.65);
        margin: 0;
        line-height: 1.55;
        max-width: 680px;
    }

    .cookie-link {
        color: rgba(212, 168, 67, 0.75);
        text-decoration: none;
        border-bottom: 1px solid rgba(212, 168, 67, 0.3);
        transition: color 0.2s, border-color 0.2s;
    }

    .cookie-link:hover {
        color: #d4a843;
        border-color: #d4a843;
    }

    .cookie-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-shrink: 0;
    }

    .btn-accept,
    .btn-reject {
        font-family: 'Cinzel', serif;
        font-size: 0.6rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 0.6rem 1.4rem;
        border-radius: 2px;
        cursor: pointer;
        transition: all 0.25s ease;
        white-space: nowrap;
    }

    .btn-accept {
        background: #d4a843;
        color: #060d1c;
        border: 1px solid #d4a843;
        font-weight: 700;
    }

    .btn-accept:hover {
        background: #e0b94e;
        border-color: #e0b94e;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(212, 168, 67, 0.3);
    }

    .btn-reject {
        background: transparent;
        color: rgba(200, 210, 220, 0.5);
        border: 1px solid rgba(200, 210, 220, 0.2);
    }

    .btn-reject:hover {
        border-color: rgba(200, 210, 220, 0.45);
        color: rgba(200, 210, 220, 0.85);
        transform: translateY(-1px);
    }

    @media (max-width: 768px) {
        .cookie-inner {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
            padding: 1rem;
        }

        .cookie-actions {
            width: 100%;
            justify-content: stretch;
        }

        .btn-accept,
        .btn-reject {
            flex: 1;
            text-align: center;
            padding: 0.7rem 1rem;
        }
    }
</style>

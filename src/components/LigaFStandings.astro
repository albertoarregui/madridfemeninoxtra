---
/**
 * Clasificación editorial de Liga F Moeve 2026/27.
 *
 * Fuente: LaLiga, https://www.laliga.com/futbol-femenino/clasificacion
 * Captura de la jornada 6, contrastada el 11-10-2026.
 * No se presenta como datos en directo: actualizar tras la siguiente jornada.
 * Evita un iframe que devuelve 403 de Sofascore para parte de los visitantes.
 */
const teams = [
  { name: 'FC Barcelona', points: 18, played: 6, won: 6, draw: 0, lost: 0, gf: 22, ga: 2 },
  { name: 'Real Madrid CF', points: 13, played: 6, won: 4, draw: 1, lost: 1, gf: 13, ga: 7 },
  { name: 'Madrid CFF', points: 13, played: 6, won: 4, draw: 1, lost: 1, gf: 11, ga: 9 },
  { name: 'Athletic Club', points: 11, played: 6, won: 3, draw: 2, lost: 1, gf: 11, ga: 8 },
  { name: 'SD Eibar', points: 11, played: 6, won: 3, draw: 2, lost: 1, gf: 4, ga: 4 },
  { name: 'Atlético de Madrid', points: 9, played: 6, won: 3, draw: 0, lost: 3, gf: 10, ga: 11 },
  { name: 'RCD Espanyol', points: 8, played: 6, won: 2, draw: 2, lost: 2, gf: 9, ga: 6 },
  { name: 'FC Badalona Women', points: 8, played: 6, won: 2, draw: 2, lost: 2, gf: 9, ga: 8 },
  { name: 'Costa Adeje Tenerife', points: 8, played: 6, won: 2, draw: 2, lost: 2, gf: 6, ga: 11 },
  { name: 'Sevilla FC', points: 7, played: 6, won: 2, draw: 1, lost: 3, gf: 7, ga: 10 },
  { name: 'Granada CF', points: 7, played: 6, won: 2, draw: 1, lost: 3, gf: 5, ga: 9 },
  { name: 'Logroño United', points: 6, played: 6, won: 2, draw: 0, lost: 4, gf: 5, ga: 7 },
  { name: 'Deportivo Alavés', points: 6, played: 6, won: 2, draw: 0, lost: 4, gf: 3, ga: 9 },
  { name: 'Deportivo Abanca', points: 5, played: 6, won: 1, draw: 2, lost: 3, gf: 5, ga: 6 },
  { name: 'Real Sociedad', points: 2, played: 5, won: 0, draw: 2, lost: 3, gf: 6, ga: 11 },
  { name: 'VCF Femenino', points: 0, played: 5, won: 0, draw: 0, lost: 5, gf: 4, ga: 12 },
];
---
<div class="mfx-standings" aria-label="Clasificación de Liga F Moeve 2026/27, jornada 6">
  <div class="mfx-standings__heading">
    <span>LIGA F MOEVE · 2026/27</span>
    <span>JORNADA 6</span>
  </div>
  <div class="mfx-standings__scroll">
    <table>
      <caption class="sr-only">Clasificación Liga F Moeve 2026/27 tras la sexta jornada</caption>
      <thead>
        <tr>
          <th scope="col" class="mfx-rank">#</th>
          <th scope="col" class="mfx-team">EQUIPO</th>
          <th scope="col" title="Puntos">PTS</th>
          <th scope="col" title="Partidos jugados">PJ</th>
          <th scope="col" title="Victorias">V</th>
          <th scope="col" title="Empates">E</th>
          <th scope="col" title="Derrotas">D</th>
          <th scope="col" title="Diferencia de goles" class="mfx-diff">DG</th>
        </tr>
      </thead>
      <tbody>
        {teams.map((team, index) => (
          <tr class:list={[{ 'mfx-madrid': team.name === 'Real Madrid CF' }]}>
            <td class="mfx-rank">{index + 1}</td>
            <th scope="row" class="mfx-team" title={team.name}>{team.name}</th>
            <td class="mfx-points">{team.points}</td>
            <td>{team.played}</td>
            <td>{team.won}</td>
            <td>{team.draw}</td>
            <td>{team.lost}</td>
            <td class="mfx-diff">{team.gf - team.ga > 0 ? '+' : ''}{team.gf - team.ga}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mfx-standings__source">Datos oficiales de LaLiga · Jornada 6 · Revisión: 11/10/2026</p>
</div>

<style>
  .mfx-standings {
    overflow: hidden;
    width: 100%;
    border-radius: 10px;
    border: 1px solid rgba(212,168,67,.28);
    background: rgba(6,13,28,.86);
    box-shadow: 0 4px 16px rgba(0,0,0,.3);
    font-family: 'DM Sans', Arial, sans-serif;
    color: #e9edf4;
  }
  .mfx-standings__heading {
    display: flex;
    justify-content: space-between;
    gap: .5rem;
    align-items: center;
    padding: .85rem .7rem;
    font: 700 .64rem 'DM Sans', Arial, sans-serif;
    color: #d4a843;
    letter-spacing: .055em;
    background: rgba(212,168,67,.09);
    border-bottom: 1px solid rgba(212,168,67,.2);
  }
  .mfx-standings__scroll { overflow-x: auto; scrollbar-width: thin; }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 280px;
    table-layout: fixed;
    font-size: .65rem;
    font-variant-numeric: tabular-nums;
  }
  th, td {
    padding: .7rem .08rem;
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,.075);
    white-space: nowrap;
  }
  thead th {
    padding: .7rem .08rem;
    font-size: .57rem;
    color: #9eaabc;
    font-weight: 700;
  }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  .mfx-rank { width: 24px; color: #b3bdca; }
  .mfx-team {
    width: auto;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: .22rem;
  }
  tbody .mfx-team { font-weight: 600; }
  th:not(.mfx-team):not(.mfx-rank), td:not(.mfx-rank) { width: 24px; }
  .mfx-diff { display: none; }
  .mfx-points { color: #f6d681; font-weight: 800; }
  .mfx-madrid { background: rgba(212,168,67,.17); }
  .mfx-madrid .mfx-team { color: #ffda75; }
  .mfx-madrid .mfx-rank { color: #ffda75; font-weight: 800; }
  .mfx-standings__source {
    padding: .65rem .7rem;
    color: rgba(233,237,244,.62);
    font-size: .61rem;
    line-height: 1.4;
    border-top: 1px solid rgba(255,255,255,.08);
    margin: 0;
  }
  @media (min-width: 440px) {
    th:not(.mfx-team):not(.mfx-rank), td:not(.mfx-rank) { width: 30px; }
    .mfx-diff { display: table-cell; }
    table { font-size: .72rem; }
  }
</style>

---
/**
 * Widgets oficiales facilitados por el editor. El contenido de cada iframe
 * conserva el formato nativo de Sofascore y se actualiza en su plataforma.
 * No se almacena ni se replica ninguna clasificación en Turso.
 *
 * Nota: el contenido de terceros puede no estar disponible si Sofascore
 * bloquea su acceso en el navegador del visitante.
 */
const clasificaciones = [
  {
    id: "sofa-standings-embed-3739-97379",
    title: "LIGA F MOEVE",
    description: "Clasificación Liga F 2026/27",
    src: "https://widgets.sofascore.com/es-ES/embed/tournament/3739/season/97379/standings/Primera%20Division%2C%20Women%2026%2F27?widgetTitle=Primera%20Division%2C%20Women%2026%2F27&showCompetitionLogo=true",
    url: "https://www.sofascore.com/es/football/tournament/spain/liga-f/1127#id:97379",
    height: 963,
  },
  {
    id: "sofa-standings-embed-198786-96633",
    title: "UEFA WOMEN'S CHAMPIONS LEAGUE",
    description: "Clasificación UEFA Women's Champions League 2026/27",
    src: "https://widgets.sofascore.com/es-ES/embed/tournament/198786/season/96633/standings/UEFA%20Champions%20League%2C%20Women%2026%2F27?widgetTitle=UEFA%20Champions%20League%2C%20Women%2026%2F27&showCompetitionLogo=true",
    url: "https://www.sofascore.com/es/football/tournament/europe/uefa-champions-league-women/696#id:96633",
    height: 991,
  },
];
---
<div class="mfx-standings-stack">
  {clasificaciones.map((competicion) => (
    <section class="mfx-standings-card" aria-label={competicion.description}>
      <header class="mfx-standings-head">
        <span class="mfx-standings-mark" aria-hidden="true">✦</span>
        <div class="mfx-standings-head-copy">
          <h3>{competicion.title}</h3>
          <span>TEMPORADA 2026/27</span>
        </div>
      </header>
      <div class="mfx-sofascore-frame">
        <iframe
          id={competicion.id}
          title={competicion.description}
          src={competicion.src}
          height={competicion.height}
          width="100%"
          loading="lazy"
          scrolling="no"
          frameborder="0"
          style={`height:${competicion.height}px!important;max-width:768px!important;width:100%!important;`}
        ></iframe>
      </div>
      <div class="mfx-sofascore-source">
        Clasificación ofrecida por <a href={competicion.url} target="_blank" rel="noopener noreferrer">Sofascore</a>
      </div>
    </section>
  ))}
</div>

<style>
  .mfx-standings-stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    min-width: 0;
  }
  .mfx-standings-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(212,168,67,.27);
    border-radius: 10px;
    background: #0b1424;
    box-shadow: 0 12px 28px rgba(0,0,0,.23);
  }
  .mfx-standings-head {
    display: flex;
    gap: 9px;
    align-items: center;
    padding: 13px 12px;
    background: linear-gradient(100deg, rgba(212,168,67,.13), rgba(212,168,67,.025));
    border-bottom: 1px solid rgba(212,168,67,.22);
  }
  .mfx-standings-mark {
    color: #d4a843;
    font-size: 1.15rem;
  }
  .mfx-standings-head-copy {
    min-width: 0;
  }
  .mfx-standings-head-copy h3 {
    margin: 0;
    font: 700 .74rem/1.55 'Cinzel',serif;
    letter-spacing: .05em;
    color: #e7c77d;
  }
  .mfx-standings-head-copy span {
    color: #a7b4c5;
    font: 600 .61rem/1.5 'DM Sans',sans-serif;
    letter-spacing: .07em;
  }
  .mfx-sofascore-frame {
    width: 100%;
    max-width: 768px;
    margin: 0 auto;
    min-width: 0;
    overflow: hidden;
  }
  .mfx-sofascore-frame iframe {
    display: block;
    width: 100%;
    border: 0;
    background: #fff;
  }
  .mfx-sofascore-source {
    border-top: 1px solid rgba(212,168,67,.13);
    padding: 12px;
    color: #aebbcf;
    font: 400 .72rem/1.5 'DM Sans',sans-serif;
  }
  .mfx-sofascore-source a {
    color: #e5c279;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mfx-sofascore-source a:hover { color: #ffe2a3; }
  @media(max-width:480px) {
    .mfx-standings-head { padding: 11px 10px; }
    .mfx-standings-head-copy h3 { font-size: .68rem; }
    .mfx-sofascore-source { padding: 10px; }
  }
</style>

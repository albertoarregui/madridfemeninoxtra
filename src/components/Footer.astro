---
import X from "../assets/redes/x.svg";
import Instagram from "../assets/redes/instagram.svg";
import TikTok from "../assets/redes/tiktok.svg";
---

<footer class="footer-container">
    <div class="footer-divider" aria-hidden="true"></div>

    <div class="footer-social-row">
        <a
            href="https://x.com/madridfemxtra"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-item footer-social-x"
            aria-label="X (Twitter)"
        >
            <span class="social-icon-wrap"><X /></span>
            <span class="social-handle">/madridfemxtra</span>
        </a>

        <div class="footer-social-sep" aria-hidden="true"></div>

        <a
            href="https://instagram.com/madridfemxtra"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-item footer-social-ig"
            aria-label="Instagram"
        >
            <span class="social-icon-wrap"><Instagram /></span>
            <span class="social-handle">/madridfemxtra</span>
        </a>

        <div class="footer-social-sep" aria-hidden="true"></div>

        <a
            href="https://tiktok.com/@madridfemeninoxtra"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-item footer-social-tt"
            aria-label="TikTok"
        >
            <span class="social-icon-wrap"><TikTok /></span>
            <span class="social-handle">/madridfemeninoxtra</span>
        </a>
    </div>

    <div class="footer-legal-row">
        <a href="/aviso-legal">Aviso Legal</a>
        <span class="footer-dot" aria-hidden="true">·</span>
        <a href="/terminos-condiciones">Términos y condiciones</a>
        <span class="footer-dot" aria-hidden="true">·</span>
        <a href="/politica-privacidad">Política de privacidad</a>
        <span class="footer-dot" aria-hidden="true">·</span>
        <a href="/politica-cookies">Política de cookies</a>
    </div>

    <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Madrid Femenino Xtra. Todos los derechos reservados.</p>
    </div>
</footer>

<style>
    .footer-container {
        width: 100%;
        background: transparent;
        color: #c8c8c8;
        padding: 0 0 2rem;
        position: relative;
    }

    .footer-divider {
        width: 320px;
        max-width: 60%;
        height: 1px;
        margin: 0 auto 3.5rem;
        background: linear-gradient(
            to right,
            transparent,
            rgba(212, 168, 67, 0.6) 30%,
            rgba(212, 168, 67, 0.6) 70%,
            transparent
        );
    }

    .footer-social-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .footer-social-sep {
        width: 1px;
        height: 28px;
        background: rgba(212, 168, 67, 0.18);
        flex-shrink: 0;
    }

    .footer-social-item {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: rgba(200, 205, 215, 0.55);
        font-family: 'Cinzel', serif;
        font-size: 0.78rem;
        letter-spacing: 0.07em;
        position: relative;
        padding: 0.55rem 1rem;
        border-radius: 10px;
        transition: color 0.35s ease;
        isolation: isolate;
    }

    .footer-social-item::before {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 14px;
        opacity: 0;
        filter: blur(14px);
        transition: opacity 0.4s ease;
        z-index: -1;
        pointer-events: none;
    }

    .social-icon-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        flex-shrink: 0;
    }

    .social-icon-wrap svg {
        width: 20px;
        height: 20px;
        transition: color 0.35s ease;
    }

    .social-handle {
        transition: color 0.35s ease;
    }

    .footer-social-x::before  { background: #1a3d7c; }
    .footer-social-x:hover    { color: #5b8dd9; }
    .footer-social-x:hover::before { opacity: 0.55; }

    .footer-social-ig::before { background: #f97316; }
    .footer-social-ig:hover   { color: #fb923c; }
    .footer-social-ig:hover::before { opacity: 0.5; }

    .footer-social-tt::before { background: #06b6d4; }
    .footer-social-tt:hover   { color: #22d3ee; }
    .footer-social-tt:hover::before { opacity: 0.5; }

    .footer-legal-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
    }

    .footer-legal-row a {
        color: rgba(180, 185, 200, 0.45);
        text-decoration: none;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        transition: color 0.25s ease;
    }

    .footer-legal-row a:hover {
        color: rgba(212, 168, 67, 0.75);
    }

    .footer-dot {
        color: rgba(212, 168, 67, 0.2);
        font-size: 0.8rem;
        line-height: 1;
    }

    .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.04);
        padding-top: 1.5rem;
        text-align: center;
        font-size: 0.75rem;
        color: rgba(150, 155, 165, 0.5);
        font-family: 'DM Sans', sans-serif;
    }

    .footer-bottom p {
        margin: 0;
        letter-spacing: 0.03em;
    }

    @media (max-width: 600px) {
        .footer-social-row {
            gap: 1.25rem;
        }

        .footer-social-sep {
            display: none;
        }

        .footer-social-item {
            font-size: 0.72rem;
            padding: 0.4rem 0.75rem;
        }

        .footer-legal-row {
            gap: 0.4rem;
            padding: 0 1rem;
        }

        .footer-legal-row a {
            font-size: 0.68rem;
        }
    }
</style>

<div class="buscador-contenedor">
    <div class="buscador-inner" id="searchContainer">
        <form action="/search" method="get" class="buscador-form" id="searchForm" autocomplete="off">
            <input
                type="search"
                name="q"
                id="searchInput"
                placeholder="Buscar partidos, jugadoras, entrenadores, rivales..."
                aria-label="Campo de búsqueda"
                class="buscador-input"
                autocomplete="off"
            />
            <button type="submit" class="buscador-boton" aria-label="Buscar">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                    <path d="M21 21l-6 -6"></path>
                </svg>
            </button>
        </form>
        <div id="searchDropdown" class="srch-dropdown" hidden></div>
    </div>
</div>

<style>
    .buscador-contenedor {
        display: flex;
        justify-content: center;
        padding: 1rem 0;
    }

    .buscador-inner {
        position: relative;
        width: 100%;
        max-width: 600px;
    }

    .buscador-form {
        display: flex;
        width: 100%;
        border: 2px solid #ccc;
        border-radius: 25px;
        overflow: hidden;
        transition: border-color 0.3s ease;
    }

    .buscador-form:hover,
    .buscador-form:focus-within {
        border-color: #ffde59;
    }

    .buscador-input {
        flex-grow: 1;
        color: #ffffff;
        padding: 0.75rem 1.5rem;
        border: none;
        outline: none;
        font-size: 1rem;
        background: transparent;
    }

    .buscador-input::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .buscador-boton {
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        padding: 0.75rem 1.25rem;
        border: none;
        cursor: pointer;
        background: transparent;
        transition: color 0.3s ease;
        flex-shrink: 0;
    }

    .buscador-boton:hover {
        color: #ffde59;
    }

    @media (max-width: 600px) {
        .buscador-inner  { max-width: 100%; }
        .buscador-form   { border-radius: 20px; }
        .buscador-input  { padding: 0.6rem 1rem; font-size: 0.9rem; }
        .buscador-boton  { padding: 0.6rem 1rem; }
    }
</style>

<style is:global>
    .srch-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
        z-index: 300;
        overflow: hidden;
    }

    .srch-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.65rem 1rem;
        text-decoration: none;
        color: #151e42;
        border-bottom: 1px solid #f3f3f3;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .srch-item:last-of-type { border-bottom: none; }
    .srch-item:hover        { background: #fffbe6; }

    /* Avatar */
    .srch-av {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f0f0;
    }

    .srch-av--square { border-radius: 6px; }

    .srch-av img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
    }

    .srch-av--square img {
        object-fit: contain;
        padding: 3px;
    }

    .srch-av-initial {
        font-family: "Archivo Black", sans-serif;
        font-size: 1.1rem;
        font-weight: 900;
        line-height: 1;
    }

    /* Text */
    .srch-text {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
        flex: 1;
    }

    .srch-meta {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .srch-badge {
        font-family: "Bebas Neue", sans-serif;
        font-size: 0.65rem;
        letter-spacing: 0.5px;
        background: #ffde59;
        color: #151e42;
        padding: 0.1rem 0.45rem;
        border-radius: 50px;
        white-space: nowrap;
        line-height: 1.4;
    }

    .srch-sub {
        font-family: "Inter", sans-serif;
        font-size: 0.7rem;
        color: #999;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .srch-title {
        font-family: "Bebas Neue", sans-serif;
        font-size: 1rem;
        color: #151e42;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.1;
    }

    /* Footer */
    .srch-all {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 1rem;
        font-family: "Bebas Neue", sans-serif;
        font-size: 0.88rem;
        letter-spacing: 0.5px;
        color: #151e42;
        background: #f7f7f7;
        border-top: 2px solid #ffde59;
        cursor: pointer;
        transition: background 0.15s ease;
        text-decoration: none;
    }

    .srch-all:hover { background: #fffbe6; }

    .srch-empty {
        padding: 1rem;
        font-family: "Inter", sans-serif;
        font-size: 0.9rem;
        color: #aaa;
        text-align: center;
        margin: 0;
    }

    .srch-match-row {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .srch-date {
        font-family: "Inter", sans-serif;
        font-size: 0.68rem;
        color: #888;
        white-space: nowrap;
    }

    .srch-comp {
        font-family: "Bebas Neue", sans-serif;
        font-size: 0.65rem;
        letter-spacing: 0.5px;
        background: #151e42;
        color: #ffffff;
        padding: 0.1rem 0.45rem;
        border-radius: 50px;
        white-space: nowrap;
        line-height: 1.4;
    }

    @media (max-width: 480px) {
        .srch-dropdown {
            border-radius: 12px;
        }

        .srch-item {
            gap: 0.6rem;
            padding: 0.55rem 0.75rem;
        }

        .srch-av {
            width: 32px;
            height: 32px;
        }

        .srch-av-initial {
            font-size: 0.9rem;
        }

        .srch-title {
            font-size: 0.88rem;
        }

        .srch-badge {
            font-size: 0.6rem;
        }

        .srch-sub,
        .srch-date {
            font-size: 0.62rem;
        }

        .srch-comp {
            font-size: 0.6rem;
        }

        .srch-all {
            font-size: 0.8rem;
            padding: 0.55rem 0.75rem;
        }
    }
</style>

<script>
    const input     = document.getElementById('searchInput')   as HTMLInputElement | null;
    const dropdown  = document.getElementById('searchDropdown') as HTMLDivElement   | null;
    const container = document.getElementById('searchContainer') as HTMLDivElement  | null;

    if (input && dropdown && container) {
        const dd = dropdown as HTMLDivElement;

        const LABELS: Record<string, string> = {
            player:  'Jugadora',
            coach:   'Entrenadora',
            rival:   'Rival',
            match:   'Partido',
            referee: 'Árbitra',
            stadium: 'Estadio',
        };

        const AV_BG: Record<string, string> = {
            player:  '#ffde59',
            coach:   '#ffde59',
            rival:   '#151e42',
            match:   '#e8e8e8',
            referee: '#ffe0b2',
            stadium: '#d0ead8',
        };

        const AV_FG: Record<string, string> = {
            rival: '#ffffff',
        };

        const SQUARE_TYPES = new Set(['rival', 'stadium', 'match']);

        let timer: ReturnType<typeof setTimeout>;

        input.addEventListener('input', () => {
            clearTimeout(timer);
            const q = input.value.trim();
            if (q.length < 2) { hide(); return; }
            timer = setTimeout(() => load(q), 280);
        });

        async function load(q: string) {
            try {
                const res  = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
                const data = await res.json();
                render(data.results ?? [], q);
            } catch (_) {}
        }

        function avatar(r: any): string {
            const src    = r.imageUrl || r.shieldUrl || '';
            const square = SQUARE_TYPES.has(r.type);
            const bg     = AV_BG[r.type]  ?? '#f0f0f0';
            const fg     = AV_FG[r.type]  ?? '#151e42';
            const letter = (r.title ?? '?').charAt(0).toUpperCase();
            const cls    = `srch-av${square ? ' srch-av--square' : ''}`;

            if (src) {
                return `<div class="${cls}"><img src="${src}" alt="" loading="lazy"></div>`;
            }
            return `<div class="${cls}" style="background:${bg}">
                        <span class="srch-av-initial" style="color:${fg}">${letter}</span>
                    </div>`;
        }

        function escHtml(s: string): string {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        const COMP_COLORS: Record<string, string> = {
            'liga f':              '#0ea5c8',
            'uwcl':                '#1e3a6e',
            'copa de la reina':    '#f97316',
            'supercopa de españa': '#dc2626',
            'amistosos':           '#9ca3af',
        };

        function compStyle(comp: string): string {
            const key = comp.toLowerCase();
            for (const [k, color] of Object.entries(COMP_COLORS)) {
                if (key.includes(k)) return `background:${color};`;
            }
            return '';
        }

        const SKIP_SUB = new Set(['rival', 'coach', 'referee']);

        function subtitleHtml(r: any): string {
            if (!r.subtitle) return '';
            if (SKIP_SUB.has(r.type)) return '';

            if (r.type === 'stadium' && r.subtitle.toLowerCase() === 'estadio') return '';

            if (r.type === 'match') {
                const dash = r.subtitle.indexOf(' - ');
                if (dash !== -1) {
                    const fecha = r.subtitle.slice(0, dash);
                    const comp  = r.subtitle.slice(dash + 3);
                    return `<div class="srch-match-row">
                                <span class="srch-date">${escHtml(fecha)}</span>
                                <span class="srch-comp" style="${compStyle(comp)}">${escHtml(comp)}</span>
                            </div>`;
                }
            }

            return `<span class="srch-sub">${escHtml(r.subtitle)}</span>`;
        }

        function render(results: any[], q: string) {
            if (!results.length) {
                dd.innerHTML = `<p class="srch-empty">Sin resultados para "<b>${escHtml(q)}</b>"</p>`;
                dd.hidden = false;
                return;
            }

            const rows = results.slice(0, 7).map((r: any) => `
                <div class="srch-item" data-href="${escHtml(r.url)}">
                    ${avatar(r)}
                    <div class="srch-text">
                        <div class="srch-meta">
                            <span class="srch-badge">${escHtml(LABELS[r.type] ?? r.type)}</span>
                            ${subtitleHtml(r)}
                        </div>
                        <span class="srch-title">${escHtml(r.title ?? '')}</span>
                    </div>
                </div>`).join('');

            const footer = `<div class="srch-all" data-href="/search?q=${encodeURIComponent(q)}">
                                <span>Ver todos los resultados</span>
                                <span>→</span>
                            </div>`;

            dd.innerHTML = rows + footer;
            dd.hidden = false;
        }

        dd.addEventListener('click', (e) => {
            const el = (e.target as Element).closest('[data-href]') as HTMLElement | null;
            if (el?.dataset.href) {
                e.stopPropagation();
                window.location.href = el.dataset.href;
            }
        });

        function hide() {
            dd.hidden = true;
            dd.innerHTML = '';
        }

        document.addEventListener('click', (e) => {
            if (!container.contains(e.target as Node)) hide();
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') { hide(); input.blur(); }
        });

        document.getElementById('searchForm')?.addEventListener('submit', hide);
    }
</script>

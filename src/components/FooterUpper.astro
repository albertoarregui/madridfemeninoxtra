---
import X from "../assets/redes/x.svg";
import Instagram from "../assets/redes/instagram.svg";
import TikTok from "../assets/redes/tiktok.svg";
import Youtube from "../assets/redes/youtube.svg";
import { localizePath, type SiteLocale } from "../i18n";

interface Props { locale?: SiteLocale; }
const { locale = "es" } = Astro.props;
const en = locale === "en";
const href = (path: string) => localizePath(path, locale);

const logo = "/icon.webp";
const descripcion = en ? "Dedicated Real Madrid Women coverage: news, results, standings, fixtures and historical statistics in one place." : "Tu fuente 100% dedicada al Real Madrid Femenino. Consulta todas las noticias, resultados, clasificación, calendario y estadísticas en un solo lugar. ¡Entra y no te pierdas nada de la actualidad del equipo!";
const sections = [
  { label: "Home", href: "/" },
  { label: en ? "News" : "Noticias", href: "/noticias" },
  { label: en ? "Squad" : "Plantilla", href: "/plantilla" },
  { label: en ? "Matches" : "Partidos", href: "/partidos" },
  { label: "Rankings", href: "/rankings" },
  { label: "La Fábrica", href: "/la-fabrica" },
];
const company = [
  { label: en ? "About us" : "Sobre nosotros", href: "/sobre-nosotros" },
  { label: en ? "Contact" : "Contacto", href: "/contacto" },
  { label: en ? "Privacy Policy" : "Política de Privacidad", href: "/politica-privacidad" },
  { label: en ? "Cookie Policy" : "Política de Cookies", href: "/politica-cookies" },
];
---
<section class="mfx-upper-footer" aria-label={en ? "Madrid Femenino Xtra links and community" : "Enlaces y comunidad de Madrid Femenino Xtra"} data-locale={locale}>
  <div class="mfx-upper-footer__container">
    <div class="mfx-footer-column mfx-footer-brand">
      <a href={href("/")} class="mfx-footer-brand__link" aria-label={en ? "Madrid Femenino Xtra, home" : "Madrid Femenino Xtra, inicio"}>
        <img src={logo} width="100" height="100" loading="lazy" alt="Logotipo de Madrid Femenino Xtra" />
      </a>
      <p>{descripcion}</p>
    </div>

    <nav class="mfx-footer-column" aria-label={en ? "Sections" : "Secciones"}>
      <h2>{en ? "SECTIONS" : "SECCIONES"}</h2>
      {sections.map(item => <a href={href(item.href)}>{item.label}</a>)}
    </nav>

    <nav class="mfx-footer-column" aria-label={en ? "Company" : "Empresa"}>
      <h2>{en ? "COMPANY" : "EMPRESA"}</h2>
      {company.map(item => <a href={href(item.href)}>{item.label}</a>)}
    </nav>

    <nav class="mfx-footer-column" aria-label="Más recursos">
      <h2>{en ? "MORE" : "MÁS"}</h2>
      <a href="/sitemap.xml">Sitemap</a>
      <a href="/rss.xml" type="application/rss+xml">RSS</a>
    </nav>

    <nav class="mfx-footer-column mfx-footer-social" aria-label="Redes sociales">
      <h2>SOCIAL</h2>
      <a href="https://x.com/madridfemxtra" rel="noopener noreferrer" target="_blank"><X aria-hidden="true" /><span>X</span></a>
      <a href="https://instagram.com/madridfemxtra" rel="noopener noreferrer" target="_blank"><Instagram aria-hidden="true" /><span>Instagram</span></a>
      <a href="https://tiktok.com/@madridfemeninoxtra" rel="noopener noreferrer" target="_blank"><TikTok aria-hidden="true" /><span>TikTok</span></a>
      <a href="https://www.youtube.com/@MadridFemXtra" rel="noopener noreferrer" target="_blank"><Youtube aria-hidden="true" /><span>YouTube</span></a>
    </nav>

  </div>
</section>

<style>
  .mfx-upper-footer { width:100%; border-top:1px solid rgba(212,168,67,.4); border-bottom:1px solid rgba(212,168,67,.16); background:transparent; color:rgb(var(--l-ink, 233, 237, 244)); position:relative; }
  .mfx-upper-footer__container { display:grid; grid-template-columns:minmax(175px,1.55fr) minmax(92px,.87fr) minmax(145px,1.3fr) minmax(65px,.67fr) minmax(102px,.9fr); gap:clamp(18px,3vw,52px); max-width:1500px; margin:0 auto; padding:clamp(38px,4.2vw,70px) clamp(16px,3.3vw,52px); }
  .mfx-footer-column { display:flex; flex-direction:column; align-items:flex-start; gap:11px; min-width:0; }
  .mfx-footer-column h2 { color:rgb(var(--l-gold, 212, 168, 67)); font:700 .71rem 'Cinzel',serif; letter-spacing:.12em; margin:3px 0 12px; }
  .mfx-footer-column > a { color:rgb(var(--l-ink, 196, 204, 217)); font:400 .82rem 'DM Sans',sans-serif; text-decoration:none; line-height:1.45; transition:color .2s ease; }
  .mfx-footer-column > a:hover { color:rgb(var(--l-gold, 238, 198, 109)); }
  .mfx-footer-column > a:focus-visible { outline:2px solid #eec66d; outline-offset:3px; }
  .mfx-footer-brand__link { display:inline-flex; margin:-15px 0 8px; width:110px; min-height:108px; align-items:center; }
  .mfx-footer-brand__link img { width:105px; height:105px; object-fit:contain; }
  .mfx-footer-brand p { color:rgb(var(--l-ink, 171, 184, 202)); font:400 .8rem/1.8 'DM Sans',sans-serif; margin:0; max-width:310px; }
  .mfx-footer-social > a { display:inline-flex; align-items:center; gap:10px; }
  .mfx-footer-social > a :global(svg) { width:17px; height:17px; color:rgb(var(--l-gold, 212, 168, 67)); flex-shrink:0; }
  @media(max-width:1230px) { .mfx-upper-footer__container { grid-template-columns:1.2fr 1fr 1.3fr; gap:38px 26px; } }
  @media(max-width:750px) { .mfx-upper-footer__container { grid-template-columns:1fr 1fr; gap:38px 23px; padding:36px 20px; } .mfx-footer-brand { grid-column:1/-1; } .mfx-footer-brand__link { min-height:80px; margin:-12px 0 2px; } .mfx-footer-brand__link img { width:90px; height:90px; } }
  @media(max-width:400px) { .mfx-upper-footer__container { gap:30px 16px; } .mfx-footer-column h2 { font-size:.67rem; } .mfx-footer-column > a { font-size:.76rem; } }
</style>

---
import {
    getRecentNewsByFocus,
    groupNewsByReference,
    type NoticiaCard,
} from "../utils/noticias";
import { fetchPlayersDirectly } from "../utils/players";

const POSITION_ORDER: Record<string, number> = {
    Portera: 1,
    "Lateral izquierda": 2,
    "Defensa central": 3,
    Defensa: 3,
    "Lateral derecha": 4,
    Centrocampista: 5,
    "Extremo izquierdo": 6,
    "Extremo derecho": 6,
    Extremo: 6,
    Delantera: 7,
};

const [players, playerNews] = await Promise.all([
    fetchPlayersDirectly(),
    getRecentNewsByFocus("player", 200),
]);

const playerNewsByRef = groupNewsByReference(playerNews, 3);

const allSeasonKeys = players.flatMap((p: any) => Object.keys(p.dorsales || {}));
const latestSeason = [...new Set(allSeasonKeys)].sort().reverse()[0] as
    | string
    | undefined;

interface Card {
    kind: "player";
    id: string;
    nombre: string;
    href: string;
    photo: string;
    dorsal: number | null;
    posicion: string;
    news: NoticiaCard[];
    order: number;
}

const PLACEHOLDER = "/assets/jugadoras-perfil/placeholder.png";

const squad: Card[] = players
    .filter((p: any) =>
        latestSeason &&
        p.season_info?.[latestSeason]?.id_categoria === 4 &&
        p.season_info?.[latestSeason]?.dorsal != null
    )
    .map((p: any) => ({
        kind: "player" as const,
        id: String(p.id_jugadora),
        nombre: p.nombre,
        href: `/jugadoras/${p.slug}`,
        photo: p.imageUrl || PLACEHOLDER,
        dorsal: p.season_info[latestSeason!].dorsal,
        posicion: p.posicion || "",
        news: playerNewsByRef.get(String(p.id_jugadora)) || [],
        order: POSITION_ORDER[p.posicion] || 99,
    }))
    .sort((a, b) => a.order - b.order || (a.dorsal ?? 99) - (b.dorsal ?? 99));

const cards: Card[] = squad;

const formatDate = (d: string) =>
    new Date(d)
        .toLocaleDateString("es-ES", {
            day: "numeric",
            month: "short",
            year: "numeric",
        })
        .replace(".", "")
        .toUpperCase();
---

{
    cards.length > 0 && (
        <section class="jugadoras-section">
            <div class="title-block">
                <h2 class="landing-title">JUGADORAS</h2>
                <p class="landing-subtitle">
                    Las noticias más relevantes de la primera plantilla del Real
                    Madrid Femenino
                </p>
            </div>

            <div class="jug-carousel-full">
                <button
                    type="button"
                    class="nav-btn jug-nav prev absolute left-0 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white p-1.5 rounded-full backdrop-blur-sm transition-all z-20 hover:scale-110"
                    aria-label="Jugadoras anteriores"
                    data-jug-prev
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                </button>
                <button
                    type="button"
                    class="nav-btn jug-nav next absolute right-0 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white p-1.5 rounded-full backdrop-blur-sm transition-all z-20 hover:scale-110"
                    aria-label="Siguientes jugadoras"
                    data-jug-next
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
                <div class="jug-grid" id="jugadorasGrid">
                    {cards.map((c) => (
                        <article class="jug-card">
                            <div class="jug-inner">
                                <a class="jug-head" href={c.href}>
                                    <span class="jug-photo">
                                        <img
                                            src={c.photo}
                                            alt={c.nombre}
                                            loading="lazy"
                                            decoding="async"
                                            width="66"
                                            height="66"
                                            onerror={`this.src='${PLACEHOLDER}'`}
                                        />
                                    </span>
                                    <span class="jug-head-text">
                                        <span class="jug-eyebrow">
                                            Noticias de {c.nombre}
                                        </span>
                                        <span class="jug-name">{c.nombre}</span>
                                        <span class="jug-tags">
                                            {c.dorsal != null &&
                                                `#${c.dorsal} / `}
                                            {c.posicion}
                                        </span>
                                    </span>
                                </a>

                                <div class="jug-news">
                                    {c.news.length > 0 ? (
                                        c.news.map((n) => (
                                            <a
                                                class="jug-news-item"
                                                href={`/noticias/${n.slug}`}
                                            >
                                                <span class="jug-news-cat">
                                                    {n.category || "NOTICIAS"}
                                                </span>
                                                <span class="jug-news-title">
                                                    {n.title}
                                                </span>
                                                <time class="jug-news-date">
                                                    {formatDate(n.createdAt)}
                                                </time>
                                            </a>
                                        ))
                                    ) : (
                                        <p class="jug-nonews">
                                            Sin noticias recientes
                                        </p>
                                    )}
                                </div>

                                <a class="jug-foot" href={c.href}>
                                    Ver todas las noticias
                                    <span class="jug-foot-arrow">→</span>
                                </a>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    )
}

<style>
    .jugadoras-section {
        width: 100%;
    }

    .jug-carousel-full {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    .jug-carousel-full .jug-grid { width: auto; margin: 0 46px; }
    @media (max-width: 640px) { .jug-carousel-full .jug-grid { margin: 0 38px; } }

    .jug-grid {
        display: flex;
        width: 100%;
        gap: 20px;
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        cursor: grab;
        padding: 8px 2px;
        touch-action: pan-x;
        -webkit-overflow-scrolling: touch;
    }

    .jug-grid::-webkit-scrollbar {
        display: none;
    }

    .jug-card {
        flex-shrink: 0;
        width: 380px;
        height: 470px;
        background: rgba(212, 168, 67, 0.14);
        border-radius: 22px 0 22px 0;
        padding: 1px;
        position: relative;
        overflow: hidden;
        user-select: none;
        transition: transform 0.3s ease;
    }

    .jug-card::before {
        content: "";
        position: absolute;
        inset: -100%;
        background: conic-gradient(
            from 0deg,
            transparent 0%,
            transparent 80%,
            rgba(212, 168, 67, 0.4) 86%,
            #d4a843 90%,
            #f5d483 92%,
            #d4a843 94%,
            transparent 100%
        );
        z-index: 0;
        opacity: 0;
        transition: opacity 0.35s ease;
        animation: jug-spin 1.8s linear infinite paused;
    }

    @keyframes jug-spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    .jug-card:hover {
        transform: translateY(-3px);
    }

    .jug-card:hover::before {
        opacity: 1;
        animation-play-state: running;
    }

    .jug-inner {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: rgba(var(--l-card, 8, 16, 34), 0.97);
        border-radius: 21px 0 21px 0;
        padding: 1.5rem 1.6rem 1.2rem;
    }

    .jug-head {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        text-decoration: none;
        padding-bottom: 1.1rem;
        border-bottom: 1px solid rgba(var(--l-hi, 255, 255, 255), 0.08);
    }

    .jug-photo {
        flex-shrink: 0;
        width: 66px;
        height: 66px;
        border-radius: 50%;
        overflow: hidden;
        background: rgb(var(--l-field, 10, 20, 40));
        border: 3px solid rgba(212, 168, 67, 0.55);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
        transition: border-color 0.3s ease, transform 0.4s ease;
    }

    .jug-card:hover .jug-photo {
        border-color: #d4a843;
        transform: scale(1.05);
    }

    .jug-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        pointer-events: none;
        -webkit-user-drag: none;
    }

    .jug-head-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .jug-eyebrow {
        font-family: "DM Sans", sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgb(var(--l-gold, 212, 168, 67));
        margin-bottom: 0.25rem;
    }

    .jug-name {
        font-family: "Cinzel", serif;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: rgb(var(--l-ink, 240, 240, 240));
        transition: color 0.3s ease;
    }

    .jug-card:hover .jug-name {
        color: rgb(var(--l-gold, 212, 168, 67));
    }

    .jug-tags {
        font-family: "DM Sans", sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(var(--l-ink, 200, 210, 220), 0.55);
        margin-top: 0.35rem;
    }

    .jug-news {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        overflow: hidden;
    }

    .jug-news-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        text-decoration: none;
        padding: 0.85rem 0;
        border-bottom: 1px solid rgba(var(--l-hi, 255, 255, 255), 0.07);
    }

    .jug-news-cat {
        font-family: "DM Sans", sans-serif;
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgb(var(--l-gold, 212, 168, 67));
    }

    .jug-news-title {
        font-family: "Cormorant Garamond", serif;
        font-size: 1.18rem;
        font-weight: 600;
        line-height: 1.25;
        color: rgb(var(--l-ink, 216, 221, 228));
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.25s ease;
    }

    .jug-news-item:hover .jug-news-title {
        color: rgb(var(--l-gold, 212, 168, 67));
    }

    .jug-news-date {
        font-family: "DM Sans", sans-serif;
        font-size: 0.62rem;
        letter-spacing: 0.05em;
        color: rgba(var(--l-ink, 200, 210, 220), 0.4);
    }

    .jug-nonews {
        margin: auto 0;
        text-align: center;
        font-family: "Cormorant Garamond", serif;
        font-size: 1.05rem;
        font-style: italic;
        color: rgba(var(--l-ink, 200, 210, 220), 0.35);
    }

    .jug-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-top: 0.9rem;
        padding-top: 0.9rem;
        border-top: 1px solid rgba(var(--l-hi, 255, 255, 255), 0.08);
        text-decoration: none;
        font-family: "DM Sans", sans-serif;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgb(var(--l-gold, 212, 168, 67));
        transition: color 0.25s ease;
    }

    .jug-foot:hover {
        color: rgb(var(--l-gold, 245, 212, 131));
    }

    .jug-foot-arrow {
        transition: transform 0.25s ease;
    }

    .jug-foot:hover .jug-foot-arrow {
        transform: translateX(4px);
    }

    @media (max-width: 768px) {
        .jug-grid {
            gap: 14px;
        }
        .jug-card {
            width: 300px;
            height: 450px;
        }
        .jug-inner {
            padding: 1.3rem 1.3rem 1rem;
        }
        .jug-name {
            font-size: 1.15rem;
        }
    }

    @media (max-width: 480px) {
        .jug-card {
            width: 82vw;
            max-width: 300px;
            height: 440px;
        }
        .jug-name {
            font-size: 1.05rem;
        }
        .jug-news-title {
            font-size: 1.05rem;
        }
    }
</style>

<script>
    function setupJugadorasArrows() {
        const grid = document.getElementById("jugadorasGrid");
        const wrap = grid?.closest(".jug-carousel-full");
        if (!grid || !wrap || wrap.hasAttribute("data-arrows-ready")) return;
        wrap.setAttribute("data-arrows-ready", "true");
        const prev = wrap.querySelector<HTMLButtonElement>("[data-jug-prev]");
        const next = wrap.querySelector<HTMLButtonElement>("[data-jug-next]");
        const step = () => {
            const card = grid.querySelector<HTMLElement>(".jug-card");
            return card ? card.offsetWidth + 20 : grid.clientWidth * 0.8;
        };
        const update = () => {
            const atStart = grid.scrollLeft <= 4;
            const atEnd = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 4;
            for (const [button, disabled] of [[prev, atStart], [next, atEnd]] as const) {
                if (!button) continue;
                button.style.opacity = disabled ? "0.3" : "1";
                button.style.pointerEvents = disabled ? "none" : "auto";
                button.setAttribute("aria-disabled", String(disabled));
            }
        };
        prev?.addEventListener("click", () => grid.scrollBy({ left: -step(), behavior: "smooth" }));
        next?.addEventListener("click", () => grid.scrollBy({ left: step(), behavior: "smooth" }));
        grid.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
    }
    setupJugadorasArrows();
    document.addEventListener("astro:page-load", setupJugadorasArrows);
</script>

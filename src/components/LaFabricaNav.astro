---
const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
const links = [
    { href: '/la-fabrica', label: 'La Fábrica' },
    { href: '/la-fabrica/historia', label: 'Historia' },
    { href: '/la-fabrica/espana', label: 'España' },
];

const isActive = (href: string) =>
    currentPath === href;
---

<nav class="fabrica-local-nav" aria-label="Navegación de La Fábrica">
    {links.map((item) => (
        <a
            href={item.href}
            class:list={['fabrica-local-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
        >
            {item.label}
        </a>
    ))}
</nav>

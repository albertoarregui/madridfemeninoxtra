---
import { getFlagSrc } from "../utils/flags";
import { fetchPlayersDirectly, getPlayerImageUrl, fetchInjuredPlayerIds, isFirstTeamInSeason } from "../utils/players";
import { fetchRankingsDirectly } from "../utils/rankings";
import { fetchGamesDirectly } from "../utils/partidos";
import { fetchCoachesDirectly } from "../utils/entrenadores";
interface Props { season: string; currentSeason: string; seasons: string[]; }
const { season, currentSeason, seasons = [] } = Astro.props;

// Todo sale de lecturas ya cacheadas y compartidas con otras páginas.
const [allPlayersDb, lesionadas, rankingRows, allGames, coaches] = await Promise.all([
    fetchPlayersDirectly(),
    fetchInjuredPlayerIds(),
    fetchRankingsDirectly(),
    fetchGamesDirectly(),
    fetchCoachesDirectly(),
]);

const squadPlayers = allPlayersDb.filter((player) => isFirstTeamInSeason(player, season));

// Partidos, goles y asistencias de la temporada (oficiales: sin amistosos).
const seasonStats = new Map<string, { partidos: number; goles: number; asistencias: number; porterias_cero: number }>();
for (const row of rankingRows) {
    if (row.temporada !== season || row.competicion === "Amistoso") continue;
    const id = String(row.id_jugadora);
    const stats = seasonStats.get(id) ?? { partidos: 0, goles: 0, asistencias: 0, porterias_cero: 0 };
    stats.partidos += Number(row.partidos) || 0;
    stats.porterias_cero += Number(row.porterias_cero) || 0;
    stats.goles += Number(row.goles) || 0;
    stats.asistencias += Number(row.asistencias) || 0;
    seasonStats.set(id, stats);
}

const listofPlayers = squadPlayers.map((player) => {
    const { pais_origin, iso } = player;
    const dorsal = player.season_info[season].dorsal;
    const profilePhoto =
        player.profile_photos && player.profile_photos[season];
    const seasonPhoto =
        player.season_photos && player.season_photos[season];

    const stats = seasonStats.get(String(player.id_jugadora)) ?? { partidos: 0, goles: 0, asistencias: 0, porterias_cero: 0 };
    // Bajo cada miniatura: partidos, goles y asistencias oficiales de la
    // temporada; en las porteras, solo las porterías a cero.
    const isGoalkeeper = (player.posicion || "").toLowerCase().includes("portera");
    const thumbStats = isGoalkeeper
        ? [{ value: stats.porterias_cero, label: "Port. a 0", long: ["portería a cero", "porterías a cero"] }]
        : [
            { value: stats.partidos, label: "PJ", long: ["partido", "partidos"] },
            { value: stats.goles, label: "G", long: ["gol", "goles"] },
            { value: stats.asistencias, label: "A", long: ["asistencia", "asistencias"] },
        ];

    return {
        ...player,
        id: player.id_jugadora.toString(),
        thumbStats,
        thumbLabel: `${player.nombre}: ${thumbStats.map((stat) => `${stat.value} ${stat.long[stat.value === 1 ? 0 : 1]}`).join(", ")}`,
        isInjured: lesionadas.has(String(player.id_jugadora)),
        name: player.nombre,
        number: dorsal != null ? dorsal.toString() : "",
        position: player.posicion,
        country: pais_origin,
        iso,
        countryName: pais_origin || "",
        flagUrl: getFlagSrc(iso || pais_origin),
        date_birth: player.fecha_nacimiento,
        height: player.altura,
        weight: player.peso,
        imageUrl: getPlayerImageUrl({
            ...player,
            foto_url: profilePhoto || seasonPhoto,
            foto_perfil_url: profilePhoto,
        }),
        thumbnailUrl: getPlayerImageUrl({
            ...player,
            foto_url: seasonPhoto,
            foto_perfil_url: null,
        }),
    };
});

listofPlayers.sort((a, b) => {
    const na = a.number === "" ? Infinity : Number(a.number);
    const nb = b.number === "" ? Infinity : Number(b.number);
    return na - nb;
});

const getNormalizedPosition = (pos: string) => {
    const p = pos?.toLowerCase() || "";
    if (p.includes("portera")) return "Portera";
    if (p.includes("defensa") || p.includes("lateral") || p.includes("central"))
        return "Defensa";
    if (p.includes("medio") || p.includes("centro") || p.includes("pivote") || p.includes("interior"))
        return "Centrocampista";
    if (p.includes("delantera") || p.includes("extremo") || p.includes("punta") || p.includes("ariete"))
        return "Delantera";
    return "Otros";
};

const firstGkIdx = listofPlayers.findIndex(p => getNormalizedPosition(p.position) === "Portera");
if (firstGkIdx > 0) {
    const [gk] = listofPlayers.splice(firstGkIdx, 1);
    listofPlayers.unshift(gk);
}

const porteras  = listofPlayers.filter(p => getNormalizedPosition(p.position) === "Portera");
const defensas  = listofPlayers.filter(p => getNormalizedPosition(p.position) === "Defensa");
const medios    = listofPlayers.filter(p => getNormalizedPosition(p.position) === "Centrocampista");
const delanteras = listofPlayers.filter(p => getNormalizedPosition(p.position) === "Delantera");
const otros     = listofPlayers.filter(p => getNormalizedPosition(p.position) === "Otros");

const rows = [
    { title: "PORTERAS",        players: porteras },
    { title: "DEFENSAS",        players: defensas },
    { title: "CENTROCAMPISTAS", players: medios },
    { title: "DELANTERAS",      players: delanteras },
].filter(row => row.players.length > 0);

if (otros.length > 0) rows.push({ title: "OTRAS", players: otros });

// Resumen de la plantilla. En temporadas pasadas la edad se calcula al inicio
// de la temporada (1 de septiembre); en la actual, a día de hoy.
const parseNumber = (value: unknown) => {
    const n = Number.parseFloat(String(value ?? "").replace(",", "."));
    return Number.isFinite(n) && n > 0 ? n : null;
};
const average = (values: (number | null)[]) => {
    const valid = values.filter((v): v is number => v !== null);
    return valid.length ? valid.reduce((sum, v) => sum + v, 0) / valid.length : null;
};
const ageReference = season === currentSeason
    ? new Date()
    : new Date(Number.parseInt(season.slice(0, 4), 10), 8, 1);
const ageAt = (birth: string) => {
    const date = new Date(birth);
    if (!birth || Number.isNaN(date.getTime())) return null;
    let age = ageReference.getFullYear() - date.getFullYear();
    const m = ageReference.getMonth() - date.getMonth();
    if (m < 0 || (m === 0 && ageReference.getDate() < date.getDate())) age--;
    return age;
};
const avgAge = average(listofPlayers.map((p) => ageAt(p.date_birth)));
const avgHeight = average(listofPlayers.map((p) => {
    const h = parseNumber(p.height);
    return h === null ? null : h > 3 ? h / 100 : h;
}));
const avgWeight = average(listofPlayers.map((p) => parseNumber(p.weight)));

// Entrenador(es) de la temporada en orden cronológico, con su primer y último
// partido dirigido y cuántos lleva. Solo los que la web reconoce como
// entrenadores (excluye interinos puntuales).
const coachSpans = new Map<string, { first: string; last: string; games: number }>();
for (const game of allGames) {
    if (game.temporada_nombre !== season || !game.entrenador_nombre || !game.isPlayed) continue;
    const fecha = String(game.fecha ?? "").slice(0, 10);
    const span = coachSpans.get(game.entrenador_nombre) ?? { first: fecha, last: fecha, games: 0 };
    if (fecha && fecha < span.first) span.first = fecha;
    if (fecha > span.last) span.last = fecha;
    span.games++;
    coachSpans.set(game.entrenador_nombre, span);
}
const coachMonths = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const coachDate = (fecha: string) => {
    const [year, month, day] = fecha.split("-").map(Number);
    return year && month && day ? `${day} ${coachMonths[month - 1]} ${year}` : "";
};
const latestCoachDate = Math.max(...[...coachSpans.values()].map((span) => Date.parse(span.last) || 0), 0);
const seasonCoaches = [...coachSpans.entries()]
    .sort((a, b) => a[1].first.localeCompare(b[1].first))
    .map(([name, span]) => {
        const coach = coaches.find((c) => c.nombre === name);
        return coach && {
            ...coach,
            from: coachDate(span.first),
            to: coachDate(span.last),
            games: span.games,
            current: season === currentSeason && Date.parse(span.last) === latestCoachDate,
        };
    })
    .filter((coach) => Boolean(coach));

const formatDecimal = (value: number | null, digits: number) =>
    value === null ? "-" : value.toFixed(digits).replace(".", ",");
const seasonHref = (value: string) =>
    value === currentSeason ? "/plantilla" : `/plantilla?temporada=${encodeURIComponent(value)}`;

function calculateAge(birthDateString: string): number {
    const birthDate = new Date(birthDateString);
    const today = new Date();
    let age = today.getFullYear() - birthDate.getFullYear();
    const m = today.getMonth() - birthDate.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
    return age;
}
---

{listofPlayers.length === 0 && (
    <p class="squad-empty">Todavía no hay jugadoras registradas para la temporada {season}.</p>
)}

<section class="squad-summary" aria-label="Resumen de la plantilla">
    <dl class="squad-summary-stats">
        <div class="squad-summary-item">
            <dt>Jugadoras</dt>
            <dd>{listofPlayers.length}</dd>
        </div>
        <div class="squad-summary-item">
            <dt>Edad media</dt>
            <dd>{formatDecimal(avgAge, 1)}<small>años</small></dd>
        </div>
        <div class="squad-summary-item">
            <dt>Estatura media</dt>
            <dd>{formatDecimal(avgHeight, 2)}<small>m</small></dd>
        </div>
        <div class="squad-summary-item">
            <dt>Peso medio</dt>
            <dd>{formatDecimal(avgWeight, 1)}<small>kg</small></dd>
        </div>
    </dl>

    {seasons.length > 1 && (
        <details class="squad-season" data-squad-season>
            <summary>
                <span class="squad-season-label">Temporada</span>
                <span class="squad-season-value">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
                    {season}
                    <svg class="squad-season-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </span>
            </summary>
            <ul>
                {seasons.map((value) => (
                    <li>
                        <a href={seasonHref(value)} class:list={{ "is-active": value === season }} aria-current={value === season ? "page" : undefined}>
                            {value}{value === currentSeason && <small>actual</small>}
                        </a>
                    </li>
                ))}
            </ul>
        </details>
    )}
</section>

{seasonCoaches.length > 0 && (
    <div class="squad-coaches">
        {seasonCoaches.map((coach) => (
            <a class="coach-card" href={`/entrenadores/${coach.slug}`} aria-label={`Ver la ficha de ${coach.nombre}`}>
                {coach.imageUrl && <img class="coach-card-photo" src={coach.imageUrl} alt="" width="64" height="64" loading="lazy" decoding="async" />}
                <span class="coach-card-body">
                    <span class="coach-card-label">Entrenador</span>
                    <span class="coach-card-name">
                        {coach.nombre}
                        {coach.flagUrl && <img class="coach-card-flag" src={coach.flagUrl} alt="" width="20" height="14" loading="lazy" decoding="async" />}
                        {coach.iso && <span class="coach-card-iso">{coach.iso.toUpperCase()}</span>}
                        {coach.current && (
                            <span class="coach-card-badge">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8.5 12.5 2.5 2.5 4.5-5" /></svg>
                                Actual
                            </span>
                        )}
                    </span>
                    <span class="coach-card-meta">{coach.from} – {coach.to} · {coach.games} {coach.games === 1 ? "partido" : "partidos"}</span>
                </span>
                <span class="coach-card-cta" aria-hidden="true">Ver ficha →</span>
            </a>
        ))}
    </div>
)}

{listofPlayers.length > 0 && <section class="player-selector">

    <div class="sf-inner">

        <div class="main-player-display">
            <div class="player-main-image-container">
                {listofPlayers.length > 0 && (
                    <img
                        id="player-main-image"
                        src={listofPlayers[0].imageUrl}
                        alt={listofPlayers[0].name}
                        class="player-main-image"
                        width="360"
                        height="480"
                        loading="eager"
                        decoding="async"
                        fetchpriority="high"
                    />
                )}
            </div>

            <span class="player-dorsal" id="player-number">
                {listofPlayers.length > 0 ? listofPlayers[0].number : ""}
            </span>

            <h2 class="player-name" id="player-name">
                {listofPlayers.length > 0 ? listofPlayers[0].name : "Selecciona jugadora"}
            </h2>

            <span
                class="squad-injured-chip"
                id="player-injured"
                title="Lesionada actualmente"
                hidden={!(listofPlayers.length > 0 && listofPlayers[0].isInjured)}
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 8v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"/><path d="M4 10a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -8"/><path d="M10 14h4"/><path d="M12 12v4"/></svg>
                Lesionada
            </span>

            <div class="player-info-top">
                <div class="player-country-flat">
                    <img
                        id="player-flag"
                        src={listofPlayers.length > 0 ? listofPlayers[0].flagUrl : ""}
                        alt={listofPlayers.length > 0 ? listofPlayers[0].countryName : ""}
                        class="country-flag"
                        width="20"
                        height="14"
                        decoding="async"
                    />
                    <span id="player-country-name">
                        {listofPlayers.length > 0 ? listofPlayers[0].countryName : "-"}
                    </span>
                </div>
            </div>

            <div class="player-stats">
                <div class="stat-item">
                    <span class="stat-label">Edad</span>
                    <span class="stat-value" id="player-age">
                        {listofPlayers.length > 0 ? calculateAge(listofPlayers[0].date_birth) : "-"}
                    </span>
                </div>
                <div class="stat-sep" aria-hidden="true"></div>
                <div class="stat-item">
                    <span class="stat-label">Altura</span>
                    <span class="stat-value" id="player-height">
                        {listofPlayers.length > 0 ? `${listofPlayers[0].height}m` : "-"}
                    </span>
                </div>
                <div class="stat-sep" aria-hidden="true"></div>
                <div class="stat-item">
                    <span class="stat-label">Peso</span>
                    <span class="stat-value" id="player-weight">
                        {listofPlayers.length > 0 ? `${listofPlayers[0].weight}kg` : "-"}
                    </span>
                </div>
            </div>

            <div class="player-actions">
                {listofPlayers.length > 0 && (
                    <a href={`/jugadoras/${listofPlayers[0].slug}`} id="player-profile-link" class="btn-profile">
                        VER PERFIL
                    </a>
                )}
            </div>
        </div>

        <div class="selector-divider" aria-hidden="true"></div>

        <div class="player-rows-container">
            {rows.map(row => (
                <div class="player-row-section">
                    <h4 class="section-title">
                        <span class="section-title-pip" aria-hidden="true"></span>
                        {row.title}
                    </h4>
                    <div class="player-row">
                        {row.players.map(player => {
                            const globalIndex = listofPlayers.findIndex(p => p.id === player.id);
                            return (
                                <button
                                    class={`player-thumbnail desktop-thumb ${globalIndex === 0 ? "active" : ""}`}
                                    data-player-id={player.id}
                                    data-player-index={globalIndex}
                                    data-profile-image={player.imageUrl}
                                    aria-label={player.thumbLabel}
                                >
                                    <span class="thumbnail-number">{player.number}</span>
                        {player.isInjured && (
                            <span class="thumb-injured" title="Lesionada" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 8v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"/><path d="M4 10a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -8"/><path d="M10 14h4"/><path d="M12 12v4"/></svg>
                            </span>
                        )}
                                    <div class="thumbnail-image-wrapper">
                                        <img src={player.thumbnailUrl} alt={player.name} class="thumbnail-image" width="150" height="188" loading="lazy" decoding="async" />
                                    </div>
                                    <span class="thumb-stats" aria-hidden="true">
                                        {player.thumbStats.map((stat) => (
                                            <span class="thumb-stat"><b>{stat.value}</b><small>{stat.label}</small></span>
                                        ))}
                                    </span>
                                </button>
                            );
                        })}
                    </div>
                </div>
            ))}
        </div>

    </div>

    <div class="mobile-player-carousel">
        <button class="carousel-arrow" id="carousel-prev" aria-label="Previous player">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="mobile-thumbnails-wrapper">
            <div class="mobile-thumbnails-track">
                {listofPlayers.map((player, index) => (
                    <button
                        class={`player-thumbnail mobile-thumb ${index === 0 ? "active" : ""}`}
                        data-player-id={player.id}
                        data-player-index={index}
                        data-profile-image={player.imageUrl}
                        aria-label={player.thumbLabel}
                    >
                        <span class="thumbnail-number">{player.number}</span>
                        {player.isInjured && (
                            <span class="thumb-injured" title="Lesionada" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 8v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"/><path d="M4 10a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -8"/><path d="M10 14h4"/><path d="M12 12v4"/></svg>
                            </span>
                        )}
                        <div class="thumbnail-image-wrapper">
                            <img src={player.thumbnailUrl} alt={player.name} class="thumbnail-image" width="150" height="188" loading="lazy" decoding="async" />
                        </div>
                        <span class="thumb-stats" aria-hidden="true">
                            {player.thumbStats.map((stat) => (
                                <span class="thumb-stat"><b>{stat.value}</b><small>{stat.label}</small></span>
                            ))}
                        </span>
                    </button>
                ))}
            </div>
        </div>
        <button class="carousel-arrow" id="carousel-next" aria-label="Next player">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
    </div>
</section>}

<script is:inline define:vars={{ players: listofPlayers }}>

    function calculateAge(birthDateString) {
        const birthDate = new Date(birthDateString);
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
        return age;
    }

    document.addEventListener('astro:page-load', () => {
        let selectedIndex = 0;

        function updatePlayerDisplay(index, isSelection = false) {
            const player = players[index];
            if (!player) return;
            if (isSelection) selectedIndex = index;

            const setContent = (id, text) => {
                const el = document.getElementById(id);
                if (el) el.textContent = text;
            };

            setContent("player-country-name", player.countryName);
            setContent("player-name", player.name);
            setContent("player-number", player.number);
            setContent("player-height", `${player.height}m`);
            setContent("player-weight", `${player.weight}kg`);
            setContent("player-age", calculateAge(player.date_birth));

            const flag = document.getElementById("player-flag");
            if (flag) { flag.src = player.flagUrl; flag.alt = player.countryName; }

            const imgEl = document.getElementById("player-main-image");
            if (imgEl) {
                if (player.imageUrl) imgEl.src = player.imageUrl;
                imgEl.alt = player.name;
            }

            const link = document.getElementById("player-profile-link");
            if (link) link.href = `/jugadoras/${player.slug}`;

            const chip = document.getElementById("player-injured");
            if (chip) chip.hidden = !player.isInjured;

            document.querySelectorAll(".player-thumbnail").forEach(thumb => {
                const i = parseInt(thumb.dataset.playerIndex || "-1");
                thumb.classList.toggle("active", i === selectedIndex);
            });
        }

        const rowsContainer = document.querySelector(".player-rows-container");
        const wrapper = document.querySelector(".mobile-thumbnails-wrapper");
        const prevBtn = document.getElementById("carousel-prev");
        const nextBtn = document.getElementById("carousel-next");

        if (prevBtn) prevBtn.addEventListener("click", () => wrapper?.scrollBy({ left: -128, behavior: "smooth" }));
        if (nextBtn) nextBtn.addEventListener("click", () => wrapper?.scrollBy({ left: 128, behavior: "smooth" }));
        if (wrapper) {
            wrapper.addEventListener("wheel", e => {
                e.preventDefault();
                wrapper.scrollBy({ left: e.deltaX || e.deltaY, behavior: "smooth" });
            }, { passive: false });
        }

        document.querySelectorAll(".player-thumbnail").forEach(thumb => {
            thumb.addEventListener("mouseenter", e => {
                if (window.innerWidth > 768 && e.currentTarget?.dataset.playerIndex)
                    updatePlayerDisplay(parseInt(e.currentTarget.dataset.playerIndex), false);
            });
            thumb.addEventListener("click", e => {
                if (e.currentTarget?.dataset.playerIndex)
                    updatePlayerDisplay(parseInt(e.currentTarget.dataset.playerIndex), true);
            });
        });

        if (rowsContainer) {
            rowsContainer.addEventListener("mouseleave", () => {
                if (window.innerWidth > 768) updatePlayerDisplay(selectedIndex, false);
            });
        }
    });
</script>

<script is:inline data-astro-rerun>
    // Cierra el selector de temporada al pulsar fuera o con Escape.
    (() => {
        const picker = document.querySelector("[data-squad-season]");
        if (!picker || picker.dataset.ready === "true") return;
        picker.dataset.ready = "true";
        document.addEventListener("click", (event) => {
            if (picker.open && !picker.contains(event.target)) picker.open = false;
        });
        picker.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && picker.open) {
                picker.open = false;
                picker.querySelector("summary").focus();
            }
        });
    })();
</script>

<style>
    /* Resumen de la plantilla y filtro de temporada */
    .squad-summary {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem;

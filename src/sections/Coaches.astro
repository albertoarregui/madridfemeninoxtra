---
import "../styles/global.css";
import { getCoachImageUrl } from "../utils/entrenadores";
import { getFlagSrc } from "../utils/flags";

interface Props {
    coaches?: any[];
}

const { coaches = [] } = Astro.props;

const listofCoaches = coaches
    .map((coach) => ({
        ...coach,
        nombre: coach.nombre || coach.name || "",
        countryName: coach.pais || "",
        flagUrl: coach.flagUrl || getFlagSrc(coach.country || coach.pais),
        imageUrl: coach.imageUrl || getCoachImageUrl(coach) || "",
    }))
    .filter((c) => {
        const name = c.nombre.trim();
        if (!name || name.toLowerCase() === "null") return false;
        const excluded = ["josé manuel lara", "antonio rodríguez", "antonio rodriguez"];
        return !excluded.includes(name.toLowerCase());
    });
---

<div class="ec-wrapper">
    <div class="pg-card-grid ec-grid" data-ec-grid>
        {listofCoaches.map((coach, index) => (
            <a
                id={`card-${coach.id || coach.slug}`}
                href={`/entrenadores/${coach.id || coach.slug}`}
                class="player-portrait-card"
                data-nombre={coach.nombre}
                data-default-order={index}
                style={`animation-delay: ${Math.min(index * 40, 400)}ms`}
                data-astro-prefetch="hover"
                aria-label={`Ver ficha de ${coach.nombre}`}
            >
                <span class="pg-corner pg-corner-tl" aria-hidden="true" />
                <span class="pg-corner pg-corner-tr" aria-hidden="true" />
                <span class="pg-corner pg-corner-bl" aria-hidden="true" />
                <span class="pg-corner pg-corner-br" aria-hidden="true" />
                <div class="pg-card-glow" aria-hidden="true" />
                <span class="pg-pos-label" aria-hidden="true">♦ ENT</span>
                <div class="pg-card-photo" transition:name={`coach-${coach.id || coach.slug}`}>
                    <img
                        src={coach.imageUrl}
                        alt={coach.nombre}
                        loading={index < 6 ? 'eager' : 'lazy'}
                        decoding="async"
                        width={200}
                        height={267}
                        onerror="this.src='/assets/entrenadores/placeholder.png'"
                    />
                </div>
                <div class="pg-card-overlay">
                    <span class="pg-card-divider" aria-hidden="true"></span>
                    <div class="pg-card-name">{coach.nombre}</div>
                    <div class="pg-card-country">
                        {coach.flagUrl && <img src={coach.flagUrl} alt="" width="14" height="14" loading="lazy" onerror="this.style.display='none'" />}
                        <span>{coach.countryName}</span>
                    </div>
                </div>
            </a>
        ))}
    </div>
</div>

<script>
  document.addEventListener('astro:after-swap', () => {
    const hash = window.location.hash;
    if (hash?.startsWith('#card-')) {
      const el = document.querySelector<HTMLElement>(hash);
      if (el) el.scrollIntoView({ behavior: 'instant', block: 'center' });
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  });

  document.addEventListener('astro:before-swap', (e: any) => {
    const from = window.location.pathname;
    const to = e.to?.pathname ?? '';
    const returning = to === '/entrenadores' && from.startsWith('/entrenadores/');
    e.newDocument.documentElement.toggleAttribute('data-skip-coaches-enter', returning);
  });
</script>

<style>
  .ec-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }

  .ec-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  html[data-skip-coaches-enter] .player-portrait-card {
    animation: none !important;
    opacity: 1 !important;
  }

  @media (min-width: 540px) {
    .ec-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 900px) {
    .ec-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

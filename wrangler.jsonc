{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "madridfemeninoxtra",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "APP_ENV": "production"
  },
  "triggers": {
    "crons": ["0 6 * * 1"]
  },
  "observability": {
    "enabled": true
  }
}
